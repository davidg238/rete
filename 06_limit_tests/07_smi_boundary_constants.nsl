(*
expect:
2305843009213693952
-2305843009213693952
4611686018427387903
-4611686018427387904
true
hit
*)
(* nsl-tuvm#4: integer literal constants in the "gap band" — values that fit the
   runtime tagged-SMI range (+-2^62 on a 64-bit host) but NOT the .oimg SMI
   ref-word (2 tag bits -> +-2^61). The oimg backend used to sign-flip these
   (2^61 loaded as -2^61) and load -2^62 as 0. Contract: every literal below
   prints exactly as written on BOTH backends, and a gap-band literal is
   canonically represented — it must be = to, hash like, and dictionary-match
   the same value reached by arithmetic. See
   nsl-tuvm/docs/superpowers/findings/2026-07-04-oimg-large-smi-constant-corruption.md. *)
class SmiBoundaryConstantTest packageUsing: manifest = () (
public main: platform args: args = (
  | d computed |
  (2305843009213693952 printString) println.       (* 2^61: bottom of the gap band *)
  (-2305843009213693952 printString) println.      (* -2^61 *)
  (4611686018427387903 printString) println.       (* 2^62-1: runtime SMI max *)
  (-4611686018427387904 printString) println.      (* -2^62: runtime SMI min; loaded as 0 pre-fix *)

  computed:: 1152921504606846976 + 1152921504606846976.  (* 2^60 + 2^60 = 2^61, canonical SMI *)
  (computed = 2305843009213693952) println.        (* true — literal equals computed value *)

  d:: platform Dictionary new.
  d at: 2305843009213693952 put: 'hit'.            (* gap-band literal as dictionary key *)
  (d at: computed ifAbsent: [ 'MISS' ]) println.   (* hit — canonical rep: hashes agree *)
)
) : (
)
