(*
expect:
true
true
true
42
42
*)
(* T-B.3 — shared-by-reference, unchanged: two references to one message are
   IDENTICAL (==, zero-copy pinned), substructure reached twice is identical,
   and structural = holds between independently built equal trees (while ==
   does not). With mutators nonexistent (12_mutation_matrix/), identity +
   absent-write-path = aliasing safety. *)
class Aliasing packageUsing: manifest = () (
public main: platform args: args = (
  | L inner a b c |
  L:: platform List.
  inner:: L with: 42.
  a:: L with: inner with: inner.
  b:: a.                                        (* second reference, no copy *)
  (a == b) printString out.                     (* true — same object *)
  ((a at: 1) == (a at: 2)) printString out.     (* true — shared substructure *)
  c:: L with: (L with: 42) with: (L with: 42).
  (a = c) printString out.                      (* true — structural equality *)
  ((a at: 1) at: 1) printString out.            (* 42 *)
  ((b at: 2) at: 1) printString out.            (* 42 — via the alias *)
)
) : (
)
