(*
expect:
32
expect-runtime-fail: message depth exceeded
*)
class ListDepthGuard packageUsing: manifest = () (
public main: platform args: args = (
  | L v |
  L:: platform List.
  v:: 0.
  1 to: 32 do: [ :i | v:: L with: v ].
  (v valueDepth) printString out.
  v:: L with: v.
  'unreached' out.
)
) : (
)
