(*
expect:
work
cleanup
caught boom
*)
class EnsureUnwind packageUsing: manifest = () (
  public main: platform args: args = (
    [ [ 'work' out. self error: 'boom' tag: #x ] ensure: [ 'cleanup' out ] ]
      on: [ :e | true ]
      do: [ :e | ('caught ' , (e at: #text ifAbsent: [ '?' ])) out ].
  )
) : (
)
