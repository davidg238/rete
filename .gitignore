*.o
*.out
/nodus/oevm/tests/test_layout
/nodus/oevm/tests/test_layout_32
/nodus/oevm/tests/test_layout32
/nodus/oevm/tests/test_oevm
/nodus/oevm/tests/test_oevm32
/nodus/oevm/tests/test_solidified
/nodus/oevm/tests/test_solidified32
