# Executables and object files
*.o
*.out
tests/test_layout
tests/test_layout_32
tests/test_layout32
tests/test_oevm
tests/test_oevm32
tests/test_solidified
tests/test_solidified32
tests/test_mirrors
tests/test_mirrors_32
tests/test_fibers
tests/test_fibers_32
tests/test_nlr
tests/test_nlr_32

# Python cache
__pycache__/
*.pyc

# Runner binary (regenerated by the test harness)
oevm_runner

# Benchmark binary (regenerated by bench.sh)
oevm_bench

# One-off manual build outputs (asan/valgrind/gc-stress variants, ad-hoc images).
# The canonical source map is src/solidified_image.stmap (tracked); these temp
# bases are underscore-prefixed so they don't collide with it.
oevm_img
_*.stmap
src/_*.stmap
zephyr/build/
# Per-board build dirs (rung 8): each board keeps its own warm CMake/ninja cache, so
# switching boards no longer forces a ~10-minute pristine rebuild.
zephyr/build-dk/
zephyr/build-dongle/
# Soft-float dongle variant (Issue-A suspect #2 experiment; see
# review/ISSUE-dongle-usb-openthread.md).
zephyr/build-dongle-softfloat/
# ESP32 per-model build dirs (run.sh defaults to build-esp32-<MODEL>), the
# throwaway layoutdump app, and the Model B blob — all regenerated by a bake.
zephyr/build-esp32-*/
zephyr/layoutdump/build/
# The Model B bake emits <node>.oimg plus a <node>.stmap source-map sidecar
# beside it (ns_compile_oevm.py writes splitext(out)[0] + ".stmap" for BOTH
# output formats). Both are regenerated by the bake.
zephyr/*.oimg
zephyr/*.stmap

zephyr/prj_dk_thread_local.conf
zephyr/prj_dongle_thread_local.conf
zephyr/prj_esp32_wifi.local.conf
zephyr/build-c6-probe/
zephyr/build-c6-netprobe/
zephyr/build-esp32c6-*/
zephyr/build-heapprobe-*/
zephyr/layoutdump/build-c6/
