(*
expect:
#converting
#idle
#converting
#idle
result: 42
*)
(* T-C L4 Protocol (Milestone C Task 5) — the 3-state machine from the staged
   fsm.ns header comment (idle/converting on #start/#tick/#timeout), driven
   through a full cycle via `handle:`: idle -[start]-> converting -[tick]->
   idle -[start]-> converting -[timeout]-> idle, printing `currentState`
   after each `handle:` — both of converting's outgoing transitions (#tick
   and #timeout) are exercised, deriving the expected states directly from
   the machine's own wiring (idle->converting->idle, twice). The #tick
   action posts a value on a channel (`chan out: '' value: 42`); a
   `whenever:`-registered observer only sees it once `space drain` runs
   (registered AFTER the posts that happen during `handle:`, so it can only
   fire via the drain fan-out, never inline) — proving the FSM-action ->
   reactor seam (Task 2/3 channel surface), not an ordinary in-process call. *)
class ProtocolBasic packageUsing: manifest = () (
public main: platform args: args = (
  | space chan machine |
  space:: platform space.
  chan:: space channel: 'result'.
  machine:: platform Protocol named: #tmp117.
  machine state: #idle on: #start do: [ :m :e | nil ] then: #converting.
  machine state: #converting on: #tick do: [ :m :e | chan out: '' value: 42 ] then: #idle.
  machine state: #converting on: #timeout do: [ :m :e | nil ] then: #idle.
  machine startIn: #idle.
  chan whenever: '' do: [ :v | ('result: ' , v printString) out ].
  machine handle: #start.
  machine currentState printString out.
  machine handle: #tick.
  machine currentState printString out.
  machine handle: #start.
  machine currentState printString out.
  machine handle: #timeout.
  machine currentState printString out.
  space drain.
)
) : (
)
