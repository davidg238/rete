(* The image-artifact fixture (rete#337, protocol/IMAGE-ARTIFACTS.md §4). Small on
   purpose, and covering each shape the image map names: the entry class's methods,
   a nested class, a class-side method (a Meta_ vtable), a block the compiler keeps
   as a block, a local that block captures, and an inlined loop variable (rete#323).
   Changing this file changes Fixture.oimg and its map: regenerate both in the same
   commit (the command is in §4). *)
class Fixture usingPlatform: platform = () (
  public class Counter = (
    | n |
  )(
    public bump = ( n:: n + 1. ^ n )
    public start: v = ( n:: v )
  ) : (
    public from: v = ( ^ self new start: v )
  )

  public main: platform2 args: args = (
    | c twice k |
    c:: Counter from: 40.
    k:: 1.
    twice:: [ :x | x + x + k ].
    1 to: 2 do: [ :i | c bump ].
    (twice value: c bump) println.
    ^ 0 )
) : (
)
