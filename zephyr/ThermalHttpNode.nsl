(*
ThermalHttpNode — the boot module for the AMG8833 thermal demo. One module
declaration nesting three decoupled classes (Newspeak idiom; the bake is
single-app-file, see the rung design 4a):
  ThermalNode  — samples the Grid-EYE on a ctl cadence, publishes frames
  HttpServer   — generic path->block route table over the chunked HTTP prims
  ThermalView  — renders a 64-px frame as an SVG heat-grid
They never reference each other; producer and consumer meet only at the channel
name 'dev/thermal0/sample'. main: is the composition root.
*)
class ThermalHttpNode packageUsing: manifest = () (

  (* ---- presentation: a 64-px centi-degC frame as an SVG heat-grid ----
     The frame arrives off the 'dev/thermal0/sample' CELL, so it is a List (rank
     8), not the raw indexable the prim answers — a raw indexable cannot cross a
     channel at all (put:value: runs the value algebra and the vtable-less prim
     result DNUs on valueRank). Hence at:, not basicAt:. ThermalNode does the
     raw->List copy at the publish boundary; only IT reads with basicAt:. *)
  class ThermalView = () (
    public renderFrame: f toId: id on: platform = (
      | row col line t k |
      (f == nil) ifTrue: [
        platform httpChunkId: id data: '<html><body>no frame</body></html>'. ^ self ].
      platform httpChunkId: id data:
        '<html><body><svg viewBox=''0 0 8 8'' width=''320'' height=''320'' shape-rendering=''crispEdges''>'.
      row:: 0. [ row <= 7 ] whileTrue: [
        line:: ''.
        col:: 0. [ col <= 7 ] whileTrue: [
          t:: f at: (row * 8 + col + 1).
          k:: ((t - 1500) * 255) // 2000.
          (k < 0)   ifTrue: [ k:: 0 ].
          (k > 255) ifTrue: [ k:: 255 ].
          line:: line , '<rect x=''' , col printString , ''' y=''' , row printString ,
                ''' width=''1'' height=''1'' fill=''rgb(' , k printString , ',0,' ,
                (255 - k) printString , ')''/>'.
          col:: col + 1 ].
        platform httpChunkId: id data: line.
        row:: row + 1 ].
      platform httpChunkId: id data: '</svg><p>'.
      platform httpChunkId: id data: (self caption: f).
      platform httpChunkId: id data: '</p></body></html>'.
      ^ self )

    caption: f = (
      | row col t maxV minV hotR hotC |
      maxV:: f at: 1. minV:: f at: 1. hotR:: 0. hotC:: 0.
      row:: 0. [ row <= 7 ] whileTrue: [
        col:: 0. [ col <= 7 ] whileTrue: [
          t:: f at: (row * 8 + col + 1).
          (t > maxV) ifTrue: [ maxV:: t. hotR:: row. hotC:: col ].
          (t < minV) ifTrue: [ minV:: t ].
          col:: col + 1 ]. row:: row + 1 ].
      ^ 'max ' , (self centi: maxV) , 'C min ' , (self centi: minV) ,
        'C hot (' , hotR printString , ',' , hotC printString , ')' )

    centi: v = (
      | whole tenth |
      whole:: v // 100.
      tenth:: (v - (whole * 100)) // 10.
      ^ whole printString , '.' , tenth printString )
  ) : (
  )

  (* ---- the sensor service: samples the Grid-EYE, publishes frames ----
     Knows nothing about HTTP. Capabilities arrive as constructor args (the
     Milestone-C rule). The cadence exists only because a ctl record asked for it
     (G9): no unrequested periodic work, and the CPU idles between ticks. *)
  class ThermalNode = ( | space seam timers sample ctl event tick timer rate
                          spans sJob sAcquire sCompute sPublish | ) (
    (* tuvm#61: the span table arrives as a capability like every other (the
       Milestone-C constructor-args rule), and the node registers ITS OWN segment
       names here rather than being handed indices. The names are this class's
       business — main: has no view into what a thermal job is made of — and
       register: is idempotent, so a re-entered setup cannot consume the budget.
       Registration happens ONCE, at construction: a name lookup is a send and an
       allocation, and the measured path must do neither. *)
    onSpace: sp seam: s timers: t spans: sn = (
      space::  sp.  seam:: s.  timers:: t.  rate:: 2.
      sample:: sp channel: 'dev/thermal0/sample'.    (* CELL:   latest frame out *)
      ctl::    sp channel: 'dev/thermal0/ctl'.       (* CELL:   {rate: N} in     *)
      event::  sp channel: 'dev/thermal0/event'.     (* STREAM: phase-2 alerts   *)
      tick::   sp channel: 'dev/thermal0/tick'.      (* STREAM: timer pulses     *)
      spans::     sn.
      sJob::      sn register: #jobThermal.          (* the whole timer->cell job *)
      sAcquire::  sn register: #acquire.             (* the I2C fetch             *)
      sCompute::  sn register: #vmCompute.           (* the raw->List copy        *)
      sPublish::  sn register: #publish.             (* the put onto the cell     *)
      ^ self )

    public start = (
      (* Both reactions are self-sends: a reified block must not name a class. *)
      tick whenever: '' do: [ :t | self sampleOnce ].
      ctl  whenever: '' do: [ :c | self reconfigure: c ].
      self arm.
      ^ self )

    (* Hold the token and cancel before re-arming — a live repeater that outlives
       its owner is what killed the ESP32 TimerNode (rung 2). *)
    arm = ( timer:: timers every: (1000 // rate) post: #tick on: tick. ^ self )
    disarm = ( timer == nil ifFalse: [ timers cancel: timer. timer:: nil ]. ^ self )

    (* A failed fetch answers nil: skip the put and KEEP the last good frame.
       Never publish a partial or absent frame onto the cell.

       The raw indexable from `sensorFrame` CANNOT travel on a channel: put:value:
       runs the value algebra (checkValue: -> rankOf:), `platform valueRank:`
       answers -1 for a raw indexable, and the fallback `valueRank` send DNUs
       because the prim receiver carries no vtable. So copy it into a List (rank 8,
       which opts into the algebra via its own valueRank) at the publish boundary
       — exactly what the predecessor HttpServerNode.nsl did. basicAt: reads the
       raw prim result here; everything downstream of the cell reads a List with
       at:. *)
    sampleOnce = (
      | f oc i |
      spans begin: sJob.
      spans begin: sAcquire.
      f:: seam sensorFrame.
      spans end: sAcquire.
      (f == nil) ifTrue: [
        (* A failed fetch produces NO span sample, so it has to be counted or it
           silently IMPROVES the percentiles — the run looks faster because the
           slow cases stopped being measured. The outer sJob span is abandoned
           deliberately rather than closed with a bogus duration; span.c self-heals
           on the next begin (the exception-unwind case). *)
        spans noteFailure: sJob.
        ^ self ].
      spans begin: sCompute.
      oc:: seam OrderedCollection new.
      i:: 1. [ i <= 64 ] whileTrue: [
        oc add: (f basicAt: i). i:: i + 1 ].
      spans end: sCompute.
      spans begin: sPublish.
      sample put: '' value: (seam List fromCollection: oc).
      spans end: sPublish.
      spans end: sJob.
      ^ self )

    (* Untrusted-input boundary: a bad rate leaves the current cadence standing. *)
    reconfigure: c = (
      | r on |
      on:: c at: #on ifAbsent: [ true ].
      r::  c at: #rate ifAbsent: [ rate ].
      on = false ifTrue: [ ^ self disarm ].
      ((r isNil not) and: [ r > 0 ]) ifTrue: [
        rate:: r. self disarm. self arm ].
      ^ self )
  ) : (
    public onSpace: sp seam: s timers: t spans: sn = (
      ^ self new onSpace: sp seam: s timers: t spans: sn )
  )

  (* ---- generic transport: a path->block route table over the chunked prims ----
     Knows nothing about sensors or presentation. C owns the socket and chunk
     framing; routing is nsl. `id` is an opaque correlation token that the C side
     resolves back to the response socket — nsl never touches a file descriptor. *)
  class HttpServer = ( | space seam paths blocks | ) (
    onSpace: sp seam: s = (
      space:: sp. seam:: s.
      paths::  s OrderedCollection new.
      blocks:: s OrderedCollection new.
      ^ self )

    public route: p do: aBlock = ( paths add: p. blocks add: aBlock. ^ self )

    public listen: port = (
      | req |
      req:: space channel: 'dev/http/request'.
      req whenever: '' do: [ :r | self handle: r ].
      seam httpListen: port.
      ^ self )

    (* Run-to-completion: one request is framed begin->body->end before the next,
       so responses for different ids never interleave. *)
    handle: r = (
      | id path i n found |
      id:: r basicAt: 1.  path:: r basicAt: 3.
      i:: 1. n:: paths size. found:: nil.
      [ (i <= n) and: [ found == nil ] ] whileTrue: [
        ((paths at: i) = path) ifTrue: [ found:: blocks at: i ].
        i:: i + 1 ].
      (found == nil)
        ifTrue: [
          seam httpBeginId: id status: 404.
          seam httpChunkId: id data: 'not found'.
          seam httpEndId: id ]
        ifFalse: [
          seam httpBeginId: id status: 200.
          found value: id value: seam.
          seam httpEndId: id ].
      ^ self )
  ) : (
    public onSpace: sp seam: s = ( ^ self new onSpace: sp seam: s )
  )

  (* ---- composition root: install the services, wire the routes, run the loop ----
     The /thermal route block sends to the CAPTURED `tview` instance; the class name
     is resolved here in method-body context, never inside the block (a reified block
     that names a class aborts on outer-scope resolution). /stats and / name classes
     and read platform metrics, so they route through self-send helpers. *)
  public main: platform args: args = (
    | space timers thermal tview http spans sRender |
    space::   platform space.
    timers::  platform Timers usingSpace: space seam: platform.
    (* tuvm#61: one span table for the whole node, created here and handed down as
       a capability. Slots 0 and 1 are already taken by the two spans http_core.c
       stamps itself, so the first name registered below lands at 2 — see
       kernel.nsl's Spans>>ensureTables for why that is seeded rather than
       computed from the slot ceiling. *)
    spans::   platform Spans new.
    (* REQUIRED — the seam posts every timer fire on the reserved 'sys/timer' path
       carrying only a token; Timers>>dispatch: fans it out onto the target
       channel, and that wiring lives in the CALLER by design (kernel.nsl Timers
       header). Omit it and fires reach 'sys/timer' and stop: the sample cell stays
       nil forever and /thermal renders 'no frame' with no error anywhere. *)
    space whenever: 'sys/timer' do: [ :e | timers dispatch: e ].
    thermal:: ThermalNode onSpace: space seam: platform timers: timers spans: spans.
    thermal start.
    tview::   ThermalView new.
    http::    HttpServer onSpace: space seam: platform.
    (* The render is main:'s to name, not the view's: ThermalView is a pure
       formatter and holds no capabilities. Registered AFTER the node, so the
       thermal job's four segments read together in the table. *)
    sRender:: spans register: #render.

    (* The block captures `spans` and `sRender` from this method's temporaries,
       which is fine — the rule a reified block breaks is naming a CLASS, resolved
       in outer scope. *)
    http route: '/thermal' do: [ :id :plat |
        spans begin: sRender.
        tview renderFrame: ((space channel: 'dev/thermal0/sample') peek) toId: id on: plat.
        spans end: sRender ].
    http route: '/hello' do: [ :id :plat | plat httpChunkId: id data: 'hello' ].
    http route: '/stats' do: [ :id :plat | self showStatsTo: id on: plat spans: spans ].
    http route: '/'      do: [ :id :plat | self showIndexTo: id on: plat ].

    http listen: 18080.
    [ true ] whileTrue: [ platform pumpEvents. space drain ].
  )

  showIndexTo: id on: platform = ( ^ self indexToId: id on: platform )
  showStatsTo: id on: platform spans: spans = (
    ^ self statsPageOn: platform toId: id spans: spans )

  indexToId: id on: platform = (
    platform httpChunkId: id data:
      '<html><head><title>tuvm http node</title></head>',
      '<body style=''font-family:system-ui,sans-serif;max-width:34rem;margin:3rem auto;padding:0 1rem;line-height:1.5''>',
      '<h1>tuvm &mdash; channel-native http node</h1>',
      '<p>Request/reply served over the VM channel space. C owns the socket + HTTP framing; routing, the reduce, and the render are authored in nsl.</p>',
      '<ul>',
      '<li><a href=''/thermal''>/thermal</a> &mdash; 8&times;8 thermal heat-grid (SVG, rendered on the VM)</li>',
      '<li><a href=''/stats''>/stats</a> &mdash; live VM heap / GC / channel metrics</li>',
      '<li><a href=''/hello''>/hello</a> &mdash; plain text</li>',
      '</ul></body></html>'.
    ^ self
  )

  statsPageOn: platform toId: id spans: spans = (
    | m |
    m:: platform metrics.
    (* The latency table carries eleven columns and wants room; the prose does not.
       So the PAGE is wide and the running text is constrained per-element instead
       — a 34rem body made the histogram column wrap to two lines on a large
       monitor while three quarters of the screen sat empty. *)
    platform httpChunkId: id data:
      '<html><head><title>tuvm vm stats</title></head>',
      '<body style=''font-family:system-ui,sans-serif;max-width:78rem;margin:3rem auto;padding:0 1rem;line-height:1.5''>',
      '<h1>tuvm &mdash; vm stats</h1>',
      '<p style=''max-width:44rem''>A live snapshot from <code>platform metrics</code> (the #Metrics Record), read on request &mdash; no periodic publisher (G9).</p>',
      '<table style=''border-collapse:collapse;width:100%;max-width:44rem''>',
      '<thead><tr><th style=''text-align:left;border-bottom:2px solid #ccc;padding:.4rem''>metric</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>value</th></tr></thead><tbody>'.
    self statRow: 'heap size (bytes)'        value: (m at: #heapSize         ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'live bytes'               value: (m at: #liveBytes        ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'heap high-water'          value: (m at: #heapHighWater    ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'largest free block'       value: (m at: #largestFreeBlock ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'gc cycles'                value: (m at: #gcCycles         ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'handles live'             value: (m at: #handlesLive      ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'handles high-water'       value: (m at: #handlesHighWater ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'channel queue high-water' value: (m at: #queueHighWater   ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'channel overruns'         value: (m at: #overruns         ifAbsent: [ -1 ]) toId: id on: platform.
    (* tuvm#34: the ISR pulse seam's own counters. This node is the reason they
       exist — it is the first to run a periodic timer AND an HTTP listener, so a
       blocking render starves the pump and ticks pile up in the mailbox (tuvm#54).
       That used to be k_oops; it is now a counted shed, and an uncounted shed would
       hide the very condition that used to announce itself as a crash.
       pulse drops rising = the reactor is behind. pulse coalesced rising = the
       repeating timer folding into one pending wakeup, which is the fix working. *)
    self statRow: 'pulse drops (ISR mailbox)' value: (m at: #pulseDrops       ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'pulse coalesced'          value: (m at: #pulseCoalesced   ifAbsent: [ -1 ]) toId: id on: platform.
    platform httpChunkId: id data: '</tbody></table>'.
    self latencyTableOn: platform toId: id spans: spans.
    platform httpChunkId: id data: '<p><a href=''/''>&larr; home</a></p></body></html>'.
    ^ self
  )

  (* tuvm#61: the job-latency table. Every slot renders, C-owned ones included —
     httpQueue and egress sit at 0 and 1 and are named in kernel.nsl's seed, so
     nothing here has to know which spans C stamps and which nsl brackets.
     The raw histogram ships beside the summary on purpose: it lets whoever is at
     the bench see the SHAPE that produced the decades, which is the whole reason
     the node publishes buckets instead of a single computed number. *)
  latencyTableOn: platform toId: id spans: spans = (
    | i |
    platform httpChunkId: id data:
      '<h2>job latency</h2>',
      '<p style=''max-width:44rem''>Percentiles are the bucket DECADE a sample falls in, never a number ',
      'interpolated inside one &mdash; a log-scaled bucket''s mass is not uniform, ',
      'so an interpolated figure would carry precision the data does not contain. ',
      'max is exact. No p95 is reported below n&nbsp;&ge;&nbsp;200.</p>',
      '<table style=''border-collapse:collapse;width:100%''>',
      '<thead><tr><th style=''text-align:left;border-bottom:2px solid #ccc;padding:.4rem''>span</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>n</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>fails</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>p50</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>p95</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>min &micro;s</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>max &micro;s</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>sumLo</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>sumHi</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem;white-space:nowrap''>histogram</th></tr></thead><tbody>'.
    i:: 0. [ i < spans slotCount ] whileTrue: [
      self latencyRow: i toId: id on: platform spans: spans.
      i:: i + 1 ].
    platform httpChunkId: id data: '</tbody></table>'.
    ^ self
  )

  (* The reducer answers #insufficient when §4.2's gate is unmet. Say WHY in the
     cell rather than printing the symbol: a reader who sees `n<200` knows the
     figure is withheld and what would restore it, where `#insufficient` reads like
     an error. The symbol stays the API — only the rendering changes. *)
  decadeCell: aDecade = (
    aDecade = #insufficient ifTrue: [ ^ 'n&lt;200' ].
    ^ aDecade printString )

  latencyRow: slot toId: id on: platform spans: spans = (
    | s b j |
    s:: spans statsAt: slot.
    (* b0..b5 are stats fields 6..11 — the decade edges are <100us, <1ms, <10ms,
       <100ms, <1s, >=1s (src/span.c's bucket_of). *)
    b:: ''. j:: 6. [ j <= 11 ] whileTrue: [
      b:: b , (s basicAt: j) printString , ' '. j:: j + 1 ].
    platform httpChunkId: id data:
      '<tr><td style=''padding:.35rem;border-bottom:1px solid #eee''>' ,
      (spans nameAt: slot) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (s basicAt: 1) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (spans failuresAt: slot) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;white-space:nowrap''>' ,
      (self decadeCell: (spans p50At: slot)) ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;white-space:nowrap''>' ,
      (self decadeCell: (spans p95At: slot)) ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (s basicAt: 2) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (s basicAt: 3) printString ,
      (* The SUM ships raw, as the two halves the C side keeps it in. The node does
         not compute a mean: reassembling hi*1000000000 + lo here would overflow a
         31-bit SMI the moment hi reaches 2, which is the very reason span.c splits
         it. Accumulate on the device, divide off it. *)
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (s basicAt: 4) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      (s basicAt: 5) printString ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      b , '</td></tr>'.
    ^ self
  )

  statRow: label value: v toId: id on: platform = (
    platform httpChunkId: id data:
      '<tr><td style=''padding:.35rem;border-bottom:1px solid #eee''>' , label ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap''>' ,
      v printString , '</td></tr>'.
    ^ self
  )
) : (
)
