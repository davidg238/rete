/*
 * tuvm/zephyr — Task 8 (nRF52840-DK acceptance bar). Expose the DK's on-board
 * BUTTON1 (button0 = P0.11, GPIO_PULL_UP | GPIO_ACTIVE_LOW, already defined in
 * the board DTS) as the physical edge source for the pulse seam. The Zephyr
 * GPIO callback in ../src/main.c binds to DT_ALIAS(pulsegpio) and, on each
 * press, calls gpio_target_fire(13) — the SAME logical pin the baked node
 * (PulseNodeDK.ns) registered via `gpio pin: 13 ...`. This overlay is applied
 * automatically for the nrf52840dk/nrf52840 board target; it is absent for the
 * native_sim gate (Task 7), so the alias — and the ISR guarded on it — compile
 * out there, leaving the Task-7 build byte-for-byte unchanged.
 *
 * NOTE (board reality, 2026-07-08): the plan's draft targeted the nrf52840
 * *dongle* (button on P1.06); the hardware on the bench is the *DK*, whose
 * BUTTON1 is P0.11. This overlay reflects the DK.
 */
/ {
	aliases {
		pulsegpio = &button0;
	};
};
