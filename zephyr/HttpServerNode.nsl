(*
HttpServerNode.nsl — the live posix twin of HttpNode.nsl. Instead of a single
injected request, it binds a real TCP listener (platform httpListen: 8080 ->
http_listen, which starts the accept thread) and then runs the standard reactor
loop forever: each pumpEvents drains the http request ring at the safe point
(http_pump) and posts [id,method,path] Arrays; the app reaction routes+renders;
the egress reaction forwards the reply Record to httpRespondId:, which writes the
framed response back to the request's socket fd and closes it. Driven by
tests/http_roundtrip_host.sh (curl round-trip). Routes match HttpNode.nsl.
*)
class HttpServerNode packageUsing: manifest = () (
  public main: platform args: args = (
    | space req thermal frame oc i |
    space::   platform space.
    req::     space channel: 'dev/http/request'.
    thermal:: space channel: 'dev/thermal0/sample'.
    oc:: platform OrderedCollection new.
    i:: 1. [ i <= 64 ] whileTrue: [
      oc add: (i = 30 ifTrue: [ 3120 ] ifFalse: [ 2200 ]). i:: i + 1 ].
    frame:: platform List fromCollection: oc.
    thermal put: '' value: frame.
    req whenever: '' do: [ :r |
      | id path status render |
      id::   r basicAt: 1.
      path:: r basicAt: 3.
      (path = '/')        ifTrue: [ status:: 200. render:: [ self indexToId: id on: platform ] ]
      ifFalse: [ (path = '/hello')   ifTrue: [ status:: 200. render:: [ platform httpChunkId: id data: 'hello' ] ]
      ifFalse: [ (path = '/thermal') ifTrue: [ status:: 200. render:: [ self renderFrame: (thermal peek: '' ifAbsent: [ nil ]) toId: id on: platform ] ]
      ifFalse: [ (path = '/stats')   ifTrue: [ status:: 200. render:: [ self statsPageOn: platform toId: id ] ]
      ifFalse: [ status:: 404. render:: [ platform httpChunkId: id data: 'not found' ] ] ] ] ].
      platform httpBeginId: id status: status.
      render value.
      platform httpEndId: id ].
    platform httpListen: 18080.
    [ true ] whileTrue: [ platform pumpEvents. space drain ].
  )

  indexToId: id on: platform = (
    platform httpChunkId: id data:
      '<html><head><title>tuvm http node</title></head>',
      '<body style=''font-family:system-ui,sans-serif;max-width:34rem;margin:3rem auto;padding:0 1rem;line-height:1.5''>',
      '<h1>tuvm &mdash; channel-native http node</h1>',
      '<p>Request/reply served over the VM channel space. C owns the socket + HTTP framing; routing, the reduce, and the render are authored in nsl.</p>',
      '<ul>',
      '<li><a href=''/thermal''>/thermal</a> &mdash; 8&times;8 thermal heat-grid (SVG, rendered on the VM)</li>',
      '<li><a href=''/stats''>/stats</a> &mdash; live VM heap / GC / channel metrics</li>',
      '<li><a href=''/hello''>/hello</a> &mdash; plain text</li>',
      '</ul></body></html>'.
    ^ self
  )

  statsPageOn: platform toId: id = (
    | m |
    m:: platform metrics.
    platform httpChunkId: id data:
      '<html><head><title>tuvm vm stats</title></head>',
      '<body style=''font-family:system-ui,sans-serif;max-width:34rem;margin:3rem auto;padding:0 1rem;line-height:1.5''>',
      '<h1>tuvm &mdash; vm stats</h1>',
      '<p>A live snapshot from <code>platform metrics</code> (the #Metrics Record), read on request &mdash; no periodic publisher (G9).</p>',
      '<table style=''border-collapse:collapse;width:100%''>',
      '<thead><tr><th style=''text-align:left;border-bottom:2px solid #ccc;padding:.4rem''>metric</th>',
      '<th style=''text-align:right;border-bottom:2px solid #ccc;padding:.4rem''>value</th></tr></thead><tbody>'.
    self statRow: 'heap size (bytes)'        value: (m at: #heapSize         ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'live bytes'               value: (m at: #liveBytes        ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'heap high-water'          value: (m at: #heapHighWater    ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'largest free block'       value: (m at: #largestFreeBlock ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'gc cycles'                value: (m at: #gcCycles         ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'handles live'             value: (m at: #handlesLive      ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'handles high-water'       value: (m at: #handlesHighWater ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'channel queue high-water' value: (m at: #queueHighWater   ifAbsent: [ -1 ]) toId: id on: platform.
    self statRow: 'channel overruns'         value: (m at: #overruns         ifAbsent: [ -1 ]) toId: id on: platform.
    platform httpChunkId: id data: '</tbody></table><p><a href=''/''>&larr; home</a></p></body></html>'.
    ^ self
  )

  statRow: label value: v toId: id on: platform = (
    platform httpChunkId: id data:
      '<tr><td style=''padding:.35rem;border-bottom:1px solid #eee''>' , label ,
      '</td><td style=''padding:.35rem;border-bottom:1px solid #eee;text-align:right;font-variant-numeric:tabular-nums''>' ,
      v printString , '</td></tr>'.
    ^ self
  )

  renderFrame: f toId: id on: platform = (
    | row col line t k |
    (f == nil) ifTrue: [ platform httpChunkId: id data: '<html><body>no frame</body></html>'. ^ self ].
    platform httpChunkId: id data: '<html><body><svg viewBox=''0 0 8 8'' width=''320'' height=''320'' shape-rendering=''crispEdges''>'.
    row:: 0. [ row <= 7 ] whileTrue: [
      line:: ''.
      col:: 0. [ col <= 7 ] whileTrue: [
        t:: f at: (row * 8 + col + 1).
        k:: ((t - 1500) * 255) // 2000.
        (k < 0)   ifTrue: [ k:: 0 ].
        (k > 255) ifTrue: [ k:: 255 ].
        line:: line , '<rect x=''' , col printString , ''' y=''' , row printString ,
              ''' width=''1'' height=''1'' fill=''rgb(' , k printString , ',0,' ,
              (255 - k) printString , ')''/>'.
        col:: col + 1 ].
      platform httpChunkId: id data: line.
      row:: row + 1 ].
    platform httpChunkId: id data: '</svg><p>'.
    platform httpChunkId: id data: (self caption: f).
    platform httpChunkId: id data: '</p></body></html>'.
    ^ self
  )

  caption: f = (
    | row col t maxV minV hotR hotC |
    maxV:: f at: 1. minV:: f at: 1. hotR:: 0. hotC:: 0.
    row:: 0. [ row <= 7 ] whileTrue: [
      col:: 0. [ col <= 7 ] whileTrue: [
        t:: f at: (row * 8 + col + 1).
        (t > maxV) ifTrue: [ maxV:: t. hotR:: row. hotC:: col ].
        (t < minV) ifTrue: [ minV:: t ].
        col:: col + 1 ]. row:: row + 1 ].
    ^ 'max ' , (self centi: maxV) , 'C min ' , (self centi: minV) ,
      'C hot (' , hotR printString , ',' , hotC printString , ')'
  )

  centi: v = (
    | whole tenth |
    whole:: v // 100.
    tenth:: (v - (whole * 100)) // 10.
    ^ whole printString , '.' , tenth printString
  )
) : (
)
