(* tuvm#88 gate node. Gate 1: a full screen of text paints. Gate 2: BUTTON_A
   bumps a counter and refreshes ONLY its row — the gate that actually proves
   partial refresh, since a full refresh would repaint everything and look
   identical. Gate 3: a deliberately out-of-grid write raises with its tag
   rather than doing nothing.

   Buttons are the proven seam from tuvm#82/#84: register the press pin, read
   held state with `gpio level:` if needed. *)
class MagTagDisplayNode packageUsing: manifest = () (
  public main: platform args: args = (
    | space display gpio press count |
    space:: platform space.
    display:: platform display.
    gpio:: platform gpio.
    count:: 0.

    display clear.
    (* 12 COLUMNS MAX — the grid is portrait 12x18 at CFB's font1016 (10x16 px
       on a 128x296 panel). Anything longer raises #displayBounds, which is a
       real gate, not a formatting nicety. *)
    display at: 0 col: 0 put: 'TUVM e-paper'.
    display at: 2 col: 0 put: 'tuvm#88'.
    display at: 4 col: 0 put: 'presses: 0'.
    display refresh.
    'gate1 painted' out.

    [ display at: 99 col: 0 put: 'X' ]
      on: [ :e | e tag = #displayBounds ]
      do: [ :e | 'gate3 caught displayBounds' out ].

    (* `whenever:do:` is the ONLY subscription selector in this dialect
       (Channel>>whenever:do:, kernel.nsl:1608) — Space has no `on:do:`, and
       because nsl dispatches dynamically the wrong selector compiles clean and
       kills the node at run time. The first bench run died exactly here: gate 1
       and gate 3 printed, `ready` never did. *)
    press:: space channel: 'btn/press'.
    press whenever: '' do: [ :m |
      count:: count + 1.
      display at: 4 col: 0 put: 'presses: ' , count printString.
      display refreshRow: 4.
      ('gate2 row 4 -> ' , count printString) out ].
    gpio pin: 15 edge: #falling post: 'A' on: press.

    'ready' out.
    (* `platform pumpEvents` only pumps the backends INTO the space queue
       (platform.c:947 — http_poll / pulse_pump / timer poll); `space drain` is
       what dequeues and fires reactions (kernel.nsl:1651). A reactor loop
       without the drain enqueues button presses forever and runs none of them.
       Same pairing as MagTagChordNode.nsl:68, the proven button node. *)
    [ true ] whileTrue: [ platform pumpEvents. space drain ].
  )
) : (
)
