(*
expect:
1
1
2
1
3
42
2
42
5
43
9
43
2
skip-berry: true
*)
class BlockInliningTest packageUsing: manifest = () (
public class BlockInlining usingPlatform: platform = () (
	public testNoInlining = (
		| a block |
		a:: 1.
		block:: [ a ].
		^ block value
	)

	public testOneLevelInlining = (
		| a |
		a:: 1.
		^ true ifTrue: [ a ] ifFalse: [ 42 ]
	)

	private oneLevelInliningWithLocalShadow: bool = (
		| a |
		a:: 1.
		^ bool
			ifTrue: [ | a |
				a:: 2.
				a
			] ifFalse: [ a (* that is outer a *) ]
	)

	public testOneLevelInliningWithLocalShadowTrue = (
		^ oneLevelInliningWithLocalShadow: true
	)

	public testOneLevelInliningWithLocalShadowFalse = (
		^ oneLevelInliningWithLocalShadow: false
	)

	private deepNestedInlinedIf: bool = (
		| block  a block2 |
		a:: 1.
		block:: [ (* not inlined *)
			a:: a + 1.
			block2:: [ (* not inlined *)
				bool ifTrue: [ ^ a:: a + 1.]
						 ifFalse:[ |a| a:: 42. a ]
			].
			block2 value
		].
		^ block value
	)

	public testDeepNestedInlinedIfTrue  = ( ^ deepNestedInlinedIf: true  )
	public testDeepNestedInlinedIfFalse = ( ^ deepNestedInlinedIf: false )

	private blockNestedInIf: bool = (
		| a |
		a:: 1.
		bool ifTrue: [
			| block |
			block:: [ a:: a + 1 ].
			block value
		] ifFalse: [
			a:: 42.
		].
		^ a
	)

	public testBlockNestedInIfTrue  = ( ^ blockNestedInIf: true  )
	public testBlockNestedInIfFalse = ( ^ blockNestedInIf: false )

	private deepNestedBlocksInInlinedIf: bool = (
		| block a block2 block3 |
		a:: 1.
		block:: [ (* not inlined *)
			a:: a + 1.
			block2:: [ (* not inlined *)
				bool ifTrue: [ a:: a + 1. (* inlined *)
					block3:: [ |block4|
						a:: a + 1.
						block4:: [ (* not inlined *)
							a:: a + 1.
							a
						].
						block4 value
					].
					block3 value
				] ifFalse:[ |a block4| (* inlined *)
					a:: 42.
					block4:: [ ^ a:: a + 1 ]. (* not inlined *)
					block4 value
				]
			].
			block2 value
		].
		^ block value
	)

	public testDeepNestedBlocksInInlinedIfTrue  = ( ^ deepNestedBlocksInInlinedIf: true  )
	public testDeepNestedBlocksInInlinedIfFalse = ( ^ deepNestedBlocksInInlinedIf: false )

	private deepDeepNested: bool = (
		| block a block2 block3 |
		a:: 1.
		block:: [ (* not inlined *)
			a:: a + 1.
			block2:: [ (* not inlined *)
				bool ifTrue: [ a:: a + 1. (* inlined *)
					block3:: [ |block4|
						a:: a + 1.
						block4:: [ (* not inlined *)
							a:: a + 1.
							block:: [ (* not inlined *)
								a:: a + 1.
								block2:: [ (* not inlined *)
									bool ifTrue: [ a:: a + 1. (* inlined *)
										block3:: [ |block4|
											a:: a + 1.
											block4:: [ (* not inlined *)
												a:: a + 1.
												a
											].
											block4 value
										].
										block3 value
									] ifFalse:[ |a block4| a:: 42. (* inlined *)
										block4:: [^ a:: a + 1]. (* not inlined *)
										block4 value
									]
								].
								block2 value
							].
							block value
						].
						block4 value
					].
					block3 value
				] ifFalse:[ |a block4| a:: 42. (* inlined *)
					block4:: [^ a:: a + 1]. (* not inlined *)
					block4 value
				]
			].
			block2 value
		].
		^ block value
	)

	public testDeepDeepNestedTrue  = ( ^ deepDeepNested: true )
	public testDeepDeepNestedFalse = ( ^ deepDeepNested: false )

	public testToDoNestDoNestIfTrue = (
		| balls bounces |
		balls:: { true }.
		bounces:: 0.

		1 to: 2 do: [ :i |
				balls do: [ :ball |
						ball ifTrue: [ bounces:: bounces + 1 ] ] ].

		^ bounces
	)
)
public main: platform args: args = (
	| bi = BlockInlining usingPlatform: platform. |
	bi testNoInlining printString out.
	bi testOneLevelInlining printString out.
	bi testOneLevelInliningWithLocalShadowTrue printString out.
	bi testOneLevelInliningWithLocalShadowFalse printString out.
	bi testDeepNestedInlinedIfTrue printString out.
	bi testDeepNestedInlinedIfFalse printString out.
	bi testBlockNestedInIfTrue printString out.
	bi testBlockNestedInIfFalse printString out.
	bi testDeepNestedBlocksInInlinedIfTrue printString out.
	bi testDeepNestedBlocksInInlinedIfFalse printString out.
	bi testDeepDeepNestedTrue printString out.
	bi testDeepDeepNestedFalse printString out.
	bi testToDoNestDoNestIfTrue printString out.
)
) : (
)
