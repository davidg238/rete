/* builtins.def — single source of truth for firmware-owned objects an image
 * may reference. Order is FROZEN; append only. Bump BUILTIN_REGISTRY_VERSION
 * (defined in oimg_loader.c) whenever this list changes.
 *
 * BUILTIN(idx, kind, name)
 *   kind: SINGLETON | VTABLE | SYMBOL
 *
 * Task 9a (Milestone A): the reserved fiber vtable rows (legacy FiberVtable,
 * Runnable/Suspended/DeadFiberVtable) and the NLR-only symbol rows
 * (executeCleanup, resumeWith:, unwindTo:value:) were removed and the list
 * compacted dense. Registry version bumped 4->5.
 */
BUILTIN(0,  SINGLETON, "nil")
BUILTIN(1,  SINGLETON, "true")
BUILTIN(2,  SINGLETON, "false")
BUILTIN(3,  VTABLE,    "IntegerVtable")
BUILTIN(4,  VTABLE,    "FloatVtable")
BUILTIN(5,  VTABLE,    "MethodContextVtable")
BUILTIN(6,  VTABLE,    "SymbolVtable")
BUILTIN(7,  VTABLE,    "VtableVtable")
BUILTIN(8,  VTABLE,    "PrimitiveClosureVtable")
BUILTIN(9,  VTABLE,    "BytecodeClosureVtable")
BUILTIN(10, VTABLE,    "BoxedBindingVtable")
/* Kernel-owned symbols (index 11+). These are exactly the selectors the
 * firmware kernel itself references regardless of the loaded app:
 *  - 11: ==             (Symbol comparison)
 *  - 12: sender         (OP_LD_SENDER)
 *  - 13: value          (Symbol_value, hardcoded in vm.c)
 *  - 14: accessViolation: (Symbol_accessViolation, dispatch.c)
 *  - 15: debug:         (Symbol_debug_, vm.c debugger hook) */
BUILTIN(11, SYMBOL,    "==")
BUILTIN(12, SYMBOL,    "sender")
BUILTIN(13, SYMBOL,    "value")
BUILTIN(14, SYMBOL,    "accessViolation:")
BUILTIN(15, SYMBOL,    "debug:")
/* Boxed LargeInteger vtable (index 16+). Appended after the kernel symbols;
 * referenced by overflowing integer literals an app may carry. */
BUILTIN(16, VTABLE,    "LargeIntegerVtable")
BUILTIN(17, VTABLE,    "StringVtable")
