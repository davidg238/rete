(*
expect:
true
skip-berry: true
*)
class SieveBenchmarkTest packageUsing: manifest = () (
class Benchmark = () (
    public assert: expected equals: value = (
      expected = value ifFalse: [
        self error: 'Expected value differs'
      ].
      ^ true
    )
)
class Sieve usingPlatform: platform = () (
  public class Sieve = Benchmark ()(
    public benchmark = (
      | flags |
      flags:: Array new: 5000.
      ^ self sieve: flags size: 5000.
    )

    public verifyResult: result = (
      ^ self assert: 669 equals: result
    )

    sieve: flags size: size = (
      | primeCount |
      primeCount:: 0.
      1 to: size do: [ :idx | flags at: idx put: true ].
      2 to: size do: [ :i |
        (flags at: i)
          ifTrue: [
            | k |
            primeCount:: primeCount + 1.
            k:: i + i.
            [ k <= size ]
              whileTrue: [
                flags at: k put: false. k:: k + i ]. ] ].
      ^ primeCount
    )
  )
  public newInstance = ( ^ Sieve new )
)
public main: platform args: args = (
    | s = Sieve usingPlatform: platform. sieve |
    sieve:: s newInstance.
    (sieve verifyResult: sieve benchmark) printString out.
)
) : (
)
