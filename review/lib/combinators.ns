(*
L1 — the complete combinator set (staging module).

With NLR gone, these ARE the early-exit story; this file completes the set already in
kernel.ns (do:, inject:into:, collect:, select:, reject:, detect:ifNone:, includes:).
Written in final form against the kernel.ns Collection protocol (everything bottoms out
in `do:` / `at:` / `size`). No new VM primitives required — landable the moment
Milestone A is green.

DESTINATIONS:
  CombinatorsStaging >> #anySatisfy: … #detectMin:   → kernel.ns class Collection
  CombinatorsStaging >> #seqCopyFrom:to: … #reversed → kernel.ns class OrderedCollection
                                                        (and Array where marked)
  class Interval                                     → kernel.ns sibling class, plus
                                                        `Integer>>to:` / `to:by:` sugar
                                                        returning one (compiler already
                                                        inlines to:do: — Interval covers
                                                        the first-class-collection uses)

Style rules honored (see lib/README.md): no `^` inside any block passed to a method;
found-flag pattern for early exit; errors per errors.md.
*)
class CombinatorsStaging usingPlatform: platform = () (

  (* ================= DESTINATION: Collection ================= *)
  class CollectionAdditions = () (

    (* True if any element satisfies aBlock. Found-flag: iteration is not cut short,
       but aBlock is not re-sent after the first hit — cheap and NLR-free. If profiles
       ever show hot any/all over big collections, the fix is an indexed from:to:do:
       walk in the concrete subclasses, not NLR. *)
    public anySatisfy: aBlock = (
      | found |
      found:: false.
      self do: [ :e | found ifFalse: [ found:: aBlock value: e ] ].
      ^ found
    )

    public allSatisfy: aBlock = (
      | ok |
      ok:: true.
      self do: [ :e | ok ifTrue: [ ok:: aBlock value: e ] ].
      ^ ok
    )

    public noneSatisfy: aBlock = ( ^ (self anySatisfy: aBlock) not )

    public count: aBlock = (
      ^ self inject: 0 into: [ :n :e | (aBlock value: e) ifTrue: [ n + 1 ] ifFalse: [ n ] ]
    )

    public do: aBlock separatedBy: sepBlock = (
      | first |
      first:: true.
      self do: [ :e |
        first ifTrue: [ first:: false ] ifFalse: [ sepBlock value ].
        aBlock value: e ].
      ^ self
    )

    (* Element with the maximal aBlock value; ifNone: on empty. *)
    public detectMax: aBlock ifNone: noneBlock = (
      | found best bestVal v |
      found:: false.
      self do: [ :e |
        v:: aBlock value: e.
        (found not or: [ v > bestVal ]) ifTrue: [ found:: true. best:: e. bestVal:: v ] ].
      found ifTrue: [ ^ best ].
      ^ noneBlock value
    )

    public detectMin: aBlock ifNone: noneBlock = (
      ^ self detectMax: [ :e | 0 - (aBlock value: e) ] ifNone: noneBlock
    )

    public detectMax: aBlock = ( ^ self detectMax: aBlock ifNone: [ self error: 'not found' ] )
    public detectMin: aBlock = ( ^ self detectMin: aBlock ifNone: [ self error: 'not found' ] )
  ) : ( )

  (* ============ DESTINATION: OrderedCollection + Array (indexed) ============ *)
  class SequenceAdditions = () (

    public withIndexDo: aBlock = (
      | i |
      i:: 0.
      self do: [ :e | i:: i + 1. aBlock value: e value: i ].
      ^ self
    )

    public indexOf: anObject ifAbsent: absentBlock = (
      | idx |
      idx:: 0.
      self withIndexDo: [ :e :i | (idx = 0 and: [ e = anObject ]) ifTrue: [ idx:: i ] ].
      idx = 0 ifTrue: [ ^ absentBlock value ].
      ^ idx
    )

    public indexOf: anObject = ( ^ self indexOf: anObject ifAbsent: [ self error: 'not found' ] )

    (* Pairwise transform; sizes must agree (contract violation crashes, per L5). *)
    public with: other collect: aBlock = (
      | r |
      self size = other size ifFalse: [ self error: 'size mismatch' ].
      r:: OrderedCollection new.
      self withIndexDo: [ :e :i | r add: (aBlock value: e value: (other at: i)) ].
      ^ r
    )

    (* Inclusive 1-based copy; empty result when stop < start (Smalltalk convention).
       Bounds errors crash. *)
    public copyFrom: start to: stop = (
      | r |
      (start < 1 or: [ stop > self size ]) ifTrue: [ self error: 'index out of bounds' ].
      r:: OrderedCollection new.
      start to: stop do: [ :i | r add: (self at: i) ].
      ^ r
    )

    public reversed = (
      | r n |
      r:: OrderedCollection new.
      n:: self size.
      1 to: n do: [ :i | r add: (self at: n - i + 1) ].
      ^ r
    )

    public first: n = ( ^ self copyFrom: 1 to: n )
    public last: n = ( ^ self copyFrom: self size - n + 1 to: self size )

    (* Concatenation: `a , b` — binary selector on sequences. *)
    public , other = (
      | r |
      r:: OrderedCollection new.
      self do: [ :e | r add: e ].
      other do: [ :e | r add: e ].
      ^ r
    )
  ) : ( )

  (* ================= DESTINATION: kernel.ns sibling class ================= *)
  (* First-class integer range: `(1 to: n)` as a Collection, so numeric ranges get
     the whole protocol (select:, anySatisfy:, inject:into:, …). The compiler still
     lowers the `to:do:` LOOP form to bytecode; Interval is for range-as-value uses.
     Inherits Collection; only do:/size/at: are primitive to it. step = 0 crashes. *)
  class Interval = Collection ( | start stop step | ) (
    public do: aBlock = (
      | i |
      step > 0
        ifTrue: [ i:: start. [ i <= stop ] whileTrue: [ aBlock value: i. i:: i + step ] ]
        ifFalse: [ i:: start. [ i >= stop ] whileTrue: [ aBlock value: i. i:: i + step ] ].
      ^ self
    )
    public size = (
      step > 0
        ifTrue: [ stop < start ifTrue: [ ^ 0 ]. ^ (stop - start) // step + 1 ].
      start < stop ifTrue: [ ^ 0 ].
      ^ (start - stop) // (0 - step) + 1
    )
    public at: i = (
      (i < 1 or: [ i > self size ]) ifTrue: [ self error: 'index out of bounds' ].
      ^ start + ((i - 1) * step)
    )
    public first = ( ^ self at: 1 )
    public last = ( ^ self at: self size )
    setStart: a stop: b step: s = (
      s = 0 ifTrue: [ self error: 'zero step' ].
      start:: a. stop:: b. step:: s. ^ self
    )
  ) : (
    public from: a to: b = ( ^ self new setStart: a stop: b step: 1 )
    public from: a to: b by: s = ( ^ self new setStart: a stop: b step: s )
  )

  (* DESTINATION: Integer (kernel.ns Object hierarchy) — sugar:
       public to: b   = ( ^ Interval from: self to: b )        -- when not inlined as a loop
       public to: b by: s = ( ^ Interval from: self to: b by: s )
     NOTE for the compiler: `x to: y` in expression (non-do:) position must compile as a
     real send; only the `to:do:` / `to:by:do:` LOOP forms are lowered. Verify against
     NEWSPEAK_DIALECT.md decision 19 when landing. *)
) : ( )
