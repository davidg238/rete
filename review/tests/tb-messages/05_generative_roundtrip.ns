(*
expect:
200
200
0
*)
(* ============================================================================
   SYNC WARNING (Milestone B landed, 2026-07-06) — DO NOT USE THIS FILE AS THE
   REFERENCE GENERATOR. This staged draft has a REAL bug: `randomBelow: n`
   below calls `self nextRandom` TWICE per evaluation (once for the receiver
   of `//`, once for the argument of the trailing `//n*n` term) — the LCG seed
   mutates between those two sends, so the result is NOT `r \\ n` of a single
   draw. It can escape `[0, n)`, and in `genValue:` an out-of-range `k` falls
   through every `k = ...` guard to the final (recursive Map) branch
   UNCONDITIONALLY — i.e. runaway recursion / stack overflow, not the intended
   depth-bounded generator.
   The LANDED, FIXED version is `nsl-tests/08_messages/14_generative.ns`
   (single draw into a temp before use; LCG constants byte-identical to this
   draft; verified 200/200/0 both paths). Treat that file as the reference
   generator. This staged file is kept only for its original design
   commentary and is intentionally NOT rewritten here — fixing the algorithm
   is a real code change, out of scope for this mechanical sync pass.
   ============================================================================ *)
(* T-B.5 — generative check: a seeded in-image LCG builds 200 random message trees
   (depth ≤ 4, mixed int/string/symbol/list/map); each tree is built TWICE from the
   same sub-seed and must be structurally = with equal hash. Deterministic (fixed
   seed), so failures reproduce. The same generator later feeds CBOR encode→decode
   round-trips (lib/cbor.md) — keep it reusable when landing.
   Prints: trees-built, equal-count, hash-mismatch-count. *)
class GenerativeRoundtrip packageUsing: manifest = () (
  | seed ::= 12345. |

  nextRandom = (   (* LCG: glibc constants, SMI-safe under 64-bit int semantics *)
    seed:: (seed * 1103515245 + 12345) - ((seed * 1103515245 + 12345) // 2147483648 * 2147483648).
    ^ seed
  )
  randomBelow: n = ( ^ (self nextRandom // 65536) - ((self nextRandom // 65536) // n * n) )

  (* depth-bounded random value; kind chosen by the stream *)
  genValue: depth = (
    | k |
    k:: self randomBelow: (depth = 0 ifTrue: [ 3 ] ifFalse: [ 5 ]).
    k = 0 ifTrue: [ ^ self randomBelow: 1000 ].
    k = 1 ifTrue: [ ^ 's' , (self randomBelow: 100) printString ].
    k = 2 ifTrue: [ ^ #sym ].
    k = 3 ifTrue: [ ^ List with: (self genValue: depth - 1) with: (self genValue: depth - 1) ].
    ^ Map fromPairs: (List with: (List with: #k with: (self genValue: depth - 1)))
  )

  public main: platform args: args = (
    | built equal hashBad savedSeed a b |
    built:: 0. equal:: 0. hashBad:: 0.
    1 to: 200 do: [ :i |
      savedSeed:: seed.
      a:: self genValue: 4.
      seed:: savedSeed.                (* rewind: build the identical tree again *)
      b:: self genValue: 4.
      built:: built + 1.
      a = b ifTrue: [ equal:: equal + 1 ].
      a hash = b hash ifFalse: [ hashBad:: hashBad + 1 ] ].
    built printString out.             (* 200 *)
    equal printString out.             (* 200 — every pair structurally equal *)
    hashBad printString out.           (* 0   — hash agrees with = *)
  )
) : (
)
