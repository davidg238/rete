(*
expect:
3
expect-crash: at:put:
*)
(* T-B.2 — mutation selectors DO NOT EXIST on algebra values (immutability by
   construction, not a write-path check): sending one is doesNotUnderstand, whose text
   contains the selector. This file: List at:put:. Landing expands to one variant per
   (type × mutating selector) — Map at:put:, Record at:put:, Bytes u8At:put:,
   List add:, … — generated mechanically from a selector list kept beside the suite. *)
class MutationRejection packageUsing: manifest = () (
  public main: platform args: args = (
    | l |
    l:: List with: 1 with: 2 with: 3.
    l size printString out.          (* 3 — reads fine *)
    l at: 1 put: 99.                 (* must be DNU: no such method exists *)
    'unreached' out.
  )
) : (
)
