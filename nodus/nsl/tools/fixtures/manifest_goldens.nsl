(* rete#243: one instance of every annotated rule in protocol/MANIFEST.cddl,
   encoded by the node's OWN Cbor and printed as `GOLDEN <path> <hex>` lines.

   Consumed by nodus/nsl/tools/test_manifest_gate.py, which zcbor-validates
   each line against the manifest — so the node's encoder answers to the
   declared contract, not merely to porta's twin. The expect block above pins
   the hex, so encoder BYTE drift is a harness FAIL (a golden) while
   shape-vs-manifest drift is the zcbor gate's FAIL: two failures, two names.

   Values are small and deterministic, not representative — size law
   measurements live in 22_spacesync, not here. Bytes values are minted by
   round-tripping through the encoder (`Cbor encode:` answers a Bytes), the
   one way test code can hold a Bytes at all. *)
class ManifestGoldens packageUsing: manifest = () (

  emit: path value: v using: p = (
    ('GOLDEN ' , path , ' ' , (p Cbor encode: v) printHex) println.
  )

  public main: platform args: args = (
    | R M L OC bytes blob blobFull oc |
    R:: platform Record.
    M:: platform Map.
    L:: platform List.
    OC:: platform OrderedCollection.
    bytes:: platform Cbor encode: 'k'.

    blob:: R tag: #BlobRef with: #hash -> bytes.
    blobFull:: R tag: #BlobRef with: #alg -> #sha256 with: #hash -> bytes with: #size -> 4.

    (* --- goal/** --- *)
    self emit: 'goal/name' value: 'bell' using: platform.

    oc:: OC new.
    oc add: #sig -> bytes.
    oc add: #image -> blobFull.
    oc add: #runlevel -> 1.
    oc add: #triggers -> (L with: #boot).
    oc add: #arguments -> (M with: #rate -> 2).
    oc add: #lifecycle -> #running.
    self emit: 'goal/apps/main' value: (R tag: #App fields: (M fromPairs: oc)) using: platform.
    (* minimal App: only the required fields *)
    self emit: 'goal/apps/main' value: (R tag: #App with: #sig -> bytes with: #image -> blob) using: platform.

    oc:: OC new.
    oc add: #mode -> #normal.
    oc add: #maxAwakeS -> 60.
    oc add: #minAwakeS -> 5.
    oc add: #loopSleepS -> 1.
    oc add: #maxAsleepS -> 300.
    self emit: 'goal/mode' value: (R tag: #Mode fields: (M fromPairs: oc)) using: platform.

    self emit: 'goal/config/main/rate' value: 42 using: platform.
    self emit: 'obs/config/main/rate' value: 'fast' using: platform.
    (* rete#375: the whole breakpoint set for the program sha; empty is the detach *)
    self emit: 'goal/debug/main'
         value: (R tag: #Debug with: #sha -> bytes with: #breaks -> (L with: (L with: 1234 with: 0)))
         using: platform.
    self emit: 'goal/debug/main' value: (R tag: #Debug with: #sha -> bytes with: #breaks -> (L fromCollection: OC new)) using: platform.
    (* rete#415: the console's tee target, and the off. *)
    self emit: 'goal/console' value: (R tag: #Console with: #addr -> '::1' with: #port -> 54330) using: platform.
    self emit: 'goal/console' value: (R tag: #Console with: #addr -> '' with: #port -> 0) using: platform.
    self emit: 'goal/profile/main'
         value: (R tag: #Profile with: #action -> #start with: #durationS -> 1000 with: #continuous -> false)
         using: platform.
    self emit: 'goal/liveness' value: (R tag: #Liveness with: #misses -> 8 with: #telCad -> 2000) using: platform.
    self emit: 'goal/do/reboot' value: (R tag: #Reboot fields: (M fromPairs: OC new)) using: platform.
    (* dbg/req is a BARE line by the node's own reader (parseProfileMs:) —
       the DbgReq record was catalogue prose that never rode the wire. *)
    self emit: 'dbg/req' value: 'profile 1000' using: platform.

    (* --- obs/** --- *)
    self emit: 'obs/name' value: 'bell' using: platform.
    self emit: 'obs/apps/main'
         value: (R tag: #AppObs with: #image -> blob with: #lifecycle -> #running)
         using: platform.
    (* rete#375: held at (blob 1234, pc 0), and the continue *)
    self emit: 'obs/debug' value: (R tag: #DebugObs with: #off -> 0 with: #blob -> 1234 with: #held -> true) using: platform.
    self emit: 'obs/debug' value: (R tag: #DebugObs with: #off -> 0 with: #blob -> 0 with: #held -> false) using: platform.

    oc:: OC new.
    oc add: #up -> 1.
    oc add: #bid -> 41.
    oc add: #pto -> 2.
    oc add: #ref -> 3.
    oc add: #rej -> 6.
    oc add: #sdr -> 4.
    oc add: #wak -> 5.
    self emit: 'obs/health' value: (R tag: #Health fields: (M fromPairs: oc)) using: platform.

    (* build WITHOUT the pin (a pre-manifest image) and WITH it (#243 D4) *)
    self emit: 'obs/build' value: (R tag: #Build with: #chip -> #esp32c6 with: #build -> 'host-test') using: platform.
    oc:: OC new.
    oc add: #man -> bytes.
    oc add: #sdk -> 'zephyr-4'.
    oc add: #chip -> #esp32c6.
    oc add: #board -> 'bench-c6'.
    oc add: #build -> 'host-test'.
    oc add: #image -> bytes.
    self emit: 'obs/build' value: (R tag: #Build fields: (M fromPairs: oc)) using: platform.
    (* the board name WITHOUT the pin (#118): chip, board, build — board sits between chip and build *)
    self emit: 'obs/build' value: (R tag: #Build with: #chip -> #esp32c6 with: #board -> 'bench-c6' with: #build -> 'host-test') using: platform.

    self emit: 'obs/liveness' value: (R tag: #Liveness with: #misses -> 8 with: #telCad -> 2000) using: platform.
    oc:: OC new.
    oc add: #mode -> #normal.
    oc add: #maxAwakeS -> 60.
    oc add: #minAwakeS -> 5.
    oc add: #loopSleepS -> 1.
    oc add: #maxAsleepS -> 300.
    self emit: 'obs/mode' value: (R tag: #Mode fields: (M fromPairs: oc)) using: platform.

    (* --- tel/** --- *)
    self emit: 'tel/print' value: (R tag: #Print with: #text -> 'hi') using: platform.
    self emit: 'tel/log' value: (R tag: #Log with: #lvl -> #info with: #txt -> 'tick 1') using: platform.
    self emit: 'tel/m/temp' value: (R tag: #Metric with: #value -> 21 with: #monoMs -> 5) using: platform.

    (* --- sys/** --- *)
    self emit: 'sys/reset'
         value: (R tag: #Reset with: #reason -> #powerOn with: #code -> 3 with: #bootId -> 41)
         using: platform.
    self emit: 'sys/overrun' value: (R tag: #Overrun with: #path -> 'tel/log' with: #dropped -> 2) using: platform.

    oc:: OC new.
    oc add: #core -> nil.
    oc add: #bootId -> 41.
    oc add: #detail -> 'cond=pulse-undrained'.
    oc add: #monoMs -> 9.
    oc add: #reason -> #watchdog.
    self emit: 'sys/panic' value: (R tag: #Panic fields: (M fromPairs: oc)) using: platform.

    oc:: OC new.
    oc add: #lb -> 1.  oc add: #gcc -> 2.  oc add: #hhw -> 3.  oc add: #hnl -> 4.
    oc add: #hsz -> 5. oc add: #lfb -> 6.  oc add: #ovr -> 7.  oc add: #pco -> 8.
    oc add: #pdr -> 9. oc add: #pst -> 10. oc add: #qhw -> 11. oc add: #hnhw -> 12.
    self emit: 'sys/metrics' value: (R tag: #Metrics fields: (M fromPairs: oc)) using: platform.

    oc:: OC new.
    oc add: #ob -> 1. oc add: #alc -> 2. oc add: #fal -> 3. oc add: #fre -> 4. oc add: #ohw -> 5.
    self emit: 'sys/cheap' value: (R tag: #CHeap fields: (M fromPairs: oc)) using: platform.

    oc:: OC new.
    oc add: #n -> 7.   oc add: #b0 -> 1. oc add: #b1 -> 2. oc add: #b2 -> 3.
    oc add: #b3 -> 4.  oc add: #b4 -> 5. oc add: #b5 -> 6. oc add: #span -> #pullSend.
    oc add: #fails -> 0. oc add: #maxUs -> 900. oc add: #minUs -> 100.
    oc add: #sumUsHi -> 0. oc add: #sumUsLo -> 3500.
    self emit: 'sys/latency' value: (R tag: #LatencySpan fields: (M fromPairs: oc)) using: platform.

    (* --- dbg / diag / gw --- *)
    self emit: 'dbg/resp' value: 'ok' using: platform.
    self emit: 'diag/spans/ctl' value: (R tag: #SpanCtl with: #state -> #running) using: platform.
    self emit: 'diag/spans/result' value: (R tag: #SpanCapture with: #n -> 7 with: #ms -> 100) using: platform.
    oc:: OC new.
    oc add: #n -> 7.   oc add: #b0 -> 1. oc add: #b1 -> 2. oc add: #b2 -> 3.
    oc add: #b3 -> 4.  oc add: #b4 -> 5. oc add: #b5 -> 6. oc add: #span -> #pullSend.
    oc add: #fails -> 0. oc add: #maxUs -> 900. oc add: #minUs -> 100.
    oc add: #sumUsHi -> 0. oc add: #sumUsLo -> 3500.
    self emit: 'diag/spans/pullSend' value: (R tag: #LatencySpan fields: (M fromPairs: oc)) using: platform.
    self emit: 'gw/liveness' value: #live using: platform.
    self emit: 'gw/liveness' value: #stalled using: platform.
  )
) : (
)
