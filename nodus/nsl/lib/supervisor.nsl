(*
ns-oevm supervisor (in-image debugger, step 1: the grant). A confined boot
citizen and the ONLY holder of the native mirror capability. Boot mints one
Supervisor, grants it `mirror_object()` via `init_mirror:`, then routes the
app launch through `run:platform:args:debug:` instead of calling the app's
`main:args:` directly. With OEVM_DEBUG off the supervisor is transparent (it just
forwards to the app, so the suite is byte-for-byte unchanged). With it on it
arms one step before launching the app, so the hook fires at once with nothing to
blame: that first pause prints `dbg:ready` and runs the one `dbg:*` command loop
(rete#311: the same loop a breakpoint, a step, or a line arriving on the cable
while the program runs lands in). An un-granted receiver could not even name
`mirror`, and `vtableOf:` on a non-holder would DNU. The ObjectMirror facade and
the loop arrived in step 2 (Plan 2).
*)
class Supervisor usingMirror: mirror = () (
  (* entry: the app instance. plat: the Kernel instance the app sees as its
     `platform`. args: the app's main: args. debugFlag: 1 when OEVM_DEBUG set. *)
  public run: entry platform: plat args: args debug: debugFlag = (
    (* `dbg` is hoisted to the METHOD top (not the ifTrue: block) so the onBreak:
       hook block's home context is this `run:` activation, which stays alive
       through `entry main:`. If it lived in the ifTrue: block, that frame would be
       dead by the time a breakpoint fires inside main:, and the captured `dbg`
       would read a stale slot -> onBreakContext: DNU on a wrong receiver. *)
    | dbg |
    debugFlag = 1 ifTrue: [
      dbg:: Debugger usingMirror: mirror channel: plat.
      dbg registerEntry: entry.
      mirror onBreak: [ :ctx | dbg onBreakContext: ctx ].
      (* The boot wait IS the first pause (rete#311): arm one step, so the next
         bytecode fires the hook with no breakpoint and no step mode -- the pause
         path -- which announces `dbg:ready` the first time and runs the ONE command
         loop. There is no separate boot loop: every verb works at boot. *)
      mirror requestStep: 1 ].
    (* rete#312 Q1: the kernel's one profile handler, in every image. The cable feeds it
       only in a standard image; in a debug image the cable belongs to the loop below,
       which hands it `profile <ms>` lines itself. *)
    plat profiler install: debugFlag = 0.
    ^ entry main: plat args: args )

  (* HLL mirror facade (Plan 2). Each facade takes the native mirror as a
     param, so only Supervisor — the sole mirror holder — can construct one;
     there is no ambient mirror access. *)
  public class ObjectMirror usingMirror: m reflecting: obj = () (
    public vtable    = ( ^ m vtableOf: obj )
    public bindings  = ( ^ m bindingsOf: self vtable )
    public reflectee = ( ^ obj )
  ) : ()

  public class ContextMirror usingMirror: m context: ctx = () (
    public context   = ( ^ ctx )
    public rawSender = ( ^ m senderOf: ctx )
    public sender = (
      | s |
      s:: m senderOf: ctx.
      ^ s == nil ifTrue: [ nil ] ifFalse: [ ContextMirror usingMirror: m context: s ] )
    public pc            = ( ^ m pcOf: ctx )
    public offset        = ( ^ m offsetOf: ctx )
    public registerAt: i = ( ^ m reg: ctx at: i )
    public registerAt: i put: v = ( ^ m reg: ctx at: i put: v )
    public numRegisters = ( ^ m numRegistersOf: ctx )
  ) : ()

  (* The debugger proper (Plan 2). Holds the granted mirror (m) and the Kernel
     instance (io) for stdin/stdout AND collection allocation — never bare-name
     reachable from a top-level class. Names every method by its BLOB OFFSET, the
     image map's key (rete#323): custos turns a line into an offset and a stop back
     into a line, so the node keeps no registry. Runs the interactive command loop. *)
  public class Debugger usingMirror: m channel: io = ( | entry bpBlobs bpOffs stepMode stepDepth curCtx ready | ) (
    public registerEntry: anEntry = ( entry:: anEntry. ^ self )

    (* Parse a non-negative integer from a String of ASCII digits (no asInteger
       in this dialect): n:: n*10 + (byte - 48). Empty string answers 0. *)
    parseInt: s = (
      | n i b |
      n:: 0.
      i:: 1.
      [ i <= s size ] whileTrue: [
        b:: s at: i.
        (b >= 48 and: [ b <= 57 ]) ifTrue: [ n:: (n * 10) + (b - 48) ].
        i:: i + 1 ].
      ^ n )

    (* rete#323: a method is its blob offset (the image map's key). The C table
       keys on oimg_blob_base + off; this record is what onBreakContext: matches. *)
    ensureBp = (
      bpBlobs == nil ifTrue: [
        bpBlobs:: io OrderedCollection new.
        bpOffs:: io OrderedCollection new ].
      ^ self )

    (* Set a breakpoint at (blob offset, pc). The prim answers nil with no blob (a
       Path A image) or an offset outside it: nothing is armed. *)
    public break: blob at: off = (
      self ensureBp.
      (m breakAt: blob offset: off) == nil ifTrue: [ 'dbg:error no-blob' println. ^ self ].
      bpBlobs add: blob.
      bpOffs add: off.
      'dbg:ok break' println.
      ^ self )

    (* Clear a breakpoint at (blob offset, pc): disarm the C-side entry and drop the
       record. Unknown -> error. *)
    public clear: blob at: off = (
      | i hit n |
      self ensureBp.
      hit:: 0 - 1.
      i:: 1.
      [ hit < 0 and: [ i <= bpBlobs size ] ] whileTrue: [
        ((bpBlobs at: i) = blob and: [ (bpOffs at: i) = off ]) ifTrue: [ hit:: i ].
        i:: i + 1 ].
      hit < 0 ifTrue: [ 'dbg:error no-bp' println. ^ self ].
      m unbreakAt: blob offset: off.
      (* compact: shift each later entry down one, then drop the last slot. *)
      n:: bpBlobs size.
      hit to: n - 1 do: [ :j |
        bpBlobs at: j put: (bpBlobs at: j + 1).
        bpOffs at: j put: (bpOffs at: j + 1) ].
      bpBlobs removeLast.
      bpOffs removeLast.
      'dbg:ok clear' println.
      ^ self )

    (* The blob offset of a frame's method, or -1 with no blob (a Path A image). *)
    blobOf: ctx = (
      | b |
      b:: m blobOffsetOf: ctx.
      ^ b == nil ifTrue: [ 0 - 1 ] ifFalse: [ b ] )

    (* Tokenize `dbg:break <blob> <off>` / `dbg:clear <blob> <off>` and act. *)
    doBreak: line = (
      | rs ignore blobTok offTok |
      rs:: io ReadStream on: line.
      ignore:: rs upTo: 32.
      blobTok:: rs upTo: 32.
      offTok:: rs upTo: 32.
      blobTok == nil ifTrue: [ 'dbg:error usage' println. ^ self ].
      offTok == nil ifTrue: [ 'dbg:error usage' println. ^ self ].
      self break: (self parseInt: blobTok) at: (self parseInt: offTok).
      ^ self )

    (* rete#313: dbg:patch <file> replaces one method from a patch file (written by
       tools/patch_method.py against this image); dbg:restart restarts the stopped
       frame from its first line, into its method's replacement when it has one. The
       stop is kept: dbg:continue then runs the new code. The VM names a refusal's
       reason on stderr. *)
    doPatch: line = (
      | rs ignore path |
      rs:: io ReadStream on: line.
      ignore:: rs upTo: 32.
      path:: rs upToEnd.
      (m patchFrom: path) = 1
        ifTrue: [ 'dbg:ok patch' println ]
        ifFalse: [ 'dbg:error patch' println ].
      ^ self )

    doRestart = (
      (m restart: curCtx) = 1
        ifTrue: [ 'dbg:ok restart' println ]
        ifFalse: [ 'dbg:error restart' println ].
      ^ self )

    doClear: line = (
      | rs ignore blobTok offTok |
      rs:: io ReadStream on: line.
      ignore:: rs upTo: 32.
      blobTok:: rs upTo: 32.
      offTok:: rs upTo: 32.
      blobTok == nil ifTrue: [ 'dbg:error usage' println. ^ self ].
      offTok == nil ifTrue: [ 'dbg:error usage' println. ^ self ].
      self clear: (self parseInt: blobTok) at: (self parseInt: offTok).
      ^ self )

    (* Fired by the registered onBreak: hook when the C bp table matches, while
       stepping, and at a pause. Announces the stop by (blob offset, pc), then runs
       the paused command loop until continue/EOF. *)
    public onBreakContext: ctx = (
      | off blob hit i ws depth pause |
      (* The SAME hook fires for a C bp-table match, after every instruction while
         stepping (stepMode non-nil), and -- rete#311 -- when a line is waiting on the
         cable (platform_debug_pending) or the Supervisor armed the boot stop. curCtx
         is set in every path so dbg:inspect / depth-recompute use the live frame. *)
      curCtx:: ctx.
      off:: m offsetOf: ctx.
      blob:: self blobOf: ctx.
      stepMode == nil ifTrue: [
        (* BREAKPOINT path: is (blob, off) a recorded breakpoint? No record means no
           breakpoint fired: this is a PAUSE -- the boot stop the first time
           (`dbg:ready`, the line every driver waits for), a line in while running
           after that. Announce, then the one command loop. *)
        hit:: 0.
        self ensureBp.
        i:: 1.
        [ hit = 0 and: [ i <= bpBlobs size ] ] whileTrue: [
          ((bpBlobs at: i) = blob and: [ (bpOffs at: i) = off ]) ifTrue: [ hit:: 1 ].
          i:: i + 1 ].
        ws:: io WriteStream new.
        (hit = 0 and: [ ready == nil ])
          ifTrue: [ ready:: true. ws nextPutAll: 'dbg:ready' ]
          ifFalse: [
            ws nextPutAll: (hit = 0 ifTrue: [ 'dbg:paused pause ' ] ifFalse: [ 'dbg:paused break ' ]).
            ws print: blob.
            ws nextPutAll: ' '.
            ws print: off ].
        ws contents println.
        self commandLoop.
        ^ self ].
      (* STEP path: decide whether to pause based on stepMode + sender-chain depth. *)
      depth:: self depthOf: ctx.
      pause:: false.
      stepMode = #into ifTrue: [ pause:: true ].
      stepMode = #over ifTrue: [ pause:: depth <= stepDepth ].
      stepMode = #out  ifTrue: [ pause:: depth < (stepDepth + 1) ].
      pause ifFalse: [ m requestStep: 1. ^ self ].
      ws:: io WriteStream new.
      ws nextPutAll: 'dbg:paused step '.
      ws print: blob.
      ws nextPutAll: ' '.
      ws print: off.
      ws contents println.
      self commandLoop.
      ^ self )

    (* Count rawSender hops to nil (counts the current frame too; only the relative
       comparison matters for step-over/out). *)
    public depthOf: ctx = (
      | d s |
      d:: 0.
      s:: ctx.
      [ s == nil ] whileFalse: [ d:: d + 1. s:: m senderOf: s ].
      ^ d )

    (* dbg:backtrace -> ONE line, innermost first: `dbg:frames <blob>@<pc> ...`.
       custos maps each pair through the image map (rete#323). *)
    doBacktrace = (
      | ws s |
      ws:: io WriteStream new.
      ws nextPutAll: 'dbg:frames'.
      s:: curCtx.
      [ s == nil ] whileFalse: [
        ws nextPutAll: ' '.
        ws print: (self blobOf: s).
        ws nextPutAll: '@'.
        ws print: (m offsetOf: s).
        s:: m senderOf: s ].
      ws contents println.
      ^ self )

    (* dbg:inspect [frameIndex] -> ONE flat line:
       `dbg:stack off=<n> r0=<printString> r1=<...> c0=<...> c1=<...>`: the registers
       bounded by numRegisters, then the slots of the frame's Context when it has one
       (its captured locals, rete#323). Walks `frameIndex` senderOf: hops from curCtx
       (nil -> dbg:error no-frame). *)
    doInspect: line = (
      | rs ignore idxTok idx s cm off n i ws slots |
      rs:: io ReadStream on: line.
      ignore:: rs upTo: 32.
      idxTok:: rs upTo: 32.
      idx:: idxTok == nil ifTrue: [ 0 ] ifFalse: [ self parseInt: idxTok ].
      s:: curCtx.
      i:: 0.
      [ i < idx and: [ s == nil ifTrue: [ false ] ifFalse: [ true ] ] ] whileTrue: [
        s:: m senderOf: s. i:: i + 1 ].
      s == nil ifTrue: [ 'dbg:error no-frame' println. ^ self ].
      cm:: ContextMirror usingMirror: m context: s.
      off:: cm offset.
      n:: cm numRegisters.
      ws:: io WriteStream new.
      ws nextPutAll: 'dbg:stack off='.
      ws print: off.
      i:: 0.
      [ i < n ] whileTrue: [
        ws nextPutAll: ' r'.
        ws print: i.
        ws nextPutAll: '='.
        ws nextPutAll: (self describe: (cm registerAt: i)).
        i:: i + 1 ].
      slots:: m lexicalSlotsOf: s.
      slots == nil ifFalse: [
        (* A raw indexable, like selectorsOf:'s: basicSize / basicAt:, 1-based. *)
        1 to: slots basicSize do: [ :k |
          ws nextPutAll: ' c'.
          ws print: k - 1.
          ws nextPutAll: '='.
          ws nextPutAll: (self describe: (slots basicAt: k)) ] ].
      ws contents println.
      ^ self )

    (* A register's printString, or a bracketed note for a value that has none. A
       pause (rete#311) lands anywhere, and a frame's registers hold blocks, contexts,
       vtables and other VM-level values that answer no printString; sending it would
       DNU and ABORT the VM, and the debugger must never be what kills the program.
       Printable means: nil, the primitive kinds (integer, float, string, symbol), or an
       object whose vtable chain reaches the kernel's Object -- the root of the entry's
       own chain -- which is where printString lives. The mirror cannot ask "does this
       understand printString" (the primitive kinds answer it with no binding), so the
       question is asked by vtable identity. Everything else is named by kind. *)
    describe: v = (
      | vt walk |
      v == nil ifTrue: [ ^ 'nil' ].
      vt:: m vtableOf: v.
      (vt == (m vtableOf: 1) or: [ vt == (m vtableOf: 1 asFloat) or: [
       vt == (m vtableOf: 'a') or: [ vt == (m vtableOf: #a) ] ] ]) ifTrue: [ ^ v printString ].
      walk:: vt.
      [ walk == nil ] whileFalse: [
        walk == self objectVtable ifTrue: [ ^ v printString ].
        walk:: m delegateOf: walk ].
      vt == (m vtableOf: [ :x | x ]) ifTrue: [ ^ '[a block]' ].
      vt == (m vtableOf: curCtx) ifTrue: [ ^ '[a context]' ].
      vt == (m vtableOf: vt) ifTrue: [ ^ '[a vtable]' ].
      ^ '[a VM object]' )

    (* The kernel's Object vtable: the root of the entry's delegate chain. *)
    objectVtable = (
      | root |
      root:: m vtableOf: entry.
      [ (m delegateOf: root) == nil ] whileFalse: [ root:: m delegateOf: root ].
      ^ root )

    (* THE command loop, entered from onBreakContext: at the boot stop, at a
       breakpoint, after a step, and at a pause (rete#311). Reads `dbg:*` lines until
       `dbg:continue` / `dbg:run` (resume; a bp re-fires on its next visit) or EOF
       (detach: resume, never stop again on our account). `dbg:pause` here is a line
       that has already done its work by arriving -- answered, not acted on. *)
    public commandLoop = (
      | line verb |
      [ true ] whileTrue: [
        line:: io readLine.
        (* dbg:continue, or EOF: a STEP continue must clear stepMode AND requestStep: 0,
           else was_stepping keeps the app single-stepping forever; the boot stop and a
           pause arrived as a step too, so the 0 is what lets the program run. *)
        (line == nil or: [ verb:: self verbOf: line. verb = 'dbg:continue' or: [ verb = 'dbg:run' ] ])
          ifTrue: [ stepMode:: nil. m requestStep: 0. ^ self ].
        verb = 'dbg:pause' ifTrue: [ 'dbg:ok pause' println ] ifFalse: [
        verb = 'dbg:break' ifTrue: [ self doBreak: line ] ifFalse: [
        verb = 'dbg:clear' ifTrue: [ self doClear: line ] ifFalse: [
        verb = 'dbg:patch' ifTrue: [ self doPatch: line ] ifFalse: [
        verb = 'dbg:restart' ifTrue: [ self doRestart ] ifFalse: [
        (* step verbs: arm stepMode (+depth), request stepping, RETURN so the hook
           returns and single-stepping engages. *)
        verb = 'dbg:step' ifTrue: [ stepMode:: #into. m requestStep: 1. ^ self ] ifFalse: [
        verb = 'dbg:over' ifTrue: [ stepMode:: #over. stepDepth:: self depthOf: curCtx. m requestStep: 1. ^ self ] ifFalse: [
        verb = 'dbg:out' ifTrue: [ stepMode:: #out. stepDepth:: (self depthOf: curCtx) - 1. m requestStep: 1. ^ self ] ifFalse: [
        (* dbg:inspect is a QUERY: emit the dump, keep looping. *)
        verb = 'dbg:inspect' ifTrue: [ self doInspect: line ] ifFalse: [
        verb = 'dbg:backtrace' ifTrue: [ self doBacktrace ] ifFalse: [
        (* rete#312 Q1: the kernel's profile handler, the same line porta would write.
           The window opens now and runs from the next continue. *)
        verb = 'profile' ifTrue: [ self doProfile: line ] ifFalse: [
          'dbg:error unknown' println ] ] ] ] ] ] ] ] ] ] ] ] )

    doProfile: line = (
      (io profiler request: line) > 0
        ifTrue: [ 'dbg:ok profile' println ]
        ifFalse: [ 'dbg:error profile wants profile <ms>' println ].
      ^ self )

    (* First space-delimited token of a command line (the verb). *)
    verbOf: line = (
      | rs t |
      rs:: io ReadStream on: line.
      t:: rs upTo: 32.
      ^ t == nil ifTrue: [ line ] ifFalse: [ t ] )
  ) : ()
) : (
)
