(*
ns-oevm kernel library (std-lib step 3b). One module — `Kernel usingPlatform:
platform` — nesting the library classes as siblings. The native C
platform_object() is injected as `platform`; the APP receives the Kernel
INSTANCE as its own `platform` and reaches library classes through the
hand-written accessors at the bottom.

Reachability (spec §3):
  Kernel -> native primitives : lexically via the injected `platform` param.
  Kernel -> Kernel            : compile-time lexical (sibling slot read / OP_NEW).
  App    -> Kernel            : runtime send to an accessor (`platform Array`).

NB: inside this module NEVER write `Array new: n` (it compiles to a fixed-slot
OP_NEW, not an indexable). Allocate indexables via `platform basicNew: Array
indexable: n` (Array as an argument is a slot read of the class object).
*)
class Kernel usingPlatform: platform = (
  (* rete#244: the ONE Timers this kernel instance answers. Lazy because the
     accessor below is the only reader, nil until first asked. *)
  | private timersOne ::= nil. private profilerOne ::= nil. private debuggerOne ::= nil. private encodeScratchOne ::= nil. private encodeScratchBusy ::= false. |
) (
  class Object = () (
    (* Milestone E Task 1: the in-flight error value is a crash Record (#tag/#text),
       not a bare String. `self error: text` and `text error: tag` are BOTH C prims
       (PRIM_error id 9, PRIM_errorTag id 91): they build the Record in C via the
       captured Kernel instance's `crashRecordTag:text:` accessor, then `raise` it
       (terminate-only prim, id 90, longjmps to the active protection frame). No
       kernel Object method is involved — an app receiver cannot reach the `Record`
       class lexically, so building it here would be unreachable. *)
    public isNil = ( ^ false )
    public notNil = ( ^ true )
    public ifNil: aBlock = ( ^ self )
    public ifNotNil: aBlock = ( ^ aBlock value: self )
    public = other = ( ^ self == other )
    public printString = ( ^ 'an Object' )
    public asString = ( ^ self printString )
    public hash = ( ^ self identityHash )
    public isValue = ( ^ false )
    public isSymbol = ( ^ false )
    public isList = ( ^ false )
    public isMap = ( ^ false )
    public isRecord = ( ^ false )
    public isBytes = ( ^ false )
    public valueRank = ( ^ -1 )
    public valueDepth = ( ^ 0 )
  ) : (
  )

  public class Array = () (
    public at: i = ( ^ self basicAt: i )
    public at: i put: v = ( self basicAt: i put: v. ^ v )
    public size = ( ^ self basicSize )
    public do: aBlock = ( 1 to: self size do: [ :i | aBlock value: (self basicAt: i) ]. ^ self )
  ) : (
    public new: n = ( ^ platform basicNew: self indexable: n )
  )

  class Collection = () (
    public do: aBlock = ( ^ self error: 'subclassResponsibility' )
    public size = ( ^ self inject: 0 into: [ :n :e | n + 1 ] )
    public isEmpty = ( ^ self size = 0 )
    public inject: a into: b = ( | acc | acc:: a. self do: [ :e | acc:: b value: acc value: e ]. ^ acc )
    public collect: b = ( | r | r:: OrderedCollection new. self do: [ :e | r add: (b value: e) ]. ^ r )
    public select: b = ( | r | r:: OrderedCollection new. self do: [ :e | (b value: e) ifTrue: [ r add: e ] ]. ^ r )
    public reject: b = ( | r | r:: OrderedCollection new. self do: [ :e | (b value: e) ifFalse: [ r add: e ] ]. ^ r )
    public includes: o = ( ^ self inject: false into: [ :acc :e | acc or: [ e = o ] ] )
    public asArray = ( | arr i | arr:: platform basicNew: Array indexable: self size. i:: 1. self do: [ :e | arr at: i put: e. i:: i + 1 ]. ^ arr )
    public detect: b ifNone: n = (
      | found result |
      found:: false.
      self do: [ :e |
        (found not and: [ b value: e ]) ifTrue: [ found:: true. result:: e ] ].
      found ifTrue: [ ^ result ].
      ^ n value )
    public detect: b = ( ^ self detect: b ifNone: [ self error: 'not found' ] )

    (* ---- L1 combinators (landed from staged review/lib/combinators.ns) --------
       With NLR gone these ARE the early-exit story, so they all use the found-flag
       pattern: iteration is not cut short, but the block is not SENT again once the
       answer is known. The observable contract is therefore EVALUATION COUNT, not
       iteration count — identical to detect:ifNone: above, and pinned by
       nsl-tests/07_no_nlr/05. No `^` inside any block (dialect: NLR is gone).
       Everything here bottoms out in `do:`, so it works for every Collection —
       including Interval. *)
    public anySatisfy: aBlock = (
      | found |
      found:: false.
      self do: [ :e | found ifFalse: [ found:: aBlock value: e ] ].
      ^ found )
    public allSatisfy: aBlock = (
      | ok |
      ok:: true.
      self do: [ :e | ok ifTrue: [ ok:: aBlock value: e ] ].
      ^ ok )
    public noneSatisfy: aBlock = ( ^ (self anySatisfy: aBlock) not )
    public count: aBlock = (
      ^ self inject: 0 into: [ :n :e | (aBlock value: e) ifTrue: [ n + 1 ] ifFalse: [ n ] ] )
    public do: aBlock separatedBy: sepBlock = (
      | first |
      first:: true.
      self do: [ :e |
        first ifTrue: [ first:: false ] ifFalse: [ sepBlock value ].
        aBlock value: e ].
      ^ self )
    public withIndexDo: aBlock = (
      | i |
      i:: 0.
      self do: [ :e | i:: i + 1. aBlock value: e value: i ].
      ^ self )
    public indexOf: anObject ifAbsent: absentBlock = (
      | idx |
      idx:: 0.
      self withIndexDo: [ :e :i | (idx = 0 and: [ e = anObject ]) ifTrue: [ idx:: i ] ].
      idx = 0 ifTrue: [ ^ absentBlock value ].
      ^ idx )
    public indexOf: anObject = ( ^ self indexOf: anObject ifAbsent: [ self error: 'not found' ] )
    (* Element with the maximal aBlock value; ifNone: on empty. *)
    public detectMax: aBlock ifNone: noneBlock = (
      | found best bestVal v |
      found:: false.
      self do: [ :e |
        v:: aBlock value: e.
        (found not or: [ v > bestVal ]) ifTrue: [ found:: true. best:: e. bestVal:: v ] ].
      found ifTrue: [ ^ best ].
      ^ noneBlock value )
    public detectMin: aBlock ifNone: noneBlock = (
      ^ self detectMax: [ :e | 0 - (aBlock value: e) ] ifNone: noneBlock )
    public detectMax: aBlock = ( ^ self detectMax: aBlock ifNone: [ self error: 'not found' ] )
    public detectMin: aBlock = ( ^ self detectMin: aBlock ifNone: [ self error: 'not found' ] )
  ) : (
  )

  public class OrderedCollection = Collection (
    | private contents ::= platform basicNew: Array indexable: 8. private count ::= 0. |
  ) (
    (* Hot paths index `contents` (always a kernel Array) via basicAt: directly,
       skipping the Array>>at: frame — the perf/op-cmp-at trial widened the
       basicAt: emitter discipline from "Array methods on self" to "kernel
       collection internals on their Array-typed slots" (see dispatch.c's
       PRIM_ix_basicAt note). Bounds stay guarded: do: is count-bounded,
       at:/at:put: check before touching contents. *)
    public do: aBlock = ( 1 to: count do: [ :i | aBlock value: (contents basicAt: i) ]. ^ self )
    public size = ( ^ count )
    public isEmpty = ( ^ count = 0 )
    public add: anObject = ( count = contents basicSize ifTrue: [ self grow ]. count:: count + 1. contents basicAt: count put: anObject. ^ anObject )
    public addLast: anObject = ( ^ self add: anObject )
    public at: i = ( (i < 1 or: [ i > count ]) ifTrue: [ ^ self error: 'index out of bounds' ]. ^ contents basicAt: i )
    public at: i put: v = ( (i < 1 or: [ i > count ]) ifTrue: [ ^ self error: 'index out of bounds' ]. ^ contents basicAt: i put: v )
    public first = ( ^ self at: 1 )
    public last = ( ^ self at: count )
    public removeLast = ( | v | v:: contents basicAt: count. count:: count - 1. ^ v )
    public removeFirst = ( | v | v:: contents basicAt: 1. 2 to: count do: [ :i | contents basicAt: i - 1 put: (contents basicAt: i) ]. count:: count - 1. ^ v )
    grow = ( | bigger | bigger:: platform basicNew: Array indexable: 2 * contents basicSize. bigger basicReplaceFrom: 1 to: count with: contents startingAt: 1. contents:: bigger. ^ self )

    (* ---- L1 sequence combinators (staged review/lib/combinators.ns) ----------
       These need indexed access (`at:`/`size`), so they live here rather than on
       Collection — a Set has no order to copy, reverse or concatenate. Interval
       is indexed too but defines its own `at:`; it inherits the do:-based
       combinators from Collection, which is all it needs.
       1-based and inclusive, per Smalltalk convention. Bounds errors crash (L5). *)
    public with: other collect: aBlock = (
      | r |
      self size = other size ifFalse: [ ^ self error: 'size mismatch' ].
      r:: OrderedCollection new.
      self withIndexDo: [ :e :i | r add: (aBlock value: e value: (other at: i)) ].
      ^ r )
    public copyFrom: start to: stop = (
      | r |
      (start < 1 or: [ stop > self size ]) ifTrue: [ ^ self error: 'index out of bounds' ].
      r:: OrderedCollection new.
      start to: stop do: [ :i | r add: (self at: i) ].
      ^ r )
    public reversed = (
      | r n |
      r:: OrderedCollection new.
      n:: self size.
      1 to: n do: [ :i | r add: (self at: n - i + 1) ].
      ^ r )
    public first: n = ( ^ self copyFrom: 1 to: n )
    public last: n = ( ^ self copyFrom: self size - n + 1 to: self size )
    (* Concatenation. `,` is a VM prim that answers String-String only; every other
       receiver falls through to normal vtable lookup (dispatch.c), so this method
       is reachable and does not collide with String concat. *)
    public , other = (
      | r |
      r:: OrderedCollection new.
      self do: [ :e | r add: e ].
      other do: [ :e | r add: e ].
      ^ r )
  ) : (
  )

  (* L1 — an integer range as a FIRST-CLASS collection, so numeric ranges get the
     whole Collection protocol (select:, anySatisfy:, count:, inject:into:, …).
     The compiler still lowers the `to:do:` / `to:by:do:` LOOP forms straight to
     bytecode; Interval is for range-as-VALUE uses and does not change that.

     The spec's `1 to: n` sugar is NOT provided: integers are VM builtins with no
     nsl-reachable vtable (`1 to: 5` compiles to a real send and dies with
     `Message 'to:' not understood`), so a range is constructed explicitly via the
     class-side. See tuvm#30 — giving integers a protocol is a VM/dialect decision,
     not a library one.

     Only do:/size/at: are primitive to it; everything else is inherited. *)
  public class Interval = Collection ( | private start private stop private step | ) (
    public do: aBlock = (
      | i |
      step > 0
        ifTrue: [ i:: start. [ i <= stop ] whileTrue: [ aBlock value: i. i:: i + step ] ]
        ifFalse: [ i:: start. [ i >= stop ] whileTrue: [ aBlock value: i. i:: i + step ] ].
      ^ self )
    public size = (
      step > 0
        ifTrue: [ stop < start ifTrue: [ ^ 0 ]. ^ (stop - start) // step + 1 ].
      start < stop ifTrue: [ ^ 0 ].
      ^ (start - stop) // (0 - step) + 1 )
    public at: i = (
      (i < 1 or: [ i > self size ]) ifTrue: [ ^ self error: 'index out of bounds' ].
      ^ start + ((i - 1) * step) )
    public first = ( ^ self at: 1 )
    public last = ( ^ self at: self size )
    public setStart: a stop: b step: s = (
      s = 0 ifTrue: [ ^ self error: 'zero step' ].
      start:: a. stop:: b. step:: s. ^ self )
  ) : (
    public from: a to: b = ( ^ self new setStart: a stop: b step: 1 )
    public from: a to: b by: s = ( ^ self new setStart: a stop: b step: s )
  )

  class HashedCollection = Collection ( | private table private count private hashes | ) (
    (* Abstract open-addressing hash table over `table` (the keys/elements
       Array); `count` is the live-entry tally. Concrete subclasses re-declare
       `table`/`count`/`hashes` WITH initializers to set the initial capacity — the bare
       `= Super` inheritance form does not run an ancestor's slot initializers,
       and a per-target bounded variant would pick a different capacity here. *)
    public size = ( ^ count )
    public isEmpty = ( ^ count = 0 )

    (* Linear probe from the home bucket (wrapping) to the slot holding aKey OR
       the first empty (nil) slot. Load factor < 1 guarantees an empty slot, so
       this terminates. Floored `\\` answers a non-negative home bucket for any
       sign of hash; the value protocol supplies `hash`.
       rete#37: `hashes` holds each live key's hash beside it, as CPython's entries do. A probe
       compares the stored hash before it sends the key's `=`, and a grow or a cluster rehash
       re-places an entry from its stored hash without sending `hash` or `=` at all. The hash
       comparison is `=`, not `==`: a user `hash` may answer a LargeInteger, and two equal ones
       are not the same object (test 04/69). *)
    slotFor: aKey = ( ^ self slotFor: aKey hash: aKey hash )
    slotFor: aKey hash: h = ( | c i k |
      c:: table basicSize. i:: (h \\ c) + 1. k:: table basicAt: i.
      [ k == nil ifTrue: [ false ] ifFalse: [ ((hashes basicAt: i) = h and: [ k = aKey ]) not ] ] whileTrue: [
        i:: i + 1. i > c ifTrue: [ i:: 1 ]. k:: table basicAt: i ].
      ^ i )
    (* The first empty slot on h's probe path: for an entry known not to be in the table. *)
    emptySlotFor: h = ( | c i |
      c:: table basicSize. i:: (h \\ c) + 1.
      [ (table basicAt: i) == nil ] whileFalse: [ i:: i + 1. i > c ifTrue: [ i:: 1 ] ].
      ^ i )

    public containsKey: aKey = ( ^ ((table basicAt: (self slotFor: aKey)) == nil) not )

    (* Load factor 0.75: Set>>add: and Dictionary>>at:put: test `count * 4 >= (table basicSize * 3)`
       inline rather than through a helper send (rete#37). *)

    (* Cluster-rehash deletion (no tombstones): after a slot is vacated, walk the
       contiguous run that follows and re-place each entry, pulling forward any
       entry that had probed past the hole. Stops at the first empty slot. *)
    rehashFrom: start = ( | c j |
      c:: table basicSize. j:: start + 1. j > c ifTrue: [ j:: 1 ].
      [ ((table basicAt: j) == nil) not ] whileTrue: [
        self reinsertEntryAt: j.
        j:: j + 1. j > c ifTrue: [ j:: 1 ] ].
      ^ self )

    grow = ( ^ self error: 'subclassResponsibility' )
    reinsertEntryAt: j = ( ^ self error: 'subclassResponsibility' )
    public do: aBlock = ( ^ self error: 'subclassResponsibility' )
  ) : (
  )

  public class Set = HashedCollection ( | private table ::= platform basicNew: Array indexable: 8. private count ::= 0. private hashes ::= platform basicNew: Array indexable: 8. | ) (
    public add: anObject = ( (anObject == nil) ifTrue: [ ^ self error: 'nil element not allowed' ]. self place: anObject. count * 4 >= (table basicSize * 3) ifTrue: [ self grow ]. ^ anObject )
    public addAll: aCollection = ( aCollection do: [ :e | self add: e ]. ^ aCollection )
    public remove: anObject = ( ^ self remove: anObject ifAbsent: [ self error: 'element not found' ] )
    public remove: anObject ifAbsent: aBlock = ( | i |
      i:: self slotFor: anObject.
      (table basicAt: i) == nil ifTrue: [ ^ aBlock value ].
      table basicAt: i put: nil. count:: count - 1. self rehashFrom: i. ^ anObject )
    public includes: anObject = ( ^ self containsKey: anObject )
    public do: aBlock = ( 1 to: table basicSize do: [ :i | | e | e:: table basicAt: i. (e == nil) ifFalse: [ aBlock value: e ] ]. ^ self )
    place: anObject = ( | h i | h:: anObject hash. i:: self slotFor: anObject hash: h. (table basicAt: i) == nil ifTrue: [ table basicAt: i put: anObject. hashes basicAt: i put: h. count:: count + 1 ]. ^ self )
    reinsertEntryAt: j = ( | e h i | e:: table basicAt: j. h:: hashes basicAt: j. table basicAt: j put: nil. i:: self emptySlotFor: h. table basicAt: i put: e. hashes basicAt: i put: h. ^ self )
    grow = ( | old oldH oldCap | old:: table. oldH:: hashes. oldCap:: table basicSize. table:: platform basicNew: Array indexable: oldCap * 2. hashes:: platform basicNew: Array indexable: oldCap * 2. 1 to: oldCap do: [ :j | | e i | e:: old basicAt: j. (e == nil) ifFalse: [ i:: self emptySlotFor: (oldH basicAt: j). table basicAt: i put: e. hashes basicAt: i put: (oldH basicAt: j) ] ]. ^ self )
  ) : (
  )

  public class Dictionary = HashedCollection ( | private table ::= platform basicNew: Array indexable: 8. private count ::= 0. private vals ::= platform basicNew: Array indexable: 8. private hashes ::= platform basicNew: Array indexable: 8. | ) (
    public at: aKey put: aValue = ( (aKey == nil) ifTrue: [ ^ self error: 'nil key not allowed' ]. self place: aKey value: aValue. count * 4 >= (table basicSize * 3) ifTrue: [ self grow ]. ^ aValue )
    public at: aKey ifAbsent: aBlock = ( | i | i:: self slotFor: aKey. (table basicAt: i) == nil ifTrue: [ ^ aBlock value ]. ^ vals basicAt: i )
    public at: aKey = ( ^ self at: aKey ifAbsent: [ self error: 'key not found' ] )
    public at: aKey ifAbsentPut: aBlock = ( | i | i:: self slotFor: aKey. ((table basicAt: i) == nil) not ifTrue: [ ^ vals basicAt: i ]. ^ self at: aKey put: aBlock value )
    public includesKey: aKey = ( ^ self containsKey: aKey )
    public removeKey: aKey = ( ^ self removeKey: aKey ifAbsent: [ self error: 'key not found' ] )
    public removeKey: aKey ifAbsent: aBlock = ( | i v |
      i:: self slotFor: aKey.
      (table basicAt: i) == nil ifTrue: [ ^ aBlock value ].
      v:: vals basicAt: i. table basicAt: i put: nil. count:: count - 1. self rehashFrom: i. ^ v )
    public keys = ( | arr j | arr:: platform basicNew: Array indexable: count. j:: 0. 1 to: table basicSize do: [ :i | | k | k:: table basicAt: i. (k == nil) ifFalse: [ j:: j + 1. arr basicAt: j put: k ] ]. ^ arr )
    public values = ( | arr j | arr:: platform basicNew: Array indexable: count. j:: 0. 1 to: table basicSize do: [ :i | | k | k:: table basicAt: i. (k == nil) ifFalse: [ j:: j + 1. arr basicAt: j put: (vals basicAt: i) ] ]. ^ arr )
    public keysAndValuesDo: aBlock = ( 1 to: table basicSize do: [ :i | | k | k:: table basicAt: i. (k == nil) ifFalse: [ aBlock value: k value: (vals basicAt: i) ] ]. ^ self )
    public do: aBlock = ( 1 to: table basicSize do: [ :i | | k | k:: table basicAt: i. (k == nil) ifFalse: [ aBlock value: (vals basicAt: i) ] ]. ^ self )
    place: aKey value: aValue = ( | h i | h:: aKey hash. i:: self slotFor: aKey hash: h. (table basicAt: i) == nil ifTrue: [ table basicAt: i put: aKey. hashes basicAt: i put: h. count:: count + 1 ]. vals basicAt: i put: aValue. ^ self )
    reinsertEntryAt: j = ( | k v h i | k:: table basicAt: j. v:: vals basicAt: j. h:: hashes basicAt: j. table basicAt: j put: nil. vals basicAt: j put: nil. i:: self emptySlotFor: h. table basicAt: i put: k. vals basicAt: i put: v. hashes basicAt: i put: h. ^ self )
    grow = ( | oldK oldV oldH oldCap | oldK:: table. oldV:: vals. oldH:: hashes. oldCap:: table basicSize. table:: platform basicNew: Array indexable: oldCap * 2. vals:: platform basicNew: Array indexable: oldCap * 2. hashes:: platform basicNew: Array indexable: oldCap * 2. 1 to: oldCap do: [ :j | | k i | k:: oldK basicAt: j. (k == nil) ifFalse: [ i:: self emptySlotFor: (oldH basicAt: j). table basicAt: i put: k. vals basicAt: i put: (oldV basicAt: j). hashes basicAt: i put: (oldH basicAt: j) ] ]. ^ self )
  ) : (
  )

  class Association = ( | private key private value | ) (
    public setKey: aKey value: aValue = ( key:: aKey. value:: aValue. ^ self )
    public key = ( ^ key )
    public value = ( ^ value )
    public printString = ( ^ key printString , ' -> ' , value printString )
  ) : (
    public key: aKey value: aValue = ( ^ self new setKey: aKey value: aValue )
  )

  (* Immutable algebra list (Milestone B Task 6). Backing `items` is a plain
     Array, copied at construction and never returned/aliased; `depth` is
     computed once at construction (checkDepth-validated) and cached, so
     `valueDepth` is O(1) rather than a deep walk. Every constructor path
     (the four `with:` arities and `fromCollection:`) funnels through the
     private `setItems:`, which validates each element (checkValue:, via the
     `outer` link to the module-level helpers below) and folds the max child
     depth in the same O(children) pass. *)
  public class List = ( | private items private depth | ) (
    public size = ( ^ items size )
    public at: i = ( (i < 1 or: [ i > items size ]) ifTrue: [ ^ self error: 'index out of bounds' ]. ^ items at: i )
    public at: i ifAbsent: aBlock = ( (i < 1 or: [ i > items size ]) ifTrue: [ ^ aBlock value ]. ^ items at: i )
    public do: aBlock = ( items do: aBlock. ^ self )
    public inject: a into: b = ( | acc | acc:: a. items do: [ :e | acc:: b value: acc value: e ]. ^ acc )
    public anySatisfy: aBlock = ( | found | found:: false. items do: [ :e | (found not and: [ aBlock value: e ]) ifTrue: [ found:: true ] ]. ^ found )
    public isList = ( ^ true )
    public isValue = ( ^ true )
    public valueRank = ( ^ 7 )
    public valueDepth = ( ^ depth )
    (* Typed structural equality (Milestone B Task 7). Guard via
       `isValueObject:` (the native `platform valueRank:` oracle), NOT via
       sending `isList`/similar to `other` — a builtin non-value receiver
       (e.g. an Integer) doesn't delegate to Kernel Object, so probing it
       with an ad hoc selector can DNU-crash; `isValueObject:` inspects the
       vtable instead and never sends anything to `other`. A non-value
       foreign receiver (Dictionary, raw heap object, ...) answers false; a
       value of a different rank (e.g. Integer) also safely answers false via
       the rank-first compare in `valueCompare:with:`. *)
    public = other = (
      (outer isValueObject: other) ifFalse: [ ^ false ].
      ^ outer value: self equals: other
    )
    public hash = ( ^ outer valueHashOf: self )
    public setItems: anArray = (
      | d |
      d:: 0.
      1 to: anArray size do: [ :i | | e cd |
        e:: anArray at: i.
        outer checkValue: e.
        cd:: outer depthOf: e.
        cd > d ifTrue: [ d:: cd ] ].
      items:: anArray.
      depth:: outer checkDepth: (1 + d).
      ^ self )
  ) : (
    public with: a = ( | arr | arr:: platform basicNew: Array indexable: 1. arr at: 1 put: a. ^ self new setItems: arr )
    public with: a with: b = ( | arr | arr:: platform basicNew: Array indexable: 2. arr at: 1 put: a. arr at: 2 put: b. ^ self new setItems: arr )
    public with: a with: b with: c = ( | arr | arr:: platform basicNew: Array indexable: 3. arr at: 1 put: a. arr at: 2 put: b. arr at: 3 put: c. ^ self new setItems: arr )
    public with: a with: b with: c with: d = ( | arr | arr:: platform basicNew: Array indexable: 4. arr at: 1 put: a. arr at: 2 put: b. arr at: 3 put: c. arr at: 4 put: d. ^ self new setItems: arr )
    public with: a with: b with: c with: d with: e = ( | arr | arr:: platform basicNew: Array indexable: 5. arr at: 1 put: a. arr at: 2 put: b. arr at: 3 put: c. arr at: 4 put: d. arr at: 5 put: e. ^ self new setItems: arr )
    public fromCollection: aCollection = ( | n arr i |
      n:: aCollection size.
      arr:: platform basicNew: Array indexable: n.
      i:: 0.
      aCollection do: [ :e | i:: i + 1. arr at: i put: e ].
      ^ self new setItems: arr )
  )

  (* Immutable algebra map (Milestone B Task 8): a sorted association array —
     two parallel private Arrays (`keys`/`vals`), NEVER Association storage
     (Associations from the `#k -> v` sugar are unwrapped at construction and
     never retained). Entries are kept sorted by `valueCompare:with:` on the
     keys, so iteration order is canonical/deterministic regardless of
     construction order (`keysDo:`/`do:`/`keysAndValuesDo:` all walk the same
     sorted order — this is what makes `05b_map_canonical_order.nsl` pass).
     Duplicate keys in construction: LAST WINS (a later `with:`/`fromPairs:`
     argument overwrites an earlier one with the same key) — pinned because
     future CBOR decoders construct by overwrite. Both keys AND values are
     validated via `outer checkValue:`; `depth` is folded over ALL keys and
     ALL values (mirrors List's `setItems:`) and cached at construction. *)
  public class Map = ( | private keys private vals private depth | ) (
    public size = ( ^ keys size )
    public at: aKey ifAbsent: aBlock = ( | lo hi mid c |
      lo:: 1. hi:: keys size.
      [ lo <= hi ] whileTrue: [
        mid:: (lo + hi) // 2.
        c:: outer valueCompare: aKey with: (keys at: mid).
        c = 0 ifTrue: [ ^ vals at: mid ].
        c < 0 ifTrue: [ hi:: mid - 1 ] ifFalse: [ lo:: mid + 1 ] ].
      ^ aBlock value )
    public keysDo: aBlock = ( keys do: aBlock. ^ self )
    public do: aBlock = ( vals do: aBlock. ^ self )
    public keysAndValuesDo: aBlock = ( 1 to: keys size do: [ :i | aBlock value: (keys at: i) value: (vals at: i) ]. ^ self )
    (* Minimal indexed read accessors (Milestone B Task 8 design decision —
       see report for surface-creep review): the module-level `mapCompare:with:`
       helper below needs to walk TWO DIFFERENT Maps' entries in lockstep by
       index, which `keysAndValuesDo:` cannot give it (it only iterates one
       receiver at a time). These return individual elements, never the
       backing Array itself — "do not expose the raw backing arrays" still
       holds. *)
    public keyAt: i = ( ^ keys at: i )
    public valueAt: i = ( ^ vals at: i )
    public isMap = ( ^ true )
    public isValue = ( ^ true )
    public valueRank = ( ^ 8 )
    public valueDepth = ( ^ depth )
    (* Typed structural equality/hash — same guard idiom as List (Task 7):
       never send an ad-hoc predicate to `other`, only the native rank oracle
       via `isValueObject:` (a foreign non-value receiver, or a value of a
       different rank, safely answers false without risking a DNU crash). *)
    public = other = (
      (outer isValueObject: other) ifFalse: [ ^ false ].
      ^ outer value: self equals: other
    )
    public hash = ( ^ outer valueHashOf: self )
    (* Construction: validate every key/value, insertion-sort the parallel
       arrays by `valueCompare:with:` on keys (stable — the shift condition is
       strict `> 0`, so equal keys are never swapped past one another and
       their original relative order survives the sort), then compact
       consecutive equal-key runs keeping the LAST entry of each run
       (last-wins falls out of stability: among duplicates the one built
       later in the caller's argument list stays later after a stable sort,
       so keeping the run's last element is exactly last-wins), then
       fold/check depth over the final (deduplicated) entries. Messages are
       small, so plain insertion sort — "no need for anything cleverer"
       (plan's own words) — and a linear compaction pass. *)
    public setPairs: karr values: varr = ( | n j outCount i d k v nextI kk vv cd |
      n:: karr size.
      1 to: n do: [ :ii | outer checkValue: (karr at: ii). outer checkValue: (varr at: ii) ].
      2 to: n do: [ :ii |
        kk:: karr at: ii. vv:: varr at: ii.
        j:: ii - 1.
        [ j >= 1 and: [ (outer valueCompare: (karr at: j) with: kk) > 0 ] ] whileTrue: [
          karr at: j + 1 put: (karr at: j).
          varr at: j + 1 put: (varr at: j).
          j:: j - 1 ].
        karr at: j + 1 put: kk.
        varr at: j + 1 put: vv ].
      outCount:: 0. i:: 1.
      [ i <= n ] whileTrue: [
        k:: karr at: i. v:: varr at: i. nextI:: i + 1.
        [ nextI <= n and: [ (outer valueCompare: (karr at: nextI) with: k) = 0 ] ] whileTrue: [
          v:: varr at: nextI. nextI:: nextI + 1 ].
        outCount:: outCount + 1.
        karr at: outCount put: k.
        varr at: outCount put: v.
        i:: nextI ].
      keys:: platform basicNew: Array indexable: outCount.
      vals:: platform basicNew: Array indexable: outCount.
      1 to: outCount do: [ :ii | keys at: ii put: (karr at: ii). vals at: ii put: (varr at: ii) ].
      d:: 0.
      1 to: outCount do: [ :ii |
        cd:: outer depthOf: (keys at: ii). cd > d ifTrue: [ d:: cd ].
        cd:: outer depthOf: (vals at: ii). cd > d ifTrue: [ d:: cd ] ].
      depth:: outer checkDepth: (1 + d).
      ^ self )
  ) : (
    public with: a = ( | k v |
      k:: platform basicNew: Array indexable: 1. v:: platform basicNew: Array indexable: 1.
      k at: 1 put: a key. v at: 1 put: a value.
      ^ self new setPairs: k values: v )
    public with: a with: b = ( | k v |
      k:: platform basicNew: Array indexable: 2. v:: platform basicNew: Array indexable: 2.
      k at: 1 put: a key. v at: 1 put: a value.
      k at: 2 put: b key. v at: 2 put: b value.
      ^ self new setPairs: k values: v )
    public with: a with: b with: c = ( | k v |
      k:: platform basicNew: Array indexable: 3. v:: platform basicNew: Array indexable: 3.
      k at: 1 put: a key. v at: 1 put: a value.
      k at: 2 put: b key. v at: 2 put: b value.
      k at: 3 put: c key. v at: 3 put: c value.
      ^ self new setPairs: k values: v )
    public with: a with: b with: c with: d = ( | k v |
      k:: platform basicNew: Array indexable: 4. v:: platform basicNew: Array indexable: 4.
      k at: 1 put: a key. v at: 1 put: a value.
      k at: 2 put: b key. v at: 2 put: b value.
      k at: 3 put: c key. v at: 3 put: c value.
      k at: 4 put: d key. v at: 4 put: d value.
      ^ self new setPairs: k values: v )
    public with: a with: b with: c with: d with: e = ( | k v |
      k:: platform basicNew: Array indexable: 5. v:: platform basicNew: Array indexable: 5.
      k at: 1 put: a key. v at: 1 put: a value.
      k at: 2 put: b key. v at: 2 put: b value.
      k at: 3 put: c key. v at: 3 put: c value.
      k at: 4 put: d key. v at: 4 put: d value.
      k at: 5 put: e key. v at: 5 put: e value.
      ^ self new setPairs: k values: v )
    (* Each element of `aList` is EITHER a 2-element algebra List (element 1 =
       key, element 2 = value) OR an Association (from `#k -> v`) — accept
       both. `isList` is a safe probe here (unlike an ad-hoc predicate on a
       foreign receiver): both accepted shapes are Kernel-nested classes that
       properly inherit Object's `isList` default, so this can never DNU. *)
    public fromPairs: aList = ( | n k v |
      n:: aList size.
      k:: platform basicNew: Array indexable: n.
      v:: platform basicNew: Array indexable: n.
      1 to: n do: [ :i | | e |
        e:: aList at: i.
        e isList
          ifTrue: [ k at: i put: (e at: 1). v at: i put: (e at: 2) ]
          ifFalse: [ k at: i put: e key. v at: i put: e value ] ].
      ^ self new setPairs: k values: v )
  )

  (* Immutable algebra record (Milestone B Task 9): a Symbol `tag` plus a Map
     of `fields` — the tagged-variant counterpart to Map's plain associative
     shape. Same immutable, depth-cached-at-construction, `outer`-link-to-
     module-helpers shape as List/Map. Construction validates `tag` (must be
     a genuine Symbol — checked via `isSymbol`, which only a builtin Symbol
     answers true for; every other receiver, including a heap value, falls to
     Object's `isSymbol = (^false)`) and `fields` (must be a heap Map — checked
     via `isMap`, the nsl override only Map has), else crashes `not a value`
     (the same frozen string `checkValue:` uses, via `self error:`). `depth`
     is `fields`' own depth plus one (tag is a Symbol, depth 0, so it never
     drives the fold) — computed once at construction and cached, same as
     List/Map's `valueDepth`. *)
  public class Record = ( | private tag private fields private depth | ) (
    public tag = ( ^ tag )
    public fields = ( ^ fields )
    public at: aKey ifAbsent: aBlock = ( ^ fields at: aKey ifAbsent: aBlock )
    public isRecord = ( ^ true )
    public isValue = ( ^ true )
    public valueRank = ( ^ 9 )
    public valueDepth = ( ^ depth )
    (* Typed structural equality/hash — same guard idiom as List/Map (Tasks
       7/8): never send an ad-hoc predicate to `other`, only the native rank
       oracle via `isValueObject:` (a foreign non-value receiver, or a value
       of a different rank, safely answers false without risking a DNU
       crash). *)
    public = other = (
      (outer isValueObject: other) ifFalse: [ ^ false ].
      ^ outer value: self equals: other
    )
    public hash = ( ^ outer valueHashOf: self )
    public setTag: aTag fields: aMap = (
      aTag isSymbol ifFalse: [ ^ self error: 'not a value' ].
      aMap isMap ifFalse: [ ^ self error: 'not a value' ].
      tag:: aTag.
      fields:: aMap.
      depth:: outer checkDepth: (1 + aMap valueDepth).
      ^ self )
  ) : (
    public tag: aTag fields: aMap = ( ^ self new setTag: aTag fields: aMap )
    public tag: aTag with: a = ( ^ self tag: aTag fields: (Map with: a) )
    public tag: aTag with: a with: b = ( ^ self tag: aTag fields: (Map with: a with: b) )
    public tag: aTag with: a with: b with: c = ( ^ self tag: aTag fields: (Map with: a with: b with: c) )
    public tag: aTag with: a with: b with: c with: d = ( ^ self tag: aTag fields: (Map with: a with: b with: c with: d) )
    public tag: aTag with: a with: b with: c with: d with: e = ( ^ self tag: aTag fields: (Map with: a with: b with: c with: d with: e) )
  )

  (* Shared multi-byte read protocol (Milestone B Task 10) — composes on the
     concrete class's u8At:/byteSize. LE is the default (u16At:), BE spelled
     out (u16BeAt:) — per the staged bytes.ns naming decision. *)
  class BytesReadProtocol = () (
    public u16At: i   = ( ^ (self u8At: i) + ((self u8At: i + 1) << 8) )
    public u16BeAt: i = ( ^ ((self u8At: i) << 8) + (self u8At: i + 1) )
  ) : ( )

  (* Mutable workbench — NOT a value (no isValue override -> Object false).
     Storage = private raw slot holding the Task-3 RawBytes C object; ALL
     bounds/range crashes come from the C layer (frozen strings), so the
     accessors here are thin forwarders — no nsl-side bounds/range checks
     (superseded staged-design decision; see Task 10 brief). *)
  public class ByteArray = BytesReadProtocol ( | private raw | ) (
    public byteSize = ( ^ raw size )
    public u8At: i = ( ^ raw at: i )
    public u8At: i put: v = ( raw at: i put: v. ^ v )
    public u16At: i put: v = ( self u8At: i put: (v bitAnd: 255). self u8At: i + 1 put: ((v >> 8) bitAnd: 255). ^ v )
    public u16BeAt: i put: v = ( self u8At: i put: ((v >> 8) bitAnd: 255). self u8At: i + 1 put: (v bitAnd: 255). ^ v )
    public freeze = ( ^ Bytes overRaw: (platform freezeBytes: raw size: raw size) )
    public setRaw: r = ( raw:: r. ^ self )
  ) : (
    public new: n = ( ^ self new setRaw: (platform basicNewBytes: n) )
    public fromList: aList = ( | r | r:: self new: aList size. 1 to: aList size do: [ :i | r u8At: i put: (aList at: i) ]. ^ r )
    (* Inverse of Bytes>>printHex (Rung 3 Task 5, hardened Task 6): parse an
       even-length lower/upper-case hex String to an IMMUTABLE Bytes via this
       mutable workbench + `freeze` copy. Lives here (not on the unexposed Bytes
       class) because `platform ByteArray` is the reachable byte-builder accessor
       — the Task-6 decode reject fixtures are its first consumers. HARDENED:
       rejects odd-length input and any non-hex character (a silent nibble-drop
       would corrupt a reject fixture). *)
    public fromHex: aString = ( | len n ba |
      len:: aString size.
      (len \\ 2) = 0 ifFalse: [ ^ self error: 'odd-length hex' ].
      n:: len // 2.
      ba:: self new: n.
      1 to: n do: [ :i |
        ba u8At: i put: ((self hexDigit: (aString at: (i * 2) - 1)) * 16
                        + (self hexDigit: (aString at: i * 2))) ].
      ^ ba freeze )
    (* Single-hex-digit decode: '0'..'9' = 48..57, 'A'..'F' = 65..70,
       'a'..'f' = 97..102 — anything else crashes rather than mis-decoding. *)
    hexDigit: ch = (
      (ch >= 48 and: [ ch <= 57 ])  ifTrue: [ ^ ch - 48 ].
      (ch >= 65 and: [ ch <= 70 ])  ifTrue: [ ^ ch - 55 ].
      (ch >= 97 and: [ ch <= 102 ]) ifTrue: [ ^ ch - 87 ].
      ^ self error: 'invalid hex digit' )
  )

  (* Immutable algebra value, rank 5 (Milestone B Task 10). Read protocol
     only — write selectors DO NOT EXIST here (immutability by construction;
     a write attempt is a DNU, no frozen string — design §7). Reached only
     via ByteArray>>freeze; no module accessor exposes this class to app
     code (keeping the class-side constructor unreachable keeps app code
     from minting a Bytes without going through a real freeze copy). *)
  class Bytes = BytesReadProtocol ( | private raw | ) (
    public byteSize = ( ^ raw size )
    public u8At: i = ( ^ raw at: i )
    public freeze = ( ^ self )
    public asByteArray = ( | r | r:: ByteArray new: self byteSize. 1 to: self byteSize do: [ :i | r u8At: i put: (self u8At: i) ]. ^ r )
    public isBytes = ( ^ true )
    public isValue = ( ^ true )
    public valueRank = ( ^ 5 )
    public valueDepth = ( ^ 0 )
    public = other = ( (outer isValueObject: other) ifFalse: [ ^ false ]. ^ outer value: self equals: other )
    public hash = ( ^ outer valueHashOf: self )
    (* Wire-type textual form (Rung 3 Task 5): lowercase hex, no separators, two
       digits per byte. Built as a byte Array of ASCII hex then interned to a
       String in one `platform string:` — the natural rendering for a Bytes on
       the CBOR wire seam and for golden-hex fixtures. *)
    public printHex = ( | n arr j b hi lo |
      n:: self byteSize.
      arr:: platform basicNew: Array indexable: n * 2.
      j:: 0.
      1 to: n do: [ :i |
        b:: self u8At: i.
        hi:: (b >> 4) bitAnd: 15.
        lo:: b bitAnd: 15.
        j:: j + 1. arr at: j put: (hi < 10 ifTrue: [ 48 + hi ] ifFalse: [ 87 + hi ]).
        j:: j + 1. arr at: j put: (lo < 10 ifTrue: [ 48 + lo ] ifFalse: [ 87 + lo ]) ].
      ^ platform string: arr )
    public setRaw: r = ( raw:: r. ^ self )
    (* Module-internal (Rung 6 Layer 2): answer the underlying RawBytes leaf for
       the send prim to read. Non-public by convention only, like every other
       non-public kernel setter — this VM's access modifiers are not enforced
       (oevm#36); nothing stops a caller outside the module from reaching this.
       The leaf itself is mutation-capable (RawBytes understands at:put:), so
       this is not an immutability boundary; it works only because the single
       caller, Socket>>sendTo:, is relied upon to treat it as read-only (memcpy
       out to the socket). *)
    public rawLeaf = ( ^ raw )
  ) : (
    public overRaw: r = ( ^ self new setRaw: r )
  )

  (* tuvm#72: a PACKED byte accumulator for the CBOR encoder. The encoder used to
     accumulate into an OrderedCollection of byte SMIs, which costs FOUR bytes per
     byte (mutable Array slots — the RAM trap oevm-vm-memory-model warns about) and
     doubles its backing Array as it fills. On a WROOM-32 (49 KB arena) encoding a
     span-capture push, that doubling asked for a 1024-slot Array and killed the
     node outright:
         VM GC Error: Out of Memory (requested 4104, used 49152 of 49152) -> abort()
     — a hard abort, not a catchable condition, so nothing was logged and the node
     simply died mid-push. Holding the bytes packed cuts that ~4x, and matters most
     for encodeMap:, which holds a separate accumulator for EVERY key and value
     simultaneously before sorting them.

     `buf` IS THE RAW INDEXABLE (`platform basicNewBytes:`), NOT A ByteArray, AND THAT
     IS LOAD-BEARING — do not "tidy" it back to the wrapper (#163). `ByteArray>>u8At:`
     is `( ^ raw at: i )` and `u8At:put:` is `( raw at: i put: v. ^ v )`: one layer of
     nsl method over a prim, so every byte moved through the wrapper costs a frame
     push, a dispatch and a return that the prim underneath does not. That is not a
     guess — a per-method profile of one 259-byte encode counted 1014
     `ByteArray>>u8At:put:` activations and ZERO for the `at:put:` beneath it, which is
     what says the wrapper is the whole cost and the prim is free.
     Dropping the layer took a flat encode from 2322 activations to ~290 (8x) and the
     real 425 B push frame from 9624 to ~3400, with the emitted bytes unchanged.
     The wrapper's job is type discipline at the language surface; this buffer is
     private to Cbor (three construction sites, all in encode:), never escapes except
     through `frozenBytes`, and so has nothing to discipline.
     Measured in `docs/results/2026-08-09-cbor-encode-shape.md`.

     Deliberately minimal: only the selectors the codec actually sends (`add:`,
     `size`, `at:`, `do:`) exist, so this is a drop-in for the OrderedCollection it
     replaces and nothing else can start depending on it. *)
  class ByteBuilder = ( | private buf ::= platform basicNewBytes: 16. private count ::= 0. | ) (
    public size = ( ^ count )
    public at: i = ( ^ buf at: i )
    public add: b = (
      count = buf size ifTrue: [ self grow ].
      count:: count + 1.
      buf at: count put: b.
      ^ b )
    public do: aBlock = ( 1 to: count do: [ :i | aBlock value: (buf at: i) ]. ^ self )
    (* rete#477 spike: a builder that keeps its buffer across uses. *)
    public reserve: n = ( buf:: platform basicNewBytes: n. count:: 0. ^ self )
    public reset = ( count:: 0. ^ self )
    grow = ( | bigger |
      bigger:: platform basicNewBytes: buf size * 2.
      1 to: count do: [ :i | bigger at: i put: (buf at: i) ].
      buf:: bigger.
      ^ self )
    (* Exact-size immutable copy of the first `count` bytes: `buf` carries slack
       from the last doubling, and the size argument keeps it out of the value.
       ONE allocation of exactly `count` — it used to build an exact copy and then
       freeze that, two allocations of `count` live at once (rete#477). *)
    public frozenBytes = ( ^ Bytes overRaw: (platform freezeBytes: buf size: count) )
  ) : (
  )

  (* Rung 3 Task 5: the CBOR value codec — encode half. A module sibling of
     List/Map/Record; the recursive descent lives here in nsl and drops to the
     C leaf byte-primitives (`platform cborEncodeInt:`/`cborEncodeFloat:`) only
     for the int/float bytes that must be byte-identical across host and target
     (LargeInteger magnitude + IEEE shortest-form are unreachable from nsl,
     design §2.3). Everything else — container heads, symbol/string/bytes
     payloads, the deterministic RFC 8949 §4.2 bytewise map-key order, the
     depth bound (32) — is natural nsl here. `encode:` walks bottom-up into an
     OrderedCollection byte accumulator (byte SMIs), frozen to an immutable
     `Bytes` at the very end via ByteArray>>freeze; intermediate work stays in
     OrderedCollections. Value classification is `outer rankOf:` (the native
     `platform valueRank:` oracle with the heap-class `valueRank` fallback), so
     builtins and heap values dispatch uniformly. Determinism: the C leaves emit
     shortest-form ints/floats; container/tag/string heads are emitted
     shortest-form here (definite lengths only); map keys are re-sorted at emit
     time bytewise over their ENCODED key bytes (NOT the Map's stored
     valueCompare order — the two diverge when keys differ in encoded length).
     No float<->int coercion (the ranks dispatch to distinct leaves). A receiver
     `rankOf:` cannot classify fails `not a value`; over-deep nesting fails
     `message depth exceeded`. *)
  public class Cbor = () (
    (* rete#477: the outermost encode writes into the kernel's one scratch builder, so
       a frame no longer climbs 16..1024 B of fresh buffers. An encode that starts
       while another is running gets a fresh builder instead: the held loop encodes
       when a debugger stop lands inside an encode, and `rankOf:` can run app code.
       `ensure:` gives the scratch back on every exit, a raise included.
       14_cbor/07_reentrant_encode.nsl pins both. *)
    public encode: v = ( | acc |
      acc:: outer takeEncodeScratch.
      acc == nil ifTrue: [
        acc:: ByteBuilder new.
        self encode: v into: acc depth: 1.
        ^ acc frozenBytes ].
      ^ [ self encode: v into: acc depth: 1. acc frozenBytes ]
          ensure: [ outer releaseEncodeScratch ] )

    encode: v into: acc depth: d = ( | rank |
      d > 32 ifTrue: [ ^ self error: 'message depth exceeded' ].
      v == nil   ifTrue: [ acc add: 246. ^ self ].    (* 0xf6 *)
      v == true  ifTrue: [ acc add: 245. ^ self ].    (* 0xf5 *)
      v == false ifTrue: [ acc add: 244. ^ self ].    (* 0xf4 *)
      rank:: outer rankOf: v.
      rank = 2 ifTrue: [ ^ self appendFrag: (platform cborEncodeInt: v) into: acc ].   (* Integer -> major 0/1 (C leaf) *)
      rank = 3 ifTrue: [ ^ self appendFrag: (platform cborEncodeFloat: v) into: acc ]. (* Float -> major 7 (C leaf) *)
      rank = 4 ifTrue: [ ^ self encodeString: v into: acc ].                           (* String -> major 3 *)
      rank = 5 ifTrue: [ ^ self encodeBytes: v into: acc ].                            (* Bytes -> major 2 *)
      rank = 6 ifTrue: [ ^ self encodeSymbol: v into: acc ].                           (* Symbol -> tag 39 + text *)
      rank = 7 ifTrue: [ ^ self encodeList: v into: acc depth: d ].                    (* List -> major 4 *)
      rank = 8 ifTrue: [ ^ self encodeMap: v into: acc depth: d ].                     (* Map -> major 5, bytewise keys *)
      rank = 9 ifTrue: [ ^ self encodeRecord: v into: acc depth: d ].                  (* Record -> tag 27 + [tag, fields] *)
      ^ self error: 'not a value' )

    (* CBOR head for (major m, argument n) shortest-form, definite length. Reused
       for container/string/bytes lengths AND for tag numbers (major 6, arg =
       tag) — tags share the head varint encoding. n is a small SMI here. *)
    emitHead: m len: n into: acc = ( | mt |
      mt:: m * 32.
      n < 24 ifTrue: [ acc add: mt + n. ^ self ].
      n < 256 ifTrue: [ acc add: mt + 24. acc add: n. ^ self ].
      n < 65536 ifTrue: [ acc add: mt + 25.
        acc add: ((n >> 8) bitAnd: 255). acc add: (n bitAnd: 255). ^ self ].
      n < 4294967296 ifTrue: [ acc add: mt + 26.
        acc add: ((n >> 24) bitAnd: 255). acc add: ((n >> 16) bitAnd: 255).
        acc add: ((n >> 8) bitAnd: 255). acc add: (n bitAnd: 255). ^ self ].
      acc add: mt + 27.
      acc add: ((n >> 56) bitAnd: 255). acc add: ((n >> 48) bitAnd: 255).
      acc add: ((n >> 40) bitAnd: 255). acc add: ((n >> 32) bitAnd: 255).
      acc add: ((n >> 24) bitAnd: 255). acc add: ((n >> 16) bitAnd: 255).
      acc add: ((n >> 8) bitAnd: 255). acc add: (n bitAnd: 255).
      ^ self )

    (* Append a C-leaf RawBytes fragment (int/float bytes) byte-by-byte; RawBytes
       answers `size`/`at:` (byte SMIs), NOT basicSize/basicAt:. *)
    appendFrag: frag into: acc = ( 1 to: frag size do: [ :i | acc add: (frag at: i) ]. ^ self )

    encodeString: v into: acc = ( | n |
      n:: v size.                       (* String size = byte count; at: = byte SMI *)
      self emitHead: 3 len: n into: acc.
      1 to: n do: [ :i | acc add: (v at: i) ].
      ^ self )

    encodeBytes: v into: acc = ( | n |
      n:: v byteSize.
      self emitHead: 2 len: n into: acc.
      1 to: n do: [ :i | acc add: (v u8At: i) ].
      ^ self )

    (* Symbol -> tag 39 (identifier) wrapping its UTF-8 text as major-3. Read
       straight off the Symbol via at:/size (rete#205). This used to go through
       `printString` and drop the leading '#', because a Symbol had no at:/size
       fast path in dispatch.c — which cost a C-heap malloc and a dead String per
       encoded Symbol, one of only TWO C-heap allocators on the whole node
       (docs/results/2026-08-12-allocation-attribution-c6.md §5.3). The emitted
       bytes are unchanged: printString's payload was always '#' + name, and the
       '#' was always skipped. *)
    encodeSymbol: v into: acc = ( | n |
      self emitHead: 6 len: 39 into: acc.    (* tag 39 = 0xd827 *)
      n:: v size.
      self emitHead: 3 len: n into: acc.
      1 to: n do: [ :i | acc add: (v at: i) ].
      ^ self )

    encodeList: v into: acc depth: d = (
      self emitHead: 4 len: v size into: acc.
      v do: [ :e | self encode: e into: acc depth: d + 1 ].
      ^ self )

    (* Map -> major 5, keys in RFC 8949 §4.2 bytewise order over ENCODED key
       bytes. The Map iterates in valueCompare order, which is NOT bytewise (they
       diverge when keys differ in encoded length), so the order can only be known
       after the keys are encoded.

       ONLY THE KEYS ARE BUFFERED; THE VALUES ARE STREAMED (#163). The sort needs
       encoded KEY bytes and nothing else — `sortPairsBytewise:` permutes the two
       collections in lockstep and never inspects the second — so the second one
       carries the value OBJECTS and each is encoded straight into `acc` at emit
       time, in sorted order, at the depth it would have had anyway. Encoding is a
       pure function of (value, depth), so the emitted bytes are identical to
       encoding it earlier into a buffer and copying that buffer out.

       This is the difference between buffering a Symbol (4-10 bytes) and
       buffering a whole nested record. It was measured as ~21% of a real 425 B
       push frame's activations in `appendColl:` alone, but the older and worse
       cost is memory: holding an accumulator for every key AND every value
       simultaneously is what took a WROOM-32 out with an uncatchable
       `VM GC Error: Out of Memory -> abort()` on a 949-byte span push. Half of
       that peak is now gone, and the surviving half is the small half.

       A depth violation now raises with earlier entries already written into
       `acc`, where before `acc` was untouched. Not observable: the raise
       propagates out of `encode:` and `acc` is discarded either way. *)
    encodeMap: v into: acc depth: d = ( | keyEncs vals n |
      keyEncs:: OrderedCollection new.
      vals::    OrderedCollection new.
      v keysAndValuesDo: [ :k :val |
        self encodeEntry: k value: val keys: keyEncs vals: vals depth: d ].
      n:: keyEncs size.
      self sortPairsBytewise: keyEncs vals: vals.
      self emitHead: 5 len: n into: acc.
      1 to: n do: [ :i |
        self appendColl: (keyEncs at: i) into: acc.
        self encode: (vals at: i) into: acc depth: d + 1 ].
      ^ self )

    (* One map entry -> its encoded KEY bytes and its value UNENCODED, appended in
       lockstep to keyEncs/vals (the per-entry block-local lives in this method
       frame, keeping the keysAndValuesDo: block a single send). *)
    encodeEntry: k value: val keys: keyEncs vals: vals depth: d = ( | kb |
      kb:: ByteBuilder new.
      self encode: k into: kb depth: d + 1.
      keyEncs add: kb.
      vals add: val.
      ^ self )

    (* Record -> tag 27 (language object) wrapping a 2-element array [tag, fields]
       where tag is the Symbol (itself tag 39) and fields is the Map. *)
    encodeRecord: v into: acc depth: d = (
      self emitHead: 6 len: 27 into: acc.    (* tag 27 = 0xd81b *)
      self emitHead: 4 len: 2 into: acc.     (* array(2) = 0x82 *)
      self encode: v tag    into: acc depth: d + 1.
      self encode: v fields into: acc depth: d + 1.
      ^ self )

    appendColl: src into: acc = ( src do: [ :b | acc add: b ]. ^ self )

    (* Stable insertion sort of (keyEncs, vals) pairs in lockstep, keyed on the
       encoded key bytes via compareBytes:with: — the RFC 8949 bytewise rule.
       `vals` is carried, never inspected: it holds value OBJECTS since #163, and
       held their encodings before, and this method cannot tell the difference. *)
    sortPairsBytewise: keyEncs vals: vals = ( | n j kk vv |
      n:: keyEncs size.
      2 to: n do: [ :ii |
        kk:: keyEncs at: ii. vv:: vals at: ii.
        j:: ii - 1.
        [ j >= 1 and: [ (self compareBytes: (keyEncs at: j) with: kk) > 0 ] ] whileTrue: [
          keyEncs at: j + 1 put: (keyEncs at: j).
          vals at: j + 1 put: (vals at: j).
          j:: j - 1 ].
        keyEncs at: j + 1 put: kk.
        vals at: j + 1 put: vv ].
      ^ self )

    (* Bytewise total order over two byte OrderedCollections: shared-prefix bytes
       decide first, an exact-prefix tie falls to shorter-is-less. *)
    compareBytes: a with: b = ( | n m lim ab bb |
      n:: a size. m:: b size. lim:: n < m ifTrue: [ n ] ifFalse: [ m ].
      1 to: lim do: [ :i |
        ab:: a at: i. bb:: b at: i.
        ab < bb ifTrue: [ ^ -1 ].
        bb < ab ifTrue: [ ^ 1 ] ].
      n < m ifTrue: [ ^ -1 ]. n > m ifTrue: [ ^ 1 ]. ^ 0 )

    (* ==== Rung 3 Task 6: the CBOR value codec — DECODE half ====
       `decode: aBytes ifInvalid: aBlock` is TOTAL: any byte sequence yields
       either one valid algebra message OR exactly one error routed to aBlock
       with its text (errors.md vocabulary), never a partial parse / pass-through.
       The recursive descent (`parse:at:depth:`) lives here in nsl and drops to
       the C decode leaves (cborReadHead:/cborIntFromMajor:/cborReadFloat:/
       utf8Valid:, and asSymbol: for tag 39) for the byte work that must be
       byte-identical across host and target. Totality is via the Milestone-E
       exception mechanism: any violation raises `self error: msg tag: #cborInvalid`
       (helper `failDecode:`) and the outer `[...] on: [pred] do: [handler]` routes
       the caught text to aBlock. NO `^` (non-local return) appears inside the
       protected / predicate / handler blocks (rejected by this VM — see
       12_caret_in_handler_rejected); the handler evaluates `aBlock value: text`
       and returns normally, and the outer `^` is on the whole on:do: expression.

       INDEX BASE: the C decode leaves are 0-BASED (cborReadHead:at:0 reads the
       first byte and returns the next index 0-based), so this walk threads a
       0-based index `i` and the raw byte at 0-based i is `b at: i + 1` (nsl
       String at: is 1-based). The input `aBytes` (a Bytes/String algebra value)
       is copied ONCE into a raw String `b` (`platform string:`) so the leaves
       see the {length,bytes[]} layout they require (a Bytes kernel object wraps
       its raw store in an ivar and is NOT layout-compatible with struct String).
       After a full parse the walk asserts ALL bytes were consumed (nextIndex =
       byteSize), else `not a value`. Depth is threaded and bounded at 32 (the
       walk trips FIRST — strictly before any container constructor's own
       checkDepth: — so a constructor never raises the UNTAGGED depth error that
       on:do: would not catch; decoded elements are all valid algebra values so
       checkValue: likewise never fires untagged). *)
    public decode: aBytes ifInvalid: aBlock = ( | b n |
      n:: aBytes byteSize.
      b:: self rawBytesOf: aBytes size: n.
      ^ [ | r |
          r:: self parse: b at: 0 depth: 1.
          (r at: 2) = n ifFalse: [ self failDecode: 'not a value' ].
          r at: 1 ]
        on: [ :e | e tag = #cborInvalid ]
        do: [ :e | aBlock value: (e at: #text ifAbsent: [ 'not a value' ]) ] )

    (* Copy the input's bytes into a fresh raw String so the C leaves see a
       {length, inline bytes} layout (a Bytes wrapper is not layout-compatible). *)
    rawBytesOf: aBytes size: n = ( | arr |
      arr:: platform basicNew: Array indexable: n.
      1 to: n do: [ :i | arr at: i put: (aBytes u8At: i) ].
      ^ platform string: arr )

    failDecode: s = ( ^ self error: s tag: #cborInvalid )

    (* Every parse result is this UNIFORM Array-classed 2-elt {value, nextIdx}
       (built via basicNew:indexable:, so it answers `at:`) — NOT `Array with:`
       (no such selector here) and NOT a raw C-leaf indexable (those answer only
       `basicAt:`). The C-leaf head/float arrays ARE read with `basicAt:` (they
       carry a class-less vtable, like spaceDequeue's events). Sentinel tests use
       identity `==` against -1: the success value is a class-less indexable that
       does not understand `=`. *)
    result: v next: idx = ( | a |
      a:: platform basicNew: Array indexable: 2.
      a at: 1 put: v. a at: 2 put: idx. ^ a )

    (* Parse ONE value at 0-based index i; answers {value, nextIdx} (nextIdx
       0-based) or raises #cborInvalid. The simple values (nil/bool/float/undefined
       = major 7 bytes) are peeked directly since cborReadHead: only serves majors
       0..6; everything else goes through the head leaf. *)
    parse: b at: i depth: d = ( | first h major arg nxt |
      d > 32 ifTrue: [ ^ self failDecode: 'message depth exceeded' ].
      i >= (b size) ifTrue: [ ^ self failDecode: 'not a value' ].     (* truncated *)
      first:: b at: i + 1.
      first = 246 ifTrue: [ ^ self result: nil   next: i + 1 ].       (* 0xf6 nil *)
      first = 245 ifTrue: [ ^ self result: true  next: i + 1 ].       (* 0xf5 true *)
      first = 244 ifTrue: [ ^ self result: false next: i + 1 ].       (* 0xf4 false *)
      first = 247 ifTrue: [ ^ self failDecode: 'not a value' ].       (* 0xf7 undefined *)
      (first = 249 or: [ first = 250 or: [ first = 251 ] ]) ifTrue: [ (* f16/f32/f64 *)
        ^ self floatFrom: b at: i ].
      h:: platform cborReadHead: b at: i.
      h == -1 ifTrue: [ ^ self failDecode: 'not a value' ].           (* truncated / indefinite / reserved *)
      major:: h basicAt: 1. arg:: h basicAt: 2. nxt:: h basicAt: 3.
      major = 0 ifTrue: [ ^ self result: (self intFrom: 0 arg: arg) next: nxt ].
      major = 1 ifTrue: [ ^ self result: (self intFrom: 1 arg: arg) next: nxt ].
      major = 2 ifTrue: [ ^ self bytesFrom: b at: nxt len: arg ].
      major = 3 ifTrue: [ ^ self stringFrom: b at: nxt len: arg ].
      major = 4 ifTrue: [ ^ self listFrom: b at: nxt count: arg depth: d ].
      major = 5 ifTrue: [ ^ self mapFrom: b at: nxt count: arg depth: d ].
      major = 6 ifTrue: [ ^ self tagFrom: b at: nxt tag: arg depth: d ].
      ^ self failDecode: 'not a value' )                              (* major 7 non-simple *)

    intFrom: m arg: arg = ( | r |
      r:: platform cborIntFromMajor: m arg: arg.
      r == nil ifTrue: [ ^ self failDecode: 'integer out of range' ].  (* -2^64 *)
      ^ r )

    (* A decoded NaN is a spec §5 totality hole: it is a genuine Float object but
       NOT a valid algebra value (`platform valueRank:` answers -1 for NaN,
       kernel.nsl rankOf: would then DNU-send `valueRank` to a builtin, and even
       `checkValue:` would raise the UNTAGGED #error the handler can't catch).
       Reject it HERE, guarded by the C oracle directly (NOT rankOf:/checkValue:,
       which re-trigger the same DNU): valueRank: = 3 for a real Float (incl.
       +/-Infinity, which are legal and round-trip), -1 for NaN. Mirrors the
       encode side, which also maps NaN -> 'not a value'. *)
    floatFrom: b at: i = ( | fr fl |
      fr:: platform cborReadFloat: b at: i.
      fr == -1 ifTrue: [ ^ self failDecode: 'not a value' ].
      fl:: fr basicAt: 1.
      (platform valueRank: fl) = 3 ifFalse: [ ^ self failDecode: 'not a value' ].
      ^ self result: fl next: (fr basicAt: 2) )

    (* major 2: definite-length byte string -> algebra Bytes (ByteArray>>freeze).
       A length running past the buffer (incl. an 8-byte LargeInteger length) is
       caught by the bounds test BEFORE any allocation. *)
    bytesFrom: b at: i len: n = ( | ba end |
      end:: i + n.
      end > (b size) ifTrue: [ ^ self failDecode: 'not a value' ].
      ba:: ByteArray new: n.
      1 to: n do: [ :k | ba u8At: k put: (b at: i + k) ].
      ^ self result: ba freeze next: end )

    (* major 3: definite-length text -> re-validated UTF-8 String. *)
    stringFrom: b at: i len: n = ( | arr end s |
      end:: i + n.
      end > (b size) ifTrue: [ ^ self failDecode: 'not a value' ].
      arr:: platform basicNew: Array indexable: n.
      1 to: n do: [ :k | arr at: k put: (b at: i + k) ].
      s:: platform string: arr.
      (platform utf8Valid: s) ifFalse: [ ^ self failDecode: 'invalid utf-8' ].
      ^ self result: s next: end )

    (* major 4: definite-length array -> List. A hostile over-large count cannot
       loop unbounded: each element parse advances into the finite buffer and the
       first read past the end fails 'not a value'. *)
    listFrom: b at: i count: n depth: d = ( | items idx pr |
      items:: OrderedCollection new.
      idx:: i.
      1 to: n do: [ :k |
        pr:: self parse: b at: idx depth: d + 1.
        items add: (pr at: 1).
        idx:: pr at: 2 ].
      ^ self result: (List fromCollection: items) next: idx )

    (* major 5: definite-length map -> Map. Duplicate keys are stricter than the
       Map constructor's last-wins: each freshly-decoded key is checked (algebra
       `=`) against those already collected and rejected 'not a value' BEFORE
       construction (design §5). *)
    mapFrom: b at: i count: n depth: d = ( | keys vals idx kp vp k v pairs |
      keys:: OrderedCollection new.
      vals:: OrderedCollection new.
      idx:: i.
      1 to: n do: [ :c |
        kp:: self parse: b at: idx depth: d + 1.
        k:: kp at: 1. idx:: kp at: 2.
        self checkNoDupKey: k in: keys.
        vp:: self parse: b at: idx depth: d + 1.
        v:: vp at: 1. idx:: vp at: 2.
        keys add: k. vals add: v ].
      pairs:: OrderedCollection new.
      1 to: keys size do: [ :c | pairs add: (List with: (keys at: c) with: (vals at: c)) ].
      ^ self result: (Map fromPairs: pairs) next: idx )

    (* No `^` inside a non-inlined (`do:`) block — use a found flag over an
       inlined `to:do:`, mirroring `anySatisfy:`. *)
    checkNoDupKey: k in: keys = ( | dup |
      dup:: false.
      1 to: keys size do: [ :c | (dup not and: [ (keys at: c) = k ]) ifTrue: [ dup:: true ] ].
      dup ifTrue: [ ^ self failDecode: 'not a value' ].
      ^ self )

    (* major 6: tags. 39 = identifier -> Symbol; 27 = language object -> Record;
       2/3 = bignum -> the distinct 'integer out of range'; anything else closed
       out as 'not a value'. `tag` may be a LargeInteger for huge tag numbers —
       the `=` probes below safely answer false. *)
    tagFrom: b at: i tag: tag depth: d = (
      tag = 39 ifTrue: [ ^ self symbolTagFrom: b at: i depth: d ].
      tag = 27 ifTrue: [ ^ self recordTagFrom: b at: i depth: d ].
      (tag = 2 or: [ tag = 3 ]) ifTrue: [ ^ self failDecode: 'integer out of range' ].
      ^ self failDecode: 'not a value' )

    (* tag 39 wraps a major-3 text; the text must be a String (rank 4) -> a
       genuine Symbol via the C leaf. A symbol is a leaf, so the inner text is
       parsed at the SAME depth (no increment), matching the encode side (which
       emits tag 39 + text without recursing through the depth-counted walk). *)
    symbolTagFrom: b at: i depth: d = ( | inner s |
      inner:: self parse: b at: i depth: d.
      s:: inner at: 1.
      (outer rankOf: s) = 4 ifFalse: [ ^ self failDecode: 'not a value' ].
      ^ self result: (platform asSymbol: s) next: (inner at: 2) )

    (* tag 27 wraps a 2-element array [tagSymbol, fieldsMap]. Validate the head is
       exactly array(2), then that element 1 is a Symbol (rank 6) and element 2 a
       Map (rank 8) BEFORE `Record tag:fields:` (whose own isSymbol/isMap failures
       raise the UNTAGGED 'not a value' that on:do: would not catch). *)
    recordTagFrom: b at: i depth: d = ( | ah idx tp fp tg fl |
      ah:: platform cborReadHead: b at: i.
      ah == -1 ifTrue: [ ^ self failDecode: 'not a value' ].
      (ah basicAt: 1) = 4 ifFalse: [ ^ self failDecode: 'not a value' ].
      (ah basicAt: 2) = 2 ifFalse: [ ^ self failDecode: 'not a value' ].
      idx:: ah basicAt: 3.
      tp:: self parse: b at: idx depth: d + 1.
      tg:: tp at: 1. idx:: tp at: 2.
      (outer rankOf: tg) = 6 ifFalse: [ ^ self failDecode: 'not a value' ].
      fp:: self parse: b at: idx depth: d + 1.
      fl:: fp at: 1. idx:: fp at: 2.
      (outer rankOf: fl) = 8 ifFalse: [ ^ self failDecode: 'not a value' ].
      ^ self result: (Record tag: tg fields: fl) next: idx )
  ) : (
  )

  class HeapStats = ( | private heapSize private liveBytes private highWater private largestFreeBlock private gcCycles | ) (
    (* A read-only snapshot of GC heap telemetry (src/gc.c oevm_heap_stats),
       surfaced by the native `platform heapStats` leaf (prim 104) as a 5-element
       Array in field order. Construct via the class-side `fromList:`. *)
    public heapSize         = ( ^ heapSize )
    public liveBytes        = ( ^ liveBytes )
    public highWater        = ( ^ highWater )
    public largestFreeBlock = ( ^ largestFreeBlock )
    public gcCycles         = ( ^ gcCycles )
    public setFromList: a = (
      (* `platform heapStats` answers a raw IndexableVtable Array (like udp
         basicReceive / cborReadHead), so read slots with basicAt:, not the
         Array-class at: — the prim receiver does not carry the Array vtable. *)
      heapSize:: a basicAt: 1. liveBytes:: a basicAt: 2. highWater:: a basicAt: 3.
      largestFreeBlock:: a basicAt: 4. gcCycles:: a basicAt: 5. ^ self )
    public printString = (
      ^ 'live ', liveBytes printString, ' / hw ', highWater printString,
        ' / free ', largestFreeBlock printString, ' / gc ', gcCycles printString,
        ' / size ', heapSize printString )
  ) : (
    public fromList: a = ( ^ self new setFromList: a )
  )

  class CHeapStats = ( | private outBytes private outHigh private allocs private frees private fails | ) (
    (* rete#190: a read-only snapshot of C-allocation accounting (src/gc.c
       oevm_cheap_stats), surfaced by the native `platform cheapStats` leaf
       (prim 152) as a 5-element Array in field order. Construct via the
       class-side `fromList:`. This is the C heap — the GC arena is HeapStats. *)
    public outBytes = ( ^ outBytes )
    public outHigh  = ( ^ outHigh )
    public allocs   = ( ^ allocs )
    public frees    = ( ^ frees )
    public fails    = ( ^ fails )
    public setFromList: a = (
      (* raw IndexableVtable Array, so basicAt: — the HeapStats precedent *)
      outBytes:: a basicAt: 1. outHigh:: a basicAt: 2. allocs:: a basicAt: 3.
      frees:: a basicAt: 4. fails:: a basicAt: 5. ^ self )
    public printString = (
      ^ 'out ', outBytes printString, ' / hw ', outHigh printString,
        ' / a ', allocs printString, ' / f ', frees printString,
        ' / fail ', fails printString )
  ) : (
    public fromList: a = ( ^ self new setFromList: a )
  )

  public class Spans = ( | private names private fails | ) (
    (* tuvm#61: named access to the C span slots (prims 118-121). The C side is
       NAMELESS — slots are integers 0..N-1 — exactly as the timer seam carries
       only a token and keeps the channel and the message in nsl. This class owns
       the name<->slot table and the per-slot failure counts, so no name string
       ever lands in the device's DRAM.

       register: is called ONCE per name at setup and answers the slot index; the
       caller HOLDS that index and passes it to begin:/end:. Nothing on a measured
       path may do a name lookup, because a lookup is a send and an allocation and
       this code runs inside the very thing it is measuring.

       State is lazily initialised rather than in a class-side `new` override —
       `ThermalView new` is the precedent (a plain `new`, instance variables
       starting nil), and it avoids depending on `super new` resolving in
       class-side context, which this kernel does nowhere else. *)
    (* The first two slots are RESERVED for the C-owned spans (src/span.h's
       SPAN_SLOT_HTTP_QUEUE and SPAN_SLOT_EGRESS), which http_core.c stamps itself
       so that no node can ship an uninstrumented HTTP path. Seeding their names
       here is what keeps register: — which hands out the next free index — from
       ever colliding with them: it starts at 2 by construction, with no ceiling
       arithmetic and no constant duplicated out of the C header. It is also why
       they appear in a rendered latency table like any other span: C owns those two
       indices, nsl still owns every name. *)
    ensureTables = (
      names isNil ifTrue: [
        names:: OrderedCollection new.
        fails:: OrderedCollection new.
        names add: #httpQueue. fails add: 0.       (* slot 0 — accept -> take   *)
        names add: #egress.    fails add: 0 ].     (* slot 1 — the chunk writes *)
      ^ self )

    (* Named access to the reserved pair, for a caller that wants to read or
       annotate one without re-deriving the index. register: answers the same two,
       being idempotent by name. *)
    public httpQueueSlot = ( self ensureTables. ^ 0 )
    public egressSlot    = ( self ensureTables. ^ 1 )

    public register: aName = (
      | i n |
      self ensureTables.
      (* Idempotent: registering the same name twice answers the SAME slot, so a
         re-entered setup path cannot silently consume the slot budget. *)
      i:: 1. n:: names size.
      [ i <= n ] whileTrue: [
        ((names at: i) = aName) ifTrue: [ ^ i - 1 ].
        i:: i + 1 ].
      names add: aName.
      fails add: 0.
      ^ names size - 1 )

    public slotCount = ( self ensureTables. ^ names size )
    public nameAt: slot = ( ^ names at: slot + 1 )

    (* tuvm#107: the path segment for this slot's sibling cell at
       diag/spans/<span>. The conversion lives HERE, in one place, because
       SpanCapture writes the cell and every reader derives the same string to
       find it — two copies of this rule are two ways for them to disagree.

       rete#205: this used to read the name out of `printString` and skip the
       leading '#', which built a String and a C-heap block per call. A Symbol
       now answers at:/size over its name directly, so there is no '#' to strip
       and no scratch String to make. Same output. *)
    public pathAt: slot = (
      | s ws |
      s:: self nameAt: slot.
      ws:: WriteStream new.
      1 to: s size do: [ :i | ws nextPut: (s at: i) ].
      ^ ws contents )

    (* tuvm#72: which side STAMPS this span. DERIVED from the reserved pair rather
       than kept as a table, so it cannot drift from the seam: slots 0 and 1 are
       the C-owned spans http_core.c stamps itself (ensureTables seeds them), and
       every other slot was handed out by register: from nsl. Answers a String
       because its only consumer is a rendered table; the wire record is
       deliberately NOT given a lang field — recordAt:'s schema is size-capped
       (porta's 256 B value law) and this is derivable by any reader. *)
    public langAt: slot = ( ^ (slot < 2) ifTrue: [ 'C' ] ifFalse: [ 'nsl' ] )

    public begin: slot = ( platform spanBegin: slot. ^ self )
    public end:   slot = ( platform spanEnd: slot. ^ self )
    public recordSlot: slot us: n = ( platform spanRecord: slot us: n. ^ self )
    (* Answers the raw IndexableVtable Array the prim builds — read with basicAt:,
       the heapStats precedent (the prim receiver carries no Array vtable).
       Field order mirrors src/span.h's SPAN_STAT_*, 1-based here:
         1 n, 2 minUs, 3 maxUs, 4 sumUsLo, 5 sumUsHi, 6..11 buckets b0..b5 *)
    public statsAt: slot = ( ^ platform spanStats: slot )

    (* A failed job produces NO span sample, so without this a failure would
       silently improve the percentiles. Counted in nsl because a failure is an
       app-level concept the C seam cannot detect. *)
    public noteFailure: slot = (
      fails at: slot + 1 put: (fails at: slot + 1) + 1. ^ self )
    public failuresAt: slot = ( ^ fails at: slot + 1 )

    (* tuvm#72: clear the accumulator for a bounded capture window. BOTH halves —
       the C sample table via the prim, and the nsl-side failure counts above,
       which C cannot see. Clearing only the C half would publish failures
       cumulative-since-boot beside windowed samples: a wrong table that looks
       right. The name<->slot table is deliberately NOT cleared — every caller
       holds a slot index handed out by register:, and moving those indices under
       them would silently mis-attribute every subsequent sample. *)
    public resetAll = (
      | i n |
      self ensureTables.
      platform spanReset.
      i:: 1. n:: fails size.
      [ i <= n ] whileTrue: [ fails at: i put: 0. i:: i + 1 ].
      ^ self )

    (* --- design 4.1/4.2: percentiles as DECADES, gated on sample count --- *)

    (* A p95 computed from too few samples is noise wearing a precise-looking
       label: at n = 20 it is simply the 19th value, and one unlucky retransmit
       relocates it wholesale. 200 is the floor below which nothing is reported. *)
    public minSamplesForP95 = ( ^ 200 )

    (* A chain rather than a literal array: this grammar has no #( ... ) literal,
       and a chain also allocates nothing per call. Index is 1-based, matching the
       stats fields 6..11 that hold b0..b5. *)
    decadeName: i = (
      i = 1 ifTrue: [ ^ #lt100us ].
      i = 2 ifTrue: [ ^ #lt1ms ].
      i = 3 ifTrue: [ ^ #lt10ms ].
      i = 4 ifTrue: [ ^ #lt100ms ].
      i = 5 ifTrue: [ ^ #lt1s ].
      ^ #ge1s )

    (* Walk the cumulative histogram and answer the decade in which the p-th
       percentile sample falls. There is deliberately NO interpolation inside the
       bucket: a bucket spanning 1 ms to 10 ms has its mass bunched at one end, so
       interpolating would assume a uniformity that is not there and manufacture
       three digits the data does not contain. The decade still says which segment
       dominates and how far the tail sits from the median, and maxUs is exact. *)
    public decadeAt: slot percentile: p = (
      | s n target seen i |
      s:: self statsAt: slot.
      n:: s basicAt: 1.
      (n < self minSamplesForP95) ifTrue: [ ^ #insufficient ].
      (* 1-based rank of the percentile sample, rounded UP so p95 of 200 samples
         is the 190th rather than the 189.99th. *)
      target:: ((n * p) + 99) // 100.
      seen:: 0. i:: 1.
      [ i <= 6 ] whileTrue: [
        seen:: seen + (s basicAt: 5 + i).     (* buckets are fields 6..11 *)
        (seen >= target) ifTrue: [ ^ self decadeName: i ].
        i:: i + 1 ].
      ^ #ge1s )

    public p50At: slot = ( ^ self decadeAt: slot percentile: 50 )
    public p95At: slot = ( ^ self decadeAt: slot percentile: 95 )

    (* One record PER SLOT, published onto sys/latency. Deliberately NOT an
       extension of #Metrics: protocol/PROTOCOL-NSL-RECORDS.md 4.4 forbids a
       12th field there and names tuvm#61 as the reason, because bucket counts are
       many fields at once. The consequence worth preserving is that adding a JOB
       adds a RECORD, not a field — so this schema never grows.

       Field names are deliberately SHORT: 4.4 observes that symbol field names
       dominate the encoded size, which is how #Metrics reached ~185-230 B on
       eleven fields with names like largestFreeBlock. *)
    public recordAt: slot = (
      | s pairs |
      s:: self statsAt: slot.
      pairs:: OrderedCollection new.
      pairs add: #span    -> (self nameAt: slot).
      pairs add: #n       -> (s basicAt: 1).
      pairs add: #fails   -> (self failuresAt: slot).
      pairs add: #minUs   -> (s basicAt: 2).
      pairs add: #maxUs   -> (s basicAt: 3).
      pairs add: #sumUsLo -> (s basicAt: 4).
      pairs add: #sumUsHi -> (s basicAt: 5).
      pairs add: #b0      -> (s basicAt: 6).
      pairs add: #b1      -> (s basicAt: 7).
      pairs add: #b2      -> (s basicAt: 8).
      pairs add: #b3      -> (s basicAt: 9).
      pairs add: #b4      -> (s basicAt: 10).
      pairs add: #b5      -> (s basicAt: 11).
      ^ Record tag: #LatencySpan fields: (Map fromPairs: pairs) )
  ) : (
  )

  (* tuvm#72: a BOUNDED span-capture session, controlled by a cell.

     Why this exists: `egress` records one sample per emitted HTTP chunk for EVERY
     route (src/http_core.c), and the /stats page emits ~24 chunks against
     /thermal's 12 — so a cumulative span table partly measures the rendering of
     the span table. Over a 300-request run that is noise for n and for the decade
     percentiles, but max is a single-sample statistic and a /stats chunk is a much
     larger string than an SVG row, so the max may be an artefact of the reporting.

     The invariant is ORDERING: reset LAST on start, snapshot FIRST on stop. In
     this shape it is structural rather than hand-maintained — a reaction runs
     during `space drain` while an HTTP response renders synchronously in its own
     request, so the report is always rendered on a LATER request than the one that
     closed the window, and a report can never land inside the window it describes.

     Deliberately generic: it knows a Space and a Spans and nothing else — no
     sensor, no HTTP, no device. That is why it lives here beside Spans rather than
     in a node file, and it is also what makes it host-testable. *)
  public class SpanCapture = ( | private space private spans private ctl private result private t0 private running | ) (
    public onSpace: sp spans: sn = (
      space::   sp.
      spans::   sn.
      running:: false.
      ctl::     sp channel: 'diag/spans/ctl'.
      result::  sp channel: 'diag/spans/result'.
      ^ self )

    public start = (
      ctl whenever: '' do: [ :c | self apply: c ].
      self normalise.
      ^ self )

    (* Registering a reaction does NOT replay a retained value, so a ctl left at
       #running by a crash mid-capture would sit there claiming a capture is
       running forever and a remote reader would believe it. Peek and correct.
       No result is published: t0 did not survive the restart, and a window whose
       start cannot be named is not a measurement. *)
    normalise = (
      | c |
      c:: ctl peek.
      c isNil ifTrue: [ ^ self ].
      ((c at: #state ifAbsent: [ #stopped ]) = #running) ifTrue: [
        ctl put: '' value: (Record tag: #SpanCtl with: #state -> #stopped) ].
      ^ self )

    apply: c = (
      | st |
      st:: c at: #state ifAbsent: [ #stopped ].
      st = #running ifTrue: [ ^ self beginWindow ].
      st = #stopped ifTrue: [ ^ self endWindow ].
      ^ self )

    (* #running while already running RESTARTS the window. Writing the cell is a
       statement of intent and "start again" is the only sane reading of it. *)
    beginWindow = (
      t0:: 0 millis.
      spans resetAll.
      running:: true.
      ^ self )

    (* #stopped while already stopped is ignored — otherwise a stray refresh
       overwrites a good capture with a zero-length one. *)
    endWindow = (
      | ms |
      running ifFalse: [ ^ self ].
      ms:: 0 millis - t0.
      (* `millis` tags into a 31-bit SMI and wraps at ~12.4 days of uptime. A
         negative elapsed is published as -1 rather than as a plausible wrong
         number: silent-wrong is the failure mode this class exists to remove. *)
      ms < 0 ifTrue: [ ms:: -1 ].
      (* Rows FIRST, summary LAST. Both readers of this facility — the bridge's
         outbound subscription and the node's own /stats page — react to
         diag/spans/result, so the summary is what says "the capture is complete".
         It may not arrive before the rows it summarises. *)
      result put: '' value: (self summaryMs: ms total: self publishSlots).
      running:: false.
      ^ self )

    (* tuvm#107: one cell per slot at diag/spans/<span>. Reuses Spans>>recordAt:,
       which already builds the per-slot #LatencySpan Record with the short field
       names porta's size law wants, and already carries a #span field naming its
       slot — so this is a change of WHERE the rows are published, not how they are
       built.

       EVERY slot publishes, including one that took no samples. Skipping the empty
       ones would leave a slot that had samples last window holding that value
       forever, silently attributing stale numbers to the current window — the
       failure mode this class exists to remove.

       Answers the TOTAL sample count across slots, computed here rather than in a
       second pass over the same table. *)
    publishSlots = (
      | i n total |
      total:: 0.
      i:: 0. n:: spans slotCount.
      [ i < n ] whileTrue: [
        (space channel: 'diag/spans/' , (spans pathAt: i))
          put: '' value: (spans recordAt: i).
        total:: total + ((spans statsAt: i) basicAt: 1).
        i:: i + 1 ].
      ^ total )

    (* The window summary ONLY (RECORDS §4.6): total samples and elapsed ms. It
       carries nothing that scales with the slot count — that is the whole of
       tuvm#107. `n` is the TOTAL across slots, deliberately not "cycles": this
       class must not know which span represents a job. The per-job count is that
       job's row. *)
    summaryMs: ms total: total = (
      ^ Record tag: #SpanCapture
          with: #n  -> total
          with: #ms -> ms )
  ) : (
    public onSpace: aSpace spans: aSpans = (
      ^ self new onSpace: aSpace spans: aSpans )
  )

  public class ReadStream = ( | private source private position | ) (
    (* Byte-granular cursor over an immutable String. `next`/`peek` answer a byte
       SMI; substring reads build Strings via `platform string:`. Open-ended reads
       answer nil at EOF so a blank line ('') stays distinct from end-of-stream. *)
    public next = ( self atEnd ifTrue: [ ^ self error: 'next past end' ]. position:: position + 1. ^ source at: position )
    public peek = ( self atEnd ifTrue: [ ^ self error: 'peek past end' ]. ^ source at: position + 1 )
    public atEnd = ( ^ position >= source size )
    public skip: n = ( position:: position + n. ^ self )
    public position = ( ^ position )
    public reset = ( position:: 0. ^ self )
    public next: n = ( | a |
      (position + n) > source size ifTrue: [ ^ self error: 'next: beyond end' ].
      a:: platform basicNew: Array indexable: n.
      1 to: n do: [ :i | a at: i put: (source at: position + i) ].
      position:: position + n.
      ^ platform string: a )
    public upTo: aByte = ( | r b |
      self atEnd ifTrue: [ ^ nil ].
      r:: OrderedCollection new.
      [ self atEnd ] whileFalse: [
        b:: self next.
        b = aByte ifTrue: [ ^ platform string: r asArray ].
        r add: b ].
      ^ platform string: r asArray )
    public nextLine = ( | s n |
      self atEnd ifTrue: [ ^ nil ].
      s:: self upTo: 10.
      n:: s size.
      (n > 0 and: [ (s at: n) = 13 ]) ifTrue: [ ^ self prefixOf: s upTo: n - 1 ].
      ^ s )
    public upToEnd = ( | r |
      self atEnd ifTrue: [ ^ nil ].
      r:: OrderedCollection new.
      [ self atEnd ] whileFalse: [ r add: self next ].
      ^ platform string: r asArray )
    public do: aBlock = ( [ self atEnd ] whileFalse: [ aBlock value: self next ]. ^ self )
    prefixOf: s upTo: k = ( | a | a:: platform basicNew: Array indexable: k. 1 to: k do: [ :i | a at: i put: (s at: i) ]. ^ platform string: a )
    public setSource: aString = ( source:: aString. position:: 0. ^ self )
  ) : (
    public on: aString = ( ^ self new setSource: aString )
  )

  public class WriteStream = ( | private bytes ::= OrderedCollection new. | ) (
    (* io.Buffer-style String builder: accumulate bytes, emit one String via
       `platform string:` — the O(n) replacement for O(n^2) `,` chaining. *)
    public nextPut: aByte = ( (aByte < 0 or: [ aByte > 255 ]) ifTrue: [ ^ self error: 'byte out of range 0..255' ]. bytes add: aByte. ^ aByte )
    public nextPutAll: aString = ( 1 to: aString size do: [ :i | bytes add: (aString at: i) ]. ^ aString )
    public print: anObject = ( ^ self nextPutAll: anObject printString )
    public nextPutLine: aString = ( self nextPutAll: aString. self nextPut: 10. ^ aString )
    public contents = ( ^ platform string: bytes asArray )
    public size = ( ^ bytes size )
    public reset = ( bytes:: OrderedCollection new. ^ self )
  ) : (
  )

  class Serial = ( | private port | ) (
    (* Confined native capability: byte/line port over a link-time backend.
       `port` holds the native serial singleton; raw bytes go through its
       basicReadByte/basicWriteByte:/basicAtEnd prims. Strings via platform. *)
    public setPort: aPort = ( port:: aPort. ^ self )
    public writeByte: aByte = ( port basicWriteByte: aByte. ^ self )
    public write: aString = ( 1 to: aString size do: [ :i | port basicWriteByte: (aString at: i) ]. ^ self )
    public atEnd = ( ^ port basicAtEnd )
    public readByte = ( port basicAtEnd ifTrue: [ ^ nil ]. ^ port basicReadByte )
    public read: n = ( | bytes |
      bytes:: OrderedCollection new.
      [ bytes size < n and: [ port basicAtEnd not ] ] whileTrue: [ bytes add: port basicReadByte ].
      ^ platform string: bytes asArray )
    public readLine = ( | bytes b done |
      port basicAtEnd ifTrue: [ ^ nil ].
      bytes:: OrderedCollection new. done:: false.
      [ done not and: [ port basicAtEnd not ] ] whileTrue: [
        b:: port basicReadByte.
        b = 10 ifTrue: [ done:: true ] ifFalse: [ bytes add: b ] ].
      (* strip a trailing CR if present (CRLF) *)
      (bytes size > 0 and: [ (bytes at: bytes size) = 13 ]) ifTrue: [ bytes removeLast ].
      ^ platform string: bytes asArray )
  ) : (
    public onPort: aPort = ( ^ self new setPort: aPort )
  )

  class Net = ( | private port | ) (
    (* Confined native capability: vends UDP Sockets over a link-time backend. *)
    public setPort: aPort = ( port:: aPort. ^ self )
    public udp = ( ^ self udpBindPort: 0 )                       (* ephemeral port *)
    public udpBindPort: aPort = ( | h |
      h:: port basicBind: aPort.
      h < 0 ifTrue: [ ^ nil ].
      ^ Socket onPort: port handle: h )
  ) : (
    public onPort: aPort = ( ^ self new setPort: aPort )
  )

  class Socket = ( | private port private handle | ) (
    public setPort: aPort handle: h = ( port:: aPort. handle:: h. ^ self )
    public sendTo: host port: aPort data: aBytes = (
      port basicSend: handle to: host port: aPort data: aBytes rawLeaf. ^ self )
    public receive = ( | t |
      t:: port basicReceive: handle.
      t == nil ifTrue: [ ^ nil ].
      ^ Datagram data: (Bytes overRaw: (t basicAt: 1)) senderHost: (t basicAt: 2) senderPort: (t basicAt: 3) )
    public close = ( port basicClose: handle. ^ self )
    (* rete#440: the channel this socket's doorbell rings, registered by `basicBind:`
       (udp.c) before the first datagram can land. Keyed by fd, not port. *)
    public doorbell = ( ^ 'sys/net/' , handle printString )
  ) : (
    public onPort: aPort handle: h = ( ^ self new setPort: aPort handle: h )
  )

  class Datagram = ( | private data private senderHost private senderPort | ) (
    public setData: d host: h port: p = ( data:: d. senderHost:: h. senderPort:: p. ^ self )
    public data = ( ^ data )
    public senderHost = ( ^ senderHost )
    public senderPort = ( ^ senderPort )
  ) : (
    public data: d senderHost: h senderPort: p = ( ^ self new setData: d host: h port: p )
  )

  (* Rung 6 Layer 2 — the reactive channel<->UDP bridge. Holds a bound Socket, an
     `out` Channel it subscribes to (posts there are CBOR-encoded and sent to the
     peer), and an `in` Channel it posts decoded inbound Records onto. Reuses the
     L1 Socket send/receive prims and the Cbor codec; no new C. Outbound is a
     normal drain-time reaction; inbound is an explicit pumpInbound step (the
     reactor's pump-then-drain idiom — pumpInbound stages, drain fires). Peer is a
     raw host String + port SMI. A malformed inbound datagram is DROPPED (untrusted
     network input, errors.md expected condition) — it must never crash the node. *)
  public class NetBridge = ( | private socket private out private peerHost private peerPort private in | ) (
    public setSocket: s out: o peerHost: ph peerPort: pp in: i = (
      socket:: s. out:: o. peerHost:: ph. peerPort:: pp. in:: i. ^ self )
    public start = (
      out whenever: '' do: [ :v | socket sendTo: peerHost port: peerPort data: (Cbor new encode: v) ].
      ^ self )
    (* Receive-until-empty; decode each datagram; drop on decode failure (bad `set`
       true), post the decoded value onto `in` otherwise (a legitimately-nil value
       still posts — only a decode FAILURE drops). *)
    public pumpInbound = (
      | dg bad v |
      dg:: socket receive.
      [ dg == nil ] whileFalse: [
        bad:: false.
        v:: Cbor new decode: dg data ifInvalid: [ :msg | bad:: true. nil ].
        bad ifFalse: [ in out: '' value: v ].
        dg:: socket receive ].
      ^ self )
  ) : (
    public socket: s out: o peer: ph port: pp in: i = (
      ^ self new setSocket: s out: o peerHost: ph peerPort: pp in: i )
  )

  (* porta space-sync, plan 2 — the NODE half of the check-in exchange
     (porta/docs/design/2026-08-01-porta-space-sync-rewrite-design.md §5/§6).

     Two node-initiated CBOR datagrams over plain UDP, both idempotent:

       PULL { id, cursor, bootId, hw }  ->  BATCH { hi, entries }
       PUSH { id, bootId, entries }     ->  ACK   { hw }

     where an entry is [ seq, path, kind, value ] and kind is 1 stream / 2 cell.
     Either request may instead be answered ERR { msg }.

     THERE IS NO RETRANSMIT LAYER, deliberately: the exchange is idempotent by
     cursor in BOTH directions — a lost pull re-pulls the same range at the next
     check-in, and a lost push is re-sent and deduped on the gateway's node-seq
     high-water. Loss is absorbed by convergence, not by retransmission.

     WHAT THIS HOLDS, and why each is here rather than elsewhere:
       `space`  — the ROOT capability. porta writes goal/** and dbg/req, the node
                  reports obs/** + tel/** + sys/**, and one object addressing both
                  is simpler than two until the grant machinery (G5) can express
                  the pair. Authority is enforced below, in `mayApply:`.
       `cursor` — porta's OUT-sequence: the last seq DELIVERED AND OFFERED to
                  this node. Not "executed": applyEntry:'s counted drops and a
                  kind-mismatch advance past entries that never ran, which is
                  why obs/health carries `rej` — under porta's replay guard
                  that loss is permanent, so it must be visible. RAM by
                  DECISION, not by slice (2026-08-26 design D3: persistence
                  buys a stranding mode, and the guard is what makes cursor 0
                  safe). Cold boot = cursor 0 replays PER KIND: cells as
                  latest-value bounded by tree size, streams only above the
                  acked high-water porta keeps (`nodes.cursor_hw`) — see
                  porta/docs/design/2026-08-26-space-sync-durability-trio-design.md
                  D1/D3.
       `acked`  — the high-water the gateway has ACCEPTED from us, in the LOCAL
                  space's seq (one counter per space per side). Cells newer than
                  this are re-scanned every check-in; pending entries at or below
                  it are done.
       `pending`— captured stream entries not yet acked. A stream's value is
                  killed on delivery, so unlike a cell it cannot be re-read later:
                  capture is the only chance.

     A crash of this job is a CONTAINED fault — porta sees a late check-in and
     nothing worse. So nothing here may take the node down: every decode failure,
     every unexpected tag and every out-of-authority path is a counted drop. *)
  (* #342 spike: the debugger's lines through the space. `accept:` is fed by the
     bridge's applyEntry: (dbg/req), `say:` offers dbg/resp rows to the bridge's
     next push, and `readLine` answers the next line, running the held loop while
     there is none (rete#440 R2: a stop is always served). *)
  class DebugLink = ( | private bridge private space private lines private armed | ) (
    public setBridge: b space: s = (
      bridge:: b. space:: s.
      lines:: OrderedCollection new. armed:: OrderedCollection new.
      ^ self )
    public accept: line = ( lines add: line. ^ self )
    (* goal/debug/main is the WHOLE breakpoint set, `Debug{sha, breaks: [[blob off]…]}`
       (rete#375). The sha names the program the offsets belong to: a blob offset
       means nothing in another image, so a goal for another program arms nothing
       and says so on dbg/resp. The previous goal's breakpoints are cleared first —
       the cell is a set, not a sum — and an empty set is the detach. The goal means
       "set these and run", so a continue follows. Untrusted: anything off-shape is
       ignored, field by field. A node that knows no hash (a bare host run) cannot
       check, and arms. *)
    public acceptGoal: v = (
      | sha mine breaks i bp at |
      (outer rankOf: v) = 9 ifFalse: [ ^ self ].
      v tag = #Debug ifFalse: [ ^ self ].
      breaks:: v at: #breaks ifAbsent: [ nil ].
      (outer rankOf: breaks) = 7 ifFalse: [ ^ self ].
      mine:: outer otaRunningHash.
      mine == nil ifFalse: [
        sha:: v at: #sha ifAbsent: [ nil ].
        ((outer rankOf: sha) = 5 and: [ sha = mine ]) ifFalse: [
          self say: 'dbg:error sha'. ^ self ] ].
      i:: 1.
      [ i <= armed size ] whileTrue: [ lines add: 'dbg:clear ' , (armed at: i). i:: i + 1 ].
      armed:: OrderedCollection new.
      i:: 1.
      [ i <= breaks size ] whileTrue: [
        bp:: breaks at: i.
        ((outer rankOf: bp) = 7 and: [ bp size = 2
            and: [ (outer rankOf: (bp at: 1)) = 2 and: [ (outer rankOf: (bp at: 2)) = 2
            and: [ (bp at: 1) >= 0 and: [ (bp at: 2) >= 0 ] ] ] ] ])
          ifTrue: [
            at:: (bp at: 1) printString , ' ' , (bp at: 2) printString.
            armed add: at.
            lines add: 'dbg:break ' , at ].
        i:: i + 1 ].
      lines add: 'dbg:continue'.
      ^ self )
    public pending = ( ^ lines isEmpty not )
    public next = ( ^ lines removeFirst )
    public say: s = ( bridge offer: 'dbg/resp' value: s. ^ self )
    (* One step of the held loop: block in the pump, then move the exchange on
       (PortaBridge>>heldStep). The Supervisor's readLine (rete#376) looks at the
       link and the cable between steps. *)
    public heldStep = ( ^ bridge heldStep )
    (* obs/debug (rete#375): held, and where. A cell, so the next push carries it —
       the held exchange's own push while stopped, the tick's after a continue. The
       blob is -1 in a Path A image (no blob); the wire says uint, so 0 stands in. *)
    public held: blob at: off = ( ^ self publishHeld: true blob: blob off: off )
    public resumed = ( ^ self publishHeld: false blob: 0 off: 0 )
    publishHeld: h blob: b off: o = (
      space put: 'obs/debug' value: (Record tag: #DebugObs
        with: #off -> (o < 0 ifTrue: [ 0 ] ifFalse: [ o ])
        with: #blob -> (b < 0 ifTrue: [ 0 ] ifFalse: [ b ])
        with: #held -> h).
      ^ self )
  ) : (
    public onBridge: b space: s = ( ^ self new setBridge: b space: s )
  )

  (* rete#440 R5 — the image fetch as reactions (design 2026-11-04, addendum 2026-11-10;
     card nodus/oevm/invarlint/revisions/r5-ota-fetch/ota_fetch.yaml). It was a C thread
     (rete#233 T9) and, on the S2, a blocking loop on this one (T10); now it is one state
     per block on the VM thread, and nothing here waits. A block is asked for, its budget
     armed first, and the fetch is moved on by one of two events: the reply, which arrives
     on the BRIDGE'S socket (its doorbell, read to empty by `readSocket`, which hands the
     block plane's frames here), or the budget's expiry on `sys/porta/fetch`.

     The wire is porta/internal/blockserv's, unchanged:
       request  0x01 | hash[32] | blockNo u32 BE            (37 bytes)
       response 0x02 | blockNo u32 BE | more u8 | data[<=256]
       error    0x7F | text
     on the peer's port plus one, by construction (otaCheck). C keeps the bytes: the stage
     (append, size, truncate) and its digest are prims over src/ota_backend.h and ota.h.

     Kept from T9 unchanged: the stage's length is the cursor, so a fetch resumes at the
     block after the bytes on hand; a slot off a block boundary restarts from block 0; a
     slot that already hashes to the image is staged at once with no traffic; a peer error
     is not retried, and on a resume it also empties the stage (a retarget would otherwise
     wedge the node on a block past the new image's end); an exhausted budget keeps the
     stage for the next check-in to resume; a whole-image mismatch empties it. A failed
     fetch is not remembered: the next check-in starts another. *)
  class OtaFetch = (
    | private socket private timers private bridge private budgetCh
      private hash ::= nil. private sig ::= nil. private host private port
      private block ::= 0. private first ::= 0. private attempts ::= 0.
      private busy ::= false. private leg ::= 0. private token ::= nil. |
  ) (
    public setSocket: s timers: t space: sp bridge: b = (
      socket:: s. timers:: t. bridge:: b.
      budgetCh:: sp channel: 'sys/porta/fetch'.
      budgetCh whenever: '' do: [ :n | self lapsed: n ].
      ^ self )
    (* porta/internal/blockserv BlockSize: a 6LoWPAN-safe payload. *)
    blockSize = ( ^ 256 )
    (* One attempt's budget and the attempts per block, as built in T9 (OTA_ATTEMPTS):
       until a measurement earns other numbers (design addendum 2026-11-10). *)
    attemptBudget = ( ^ 1000 )
    maxAttempts = ( ^ 5 )

    public busy = ( ^ busy )
    public hash = ( ^ hash )
    public sig = ( ^ sig )
    public block = ( ^ block )
    (* The bytes on the stage: the resume cursor, and what `ota staging N` reports. *)
    public staged = ( ^ platform otaStageSize )
    (* Empties the stage. For the suite, which must start from a known slot. *)
    public discard = ( platform otaStageTruncate. ^ self )

    (* A block-plane frame, by its first byte. A space-sync reply is a CBOR Record and
       never begins with 0x02 or 0x7F. *)
    public isBlockFrame: bytes = ( | b |
      bytes byteSize = 0 ifTrue: [ ^ false ].
      b:: bytes u8At: 1.
      ^ b = 2 or: [ b = 127 ] )

    (* Answers #staged (the slot already holds the image: one re-hash, no traffic),
       #failed (no slot, no socket, or no timer), or #started, in which case the end
       comes later as `bridge fetched:`. *)
    public start: h sig: s host: hh port: p = (
      | size |
      size:: platform otaStageSize.
      size < 0 ifTrue: [ self say: 'no staging slot (OEVM_OTA_STAGE unset)'. ^ #failed ].
      hash:: h. sig:: s.
      (size > 0 and: [ platform otaStageMatches: h rawLeaf ]) ifTrue: [
        self say: 'already staged, bytes=' , size printString.
        ^ #staged ].
      (* A partial trailing block cannot be resumed from (the stage truncates to zero
         only), so an off-boundary slot restarts from block 0. *)
      (size \\ self blockSize) = 0 ifFalse: [
        self say: 'slot not on a block boundary, restarting; bytes=' , size printString.
        platform otaStageTruncate.
        size:: 0 ].
      socket == nil ifTrue: [ self say: 'no socket'. ^ #failed ].
      host:: hh. port:: p.
      block:: size // self blockSize.
      first:: block.
      attempts:: 0.
      ([ self ask. true ] on: [ :e | true ] do: [ :e | false ]) ifFalse: [
        self cancel.
        self say: 'timer table full'.
        ^ #failed ].
      busy:: true.
      ^ #started )

    (* One attempt: the budget is armed BEFORE the request is sent, so a full timer table
       (#81) raises with nothing in flight, and every waiting state holds a wake. *)
    ask = (
      self cancel.
      attempts:: attempts + 1.
      leg:: leg + 1.
      token:: timers after: self attemptBudget post: leg on: budgetCh.
      socket sendTo: host port: port data: self request.
      ^ self )

    (* Inside a reaction a raise would leave the fetch busy with no wake, so a re-arm that
       raises ends the fetch instead; the stage is kept, and the next check-in resumes. *)
    askAgain = (
      ([ self ask. true ] on: [ :e | true ] do: [ :e | false ]) ifTrue: [ ^ self ].
      self say: 'timer table full'.
      ^ self end: false )

    cancel = (
      token == nil ifFalse: [ timers cancel: token. token:: nil ].
      ^ self )

    request = ( | raw h |
      raw:: platform basicNewBytes: 37.
      raw at: 1 put: 1.
      h:: hash rawLeaf.
      1 to: 32 do: [ :i | raw at: i + 1 put: (h at: i) ].
      raw at: 34 put: ((block >> 24) bitAnd: 255).
      raw at: 35 put: ((block >> 16) bitAnd: 255).
      raw at: 36 put: ((block >> 8) bitAnd: 255).
      raw at: 37 put: (block bitAnd: 255).
      ^ Bytes overRaw: (platform freezeBytes: raw size: 37) )

    (* A block-plane frame, read off the bridge's socket. A frame for another block, a
       short one or one arriving when no fetch is in flight is a late duplicate, and is
       dropped; the budget still runs, so a drop costs an attempt and nothing else. *)
    public arrived: bytes = (
      | n |
      busy ifFalse: [ ^ self ].
      n:: bytes byteSize.
      (bytes u8At: 1) = 127 ifTrue: [
        self say: 'peer error: ' , (self textOf: bytes).
        ^ self rejected ].
      (self isBlock: bytes) ifFalse: [ ^ self ].
      n - 6 > self blockSize ifTrue: [ ^ self rejected ].     (* over-long: a bad peer *)
      (platform otaStageAppend: bytes rawLeaf from: 7) ifFalse: [
        self say: 'staging slot write failed'.
        ^ self end: false ].
      (bytes u8At: 6) = 0 ifTrue: [ ^ self verify ].
      block:: block + 1.
      attempts:: 0.
      ^ self askAgain )

    (* The block asked for, compared byte by byte so no arithmetic leaves the SMI band. *)
    isBlock: bytes = (
      bytes byteSize < 6 ifTrue: [ ^ false ].
      (bytes u8At: 1) = 2 ifFalse: [ ^ false ].
      ^ (bytes u8At: 2) = ((block >> 24) bitAnd: 255)
        and: [ (bytes u8At: 3) = ((block >> 16) bitAnd: 255)
        and: [ (bytes u8At: 4) = ((block >> 8) bitAnd: 255)
        and: [ (bytes u8At: 5) = (block bitAnd: 255) ] ] ] )

    (* "Unknown hash" is a state at porta, not a lost datagram, so it is not retried. On a
       RESUME it means the bytes on hand are not a prefix of the wanted image at all — the
       commonest cause is a retarget to a shorter image, whose resume block is past its end.
       The slot carries no record of which image it holds, so emptying it is the only exit;
       leaving it would repeat this request at every check-in, forever. A fresh stage is
       left alone: it is the record-pushed-before-the-blob case, and it heals itself. *)
    rejected = (
      first > 0 ifTrue: [
        self say: 'peer rejected a resumed block -- discarding the stale slot'.
        platform otaStageTruncate ].
      ^ self end: false )

    (* The whole image, hashed. A mismatch is not recoverable by resuming — the bytes are
       wrong, not incomplete — so the slot goes to zero and the next fetch starts at 0. *)
    verify = ( | size |
      size:: platform otaStageSize.
      (platform otaStageMatches: hash rawLeaf) ifTrue: [
        self say: 'staged ok, bytes=' , size printString.
        ^ self end: true ].
      self say: 'staged image hash MISMATCH, discarding bytes=' , size printString.
      platform otaStageTruncate.
      ^ self end: false )

    (* The budget's reaction. `n` is the attempt it was armed for; an older one is ignored.
       Read first: a reply already waiting is an arrival, not a miss. *)
    lapsed: n = (
      | was |
      (busy and: [ n = leg ]) ifFalse: [ ^ self ].
      was:: leg.
      bridge readSocket.
      (busy and: [ leg = was ]) ifFalse: [ ^ self ].
      attempts < self maxAttempts ifTrue: [ ^ self askAgain ].
      (* Porta is unreachable: the bytes on hand are still a good prefix, so the slot
         stays, and it is the cursor for the next check-in. *)
      self say: 'block timed out after ' , self maxAttempts printString , ' attempts, block=' , block printString.
      ^ self end: false )

    end: ok = (
      self cancel.
      busy:: false.
      ^ bridge fetched: ok )

    textOf: bytes = ( | n arr |
      n:: bytes byteSize - 1.
      n > 95 ifTrue: [ n:: 95 ].
      arr:: platform basicNew: Array indexable: n.
      1 to: n do: [ :i | arr at: i put: (bytes u8At: i + 1) ].
      ^ platform string: arr )

    say: msg = ( ('ota: ' , msg) out. ^ self )
  ) : (
    public socket: s timers: t space: sp bridge: b = ( ^ self new setSocket: s timers: t space: sp bridge: b )
  )

  public class PortaBridge = (
    | private socket private space private nodeId private peerHost private peerPort
      private cursor ::= 0. private acked ::= 0. private rejected ::= 0. private misses ::= 0. private dropped ::= 0.
      private crossed ::= 0.
      (* The debugger's link through the space (rete#376: set at construction in
         a debug image, nil in a standard one). `holding` is true while the held
         loop runs the bridge (`heldStep`); `quiet` marks an exchange the held loop
         started, which ends without a debugger wake, an otaCheck or a `finished`
         (rete#440 R2, design "While the program is stopped"). *)
      private dbgLink ::= nil. private heldExchanges ::= 0. private holding ::= false. private quiet ::= false.
      (* rete#440 R2 — the exchange as a state machine (design 2026-11-04, "The
         check-in as reactions"). `state` is #idle, #linking (R3: the radio is on and
         the link not yet up), #pulling or #pushing. `timers` is the bridge's, from construction, so every state that
         waits holds an armed one-shot: `budgetToken`, posting `leg` on
         sys/porta/budget. `leg` counts every arm, so an expiry that was already on
         its way when a reply moved the exchange on is recognised and ignored.
         `deadline` is the same expiry read against the clock, for the held loop,
         where no reaction runs. `exchangeCh` is sys/porta/exchange, `finished`. *)
      private timers private state ::= #idle. private budgetToken ::= nil. private leg ::= 0. private deadline ::= 0.
      private budgetCh private exchangeCh
      (* rete#440 R5 — `fetch` is the image fetch (OtaFetch), built here with the bridge's
         socket and timers. `owed` is a `finished` an app's exchange or fetch has earned and
         not yet said: it is said only when the bridge is idle, no exchange and no fetch in
         flight, so a run-once node that sleeps on it sleeps after its stage (addendum
         2026-11-10). *)
      private fetch private owed ::= false.
      (* rete#440 R3 (#458) — the radio, an app policy the bridge carries out (design
         2026-11-04, "Radio"). `radioMode` is the policy in force: #always (the default),
         #perExchange, or one of off-for-N's phases — #lastCall (asked, the exchange that
         carries sys/radio not yet begun), #carrying (that exchange in flight), #off (the
         radio off, check-ins counted and nothing sent), #forced (N expired: one exchange,
         whatever the app does). `basePolicy` is what off-for-N returns to. `offLeg` names
         the N timer's arm, as `leg` names the budget's, so an expiry from an earlier off
         is ignored; `offDeadline` is the same expiry for the held loop. `gapMisses` is the
         expected gap re-declared on obs/liveness while off. `skipped` counts check-ins the
         link was down for, `silent` those the radio was off for. `linkStart`/`linkMs` time
         the last link wait, radio on to link up: the reconnect that sets `linkBudget`. *)
      private radioMode ::= #always. private basePolicy ::= #always. private radioIsOn ::= true.
      private offMs ::= 0. private offLeg ::= 0. private offToken ::= nil. private offDeadline ::= 0.
      private gapMisses ::= 0. private skipped ::= 0. private silent ::= 0.
      private linkStart ::= 0. private linkMs ::= -1. private offCh
      (* rete#272 D3.3 — this boot's check-ins, counted in `checkIn` and sent as
         #wak in every pull. Per-boot and deliberately not persisted. *)
      private wakes ::= 0.
      (* rete#161/rete#199 — how many rows fitted the last push frame, so the next
         one starts its search there instead of at "all of them". A HINT and never
         a bound: `pushFrame` clamps it and corrects it in both directions, so a
         stale value costs an encode and can never cost a row. Zero means "no push
         yet"; per-boot and deliberately not persisted, like the cursor. *)
      private fitRows ::= 0.
      (* rete#199 — the frame the gateway has NOT accepted yet, kept rather than
         rebuilt. `checkIn`'s own comment already promised that the next check-in
         "re-pushes the same entries"; it simply rebuilt them from scratch to keep
         the promise, and rebuilding is `collectOutbound` plus a `valueFits:`
         encode of every candidate plus a full frame encode, EVERY tick, forever,
         for a node that is getting nowhere. Measured on the host against a porta
         answering #err to everything: 2.1x the GC cycles of a healthy node, and
         the largest free block collapsed from ~16.8 KB to ~2.9 KB — so a refused
         node could not satisfy the 4104-byte allocation that killed a C6 on 74%
         of its ticks against a healthy node's 10%. It was never a leak; nothing
         accumulated. It was the allocation RATE, and the arena fragmented under
         it. `framesBuilt` is the observable that makes the reuse falsifiable. *)
      private lastFrame ::= nil. private lastFrameAcked ::= 0. private framesBuilt ::= 0.
      (* rete#114 — the seq of the sys/panic entry currently on offer, 0 when
         none is. Latched from `pending` (never at publish time — capture is
         deferred to `space drain`, so the stamp does not exist yet when
         offerPanic writes). Cleared by capture:'s eviction, which is what
         keeps an evicted, never-pushed offer from being mistaken for a
         delivered one when `acked` later sweeps past its seq. *)
      private panicSeq ::= 0.
      (* rete#199 — a REFUSAL is not a timeout, and until this counter existed the
         node could not say which was happening to it: an #err incremented neither
         `misses` nor `acked`, so `obs/health` read identically for a node being
         uniformly rejected and one being answered. That is the whole reason the
         original diagnosis took two hours — the console said `misses 0` the whole
         way to the panic. `lastErrMsg` makes the message itself reportable ONCE
         rather than once per tick. *)
      private refused ::= 0. private lastErrMsg ::= nil.
      (* rete#25 — the whole of the image-push policy's state, four slots and no
         object. `otaStaged` is the one-tick delay between "the bytes are on
         flash" and "boot them" made explicit (see otaCheck); `otaConfirmed` is
         what makes the confirm happen ONCE per boot rather than every check-in;
         `stagedHash`/`stagedSig` carry the two arguments the activation needs
         across that tick, because by then `goal/apps/main` is only where they
         CAME from and re-reading it would let a gateway retarget an activation
         mid-flight. All four are per-boot and deliberately not persisted: a
         reboot re-reads the goal and re-decides, which is the same replay-safe
         reasoning the cursor rests on. `appsPublished` is the fifth and belongs
         to the same story from the other end: obs/apps/main is written once per
         boot because the running hash cannot change without one. *)
      private otaStaged ::= false. private otaConfirmed ::= false. private appsPublished ::= false.
      (* rete#231 D2 / rete#273 D2 — the liveness contract. `cadMs` is telCad: how
         often this node INTENDS to speak. `missBudget` is how many consecutive
         check-ins it tolerates losing to ordinary mesh loss before its silence
         means anything — c6-bell misses roughly half of its at 30 s, and the node
         is the only party that knows its own loss rate. porta derives the budget
         as telCad x misses; there is no `bud` on the wire and so no grid to snap
         (D2: an incoherent declaration is unrepresentable). 8 is the one default at
         every period (D2.3): the false-trip rate is ~p^misses and the period cancels.

         The defaults are compiled in so that a node which has never heard from porta
         still has a budget, which is what makes a never-seen node judgeable at all.
         30 s is the slowest cadence on this bench; declaring a cadence SLOWER than
         the node keeps is always safe, because speaking more often than declared
         violates nothing.

         `appCadDeclared` is rete#273 D1's other number — how long the app's event
         dispatch may go without running before the OBSERVER reboots it. 0 means
         the app declared nothing and the bridge declares cadMs x 8 on its behalf
         (the same 16 s every gate already reads at cad 2000). It NEVER crosses
         the wire.

         `livenessPublished` is the obs/apps/main rule (#25): written once per boot,
         because a cell that never changes must not be allowed to crowd out the one
         that does under pushFrame's tail-trim. A declaration or an accepted goal
         clears it, which is the only way the value can move. *)
      private cadMs ::= 30000. private missBudget ::= 8. private appCadDeclared ::= 0. private livenessPublished ::= false.
      (* rete#231 D1 — the base tick the KERNEL owns, registered on the bridge's own
         `timers` (handed in at construction since rete#440 R2, never minted here).
         Since rete#244 `platform timers` answers the per-kernel singleton, so handing
         it is convention rather than load-bearing — but an explicitly-constructed
         private registry (Timers usingSpace:seam:) still aliases the global C
         registry, so the handed-in shape stays. `tickToken` is what makes the registration
         once-per-boot observable, and it is what adoptCad:misses:'s re-arm cancels
         now that the cadence half of goal/liveness is honoured (rete#240.2). *)
      private tickChannel ::= nil. private tickToken ::= nil.
      private pending ::= OrderedCollection new.
      (* tuvm#107 follow-on: the six spans that decompose an exchange. See the
         bracket comment on checkIn for what each one covers and why the sends are
         separated from the waits.
         tuvm#161: three more NESTED inside `pushBuild`, which measured 62% of the
         check-in — see the bracket comment on pushFrame. *)
      private spans private sPullSend private sPullWait private sApplyIn private sPushBuild private sPushSend private sPushWait
      private sPushCollect private sPushEncode private sPushTrim
      private stagedHash private stagedSig private bootId |
  ) (
    (* `spans` is a CONSTRUCTOR ARGUMENT and not optional, for the reason
       src/span.h gives for pinning the two C-owned slots: a node must not be able
       to ship an uninstrumented bridge by forgetting a bracket. The cost is a
       sixth keyword at every construction site, which is the price named under
       "mechanism minimization" — one shape, no instrumented/uninstrumented modes,
       no nil guard on a measured path.

       IT MUST BE THE APP'S ONE Spans. Each Spans instance owns its own name<->slot
       table and hands out indices sequentially from 2, so two instances in one
       image both allocate slot 2 and then silently accumulate into each other's
       samples — the one-instance rule `platform timers` lived under until
       rete#244 memoized it. The constructor cannot enforce this (a freshly
       minted Spans is accepted and collides); making `platform Spans` answer a
       memoized instance would, and is the right follow-on — #244 is now the
       precedent shape. Registration happens HERE, at construction, so the slot
       table is complete before any capture window opens: SpanCapture publishes one
       cell per slot, and a table that grew mid-window would publish a different set
       of cells at stop than existed at start. *)
    (* `timers` is a constructor argument for the reason `spans` is (rete#440 R2):
       every state that waits on the network holds an armed budget on it, so a
       bridge cannot exist in a shape that waits forever. It must be the Timers the
       app dispatches `sys/timer` to — `platform timers`, the singleton. *)
    public setSocket: s space: sp id: anId peer: h port: p spans: sn timers: t = (
      socket:: s. space:: sp. nodeId:: anId. peerHost:: h. peerPort:: p.
      spans:: sn. timers:: t.
      (* rete#162 — read ONCE, here, for the reason the bracket comment on
         `bootId` gives: this send is what performs the NVS write, and it must
         not happen inside a measured check-in. *)
      bootId:: platform bootId.
      sPullSend::  sn register: #pullSend.
      sPullWait::  sn register: #pullWait.
      sApplyIn::   sn register: #applyIn.
      sPushBuild:: sn register: #pushBuild.
      sPushSend::  sn register: #pushSend.
      sPushWait::  sn register: #pushWait.
      (* tuvm#161. Registered here with the other six rather than lazily inside
         pushFrame, for the reason the comment above gives: the slot table must be
         complete before any capture window opens, or stop publishes a different
         set of cells than start. Three more takes a bridged C6 node from 11 slots
         to 14 of OEVM_SPAN_SLOTS = 16 — which is what the 8 -> 16 raise was for. *)
      sPushCollect:: sn register: #pushCollect.
      sPushEncode::  sn register: #pushEncode.
      sPushTrim::    sn register: #pushTrim.
      (* rete#114 — the bridge owns must-deliver, so it owns the capture too.
         Before this line NOTHING subscribed sys/panic: every publication since
         rete#215 died undelivered at the drain (a stream write with no
         reaction is killed on delivery), so the must-deliver row had never
         once reached porta. Subscribing at construction, beside the slot
         registrations, for the same reason they live here: the bridge must
         not be constructible in a shape that silently cannot deliver. *)
      self subscribeStream: 'sys/panic'.
      (* rete#376 (D19): a debug image is debugged over USB or porta, with no
         opt-in. So a bridge built in a debug image hands the kernel's debugger
         its link here, at construction, beside the other things a bridge must
         not be constructible without. A standard image has no debugger and the
         bridge is an ordinary bridge. The link's lines are dbg/req rows and the
         goal/debug cell; its replies are dbg/resp rows. While the program is
         stopped no reaction runs, so the link drives `heldStep` itself, exchange
         after exchange, blocking in the pump between events, until a line arrives
         on it or on the cable (Supervisor `Debugger>>readLine`). *)
      outer debugger == nil ifFalse: [
        dbgLink:: DebugLink onBridge: self space: space.
        outer debugger useLink: dbgLink ].
      (* rete#440 R2: the three events that move an exchange on — the cadence's
         `checkIn` (a send, below), the socket's doorbell and the budget's expiry —
         are subscribed here, with the rest of what a bridge must not be
         constructible without. The doorbell is `sys/net/<fd>`, rung by the VM
         (udp.c `basicBind:`) whenever the socket can be read. *)
      budgetCh:: space channel: 'sys/porta/budget'.
      budgetCh whenever: '' do: [ :n | self budgetLapsed: n ].
      exchangeCh:: space channel: 'sys/porta/exchange'.
      fetch:: OtaFetch socket: s timers: t space: sp bridge: self.
      socket == nil ifFalse: [
        (space channel: socket doorbell) whenever: '' do: [ :bell | self readSocket ] ].
      (* rete#440 R3: the fourth event, the link (`sys/net/link`, rung by Net on every
         change; asking `linkUp` once here arms it), and off-for-N's timer. *)
      (space channel: 'sys/net/link') whenever: '' do: [ :t | self linkChanged ].
      platform linkUp.
      offCh:: space channel: 'sys/porta/radio'.
      offCh whenever: '' do: [ :n | self offExpired: n ].
      ^ self )

    (* bootId rides the batch envelope, not every record — it is constant for
       every entry in a check-in, and paying 3-9 bytes per entry for it would be
       real money against a 512-byte batch.

       rete#162: this WAS the source constant 1, and the constant is what cost
       c6-bell a night of telemetry. porta cannot distinguish "the node rebooted,
       so its seq counter restarted at 0" from "porta's ack went missing, so the
       node is legitimately re-offering rows it already sent" — and those two
       need OPPOSITE responses. Reading a reboot as a missed ack leaves porta's
       high-water hours ahead of the node's fresh sequence, every pushed row is
       discarded as already-applied, and the ack carries the stale watermark back
       so the node believes it was delivered. Both ends then report success
       forever. A per-boot identity collapses the ambiguity to a comparison.

       LATCHED HERE, at construction, and deliberately not read per check-in.
       The first read is what performs the NVS increment-and-store, and a flash
       erase/write inside `checkIn` would land in the middle of the six spans
       #161 exists to measure — it would be charged to pushBuild and read as a
       codec regression. Latching also makes the constant-within-a-boot property
       structural rather than a promise the C side happens to keep.

       0 means the node has NO persistent boot identity (no settings/NVS backend,
       or a write that failed). It is a value to branch on, not an error: porta
       reads it as "restart detection unavailable for this node" and says so,
       which is the one thing the old constant could never do. *)
    public bootId = ( ^ bootId )
    (* The caps are a RADIO constraint, not a preference: 6LoWPAN fragments above
       ~102 B and a datagram survives only if every fragment does. porta rejects
       a push that breaks either, so the trimming below is what keeps a node from
       talking itself out of the fleet. *)
    maxBatchBytes = ( ^ 512 )
    maxValueBytes = ( ^ 256 )
    maxRows = ( ^ 8 )
    replyBudget = ( ^ 2000 )   (* ms one leg's budget runs before it scores a miss *)

    (* The pending queue is BOUNDED. Found on hardware: with the gateway
       unreachable, applyAck: never runs and this queue is the only thing that
       grows — the node OOMs and panics at about ninety seconds. A miss must cost
       latency and bounded loss, never unbounded memory (plan 2's N7 said
       otherwise; the bench corrected it).

       64 rows is eight full pushes of backlog at maxRows = 8, which is a real
       reconnection window, and at four smallish fields a row it is far from the
       heap. Oldest-first eviction: for tel/** the newest entry is the one worth
       keeping, and it leaves the survivors in ascending seq order, which the push
       frame requires. sys/panic is marked must-deliver in RECORDS and needs a
       different answer than "drop it" — that is a design question, not this cap.

       Say the cost outright: oldest-first eviction MANUFACTURES A GAP at the
       HEAD of the pushed seq series once the bound bites — CLAIMS.md's "no gaps"
       is proven only for the runs where it never does. At one capture per tick
       and the 2 s cadence, the bound bites after roughly 65 consecutive unacked
       ticks, about 130 seconds of sustained disconnection. *)
    public maxPending = ( ^ 64 )

    public cursor = ( ^ cursor )
    public acked = ( ^ acked )
    public rejected = ( ^ rejected )
    public misses = ( ^ misses )
    public refused = ( ^ refused )
    public framesBuilt = ( ^ framesBuilt )
    public dropped = ( ^ dropped )
    (* Replies that arrived in the OTHER leg's wait and were walked past. Counted
       rather than merely handled: a silent skip makes "the window never opened"
       and "it opened and we coped" read identically from the outside. *)
    public crossed = ( ^ crossed )
    public pendingSize = ( ^ pending size )
    public pendingRows = ( ^ pending )

    (* ---- outbound stream capture ------------------------------------------
       A cell can be re-read at check-in time; a stream entry cannot — the
       reactor kills the event on delivery. So each outbound stream path is
       subscribed here and its writes are captured into `pending`, stamped with
       `space stamp` so they share ONE ascending sequence with the cell writes. *)
    (* ---- debugging through the space (#342 spike; the link is handed over at
       construction, rete#376) ------------------------------------------- *)
    (* Only `dbg:` lines are the debugger's. `profile <ms>` stays with the kernel's
       Profiler, so a profile request never holds the node. ASCII d b g : = 100 98 103 58. *)
    isDbgLine: v = (
      (outer rankOf: v) = 4 ifFalse: [ ^ false ].
      v size < 4 ifTrue: [ ^ false ].
      ^ (v at: 1) = 100 and: [ (v at: 2) = 98 and: [ (v at: 3) = 103 and: [ (v at: 4) = 58 ] ] ] )
    public offer: absolutePath value: v = ( self capture: absolutePath value: v. ^ self )
    (* The held loop's one step (rete#440 R2, design "While the program is
       stopped"). A stop holds the stack, so no reaction runs and the bridge is
       serviced here directly: start an exchange if idle, block in the pump — the
       same block every program idles in — then read the socket and the clock
       against the budget's deadline. The budget armed in every waiting state is
       what guarantees the pump wakes; a held VM is exempt from the liveness
       observer, so nothing else would. Whatever else the pump delivers queues in
       the space for the continue, and the budget is cancelled as each leg ends,
       so its expiry is dropped by `Timers>>dispatch:` there. An exchange in flight
       when the program stopped is finished here, so a stop is always served. *)
    (* `holding` is cleared by `ensure:`, on every exit: a raise inside the step
       (`applyEntry:` on a bad row, a full timer table) would otherwise leave it set for
       the rest of the boot, and every later `leave` would skip the wake and otaCheck. *)
    public heldStep = (
      holding:: true.
      [ state = #idle ifTrue: [ self beginExchange ].
        platform pumpEvents.
        self readSocket.
        (* rete#440 R3: the link and N, read here as the socket and the budget are. *)
        (state = #linking and: [ platform linkUp ]) ifTrue: [ self linkChanged ].
        ((state = #idle) not and: [ platform monotonicMillis >= deadline ]) ifTrue: [ self lapse ].
        (radioMode = #off and: [ platform monotonicMillis >= offDeadline ]) ifTrue: [
          self offExpired: offLeg ] ]
        ensure: [ holding:: false ].
      ^ self )
    public heldExchanges = ( ^ heldExchanges )

    public subscribeStream: absolutePath = (
      (space channel: absolutePath) whenever: '' do: [ :v | self capture: absolutePath value: v ].
      ^ self )
    capture: absolutePath value: v = (
      | evicted |
      (* rete#444: the 5th field is monoMs at CAPTURE, so a row held through an outage
         keeps its own time; collectOutbound turns it into an age for the wire. *)
      pending add: (List with: space stamp with: absolutePath with: 1 with: v with: platform monotonicMillis).
      [ pending size > self maxPending ] whileTrue: [
        evicted:: pending removeFirst.
        (* rete#114: an evicted OFFER must not read as a delivered one. With
           panicSeq cleared, offerPanic re-publishes; left set, a later ack
           sweeping past the evicted seq would ack the note for an entry that
           was never pushed — a false receipt, the exact failure class the
           re-offer exists to close. *)
        ((evicted at: 2) = 'sys/panic') ifTrue: [ panicSeq:: 0 ].
        dropped:: dropped + 1 ].
      ^ self )

    (* ---- the pull half ---------------------------------------------------- *)
    (* The cursor sent is the one already APPLIED, which is what makes "the
       node's cursor passed seq N" better evidence of delivery than any
       gateway-side delivered_at flag. *)
    (* #wak — rete#272 D3.3. The count of this boot's check-ins, sent on the one
       request that is built fresh every tick. porta judges progress from it, and
       it CANNOT ride the push: pushFrame re-sends the same bytes until an ack is
       heard (rete#199), so a count in there is the count from when the frame was
       built — a deaf node would report no progress at all and a lost frame would
       land an old count at a new time. *)
    public pullFrame = (
      ^ Cbor new encode: (Record tag: #pull
          with: #id -> nodeId
          with: #cursor -> cursor
          with: #bid -> self bootId
          with: #hw -> acked
          with: #wak -> wakes) )

    (* Apply one #batch; answer whether it WAS one. An #err reply, a malformed
       datagram or anything else answers false and moves nothing.
       `=` and never `==` on the tag: a decoded Symbol is not the image's
       interned one, and `==` (identity) would silently never match. *)
    public applyBatch: aBytes = (
      | bad r entries i hi |
      bad:: false.
      r:: Cbor new decode: aBytes ifInvalid: [ :m | bad:: true. nil ].
      bad ifTrue: [ ^ false ].
      (outer rankOf: r) = 9 ifFalse: [ ^ false ].
      (r tag = #batch) ifFalse: [ ^ false ].
      entries:: r at: #ent ifAbsent: [ nil ].
      (outer rankOf: entries) = 7 ifFalse: [ ^ false ].
      i:: 1.
      [ i <= entries size ] whileTrue: [
        self applyEntry: (entries at: i).
        i:: i + 1 ].
      hi:: r at: #hi ifAbsent: [ cursor ].
      (outer rankOf: hi) = 2 ifTrue: [ hi > cursor ifTrue: [ cursor:: hi ] ].
      ^ true )

    (* One inbound entry. EVERYTHING here is untrusted: a wrong shape, a wrong
       kind or an out-of-authority path is counted and dropped — never applied,
       never raised. A node that crashes on a malformed datagram is a node an
       attacker can switch off. *)
    applyEntry: row = (
      | path kind value have |
      (outer rankOf: row) = 7 ifFalse: [ rejected:: rejected + 1. ^ self ].
      row size = 4 ifFalse: [ rejected:: rejected + 1. ^ self ].
      path::  row at: 2.
      kind::  row at: 3.
      value:: row at: 4.
      (outer rankOf: path) = 4 ifFalse: [ rejected:: rejected + 1. ^ self ].
      (self mayApply: path) ifFalse: [ rejected:: rejected + 1. ^ self ].
      (kind = 1 or: [ kind = 2 ]) ifFalse: [ rejected:: rejected + 1. ^ self ].
      (* THE KIND MUST BE ASKED, NOT ASSUMED (rete#174). Kind is pinned by the
         first write and re-created by replay, and the wire carries a kind the
         OPERATOR chose — so `put:` on a pinned stream and `out:` on a pinned cell
         are both reachable by one ordinary `porta put --kind …`. Both raise, and
         the raise escapes `applyBatch:` before the high-water is adopted: the
         cursor never advances, the same batch re-pulls, and it raises again every
         tick forever while the exchange goes on looking healthy. A permanent
         wedge, invisible from both ends.
         The write-side twin of `peekCell:ifStream:`, and the same rule as every
         other check here: untrusted input is counted and dropped, never raised. *)
      have:: space kindAt: path.
      (have = 0 or: [ have = kind ]) ifFalse: [
        rejected:: rejected + 1.
        self telLog: #error text: 'kind mismatch'.
        ^ self ].
      kind = 2 ifTrue: [
        space put: path value: value.
        (* #342 spike, #375: the breakpoint set a cold-booting node must re-arm. A
           cell is replayed to a fresh boot's cursor 0 and a dbg/req row is not
           (#262), so the goal is what survives deep sleep. Applied here and not in
           a reaction: a node that wakes, checks in, works and sleeps would run its
           work before any drain set the breakpoint. *)
        (dbgLink == nil or: [ (path = 'goal/debug/main') not ]) ifFalse: [
          dbgLink acceptGoal: value ].
        (* rete#415: the console's tee target, applied here for the same reason: a
           node that wakes, checks in, works and sleeps must tee the work, and a
           profile window cut by that sleep dumps through it. *)
        (path = 'goal/console') ifTrue: [ self applyConsole: value ].
        (* rete#415 Q8: the profile request, a one-shot cell retained across sleep. *)
        (path = 'goal/profile') ifTrue: [ self applyProfile: value ].
        ^ self ].
      (* #342 spike: in a debug image whose debugger talks through the space,
         dbg/req belongs to the debugger, as the cable does (supervisor.nsl's
         commandLoop also answers `profile <ms>`). Handed over here because a
         stopped program runs no drain. *)
      (dbgLink == nil or: [ (path = 'dbg/req') not or: [ (self isDbgLine: value) not ] ]) ifFalse: [
        dbgLink accept: value. ^ self ].
      space out: path value: value.
      ^ self )

    (* rete#415: `Console{addr, port}` points the console's UDP tee; an empty addr
       turns it off. Untrusted like every inbound value: a bad record, or an address
       the platform cannot parse, is logged and changes nothing. *)
    applyConsole: rec = (
      | addr port |
      ((outer rankOf: rec) = 9 and: [ rec tag = #Console ]) ifFalse: [
        self telLog: #error text: 'console bad record'. ^ self ].
      addr:: rec at: #addr ifAbsent: [ nil ].
      port:: rec at: #port ifAbsent: [ nil ].
      ((outer rankOf: addr) = 4 and: [ (outer rankOf: port) = 2 ]) ifFalse: [
        self telLog: #error text: 'console bad record'. ^ self ].
      (outer consoleTee: addr port: port) ifFalse: [
        self telLog: #error text: 'console bad address' ].
      ^ self )

    (* rete#415 Q8: `Profile{ms, id}` is one request, identified by id; ms 0 disarms.
       Checked here, as applyConsole: checks its record; the Profiler owns the rest. *)
    applyProfile: rec = (
      | ms id |
      ((outer rankOf: rec) = 9 and: [ rec tag = #Profile ]) ifFalse: [
        self telLog: #error text: 'profile bad record'. ^ self ].
      ms:: rec at: #ms ifAbsent: [ nil ].
      id:: rec at: #id ifAbsent: [ nil ].
      ((outer rankOf: ms) = 2 and: [ (outer rankOf: id) = 2 ]) ifFalse: [
        self telLog: #error text: 'profile bad record'. ^ self ].
      outer profiler requestMs: ms id: id.
      ^ self )

    (* porta's authority, enforced where it can be believed: goal/** and dbg/req,
       and nothing else. An accepted write to obs/** would forge the node's own
       report of what it observes, which is the one thing the convergence view
       rests on. *)
    mayApply: path = (
      (path = 'dbg/req') ifTrue: [ ^ true ].
      (path = 'goal') ifTrue: [ ^ true ].
      ^ self path: path startsWith: 'goal/' )

    (* No `startsWith:` exists in this dialect — the same grep-confirmed finding
       Space>>isSysPath: and SupervisedJob>>addresses: already record. Byte
       compare over size/at:. *)
    path: p startsWith: prefix = (
      | n i |
      n:: prefix size.
      p size < n ifTrue: [ ^ false ].
      i:: 1.
      [ i <= n ] whileTrue: [
        (p at: i) = (prefix at: i) ifFalse: [ ^ false ].
        i:: i + 1 ].
      ^ true )

    (* ---- the push half ---------------------------------------------------- *)
    (* Answer the encoded #push, or nil when there is nothing to send. Cells come
       from the scan (obs/** newer than `acked`), stream entries from `pending`;
       both carry seqs from the ONE space counter, so merging them ascending is a
       sort and not a reconciliation.

       Then TRIM FROM THE TAIL until the datagram fits: entries dropped here are
       not lost, they ride the next check-in — whereas an oversize datagram is
       lost on the mesh, which is strictly worse.

       Known and accepted for v1 — filed as #150 (P3): trimming from the tail drops the HIGHEST seq
       first, and sys/cheap is written immediately before the push (publishCheap,
       after publishMetrics), so it always holds the highest seq — under batch
       pressure it is the FIRST thing dropped. This used to say sys/metrics;
       rete#190 put sys/cheap behind it and took over the last-written slot.

       THE CAP BOUND AT THIRTY-DAY WIDTHS FOR ONE DAY, AND IT BIT — measured
       2026-08-11 (rete#190), witnessed the same day, fixed by rete#197. The
       four-row steady-state frame (obs/health, sys/metrics, tel/log, sys/cheap)
       encoded to 529 B against maxBatchBytes' 512, so on a long-uptime node also
       emitting a tel/log row, sys/cheap was trimmed on EVERY check-in — and that is
       exactly what a live node did: c6-bench stopped delivering sys/cheap entirely
       while every other row kept arriving every 2 s. #197 shortened every label in
       the frame and it now encodes to 378 B, 134 B under the cap. See
       nodus/tests/22_spacesync/09_batch_size.nsl, which pins it and carries the
       full reasoning, including why shortening CHeap's five names ALONE was
       measured not to reach (one-character names, the floor, land at 503 B).

       #150 IS STILL OPEN. This bought headroom; it did not change the trim rule.
       sys/cheap still holds the highest seq and is still the first row dropped
       whenever the cap does bind, so the structural answer below — reserve bytes
       for sys/ before filling from obs/, or trim BY TYPE — is still the fix, and
       still unfunded. Headroom postpones that question; it does not answer it.

       Why TAIL: porta acks one high-water mark and applyAck: sets `acked:: hw`,
       after which cells are re-scanned `changedSince: acked` — so a frame that
       omitted a LOW seq while carrying a high one would have the ack advance past
       the omitted entry, which `changedSince:` never returns again.

       That is survivable for a cell REWRITTEN every tick (obs/health, sys/metrics:
       the cost is one lost sample, not the value) and permanent for a WRITE-ONCE
       cell. obs/build is the one that bites — written once in main, and it is the
       node's provenance (#74). So tail-trimming is not the only safe rule, it is the
       only rule that needs no knowledge of which paths are write-once.

       REORDERING cannot help either way: metrics are written last precisely so they
       are fresh, and freshness and trim-survival are the same axis pointing opposite
       ways. obs/health is written before `checkIn` starts the exchange (rete#440
       R2), so it rides the SAME push with an older seq — metrics are newest
       wherever inside the exchange they are published.

       So if the cap binds, the answer is to RESERVE bytes for sys/ before filling
       from obs/, or to trim BY TYPE and protect the write-once and must-deliver
       paths — which is the same question already parked above for sys/panic, and is
       probably worth answering once for both. The 87 B of headroom this paragraph
       used to claim (design §9.1, two cells and one tel/log row) was SPENT and then
       overdrawn: three cells and one tel/log row reached 529 B, 17 B over, and the
       "cannot bite today" it rested on turned out to mean "has not bitten yet". It
       did not wait for a node with many obs/ paths — ONE more sys/ cell was enough,
       and the bite was silent. rete#197 bought the headroom back (134 B), which
       resets the counter on this paragraph rather than retiring it: the next field
       added to any record on this frame spends it again, at ~10 B a field. Said out
       loud because a metrics record that silently loses the race under load is
       exactly the observability that lies when it matters. *)
    (* THE THREE INNER SPANS (tuvm#161), nested inside `pushBuild`:

         pushCollect  collectOutbound — the pending walk, the three cell scans,
                      and `valueFits:`, which CBOR-encodes every candidate value
                      in full and throws the bytes away
         pushEncode   the FIRST full-frame encode, re-encoding every one of those
                      values a second time
         pushTrim     the re-encode-per-dropped-row loop

       This is the falsifiable precondition #161 names, and it is the whole point
       of taking it before any fix: the source reading says a value is encoded
       once to be measured, once to be sent, and once more per trim iteration, and
       the two proposed fixes address DIFFERENT terms of that sum — carrying
       `valueFits:`'s bytes into the row pays off in `pushCollect` + `pushEncode`,
       sizing the frame incrementally pays off in `pushTrim`. Without this split,
       "the trim loop is expensive" is a reading of the source, not a finding.

       THE THREE ARE UNCONDITIONAL, so they partition `pushBuild` the way the six
       partition `checkIn`. In particular `pushTrim` is entered on every push even
       when nothing is trimmed, and then measures one failed predicate — a
       near-zero mean against a full sample count is exactly the reading that says
       the loop never fired, where a conditional bracket would report the same
       thing as a missing span. The one place the partition breaks is the empty
       early return, which is the same unreachable-in-practice case `pushStart`
       documents: publishMetrics writes sys/metrics every check-in, so there is
       always a row. *)
    (* THE FRAME IS NEVER ENCODED LARGER THAN IT WILL BE SENT (rete#161/rete#199).

       What it computes is unchanged: the LONGEST PREFIX of `rows` whose encoded
       frame fits `maxBatchBytes`, keeping the lowest seqs and dropping the tail —
       the rule rete#150 still owns and this does not touch.

       WHAT CHANGED IS WHERE IT STARTS. The old walk encoded ALL the rows and then
       dropped one and re-encoded until the result fit. Both of those are costs,
       and MEASUREMENT SAYS THE FIRST ONE IS THE ONE THAT KILLS. A bisection was
       tried first and gated: it cut the walk from ~80 full-frame encodes per
       check-in to ~9 and bought a refused node 114 s -> 168 s of life, and it
       still died — on a 3590 B request, from the exact-size copy `frozenBytes`
       makes of that first oversized encode. Removing the walk was never enough,
       because encoding seventy rows at all is the allocation.

       So the search STARTS FROM WHAT FIT LAST TIME (`fitRows`) and climbs one row
       at a time. It never encodes more than one row beyond the answer, so the
       accumulator never grows past the batch cap by more than a row, and the
       4 KB ByteBuilder rung that fragmented the arena is simply never reached.

       THIS IS EXACT, NOT AN ESTIMATE, and the reason is a property of the codec
       rather than an assumption about the data: `encodeList:` emits the array head
       and then encodes each element INDEPENDENTLY (`encode:into:depth:` carries no
       context but a depth counter). A row costs the same bytes alone as in place,
       so adding a row can only lengthen the frame — the predicate is monotone, and
       hill-climbing a monotone predicate from ANY starting point lands on the same
       boundary the walk walked down to.

       THE STEADY STATE IS ONE ENCODE, which is why this is not a trade. A healthy
       node's rows all fit, so `fitRows` sits at the row count, the climb has
       nowhere to go, and the cost is the single encode the walk also paid — the
       control leg measures `pushTrim` at 2 microseconds. A refused node settles at
       k rows and pays two: one at k, one at k+1 that fails.

       STILL NOT THE WHOLE OF rete#161: fix (1), carrying the bytes `valueFits:`
       already produced instead of discarding them, is untouched. It addresses
       `pushCollect` and the surviving encode, which this leaves as they were. *)
    (* rete#199 — THE CACHE, and why `acked` is the whole of its invalidation rule.

       A push is idempotent by construction and porta dedupes on `seq <= hw`, so
       re-sending the frame the gateway did not accept is exactly what the protocol
       already expects — `checkIn` says so in as many words. `acked` advancing is
       the ONE signal that the node made progress and therefore has something
       different to say; a miss and a refusal both leave it where it was, and both
       are cases where rebuilding produces the same rows at the cost of the
       collect, one `valueFits:` encode per candidate, and a full frame encode.

       A HEALTHY NODE IS UNAFFECTED: it acks every tick, so it rebuilds every tick
       and pays exactly what it paid before. The saving lands entirely on the node
       that is getting nowhere, which is the node that can least afford it.

       NOT DEFERRED SILENTLY: there is no forced rebuild after N refused ticks, so
       a node refused for content rather than for shape re-sends the same rejected
       frame forever. It stays alive and `refused` climbs, which is strictly better
       than the arena death this replaces, and N is exactly the invented tunable
       CLAUDE.md says not to reach for before there is data. What would earn it: a
       refusal that a LATER frame would have satisfied — i.e. porta rejecting one
       row rather than the envelope. Nothing has produced that yet. *)
    public pushFrame = (
      (lastFrame == nil) ifFalse: [
        (acked = lastFrameAcked) ifTrue: [ ^ lastFrame ] ].
      lastFrame:: self buildFrame.
      lastFrameAcked:: acked.
      ^ lastFrame )

    buildFrame = (
      | rows bytes probe n climbing |
      framesBuilt:: framesBuilt + 1.
      spans begin: sPushCollect.
      rows:: self collectOutbound.
      spans end: sPushCollect.
      rows isEmpty ifTrue: [ ^ nil ].

      (* `fitRows` is 0 before the first push and can be stale in either direction
         after any check-in, so it is a HINT and never a bound: clamped into range
         here, and corrected by the climb below either way. A wrong hint costs
         encodes, never rows. *)
      n:: fitRows.
      (n < 1) ifTrue: [ n:: rows size ].
      (n > rows size) ifTrue: [ n:: rows size ].

      spans begin: sPushEncode.
      bytes:: self encodePush: (self firstRows: n of: rows).
      spans end: sPushEncode.

      spans begin: sPushTrim.
      bytes byteSize > self maxBatchBytes
        ifTrue: [
          (* Too big: step down. `n > 1` is the floor the walk also refused to go
             below — a one-row frame that still does not fit is left for the guard
             at the end to drop, because a frame that omits a low seq while
             carrying a high one loses the omitted entry permanently. *)
          [ n > 1 and: [ bytes byteSize > self maxBatchBytes ] ] whileTrue: [
            n:: n - 1.
            bytes:: self encodePush: (self firstRows: n of: rows) ] ]
        ifFalse: [
          (* Fits: climb while there are rows left and the next one still fits.
             `climbing` is the loop's own exit — nsl has no break, and folding the
             test into the whileTrue: condition would re-encode the probe. *)
          climbing:: true.
          [ climbing and: [ n < rows size ] ] whileTrue: [
            probe:: self encodePush: (self firstRows: n + 1 of: rows).
            probe byteSize > self maxBatchBytes
              ifTrue:  [ climbing:: false ]
              ifFalse: [ n:: n + 1. bytes:: probe ] ] ].
      fitRows:: n.
      spans end: sPushTrim.

      bytes byteSize > self maxBatchBytes ifTrue: [ ^ nil ].
      ^ bytes )

    (* A prefix, not a mutation: the climb probes in both directions, so unlike the
       walk it cannot consume `rows` as it goes. *)
    firstRows: n of: rows = (
      | out i |
      out:: OrderedCollection new.
      i:: 1.
      [ i <= n ] whileTrue: [ out add: (rows at: i). i:: i + 1 ].
      ^ out )

    encodePush: rows = (
      ^ Cbor new encode: (Record tag: #push
          with: #id -> nodeId
          with: #bid -> self bootId
          with: #ent -> (List fromCollection: rows)) )

    (* ALL THREE prefixes are the node's own authority (PROTOCOL-NSL §4.1 grants the
       bridge obs/**, tel/**, sys/**, dbg/resp and diag/** outbound); only the cell
       half of that grant used to be implemented, which left RECORDS §4.4's
       sys/metrics — a pinned CELL — unsendable by construction, and is why no node
       app ever published it.

       `diag` joined the scan with tuvm#107, which is the OTHER half of making a span
       capture sendable: #107 split the ~1120 B nested value into sibling cells that
       fit the 256 B cap, and a value that fits but is never scanned is unsendable in
       exactly the same way sys/metrics was. Both halves, or neither is worth having.

       goal/** is porta's authority and is excluded BY CONSTRUCTION, not by a test:
       each scan runs against a capability rooted at its own prefix, and a rooted
       channel cannot learn that `goal/name` was written (22_spacesync/02). There is
       no prefix check here to get wrong.

       maxRows applies PER PREFIX, so up to 2x maxRows rows can enter before pushFrame
       trims by bytes. Safe, and not free — see the starvation note on pushFrame. *)
    public collectOutbound = (
      | rows i r now |
      rows:: OrderedCollection new.
      i:: 1.
      now:: platform monotonicMillis.
      (* rete#444: an entry's 5th field on the wire is its AGE, ms between capture and
         this push, so porta stamps it arrival - age (G6) with no clock or state of
         its own. Rebuilt every push, so a re-sent row's age is never stale. *)
      [ i <= pending size ] whileTrue: [
        r:: pending at: i.
        rows add: (List with: (r at: 1) with: (r at: 2) with: (r at: 3) with: (r at: 4) with: now - (r at: 5)).
        i:: i + 1 ].
      self addCellsFrom: 'obs' into: rows.
      self addCellsFrom: 'sys' into: rows.
      self addCellsFrom: 'diag' into: rows.
      ^ self sortedBySeq: rows )

    addCellsFrom: prefix into: rows = (
      | cells i r |
      cells:: (space channel: prefix) changedSince: acked max: self maxRows.
      i:: 1.
      [ i <= cells size ] whileTrue: [
        r:: cells at: i.
        (self valueFits: (r at: 3))
          ifTrue: [ rows add: (List with: (r at: 2) with: (r at: 1) with: 2 with: (r at: 3) with: 0) ]
          ifFalse: [ rejected:: rejected + 1 ].
        i:: i + 1 ].
      ^ self )

    (* An oversize value is rejected by porta for the WHOLE push, so one bad cell
       would stall every good one behind it. Drop it here, count it, keep going. *)
    (* `byteSize`, not `size`: an immutable Bytes has no `size` — the read
       protocol is byteSize/u8At:. *)
    valueFits: v = ( ^ (Cbor new encode: v) byteSize <= self maxValueBytes )

    sortedBySeq: rows = (
      | i j cur |
      i:: 2.
      [ i <= rows size ] whileTrue: [
        cur:: rows at: i.
        j:: i - 1.
        [ j >= 1 and: [ ((rows at: j) at: 1) > (cur at: 1) ] ] whileTrue: [
          rows at: j + 1 put: (rows at: j).
          j:: j - 1 ].
        rows at: j + 1 put: cur.
        i:: i + 1 ].
      ^ rows )

    (* Apply one #ack. `hw` is what the gateway ACCEPTED, so pending entries at or
       below it are done and cells at or below it need not be re-scanned. A
       trimmed push acks LOWER than we offered — which is correct, and is why the
       watermark is taken from the reply and never from what we sent. *)
    public applyAck: aBytes = (
      | bad r hw keep i row |
      bad:: false.
      r:: Cbor new decode: aBytes ifInvalid: [ :m | bad:: true. nil ].
      bad ifTrue: [ ^ false ].
      (outer rankOf: r) = 9 ifFalse: [ ^ false ].
      (* rete#199 — an #err is porta's REAL terminal answer, and it is a different
         fact from a timeout. Counted here rather than in `pushed:` because this
         is the one place the reply is decoded, and because it makes the property
         testable with no socket in sight (22_spacesync/16). *)
      (r tag = #err) ifTrue: [ ^ self noteRefused: r ].
      (r tag = #ack) ifFalse: [ ^ false ].
      hw:: r at: #hw ifAbsent: [ nil ].
      (outer rankOf: hw) = 2 ifFalse: [ ^ false ].
      hw > acked ifTrue: [ acked:: hw ].
      keep:: OrderedCollection new.
      i:: 1.
      [ i <= pending size ] whileTrue: [
        row:: pending at: i.
        (row at: 1) > acked ifTrue: [ keep add: row ].
        i:: i + 1 ].
      pending:: keep.
      ^ true )

    (* Answers FALSE like every other non-ack path: the caller's question is "did
       this advance the watermark", and a refusal did not.

       ONCE, NOT ONCE PER TICK. A refused node checks in forever, and a message
       repeated every cadence is a message nobody reads — while the FIRST one is
       the line that would have turned rete#199's two-hour diagnosis into a glance.
       A CHANGED message prints again, because the reason changing is itself news.

       Garbage is deliberately NOT counted here: an undecodable datagram is a
       datagram we could not read, and folding it into `refused` would blur the one
       number that separates "the gateway refuses me" from "the gateway is not
       answering" — which is the distinction this counter exists to make. *)
    noteRefused: r = (
      | msg |
      refused:: refused + 1.
      msg:: r at: #msg ifAbsent: [ '' ].
      (self errMsgIsNew: msg) ifTrue: [
        lastErrMsg:: msg.
        ('porta refused this node: ' , msg) out ].
      ^ false )

    errMsgIsNew: msg = (
      lastErrMsg == nil ifTrue: [ ^ true ].
      ^ (lastErrMsg = msg) not )

    (* ---- one check-in ----------------------------------------------------- *)
    (* PULL, apply, PUSH, ack — as reactions (rete#440 R2, design 2026-11-04 "The
       check-in as reactions"). `checkIn` starts an exchange if idle and returns at
       once; nothing here waits. Four events move the exchange on: this send, the
       link (`linkChanged`, rete#440 R3), the socket's doorbell (`readSocket`) and the
       budget's expiry (`budgetLapsed:`).

         state     checkIn        doorbell (read to empty)          budget
         idle      the policy     discard all (stale, counted        —
                   (beginExchange) crossed)
         linking   ignored        discard all; link up → PULL,       a miss, → idle
                                  → pulling (`linkChanged`)
         pulling   ignored        #batch → apply, publish, PUSH,     read first; else a
                                  → pushing; #ack → crossed          miss, PUSH anyway
         pushing   ignored        #ack → applyAck, leave;            read first; else a
                                  #batch → crossed                   miss, leave

       Each leg gives up after `replyBudget` and counts a miss: the next check-in
       re-pulls the same range and re-pushes the same entries, so a miss costs
       latency and nothing else — the whole reason there is no retransmit layer.
       An #err answers whichever leg asked and is not skipped; undecodable traffic
       is discarded. A crossed reply (the OTHER leg's tag, tuvm#108) is discarded,
       never applied: the exchange is idempotent by cursor, so it is cheaper to
       re-ask than to let a reply move state in a leg that did not ask for it. *)
    (* THE SIX SPANS PARTITION THE EXCHANGE, which is the property that makes them
       readable: an exchange is now spread over three reactions, and the six cover
       it from the PULL send to the leaving.

         pullSend   encode the #pull frame and send it
         pullWait   from the send to the reaction that receives the #batch
         applyIn    apply the batch, publish sys/metrics
         pushBuild  collectOutbound + encode + the trim re-encodes
         pushSend   send the #push frame
         pushWait   from the send to the reaction that applies the #ack

       `pushBuild` is itself split three ways by tuvm#161 — pushCollect /
       pushEncode / pushTrim, nested inside it and bracketed in pushFrame. Those
       three do not join the partition above; they partition pushBuild.

       WHY THE SENDS ARE SEPARATED FROM THE WAITS. The first capture off c6-bench
       (docs/results/2026-08-05-c6-span-capture-first.md) found a check-in costing
       ~300 ms and being 97% of the tick, with no way to say whether that was radio
       or VM. The pull frame is ~40 B and rides one 6LoWPAN fragment; a push frame
       runs to the 512 B cap and rides five or six, and a datagram survives only if
       every fragment does. So `pushSend` is the one stretch where fragmentation and
       MAC retries can hide. The waits are now time the VM spends elsewhere or
       idle, and still read as the round trip. `applyAck:` is inside `pushWait`. *)
    public checkIn = (
      (* Counted before the socket test: the count is of TICKS the reactor ran, and
         a node with no socket still ticked (rete#272 D3.3). *)
      wakes:: wakes + 1.
      ^ self beginExchange )

    public state = ( ^ state )

    (* ---- the radio policy (rete#440 R3, #458; design 2026-11-04 "Radio") ------------
       The app says which; the bridge carries it out, in the idle row of the table:

         policy        a check-in while idle                       when the bridge is idle
         always        link down: counted (`skipped`), nothing     —
                       sent; else PULL
         perExchange   radio on; link up: PULL; else wait for      radio off
                       sys/net/link under `linkBudget` (#linking)
         off for N     one last exchange carries sys/radio (as     after it: radio off, N armed;
                       perExchange); then counted (`silent`),      at N, one exchange whatever
                       nothing sent                                the app does, then the policy

       "Idle" is R5's finished rule: no exchange AND no fetch in flight. A check-in that
       sends nothing says `finished` at once, so a run-once node is never left waiting. No
       wait anywhere: the link and N are events, and a deadline is a timer. *)
    public radioAlways = ( ^ self radioPolicy: #always )
    public radioPerExchange = ( ^ self radioPolicy: #perExchange )
    (* Off always has a duration (David, 2026-11-05): a bug in an app's turn-back-on code
       must not strand a node, so N is a timer and at N the bridge does one exchange. N is
       clamped to the liveness ceiling, past which porta could not be told the gap. The
       gap is re-declared on obs/liveness (`gapMisses`), so porta reads the silence as
       planned, not as death; the last exchange carries it with sys/radio. *)
    public radioOffFor: ms = (
      | n |
      n:: ms.
      n < 1 ifTrue: [ n:: 1 ].
      n > self livenessCeilingMs ifTrue: [ n:: self livenessCeilingMs ].
      self endOff.
      offMs:: n.
      radioMode:: #lastCall.
      self publishRadio: #offFor ms: n.
      self declareGap: n + self linkBudget.
      state = #idle ifTrue: [ self beginExchange ].
      ^ self )

    (* ONE number (design "Radio"): how long a per-exchange check-in waits for the link
       after the radio comes on. Twice the worst reconnect observed: OCM.1 through the Pixel
       relay, per exchange at 60 s, 12 samples, 2026-11-10 (rete#458), misses 0:
       5262 3181 3301 1280 676 350 2798 353 342 3185 766 976 ms (median ~1.1 s, worst 5.3 s).
       What would earn another number: a transport whose reconnect differs, measured. *)
    public linkBudget = ( ^ 10000 )

    public radioMode = ( ^ radioMode )
    public radioIsOn = ( ^ radioIsOn )
    public skipped = ( ^ skipped )
    public silent = ( ^ silent )
    (* The last link wait, radio on to link up, in ms; -1 before the first. *)
    public linkMs = ( ^ linkMs )

    radioPolicy: p = (
      self endOff.
      basePolicy:: p.
      radioMode:: p.
      self publishRadio: p ms: 0.
      p = #always ifTrue: [ self radio: true ].
      (state = #idle and: [ fetch busy not ]) ifTrue: [ self settleRadio ].
      ^ self )

    radio: on = ( radioIsOn:: platform radioOn: on. ^ self )

    (* sys/radio, a cell, so the last push before the radio goes off says so. Written only
       when the app sets a policy: a node that never does runs the default, and absence
       says that. *)
    publishRadio: pol ms: n = (
      space put: 'sys/radio' value: (Record tag: #Radio with: #ms -> n with: #pol -> pol).
      ^ self )

    (* The gap, in check-ins, added to the declared misses until the forced exchange. *)
    declareGap: ms = (
      | g room |
      g:: ms + cadMs - 1 // cadMs.
      room:: (self livenessCeilingMs // cadMs) - missBudget.
      room < 0 ifTrue: [ room:: 0 ].
      g > room ifTrue: [ g:: room ].
      gapMisses:: g.
      livenessPublished:: false.
      ^ self )

    (* Leave off-for-N, wherever it is: the N timer cancelled, the gap withdrawn. *)
    endOff = (
      offToken == nil ifFalse: [ timers cancel: offToken. offToken:: nil ].
      gapMisses = 0 ifFalse: [ gapMisses:: 0. livenessPublished:: false ].
      ^ self )

    (* The idle row: what a check-in does when no exchange is in flight. *)
    beginExchange = (
      socket == nil ifTrue: [ ^ self ].
      state = #idle ifFalse: [ ^ self ].
      radioMode = #off ifTrue: [ silent:: silent + 1. ^ self nothingSent ].
      radioMode = #always ifTrue: [
        platform linkUp ifFalse: [ skipped:: skipped + 1. ^ self nothingSent ].
        ^ self startExchange ].
      radioMode = #lastCall ifTrue: [ radioMode:: #carrying ].
      ^ self linkThenExchange )

    (* A check-in that sent nothing is over at once: `finished`, unless the held loop
       asked (it says nothing, as its exchanges do). *)
    nothingSent = (
      holding ifTrue: [ ^ self ].
      owed:: true.
      ^ self announce )

    (* Radio on; the link may already be up (always, or a fetch kept it on). Else wait for
       it under the link budget, armed first for the reason startExchange arms first. *)
    linkThenExchange = (
      self radio: true.
      platform linkUp ifTrue: [ ^ self startExchange ].
      self armBudget: self linkBudget.
      quiet:: holding.
      linkStart:: platform monotonicMillis.
      state:: #linking.
      ^ self )

    (* sys/net/link's reaction: only a wait for the link cares, and only for up. The
       re-arm can find the timer table full (#81), as pushStart's can: raised here it
       would leave #linking with no budget and no wake, so the wait ends as a miss. *)
    linkChanged = (
      state = #linking ifFalse: [ ^ self ].
      platform linkUp ifFalse: [ ^ self ].
      linkMs:: platform monotonicMillis - linkStart.
      ([ self startExchange. true ] on: [ :e | true ] do: [ :e | false ]) ifFalse: [
        self telLog: #error text: 'timer table full'.
        ^ self linkMissed ].
      ^ self )

    (* The link budget lapsed: a miss, and the exchange is over (idle, so the radio goes
       off under per exchange, and `finished`). *)
    linkMissed = (
      misses:: misses + 1.
      self cancelBudget.
      state:: #idle.
      quiet ifTrue: [ quiet:: false. heldExchanges:: heldExchanges + 1. ^ self announce ].
      owed:: true.
      ^ self announce )

    (* The bridge is idle (no exchange, no fetch): the policy's "when idle" column. *)
    settleRadio = (
      radioMode = #carrying ifTrue: [ ^ self goOff ].
      radioMode = #lastCall ifTrue: [ ^ self beginExchange ].
      radioMode = #forced ifTrue: [ radioMode:: basePolicy ].
      radioMode = #perExchange ifTrue: [ self radio: false ].
      ^ self )

    (* After the carrying exchange: the radio off and N armed. Armed FIRST: a full timer
       table (#81) must not leave the radio off with no way back, so the policy stays
       what it was and says so on tel/log. *)
    goOff = (
      ([ offLeg:: offLeg + 1.
         offToken:: timers after: offMs post: offLeg on: offCh. true ]
         on: [ :e | true ] do: [ :e | false ]) ifFalse: [
        self telLog: #error text: 'timer table full'.
        radioMode:: basePolicy.
        self endOff.
        self publishRadio: basePolicy ms: 0.
        ^ self settleRadio ].
      offDeadline:: platform monotonicMillis + offMs.
      radioMode:: #off.
      ^ self radio: false )

    (* N expired: one exchange whatever the app does, carrying the policy it returns to
       and the liveness it had. `n` names the arm, so an expiry from an off the app has
       since left is ignored. *)
    offExpired: n = (
      (radioMode = #off and: [ n = offLeg ]) ifFalse: [ ^ self ].
      offToken:: nil.
      self endOff.
      radioMode:: #forced.
      self publishRadio: basePolicy ms: 0.
      ^ self beginExchange )

    (* The budget is armed FIRST: `timers after:` raises `timer table full` (#81) in
       the job that armed it, and armed first a full table leaves the bridge idle and
       the next check-in tries again, rather than waiting with no wake. *)
    startExchange = (
      self armBudget.
      (* A link wait already said whose exchange this is. *)
      state = #linking ifFalse: [ quiet:: holding ].
      spans begin: sPullSend.
      socket sendTo: peerHost port: peerPort data: self pullFrame.
      spans end: sPullSend.
      spans begin: sPullWait.
      state:: #pulling.
      ^ self )

    (* One one-shot per waiting state, against OEVM_MAX_TARGET_TIMERS. The old one is
       cancelled first, so a re-arm frees the slot it takes. The deadline is read
       BEFORE arming: the timer cannot then fire before the clock says it is due,
       so the held loop's comparison never misses the wake that woke it. *)
    armBudget = ( ^ self armBudget: self replyBudget )

    (* rete#440 R3: the link wait arms the same one-shot, for `linkBudget`. *)
    armBudget: ms = (
      self cancelBudget.
      leg:: leg + 1.
      deadline:: platform monotonicMillis + ms.
      budgetToken:: timers after: ms post: leg on: budgetCh.
      ^ self )

    cancelBudget = (
      budgetToken == nil ifFalse: [ timers cancel: budgetToken. budgetToken:: nil ].
      ^ self )

    (* The doorbell's reaction, and invariant 4 (design "Arrivals"): read the socket
       to EMPTY, on every path, handling each datagram in the state it finds. The
       reader re-arms the doorbell only on an empty answer, so a read that stopped
       early would leave the node alive, idle and deaf. Public for the fetch's own
       budget reaction, which reads first too (OtaFetch>>lapsed:). *)
    public readSocket = (
      | dg |
      socket == nil ifTrue: [ ^ self ].
      dg:: socket receive.
      [ dg == nil ] whileFalse: [
        self arrived: dg data.
        dg:: socket receive ].
      ^ self )

    (* `=` and never `==` on the tags: a decoded Symbol is not the image's interned
       one (tuvm#75). *)
    arrived: bytes = (
      | tag |
      (* The block plane shares this socket (rete#440 R5): its frames are the fetch's. *)
      (fetch isBlockFrame: bytes) ifTrue: [ ^ fetch arrived: bytes ].
      tag:: self tagOf: bytes.
      tag == nil ifTrue: [ ^ self ].
      state = #pulling ifTrue: [
        tag = #ack ifTrue: [ crossed:: crossed + 1. ^ self ].
        ^ self pulled: bytes ].
      state = #pushing ifTrue: [
        tag = #batch ifTrue: [ crossed:: crossed + 1. ^ self ].
        ^ self pushed: bytes ].
      (tag = #batch or: [ tag = #ack ]) ifTrue: [ crossed:: crossed + 1 ].
      ^ self )

    (* The pull leg's end: `bytes` is the reply, or nil for a miss. A pull miss
       still pushes, as it always has. *)
    pulled: bytes = (
      spans end: sPullWait.
      spans begin: sApplyIn.
      bytes == nil
        ifTrue: [ misses:: misses + 1 ]
        ifFalse: [ self applyBatch: bytes ].
      (* In THIS order: applying goal/** first means the metrics published here
         describe the state porta just asked for, not the one before it. *)
      (* publishApps BEFORE publishMetrics, and that order is not arbitrary:
         pushFrame trims from the TAIL of an ascending-seq frame, so the LAST
         cell written before the push is the first one dropped under batch
         pressure. sys/metrics is rewritten every check-in and can afford to lose
         a sample; obs/apps/main is written ONCE per boot (see publishApps), so
         losing its one push would leave the node's answer to "what are you
         running" permanently absent — the write-once trim hazard the pushFrame
         comment already records for obs/build, and now a second instance of it.
         obs/liveness joins that group and for the same reason — it is written once
         per boot, so it must be ahead of the per-check-in rows that can afford to
         lose a sample. *)
      self publishApps.
      self offerPanic.
      (* BEFORE publishLiveness, so a request arriving on this exchange is answered
         on this exchange rather than the next: adoptCad:misses: clears
         livenessPublished and the publish below is what carries the answer back. *)
      self applyLivenessGoal.
      self publishLiveness.
      self publishMetrics.
      self publishCheap.
      spans end: sApplyIn.
      ^ self pushStart )

    (* This early return is the ONE place the six stop partitioning the exchange, and
       in practice it is unreachable: publishMetrics writes sys/metrics on every
       exchange and `collectOutbound` scans sys/**, so there is always at least one
       row. A bridge that has nothing to say must not send an empty frame. *)
    pushStart = (
      | frame |
      spans begin: sPushBuild.
      frame:: self pushFrame.
      spans end: sPushBuild.
      frame == nil ifTrue: [ ^ self leave ].
      (* A re-arm can find the table full (#81): after a lapse the fired one-shot
         freed nothing this reaction can count on, and another job may have taken
         the slot. Raised here it would strand the bridge in #pulling with no wake,
         so the exchange leaves instead (idle, `finished` posted) and the next
         check-in tries again. The push it would have sent rides that one. *)
      ([ self armBudget. true ] on: [ :e | true ] do: [ :e | false ]) ifFalse: [
        self telLog: #error text: 'timer table full'.
        ^ self leave ].
      spans begin: sPushSend.
      socket sendTo: peerHost port: peerPort data: frame.
      spans end: sPushSend.
      spans begin: sPushWait.
      state:: #pushing.
      ^ self )

    (* The push leg's end: `bytes` is the reply, or nil for a miss. *)
    pushed: bytes = (
      bytes == nil
        ifTrue: [ misses:: misses + 1 ]
        ifFalse: [ self applyAck: bytes ].
      spans end: sPushWait.
      ^ self leave )

    (* The budget's reaction. `n` is the leg it was armed for: an expiry already on
       its way when a reply moved the exchange on names an older leg, and is
       ignored — `Timers>>dispatch:` drops a cancelled token, but not one it had
       already dispatched before the reply's reaction cancelled it. *)
    budgetLapsed: n = (
      | raised |
      (n = leg and: [ (state = #idle) not ]) ifFalse: [ ^ self ].
      (* From here to the push leg's re-arm (`pulled: nil` → publish → `pushFrame`) no
         budget is armed: this expiry was it. A raise in that stretch, swallowed by the
         reaction's `protectedFire:`, would leave the bridge waiting with no wake, so it
         leaves the exchange instead (idle, `finished` posted) and says so on tel/log. *)
      raised:: [ self lapse. nil ] on: [ :e | true ] do: [ :e | e ].
      (raised == nil or: [ state = #idle ]) ifFalse: [
        (* The tel/log text stays fixed, so a query can count it; the raise's own text,
           which the supervisor's crash line used to carry, goes to the console. *)
        ('porta: exchange raised: ' , (raised at: #text ifAbsent: [ 'unknown' ])) out.
        self telLog: #error text: 'exchange raised'.
        self leave ].
      ^ self )

    (* Read first: a reply found is an arrival, not a miss. Only a leg the read did
       not move on is a miss. *)
    lapse = (
      | was |
      was:: leg.
      self readSocket.
      (leg = was and: [ (state = #idle) not ]) ifFalse: [ ^ self ].
      state = #linking ifTrue: [ ^ self linkMissed ].
      state = #pulling ifTrue: [ ^ self pulled: nil ].
      ^ self pushed: nil )

    (* Leaving an exchange — the moment the tail of the old blocking `checkIn` ran.
       Idle FIRST: waking the debugger stops the program at its next bytecode, which
       is in this method, and the held loop must then find an idle bridge, not one
       still pushing with its budget cancelled. Then wake the debugger if lines
       arrived; then `otaCheck`, after the push on the same exchange (design D6);
       then `finished`, once no fetch is in flight either (`announce`). An exchange the
       held loop started (`quiet`) does none of these; while held, the app's own
       exchange skips the wake and the otaCheck — the debugger is already stopped, and
       an activation would exit under it — but still says it finished, because a
       run-once node is waiting to hear it. *)
    leave = (
      self cancelBudget.
      state:: #idle.
      quiet ifTrue: [ quiet:: false. heldExchanges:: heldExchanges + 1. ^ self announce ].
      holding ifFalse: [
        (dbgLink == nil or: [ dbgLink pending not ]) ifFalse: [ outer debugger wake ].
        (* Outside all six spans: otaCheck is not exchange time. The position is the
           whole timing mechanism (design D6): a stage on exchange T writes
           `tel/log 'ota staged'` here, the reaction captures it before exchange
           T+1, and T+1's push delivers it BEFORE T+1's otaCheck activates.
           Activation exits the process, so a log line written on the exit
           exchange would die unpushed in the in-RAM pending queue — the one-tick
           delay is what makes a rollout's last words reach the gateway. *)
        self otaCheck ].
      owed:: true.
      ^ self announce )

    (* `finished` means the bridge is idle (rete#440 R5, addendum 2026-11-10): said once
       for whatever an app's exchanges and fetch owe, and only when neither an exchange
       nor a fetch is in flight. A fetch the first exchange of a wake starts therefore
       ends before the run-once node hears `finished`, checks in again and, on that
       exchange's otaCheck, activates. *)
    announce = (
      (* rete#440 R3: the radio's "when idle" first; it may begin the exchange that
         carries sys/radio, and `finished` then waits for that one. *)
      (state = #idle and: [ fetch busy not ]) ifTrue: [ self settleRadio ].
      (owed and: [ state = #idle and: [ fetch busy not ] ]) ifFalse: [ ^ self ].
      owed:: false.
      exchangeCh out: '' value: #finished.
      ^ self )

    (* The fetch's end, in its own reaction (OtaFetch>>end:). A staged image is recorded
       HERE, not at the next otaCheck, so the very next exchange activates it: on a
       deep-sleep node the stage does not outlive the wake. The pair comes from the fetch;
       otaCheck step 2 boots it only while the goal still names its hash, so a goal
       retargeted mid-fetch drops it instead. *)
    public fetched: ok = (
      self noteStage: ok hash: fetch hash sig: fetch sig.
      owed:: true.
      ^ self announce )

    noteStage: ok hash: h sig: s = (
      ok ifFalse: [ ^ self telLog: #error text: 'ota stage failed' ].
      stagedHash:: h.
      stagedSig::  s.
      otaStaged::  true.
      ^ self telLog: #info text: 'ota staged' )

    (* For the suite: the fetch, to drive and read without a gateway. *)
    public otaFetch = ( ^ fetch )

    (* #56 capability (3): "metrics die with the node", and /stats is a PULL, which
       is a human affordance — an agent arrives after the corpse is cold.

       The record is BUILT by the kernel and WRITTEN by the bridge, which holds
       `space` only because the app granted it at construction; the kernel never
       conjures space access. Publishing here rather than in each app is design D4:
       every bridged app inherits metrics without re-implementing anything, which is
       the duplication that gave obs/health three inconsistent definitions.

       v1 publishes on EVERY check-in. Escalating on degradation was designed and
       deliberately staged out (design D6): it needed five invented constants, and D7
       had already capped its worst case at exactly this — one record per check-in.
       The ceiling of the elaborate design is the simple design, and it is the only
       setting whose cost can be measured. Do not add cadence logic here without the
       data D6 names as earning it back. *)
    public publishMetrics = (
      space put: 'sys/metrics' value: outer metrics.
      ^ self )

    (* rete#114 — sys/panic is MUST-DELIVER (RECORDS §4.4, design D4 of
       porta/docs/design/2026-08-26-space-sync-durability-trio-design.md):
       re-offered until porta's ACK covers the offered entry, from the durable
       source that is the #215 RebootNote. Run once per check-in. Three states:

         - a STANDING offer (its captured row still in `pending`) is left
           alone — no duplicate rides while the last is in flight. The seq is
           (re)latched from the row here because capture is DEFERRED: `out:`
           only enqueues on the space ring and the bridge's own subscription
           stamps the row at the app's next `space drain`, so at publish time
           the stamp does not exist yet.
         - a VANISHED offer whose seq `acked` covers is the receipt: ack the
           note. This replaces the app-side reportPanicOnce's clean-check-in
           GUESS — the note now clears on porta's high-water covering the
           entry, never on hope — and §5.2's loop-breaker reset rides it
           exactly as before, just later and honestly.
         - a VANISHED offer NOT covered was evicted by the bounded queue
           (capture: clears panicSeq as it evicts): re-publish. This arm is
           what D4's "re-offered per check-in" buys — a long disconnection
           must not turn must-deliver into dropped-once.

       Duplicates in an append-only log are acceptable; loss is not. Public
       for the same reason pushFrame and applyAck: are — the whole loop is
       host-testable with no socket (22_spacesync/24). *)
    public offerPanic = (
      | i p |
      i:: 1.
      [ i <= pending size ] whileTrue: [
        (((pending at: i) at: 2) = 'sys/panic') ifTrue: [
          panicSeq:: (pending at: i) at: 1.
          ^ self ].
        i:: i + 1 ].
      (panicSeq > 0 and: [ acked >= panicSeq ]) ifTrue: [
        outer panicNoteAck: bootId.
        panicSeq:: 0.
        ^ self ].
      p:: outer panic.
      (p == nil) ifTrue: [ ^ self ].
      space out: 'sys/panic' value: p.
      ^ self )

    (* rete#190: the C-heap twin of publishMetrics. Same cadence, same rationale —
       one record per check-in, no escalation logic, no invented constants. *)
    publishCheap = (
      space put: 'sys/cheap' value: outer cheap.
      ^ self )

    (* rete#25 — the observed half of the image pair. `goal/apps/main` is what
       porta wants running; this is what IS running, so the rollout view is the
       same tree diff every other convergence question is, with no rollout table
       and no per-node status verb.

       SILENT WHEN THE NODE DOES NOT KNOW. `otaRunningHash` answers nil on any
       node launched without a runner environment — every host run of this tree,
       the porta_sync_host gate included — and the honest report of "I cannot
       name my own image" is to write NOTHING, not to publish a nil hash or an
       #unknown lifecycle. Absence is already the reading obs/build carries for
       the same case (#74), and a published placeholder would make a bare node
       and a node whose runner broke look identical from the gateway.

       `#running` is the only lifecycle this node can honestly claim: it is
       executing, and it says so. The trial/confirmed distinction lives in the
       runner's own markers and in `otaTrial`, not here — publishing it would
       mean two places answer "is this image confirmed", and they would
       eventually disagree.

       WRITTEN ONCE PER BOOT, which is the obs/build precedent (#74) and not an
       optimisation. The running hash cannot change without the process exiting,
       so every rewrite would carry identical bytes — but `put:` refreshes the
       cell's seq unconditionally (it does not compare values), so a per-check-in
       write would make `changedSince: acked` re-send this ~55 B row on EVERY
       push, forever, against 87 B of measured headroom (design §9.1). That is
       not just waste: `pushFrame` trims from the tail when the batch overflows,
       and the row it would start dropping is whatever was written last — which,
       on the tick a rollout activates, is the `ota staged` log line that is the
       only record the node leaves behind before it exits. A cell that never
       changes must not be allowed to crowd out the one that does. *)
    (* rete#259: obs/build in ONE place. rete#243 added the conditional #man
       field and had to edit five app files identically — the divergence-by-copy
       smell the manifest exists to catch downstream, removed at the source. An
       app supplies only its chip symbol; called once from app setup, so it
       needs no once-per-boot guard the way publishApps does. #man rides iff the
       image carries a pin (rete#243) — a pinless build (host, pre-manifest)
       omits the field, absence meaning "cannot say". #board (rete#118) is the
       build-time board name and follows the same rule: a build told no name omits
       the field, never an empty string. *)
    public publishBuild: chipSym = (
      | pin name pairs |
      pairs:: OrderedCollection new.
      pairs add: #chip -> chipSym.
      pairs add: #build -> outer buildId.
      pin:: outer manifestPin.
      pin == nil ifFalse: [ pairs add: #man -> pin ].
      name:: outer boardName.
      name == nil ifFalse: [ pairs add: #board -> name ].
      space put: 'obs/build' value: (Record tag: #Build fields: (Map fromPairs: pairs)).
      ^ self )

    publishApps = (
      | h |
      appsPublished ifTrue: [ ^ self ].
      h:: outer otaRunningHash.
      h == nil ifTrue: [ ^ self ].
      space put: 'obs/apps/main' value: (Record tag: #AppObs
        with: #image -> (Record tag: #BlobRef with: #hash -> h)
        with: #lifecycle -> #running).
      appsPublished:: true.
      ^ self )

    public cadMs      = ( ^ cadMs )
    public missBudget = ( ^ missBudget )
    (* DERIVED, never stored and never on the wire (rete#273 D2). *)
    public budMs      = ( ^ cadMs * missBudget )
    (* rete#273 D1: the EFFECTIVE app cadence — the declaration, or the bridge's
       default of telCad x 8 when the app said nothing. This is the number the
       observer holds. *)
    public appCadMs   = ( appCadDeclared = 0 ifTrue: [ ^ cadMs * 8 ]. ^ appCadDeclared )

    (* rete#231 D7 — the one invented constant in the design, and it is a ceiling on
       the DECLARATION rather than a cadence: a node speaking once a month is free to
       try, it simply cannot promise a month of silence and still be considered
       healthy. 24 h is the coarsest granularity at which a fleet is still a fleet.
       Since rete#273 D2 it bounds the PRODUCT telCad x misses, clamped on misses. *)
    livenessCeilingMs = ( ^ 86400000 )

    (* rete#231 D2/D7, rete#273 D2 — the ONE place a liveness pair is adopted,
       whether it came from the app (here) or from porta (applyLivenessGoal).

       CLAMPED, NEVER REJECTED. Every path out of this method adopts something and
       publishes it, so `goal/liveness` versus `obs/liveness` always answers "did the
       node accept?" — a silent refusal would read exactly like acceptance. *)
    adoptCad: aCadMs misses: aMisses = (
      | cad n ceiling cadMoved |
      ceiling:: self livenessCeilingMs.
      cad:: aCadMs.
      cad < 1 ifTrue: [ cad:: 30000 ].
      cad > ceiling ifTrue: [ cad:: ceiling ].
      n:: aMisses.
      n < 1 ifTrue: [ n:: 1 ].
      n > (ceiling // cad) ifTrue: [ n:: ceiling // cad ].
      (cad = cadMs and: [ n = missBudget ]) ifTrue: [ ^ self ].
      cadMoved:: (cad = cadMs) not.
      cadMs:: cad.
      missBudget:: n.
      (* rete#240.2 — an adopted cadence is a KEPT cadence: re-arm the base tick
         at the new period, and re-declare the app cadence, whose default rides
         on it. Guarded on tickToken so a pre-startTickingOn: declaration just sets
         the period startTickingOn: will use. *)
      (cadMoved and: [ (tickToken == nil) not ]) ifTrue: [
        timers cancel: tickToken.
        tickToken:: timers every: cadMs post: #go on: tickChannel.
        self declareAppCad ].
      (* The pair moved, so the published cell is stale. Clearing the flag is the
         whole of the re-publish mechanism — no second path, no dirty list. *)
      livenessPublished:: false.
      ^ self )

    (* The app's declaration of how often it will speak and how many misses it
       tolerates. A SETTER and not a constructor argument, on purpose (see
       startTickingOn:). *)
    public liveness: aCadMs misses: aMisses = ( ^ self adoptCad: aCadMs misses: aMisses )

    (* rete#273 D1 — the app's declaration of how long its event dispatch may go
       without running. 0 withdraws it and the bridge's default (telCad x 8) is
       back in force. Clamped to the same 24 h ceiling, published to the OBSERVER
       only — this number never rides the wire. Takes effect at once if the tick
       is already armed, otherwise at startTickingOn:. *)
    public appLiveness: aMs = (
      | ms |
      ms:: aMs.
      ms < 0 ifTrue: [ ms:: 0 ].
      ms > self livenessCeilingMs ifTrue: [ ms:: self livenessCeilingMs ].
      appCadDeclared:: ms.
      (tickToken == nil) ifFalse: [ self declareAppCad ].
      ^ self )

    (* The one send that reaches the observer: the EFFECTIVE number, prim 158.
       The observer sees a number and not its provenance — only this class knows
       whether the app chose it or the default stood in (rete#273 D1.1's dump
       question is answered from here, not from the sample). *)
    declareAppCad = (
      platform appLiveness: self appCadMs.
      ^ self )

    (* rete#231 D1 — the heartbeat, owned by the kernel and riding the reactor.

       NOT C ON ITS OWN THREAD, and the reason is not cost: a heartbeat a wedged
       node can still emit is `port=up` with better manners, which is the exact
       lie #152 is about. On the reactor, a wedged node stops emitting it, so its
       absence means something. It also adds no C at all — `timer_target_snapshot`
       already reports every live repeating timer to the #215 observer, so this one
       registration gives the detector a deadline that always exists AND drives the
       check-in. A node whose app declares no repeating timer of its own stops
       being invisible to the detector, which is the case nothing could see before.

       THE TIMERS INSTANCE IS HANDED IN, at construction since rete#440 R2 (it
       was this method's argument). Before rete#244 `platform timers`
       answered a FRESH instance per send, and a bridge that minted its own
       registered tokens the app's dispatcher had never heard of — every tick
       dropped in silence. The accessor answers the singleton now, so the
       hazard is an explicitly-constructed second registry; handing the
       instance keeps the wiring visible either way.

       ONCE PER BOOT. Two timers at one period is two check-ins per tick forever,
       and the second is invisible until someone counts radio wakeups.

       The app still owns what a tick DOES — it keeps its own reaction on the
       channel. What moves here is the period and the fact that a period exists at
       all, which is the half the detector needs and the half an app can forget. *)
    public startTickingOn: aChannel = (
      tickToken == nil ifFalse: [ ^ self ].
      tickChannel:: aChannel.
      tickToken:: timers every: cadMs post: #go on: aChannel.
      self declareAppCad.
      ^ self )

    (* rete#231 D2 — porta's REQUEST, read once per check-in from the tail of the
       apply step. No timer, no reaction: the cadence is the check-in's.

       THE NODE ALWAYS WINS, and it wins by publishing rather than by refusing.
       Every request is adopted through the same `adoptCad:misses:` the app's own
       declaration goes through, so the clamp applies identically — an operator
       asks for 604800 misses on a 2 s node, `obs/liveness` answers 43200, and
       the divergence is the whole answer. Since rete#273 D2 the request names
       `misses` and `telCad`; the budget is their product and is never sent.

       THE CADENCE HALF IS HONOURED since rete#240.2 — Task 10 landed the kernel
       base tick, so an adopted cadence is now a kept one: adoptCad:misses: re-arms
       the tick when the cadence moves. The record's telCad is read like its
       misses, and a request missing either is the same bad record. (Until Task 10 the
       cad was deliberately re-asserted from what the node really did, because
       adopting a cadence the app's own timer did not keep would have published
       the `port=up` lie this design exists to refuse.)

       `peekCell:ifStream:` and never `peek:` — see otaCheck's comment at length:
       a gateway can legally create this leaf as a STREAM, and a raise here would
       be caught by `protectedFire:`, abandoning the rest of the reaction that
       drives the tick. obs/health and tel/log would stop, permanently, with
       nothing logged. *)
    public applyLivenessGoal = (
      | rec n cad |
      rec:: space peekCell: 'goal/liveness' ifStream: [
        self telLog: #error text: 'liveness bad record'.
        nil ].
      rec == nil ifTrue: [ ^ self ].
      rec tag = #Liveness ifFalse: [
        self telLog: #error text: 'liveness bad record'.
        ^ self ].
      n:: rec at: #misses ifAbsent: [ nil ].
      n == nil ifTrue: [
        self telLog: #error text: 'liveness bad record'.
        ^ self ].
      cad:: rec at: #telCad ifAbsent: [ nil ].
      cad == nil ifTrue: [
        self telLog: #error text: 'liveness bad record'.
        ^ self ].
      ^ self adoptCad: cad misses: n )

    (* rete#231 D2 — the node's own authority, on the node's own path. porta writing
       obs/** would be a lie (2026-08-10 D7), so the operator gets goal/liveness and
       a tree diff instead (Task 6); the node always wins.

       Written once per boot for the reason publishApps gives at length: `put:` does
       not compare values, so a per-check-in write would re-send an unchanging ~30 B
       row on every push forever, and the row pushFrame's tail-trim starts dropping
       is whatever was written last.
       rete#440 R3: while the radio is off for N the misses carry the planned gap
       (`gapMisses`), so porta reads the silence as declared; it is withdrawn at N. *)
    public publishLiveness = (
      livenessPublished ifTrue: [ ^ self ].
      space put: 'obs/liveness' value: (Record tag: #Liveness
        with: #misses -> (missBudget + gapMisses)
        with: #telCad -> cadMs).
      livenessPublished:: true.
      ^ self )

    (* rete#25 — the ENTIRE image-update policy, run once per exchange as it
       leaves (`leave`). No timer, no job and no `whenever:` reaction of its own:
       the cadence is the check-in's cadence, and the ordering the design needs
       falls out of the call site (see leave). A `whenever:` on
       `goal/apps/main` would buy nothing but an unpredictable moment to exit the
       process in.

       The five steps are ORDERED, and each ordering is load-bearing:

       1. CONFIRM FIRST, and only after an ack. `acked > 0` is the node's proof
          that this image can still talk to the gateway — the one property a
          rollback exists to protect. Confirming on boot instead would confirm an
          image that cannot reach anyone, which is exactly the brick the trial
          marker is there to prevent. Once per boot: `otaConfirm` is cheap but not
          free, and a confirm per check-in would write flash every two seconds.

       2. ACTIVATE ONLY WHAT THE GOAL STILL NAMES. `otaActivate:` does not return
          — it exits into the runner — so anything after it in this method is dead
          code on the tick it fires. The staged pair comes from the slots, never
          from the goal, so a gateway that rewrote the goal between staging and
          activating cannot send us into a reboot with a hash we never fetched. But
          the goal is still READ: a stage whose hash the goal no longer names is
          dropped, not booted (rete#440 R5, addendum 2026-11-10: a retarget mid-fetch
          never activates the old image, T9's behaviour), and this same check-in
          goes on to stage the goal it names now.

       3. NOTHING TO DO IS THE COMMON CASE. A node with no `goal/apps/main` (every
          node in the fleet, almost always) does one cell peek and returns.

       4. A MALFORMED RECORD IS A LOG LINE, NOT A CRASH. It arrives off the wire
          from a gateway this node cannot audit; `otaWantedFrom:` answers nil for
          every shape that is not exactly the pinned one, and the node keeps
          running. Logged every check-in on purpose — a gateway writing garbage to
          this path is not a transient, and one line at boot would scroll away
          long before anyone looked.

       5. THE FETCH IS REACTIONS, AND IS STARTED HERE (rete#440 R5; a thread since
          rete#233 T9, because ~55 s over Thread in one prim is what the observer's
          app-stale rule reboots). `OtaFetch>>start:` answers at once: #staged when
          the slot already holds the image, #failed, or #started — logged as
          `ota staging N`, the bytes on hand, and again at every check-in while it
          runs. Its end is `fetched:`, which records the stage and logs `ota staged`
          or `ota stage failed`. The slot's length is the cursor, so nothing is lost
          between fetches. A FAILED STAGE IS NOT REMEMBERED: the next check-in simply
          tries again, a retry loop with no backoff state and no give-up threshold —
          none of which there is data to choose yet (design D6, rete#175).

       The block plane is `peerPort + 1` by construction, not by configuration —
       one address, one port pair, nothing new to provision. *)
    (* PUBLIC only so the suite can drive one decision without a socket: `checkIn`
       returns at its first line when `socket == nil`, so there is no other way in,
       and the trial-unconfirmed guard below is a claim worth a test rather than a
       gate. No app calls this — the cadence is `checkIn`'s and must stay so. *)
    public otaCheck = (
      | rec want hash sig r |
      (otaConfirmed not and: [ acked > 0 and: [ outer otaTrial ] ]) ifTrue: [
        outer otaConfirm.
        otaConfirmed:: true.
        self telLog: #info text: 'ota confirmed' ].
      otaStaged ifTrue: [
        (self goalNames: stagedHash) ifTrue: [ ^ outer otaActivate: stagedHash sig: stagedSig ].
        otaStaged:: false. stagedHash:: nil. stagedSig:: nil.
        self telLog: #info text: 'ota retargeted' ].
      (* A TRIAL-UNCONFIRMED NODE NEVER STAGES. Found in the Task 8 runner review
         and fixed here, because the node is the only place it can be fixed.

         The chain: a trial node that stages exits 42, and the runner handles
         exit-42 BEFORE the trial-unconfirmed revert (design §5 step 3, in that
         written order) — so the manifest ends `active = an image that was never
         confirmed`, `prev` cleared to the image that was itself on trial. The
         last known-good image is now in neither slot and §5's own invariant,
         "`prev` is never itself trial", is broken. Reordering the RUNNER makes it
         worse rather than better: by exit-42 time the staging has already
         overwritten the rollback slot, so a revert-first runner would verify-fail
         against a cleared `prev` and exit 3 — a hard brick instead of a bad
         manifest.

         Deferring the stage removes the whole class from the node side and costs
         nothing. A retarget arriving inside the 30 s trial window simply waits:
         either this node confirms (step 1 above, on the next tick with an ack)
         and the tick after that stages normally, or the watchdog reverts and the
         REVERTED image's next tick reads the same goal and stages from a proven
         base. One tick of latency, at most, and nothing is lost — the goal is a
         cell, so it is still there whichever way the trial ends.

         Placed after the confirm and activate steps, not before them: a node that
         can confirm this tick has already done so above, and must not then be
         held back by the flag it just cleared. *)
      (otaConfirmed not and: [ outer otaTrial ]) ifTrue: [ ^ self ].
      (* `peekCell:ifStream:` and never `peek:`. A gateway can create this leaf as
         a STREAM (`porta put --raw --kind stream` is a legal write), kind is
         pinned by the first write and re-created by replay, and `peek:` would
         raise `'not a cell'` here on every tick forever. That raise is caught by
         `protectedFire:` in whatever reaction drives the tick, which ABANDONS the
         rest of that reaction's body — so obs/health and tel/log would silently
         stop while the exchange kept working, permanently, with nothing logged.
         A wrongly kinded leaf is a peer disagreeing with the pinned record, so it
         gets the same report a malformed value gets. *)
      rec:: space peekCell: 'goal/apps/main' ifStream: [
        self telLog: #error text: 'ota bad record'.
        nil ].
      rec == nil ifTrue: [ ^ self ].
      want:: self otaWantedFrom: rec.
      want == nil ifTrue: [
        self telLog: #error text: 'ota bad record'.
        ^ self ].
      hash:: want at: 1.
      sig::  want at: 2.
      (outer otaIsRunning: hash) ifTrue: [ ^ self ].
      fetch busy ifFalse: [
        r:: fetch start: hash sig: sig host: peerHost port: peerPort + 1.
        r = #started ifFalse: [ ^ self noteStage: r = #staged hash: hash sig: sig ] ].
      self telLog: #info text: 'ota staging ' , fetch staged printString.
      ^ self )

    (* Whether `goal/apps/main` still names `aHash`. Quiet on a bad or wrongly kinded
       record: the stage is then simply not booted, and the read below reports it. *)
    goalNames: aHash = (
      | rec want |
      rec:: space peekCell: 'goal/apps/main' ifStream: [ nil ].
      rec == nil ifTrue: [ ^ false ].
      want:: self otaWantedFrom: rec.
      want == nil ifTrue: [ ^ false ].
      ^ (want at: 1) = aHash )

    (* tel/log carries a `Log { level, text }` record and NOT a bare String —
       PROTOCOL-NSL-RECORDS §4 pins the shape, both production node apps already
       honour it, and porta's log query reads the fields. A bare String would
       decode and store fine and then be un-filterable by level, which is the
       kind of divergence that is only ever noticed once someone needs it.

       Levels: staging and confirming are the machine reporting progress it was
       asked for (#info); a bad record, a wrongly kinded leaf and a failed stage
       are all "this is not happening" (#error).

       Named `telLog:` and not `otaLog:` since rete#174: the ota tail was merely
       its first caller, and `applyEntry:`'s kind-mismatch report is the second.
       One helper rather than one per caller — the shape it writes is pinned by
       RECORDS §4 for every writer, not for ota. *)
    telLog: level text: text = (
      space out: 'tel/log' value:
        (Record tag: #Log with: #lvl -> level with: #txt -> text).
      ^ self )

    (* The pure decision: given whatever sits at `goal/apps/main`, answer the
       {hash, sig} pair this node is being asked to run, or nil for "nothing to
       do". Split out of `otaCheck` because it is the only part with an answer
       worth asserting — every case below is a datagram a gateway can send, and
       they are exercised as such in 24_ota/03 with no socket in sight.

       `outer rankOf:` and not `isRecord`, for the reason applyEntry: already
       gives: `rankOf:` is the NATIVE oracle and classifies a builtin — nil
       included — where an nsl predicate send would first have to find a vtable.
       `=` and never `==` on both tags: these Symbols came off the wire through a
       real decode and are not the image's interned ones (tuvm#75).

       Both fields are REQUIRED and neither is defaulted. An absent signature is
       not "unsigned, carry on" — the runner is the one seat where verification
       happens (design D4), and handing it a record with the provenance quietly
       missing would leave it nothing to check. *)
    public otaWantedFrom: rec = (
      | img hash sig |
      (outer rankOf: rec) = 9 ifFalse: [ ^ nil ].
      rec tag = #App ifFalse: [ ^ nil ].
      img:: rec at: #image ifAbsent: [ nil ].
      (outer rankOf: img) = 9 ifFalse: [ ^ nil ].
      img tag = #BlobRef ifFalse: [ ^ nil ].
      hash:: img at: #hash ifAbsent: [ nil ].
      hash isBytes ifFalse: [ ^ nil ].
      sig:: rec at: #sig ifAbsent: [ nil ].
      sig isBytes ifFalse: [ ^ nil ].
      ^ List with: hash with: sig )

    (* The tag, or nil for anything that is not a decodable Record — which `arrived:`
       discards. *)
    tagOf: aBytes = (
      | bad r |
      bad:: false.
      r:: Cbor new decode: aBytes ifInvalid: [ :m | bad:: true. nil ].
      bad ifTrue: [ ^ nil ].
      (outer rankOf: r) = 9 ifFalse: [ ^ nil ].
      ^ r tag )

  ) : (
    public socket: s space: sp id: anId peer: h port: p spans: sn timers: t = (
      ^ self new setSocket: s space: sp id: anId peer: h port: p spans: sn timers: t )
  )

  public serialOn: aPort = ( ^ Serial onPort: aPort )
  public netOn: aPort = ( ^ Net onPort: aPort )

  (* Capability-scoped channel (Milestone C Task 2, addendum A1) — a
     rooted-prefix capability into the C tuple-space singleton (Task 1's
     space.c substrate, reached only by selector via `platform`; there is no
     nsl-side storage here beyond the root string). `root` is set once at
     construction, always a `checkPath:`-validated canonical relative path
     ('' is the legal root-of-everything path). Every verb resolves its
     ARGUMENT path against `root` via the shared `resolve:` helper below
     before ever reaching a `platform space...` prim, so a capability can
     only ever name a channel at-or-under its own root: segment-aligned per
     A1 (a capability rooted at `sensor` does NOT address `sensors/temp` —
     `resolve:` always joins with an explicit `/` separator, so the two can
     never collapse to the same string) and never silently normalized
     (`checkPath:` rejects, it does not fix up). There is no accessor for
     `root` itself and no widening operation — the only ways to obtain a
     capability are `channel:` (monotonic attenuation: the child's resolved
     root is always the parent's root plus a validated suffix) or the
     module's own `space` accessor (the sole capability with an empty root).
     Any other message a capability doesn't define (e.g. a hypothetical
     `parent`) is a plain DNU — there is no reflective escape hatch. This
     task lands the class shape, `setRoot:`, `resolve:`, `channel:`, and the
     three verbs as thin forwarders to the Task-1 prims (`out:value:`,
     `take:`, `whenever:do:` — each validates/resolves, then makes exactly
     one `platform` send); Task 3 lands `Space>>drain`, the reactor loop that
     actually fires `whenever:`-registered blocks. *)
  class Channel = ( | private root | ) (
    public setRoot: r = ( root:: r. ^ self )
    (* Module-internal accessor (Milestone D Task 2) — answers the capability's
       own root String, so `Space>>drain` can post it as `#channel` on a crash
       record and `postCrash:channel:` can run the sys/-loop guard on it. No
       reflective escape hatch: only code inside this module (`outer`/sibling
       sends) can reach it, same confinement as every other Channel verb. *)
    public rootPath = ( ^ root )
    (* Validate `rel` (crash `bad channel path` on any A1 violation), then
       join it under `root`: `''` answers `root` itself (the capability's own
       channel — demo-node's `chan out: '' value: ...` idiom); an empty
       `root` (the space's own root capability) answers `rel` unprefixed;
       otherwise the two joined with an explicit `/` (never a bare
       concatenation — that is what keeps `sensor`/`sensors` and `a/b`/`a/bc`
       from ever colliding). *)
    resolve: rel = (
      outer checkPath: rel.
      rel = '' ifTrue: [ ^ root ].
      root = '' ifTrue: [ ^ rel ].
      ^ root , '/' , rel )
    public channel: rel = ( ^ Channel new setRoot: (self resolve: rel) )
    (* ---- rung 9 (tuvm#32, option A): streams and cells --------------------
       A name is a STREAM (a pigeonhole you EMPTY: `out:value:` appends, `take:`
       removes) or a CELL (a pigeonhole that HOLDS the latest letter: `put:value:`
       overwrites, `peek:ifAbsent:` reads without removing). The kind is fixed by
       the FIRST WRITE, and the wrong verb on an existing name is an error — the
       same bargain as `read()` on a directory answering EISDIR. `whenever:do:`
       is the one verb that works on both and sets no kind.

       The RULE is enforced here, in nsl, not in `space.c` — which is storage, not
       policy (its own file header says so), exactly as capability confinement is
       enforced by `checkPath:` here and not there. `self error:` raises an ordinary
       Milestone-E condition, so a job can catch a kind mismatch with `on:do:` and,
       uncaught, it reaches the supervisor as any other crash does.

       Why a cell exists at all: `space_dequeue` kills an event on delivery whether
       or not anyone was registered for it, so a job that was DOWN when a letter
       arrived is replayed nothing when it restarts — and there is no request/reply
       with which to ask for a re-send. A cell survives the job that reads it. That
       is what lets a restarted PID read its setpoint back with no network, no
       bridge, and nobody to ask (nsl-tests/15_cells/02_survives_crash). *)
    KIND_STREAM = ( ^ 1 )
    KIND_CELL   = ( ^ 2 )                (* 0 = unset: nobody has ever written it *)

    (* The pinned kind at `rel`: 1 stream, 2 cell, 0 nobody has ever written it.
       For a caller that does NOT own the name and must therefore not use the
       raising verb — `peekCell:ifStream:` is the read-side convenience built on
       this, and PortaBridge>>applyEntry: is the write side, which has two verbs
       to guard rather than one and so wants the kind itself.

       Confinement is intact for the reason `peekCell:ifStream:` gives: the
       resolve happens HERE, so a capability can only ever be told about names it
       can already address, and no caller reaches `platform spaceKind:` past
       `resolve:`. *)
    public kindAt: rel = ( ^ platform spaceKind: (self resolve: rel) )

    public out: rel value: v = (
      | p |
      outer checkValue: v.
      p:: self resolve: rel.
      (platform spaceKind: p) = self KIND_CELL ifTrue: [ self error: 'not a stream' ].
      platform spacePost: p value: v.
      ^ self )
    public take: rel ifEmpty: emptyBlock = (
      | p r |
      p:: self resolve: rel.
      (platform spaceKind: p) = self KIND_CELL ifTrue: [ self error: 'not a stream' ].
      r:: platform spaceTake: p.
      r == nil ifTrue: [ ^ emptyBlock value ].
      ^ r basicAt: 1 )

    (* Write the cell. Creates it if new; overwrites if not. Fires `whenever:`
       reactions on every WRITE (not only on a CHANGE of value: we do not compare
       the new value to the old — deep record equality on a control loop's hot path,
       to skip a reaction that is idempotent anyway. De-duplicating identical writes
       is the writer's business). *)
    public put: rel value: v = (
      | p |
      outer checkValue: v.
      p:: self resolve: rel.
      (platform spaceKind: p) = self KIND_STREAM ifTrue: [ self error: 'not a cell' ].
      platform spacePut: p value: v.
      ^ self )

    (* Read the cell, non-destructively. `aBlock` on a name NOBODY HAS EVER WRITTEN
       — the kernel's expected-miss convention (review/lib/errors.md), and the reason
       this is correct without waiting on tuvm#21: the kind, not the value, says
       whether the pigeonhole is empty, so a cell holding `nil` answers `nil` and
       does NOT take the ifAbsent: branch. Two prim calls, no allocation: a PID reads
       its setpoint every tick. *)
    public peek: rel ifAbsent: aBlock = (
      | p k |
      p:: self resolve: rel.
      k:: platform spaceKind: p.
      k = self KIND_STREAM ifTrue: [ self error: 'not a cell' ].
      k = 0 ifTrue: [ ^ aBlock value ].
      ^ platform spacePeek: p )
    (* Nil-defaulting cell reads — the common case where absence and a held `nil`
       are treated alike (a never-written cell reads as `nil`, no ifAbsent: needed).
       `peek` reads THIS channel's own root cell; `peek: rel` reads a named sub-cell.
       Use `peek:ifAbsent:` above when the never-written-vs-holds-nil distinction
       matters. Distinct selectors — arity is part of the name, no collision. *)
    public peek = ( ^ self peek: '' ifAbsent: [ nil ] )
    public peek: rel = ( ^ self peek: rel ifAbsent: [ nil ] )

    (* rete#25 — the cell read for a leaf WHOSE KIND YOU DO NOT CONTROL. Same
       answer as `peek: rel` for absent (nil) and for a real cell (the value),
       but a STREAM runs `aBlock` instead of raising.

       Why this exists, and why it is a Channel verb rather than a guard at the
       one call site. `peek:` raises `'not a cell'` on a stream leaf, and kind is
       pinned by the FIRST write and re-created by replay — so any reader of a
       leaf some OTHER writer creates can be permanently disabled by one wrongly
       kinded write, with no way to recover short of a new path. For a reader
       inside a space reaction that failure is worse than a crash: `drain` fires
       reactions through `protectedFire:`, which catches the raise, abandons the
       REST of that reaction's body, and moves on — so every statement after the
       read silently stops running on every tick, for good, while everything
       before it keeps working. Nothing is logged and nothing looks broken.

       PortaBridge reading gateway-written `goal/apps/main` is exactly that
       reader (`porta put --raw --kind stream` is a legal write today), but the
       shape is general: any leaf whose writer is not its reader has it. Hence
       one verb here rather than a probe at the call site — and a probe at the
       call site would have to reach `platform spaceKind:` directly, past
       `resolve:`, which is the confinement this class exists to enforce.

       `ifStream:` and not a nil-for-both answer, because the two cases call for
       different behaviour: absence is the ordinary "nothing to do", while a
       stream where a cell was pinned is a peer disagreeing with the protocol and
       is worth reporting. Same shape as `peek:ifAbsent:` — the caller names what
       the unusual case means. *)
    public peekCell: rel ifStream: aBlock = (
      | p k |
      p:: self resolve: rel.
      k:: platform spaceKind: p.
      k = self KIND_STREAM ifTrue: [ ^ aBlock value ].
      k = 0 ifTrue: [ ^ nil ].
      ^ platform spacePeek: p )
    (* ---- porta space-sync (plan 2): the cell-replication query ---------------
       Answer every CELL at or under this capability's root whose last write is
       newer than `cursor`, OLDEST FIRST, at most `n` of them — each row a
       3-element algebra List {absolutePath, seq, value}.

       Confinement is enforced the way every other verb here enforces it: the
       scan prefix IS `root`, resolved before the prim is reached, so a
       capability can only ever be told about names it can already address.
       Segment alignment comes from the C side, matching the rule `resolve:`
       obeys for whole paths — a capability rooted at `obs` never matches
       `obscure`.

       CELLS ONLY. A stream's seq advances on every write, but its value is
       killed on delivery (`space_dequeue`), so a stream row would carry a
       stale-or-nil value under a fresh seq. Streams reach the wire by reaction
       capture instead (`PortaBridge>>subscribeStream:`).

       ASCENDING is load-bearing, not tidiness: a caller sends a PREFIX of this
       list and moves its cursor to the last row it sent, so any other order
       strands whatever it skipped. `n` is how a caller keeps a batch inside the
       radio's datagram cap.

       Paths are ABSOLUTE (space-relative), not root-relative — they are what
       goes on the wire, and the protocol stores them node-relative with the node
       id beside them, never re-prefixed per capability. *)
    public changedSince: cursor max: n = (
      | raw rows i |
      raw:: platform spaceChangedSince: cursor under: root max: n.
      rows:: OrderedCollection new.
      i:: 1.
      [ i <= raw basicSize ] whileTrue: [
        rows add: (self rowOf: (raw basicAt: i)).
        i:: i + 1 ].
      ^ rows )
    (* The prim answers a bare `indexable_new` backing store (class-less vtable),
       exactly as `spaceDequeue` does, so it is consumed ONLY via the shape-gated
       basicAt:/basicSize and never escapes as itself — `Space>>drain`'s rule. *)
    rowOf: raw = (
      ^ List with: (raw basicAt: 1) with: (raw basicAt: 2) with: (raw basicAt: 3) )

    public whenever: rel do: aBlock = (
      platform spaceRegister: (self resolve: rel) block: aBlock owner: self.
      ^ self )
    (* Module-internal (Milestone D Task 4): drop every reaction owned by THIS
       capability, across every channel. The Supervisor (Task 5) calls the
       platform prim directly with a job's rootCap instead — this helper exists
       for any module-internal caller that already holds the capability object
       rather than passing it around separately. *)
    dropMyReactions = (
      platform spaceDropReactionsOwnedBy: self.
      ^ self )
  ) : (
  )

  (* The root capability's class (Milestone C Task 2) — identical shape to
     Channel (attenuating a Space via `channel:` answers a plain Channel,
     never another Space: only the module's `space` accessor ever mints a
     Space, so a derived capability can only ever be narrower). `drain`
     (Task 3) is the host reactor loop and is unique to the root — an
     attenuated Channel never drains, it only addresses. *)
  class Space = Channel ( ) (
    (* The host reactor (Milestone C Task 3; PROTECTED — Milestone D Task 2):
       dispatch queued events until the queue is empty (supervisor idle-wait
       is a later Milestone D task). Each `platform spaceDequeue` answers nil
       (queue empty) or a raw 3-slot indexable {value, reactionBlocksSnapshot,
       channelPath} — snapshot taken at dequeue (D-C5), in registration order
       (D-C3); `channelPath` is the firing event's channel, added by Task 2 so
       a caught crash can be attributed to it. The raw indexable is a bare
       `indexable_new` backing store (class-less vtable — probe-proven,
       Task-3 controller correction), so it is consumed ONLY via the
       shape-gated `basicAt:`/`basicSize` and never escapes this method.
       Fan-out invokes every snapshot block with the carried value THROUGH
       `platform protectedFire:value:` (Task 1's setjmp crash boundary): a
       clean firing answers the canonical nil and drain moves on; a firing
       that `self error:`s is caught, unwound, and abandoned mid-body (the
       crashing reaction's own remaining statements never run — the process
       survives) and `protectedFire:` answers the raised condition (a
       non-nil String), which `postCrash:channel:` turns into a first-class
       crash record. A reaction that posts merely enqueues — the outer
       whileTrue picks the new event up on a LATER iteration, never
       recursively (run-to-completion, D-C). `drain` is not re-entrant — a
       reaction that itself called `drain` would violate run-to-completion;
       reactions post (enqueue) and return. *)
    public drain = (
      | ev v bs ch i cond |
      [ ev:: platform spaceDequeue. (ev == nil) not ] whileTrue: [
        v::  ev basicAt: 1.
        bs:: ev basicAt: 2.
        ch:: ev basicAt: 3.
        i:: 1.
        [ i <= bs basicSize ] whileTrue: [
          cond:: platform protectedFire: (bs basicAt: i) value: v.
          cond == nil ifFalse: [ self postCrash: cond channel: ch ].
          i:: i + 1 ] ].
      ^ self )

    (* porta space-sync (plan 2): the space's ONE monotonic counter (design D5).
       `seq` reads it; `stamp` bumps it and answers the new value.

       On Space and not on Channel because the counter is space-GLOBAL — an
       attenuated capability has no narrower counter to read, so offering it one
       would be a lie about the scope.

       `stamp` exists for captured stream entries: a stream's value is not
       retained, so `PortaBridge` captures it in a `whenever:` reaction, and two
       captures with no intervening write would share a seq if it merely READ the
       counter. The gateway drops `seq <= high-water` as a duplicate, so that is
       silent loss rather than a repeated delivery. *)
    public seq = ( ^ platform spaceSeq )
    public stamp = ( ^ platform spaceStamp )

    (* A contained crash posts a first-class crash record on sys/crash —
       EXCEPT a crash raised while firing a sys/-rooted reaction (a
       supervisor/observer bug): re-posting would amplify into a loop (the
       new crash record would itself land on sys/crash, re-firing the very
       reaction that just crashed), so it is reported via `out` (this
       dialect has no dedicated stderr selector — grep-confirmed: kernel.nsl
       and oevm/src/dispatch.c's PRIM_NAMES have no `outError`/`startsWith:`
       primitive) and dropped instead. `self out: 'sys/crash' value: ...`
       uses the existing `Channel>>out:value:` — `drain` runs on the root
       `Space`, whose root is `''`, so `resolve: 'sys/crash'` answers
       `'sys/crash'` unprefixed. *)
    (* Milestone E Task 1: `caught` is the raised crash Record (protectedFire's
       return is now the in-flight Record, not a bare String). Per controller
       decision (a) the sys/crash record carries the RAISE tag (`caught tag`),
       NOT the retired constant `#crash` — the supervisor is channel-matched
       (`handleCrash:` reads `#channel`, never the tag). #text is read back the
       same way it was stored (`at: #text ifAbsent:`). *)
    postCrash: caught channel: chPath = (
      (self isSysPath: chPath)
        ifTrue: [ ('supervisor-crash ' , chPath , ' ' , (caught at: #text ifAbsent: [ '' ])) out ]
        ifFalse: [
          self out: 'sys/crash'
               value: (Record tag: (caught tag)
                              with: #text -> (caught at: #text ifAbsent: [ '' ])
                              with: #channel -> chPath) ].
      ^ self )

    (* `chPath = 'sys'` or `chPath` starts with `'sys/'`. No generic
       `startsWith:` exists in this dialect (grep-confirmed), so this is
       spelled directly over `size`/`at:` byte comparison — same idiom
       `checkPath:` (~:801) already uses for its own segment scan. ASCII:
       $s=115, $y=121, /=47. *)
    isSysPath: p = (
      (p = 'sys') ifTrue: [ ^ true ].
      ^ p size > 4
        and: [ (p at: 1) = 115
        and: [ (p at: 2) = 121
        and: [ (p at: 3) = 115
        and: [ (p at: 4) = 47 ] ] ] ] )
  ) : (
  )

  (* One supervised job's restart-policy bookkeeping (Milestone D Task 5) —
     Kernel-module sibling of Space, same flat shape as Transition/Protocol
     below. `rootCap` is the job's own root capability (the object `whenever:`
     registrations are OWNED by, per Task 2's `owner: self`), so
     `platform spaceDropReactionsOwnedBy: rootCap` sweeps exactly this job's
     reactions and no other job's. `rootPath` is cached at registration
     (`rootCap rootPath`, Task 2) so `addresses:` can attribute a crash
     record's `#channel` string to this job without re-deriving anything.
     `addresses:` answers whether `chPath` is this job's own root or a
     channel nested under it (`root` or `root/...`) — hand-rolled byte
     compare (NOT `startsWith:`: no such selector exists in this dialect,
     grep-confirmed against kernel.nsl/dispatch.c PRIM_NAMES, same finding
     `postCrash:channel:` already documents above), same at:/size idiom as
     `isSysPath:`. The `^` returns below are all inside `whileTrue:`, which
     `dispatch.c` inlines at compile time (no real closure/call frame is
     created), so they are ordinary method returns — NOT the deleted-NLR
     pattern; a `^` inside a block actually passed to a real method (`do:`,
     `detect:ifNone:`, `whenever:do:`) would be unsafe and is avoided
     throughout this class and Supervisor below. *)
  class SupervisedJob = ( | private rootCap private rootPath private restartThunk private crashes ::= 0. private quarantined ::= false. | ) (
    public rootCap = ( ^ rootCap )
    public rootPath = ( ^ rootPath )
    public restartThunk = ( ^ restartThunk )
    public crashes = ( ^ crashes )
    public quarantined = ( ^ quarantined )
    public bumpCrashes = ( crashes:: crashes + 1. ^ crashes )
    public noteProgress = ( crashes:: 0. ^ self )
    public markQuarantined = ( quarantined:: true. ^ self )
    public addresses: chPath = (
      | rlen clen i |
      (chPath = rootPath) ifTrue: [ ^ true ].
      rlen:: rootPath size.
      clen:: chPath size.
      (clen > rlen) ifFalse: [ ^ false ].
      i:: 1.
      [ i <= rlen ] whileTrue: [
        (chPath at: i) = (rootPath at: i) ifFalse: [ ^ false ].
        i:: i + 1 ].
      ^ (chPath at: rlen + 1) = 47 )
    public setRootCap: c restart: t = (
      rootCap:: c. rootPath:: c rootPath. restartThunk:: t. ^ self )
  ) : (
    public rootCap: c restart: t = ( ^ self new setRootCap: c restart: t )
  )

  (* The Supervisor (Milestone D Task 5, spec §5) — observes crash records on
     `sys/crash` (posted by the protected reactor, Task 2), attributes each
     crash to the owning `SupervisedJob` via `jobAddressing:`, sweeps that
     job's reactions (`platform spaceDropReactionsOwnedBy:` — Task 4's raw
     native prim, called directly since the Supervisor lives INSIDE this
     module, same idiom as Channel's own `dropMyReactions` above; the
     Kernel-level `spaceDropReactionsOwnedBy:` forwarder near `space` is for
     app-level callers only), and either restarts (re-runs the job's own
     start thunk, which re-registers its reaction under the SAME rootCap
     object, so the next sweep still finds it) or quarantines (stops
     restarting; logs a `#quarantine` record to `sys/log` for observability)
     once `quarantineLimit` consecutive crashes accumulate. A `progress:`
     capability lets a job report it is running cleanly (an ordinary
     `whenever: '' do:` reaction — no special mechanism, just a channel
     event), resetting its crash count so transient trouble doesn't
     accumulate toward quarantine across unrelated healthy periods. *)
  class Supervisor = ( | private space private jobs private quarantineLimit ::= 3. private timers | ) (
    public setSpace: s = ( space:: s. jobs:: OrderedCollection new. ^ self )

    (* tuvm#23: hand the supervisor the Timers registry so its crash sweep can
       cancel a job's timers alongside its reactions (see sweepJob: below).
       Optional — nil (never wired) preserves the pre-#23 reaction-only sweep,
       so a rig with no timers changes nothing. *)
    public timers: t = ( timers:: t. ^ self )

    public register: rootCap restart: aThunk progress: progressCap = (
      | j |
      j:: SupervisedJob rootCap: rootCap restart: aThunk.
      jobs add: j.
      progressCap whenever: '' do: [ :e | j noteProgress ].
      ^ j )

    public start = (
      (space channel: 'sys') whenever: 'crash' do: [ :rec | self handleCrash: rec ].
      ^ self )

    public isQuarantined: aRootPath = (
      | j |
      j:: jobs detect: [ :x | x rootPath = aRootPath ] ifNone: [ nil ].
      ^ (j == nil) ifTrue: [ false ] ifFalse: [ j quarantined ] )

    handleCrash: rec = (
      | chPath j |
      chPath:: rec at: #channel ifAbsent: [ nil ].
      j:: self jobAddressing: chPath.
      j == nil ifTrue: [ ^ self ].                  (* crash on an unowned channel: already logged *)
      j quarantined ifTrue: [ ^ self ].
      j bumpCrashes.
      (j crashes >= quarantineLimit)
        ifTrue: [ self quarantine: j ]
        ifFalse: [ self restart: j ].
      ^ self )

    (* tuvm#23 — the FULL sweep of a crashed job's registrations, applied
       before restart and at quarantine alike: reactions (Task 4's owner-object
       sweep, as before) AND timers (address-attributed; Timers>>
       cancelAddressedBy:). Timers must go too or a crash-looping job leaks a
       live repeater per restart — on target each one pins an M6 handle slot,
       so let-it-crash inverted into node death in <=32 restarts. Sweep BEFORE
       the restart thunk runs, so the fresh instance's registrations are not
       caught by their own job's sweep. *)
    sweepJob: j = (
      platform spaceDropReactionsOwnedBy: j rootCap.
      timers == nil ifFalse: [ timers cancelAddressedBy: j rootPath ].
      ^ self )

    public restart: j = (
      self sweepJob: j.
      j restartThunk value.
      ^ self )

    quarantine: j = (
      self sweepJob: j.
      j markQuarantined.
      (space channel: 'sys') out: 'log'
          value: (Record tag: #quarantine with: #channel -> j rootPath).
      ^ self )

    jobAddressing: chPath = (
      chPath == nil ifTrue: [ ^ nil ].
      ^ jobs detect: [ :x | x addresses: chPath ] ifNone: [ nil ] )
  ) : (
  )

  (* A single `state:on:do:then:` wire — landed from staged `oevm/review/lib/
     fsm.ns` (Milestone C Task 5). Kernel-module sibling of Protocol (staged
     nested it as `Protocol class Transition`; flattened to a top-level
     sibling here, matching this module's exclusively-flat class shape — no
     other kernel.nsl class nests a class, and the public surface — `action`,
     `target`, class-side `action:target:` — is unchanged by the move). *)
  class Transition = ( | private action private target | ) (
    public action = ( ^ action )
    public target = ( ^ target )
    public setAction: a target: t = ( action:: a. target:: t. ^ self )
  ) : (
    public action: a target: t = ( ^ self new setAction: a target: t )
  )

  (* L4 — Protocol: the state-machine idiom (Milestone C Task 5; THE fiber
     replacement, addendum A3 mechanism #1). One object per device protocol;
     events in, actions out; current state explicit, inspectable, and
     trivially persistable via `snapshot`/`restore:`. Landed from the staged
     `oevm/review/lib/fsm.ns` (PLAN-DRAFT CAUTION — see task report for the
     staged-vs-landed divergence). Depends on Dictionary (per-machine mutable
     transition/entry tables: `states` maps state -> Dictionary of
     eventKey -> Transition, `entryActions` maps state -> block — Map is the
     wrong tool here, it is an immutable value type, not a mutable table) and,
     by convention only, the channel surface (a transition/entry action may
     `out:value:`; this class itself sends no channel prim — it adds no new
     VM surface, exactly as the staged header promises). *)
  public class Protocol = ( | private name ::= #protocol. private current ::= #initial.
      private states ::= Dictionary new.       (* state -> (eventKey -> Transition) *)
      private unhandled ::= nil.               (* block or nil; nil = silently ignore *)
      private entryActions ::= Dictionary new. (* state -> block, optional *)
      private trace ::= false. | ) (

    (* ---- definition ---- *)
    public state: s on: eventKey do: action then: target = (
      | table |
      table:: states at: s ifAbsent: [ | t | t:: Dictionary new. states at: s put: t. t ].
      table at: eventKey put: (Transition action: action target: target).
      ^ self
    )
    public state: s onEntry: aBlock = ( entryActions at: s put: aBlock. ^ self )
    public onUnhandled: aBlock = ( unhandled:: aBlock. ^ self )
    public startIn: s = ( current:: s. self runEntry: s with: nil. ^ self )
    public trace: aBool = ( trace:: aBool. ^ self )

    (* ---- introspection / persistence (the deep-sleep hooks) ---- *)
    public currentState = ( ^ current )
    public name = ( ^ name )
    (* Persistable snapshot is just the state symbol; a protocol carries no
       other implicit state BY DESIGN — anything else the handler needs
       lives in the job's own slots or in channel messages, both of which are
       already explicit. *)
    public snapshot = ( ^ current )
    public restore: s = ( current:: s. ^ self )

    (* ---- dispatch (run-to-completion; called from a whenever: handler) ---- *)
    public handle: event = (
      | key table hit t |
      key:: self keyFor: event.
      table:: states at: current ifAbsent: [ nil ].
      hit:: false.
      table == nil ifFalse: [
        t:: table at: key ifAbsent: [ nil ].
        t == nil ifFalse: [
          hit:: true.
          trace ifTrue: [ (name asString , ': ' , current asString , ' -' , key asString , '-> ' , t target asString) out ].
          t action value: self value: event.
          current:: t target.
          self runEntry: current with: event ] ].
      hit ifFalse: [
        unhandled == nil ifFalse: [ unhandled value: self value: event ] ].
      ^ hit
    )

    keyFor: event = (
      (* Symbol -> itself; Record -> tag; anything else -> the catch-all key.
         isSymbol/isRecord are the type predicates from messages.md. *)
      event isSymbol ifTrue: [ ^ event ].
      event isRecord ifTrue: [ ^ event tag ].
      ^ #event
    )

    (* Setup-time check: every transition target has a state table or an
       entry action. Configuration bugs die at setup, not in the field. Call
       at end of definition: `machine validate.` *)
    public validate = (
      states do: [ :table |
        table do: [ :t |
          ((states containsKey: t target) or: [ entryActions containsKey: t target ])
            ifFalse: [ self error: 'unknown state' ] ] ].
      ^ self
    )
    runEntry: s with: event = (
      | a |
      a:: entryActions at: s ifAbsent: [ nil ].
      a == nil ifFalse: [ a value: self value: event ].
      ^ self
    )
    public setName: n = ( name:: n. ^ self )
  ) : (
    public named: n = ( ^ self new setName: n )
  )

  (* A pending timer registration — landed from staged `oevm/review/lib/
     timers.ns` (Milestone D Task 6). Kernel-module sibling of Transition
     above (staged nested it as `Timers class Pending`; flattened to a
     top-level sibling here, matching this module's exclusively-flat class
     shape — no other kernel.nsl class nests a class, and the public surface
     — `chan`, `msg`, `repeating`, class-side `chan:msg:repeating:` — is
     unchanged by the move). *)
  class Pending = ( | private chan private msg private repeating | ) (
    public chan = ( ^ chan )
    public msg = ( ^ msg )
    public repeating = ( ^ repeating )
    public setChan: c msg: m repeating: r = ( chan:: c. msg:: m. repeating:: r. ^ self )
  ) : (
    public chan: c msg: m repeating: r = ( ^ self new setChan: c msg: m repeating: r )
  )

  (* L3 — timers as channel events (Milestone D Task 6; design doc's
     event-source seam). Landed from the staged `oevm/review/lib/timers.ns`,
     Kernel-module sibling of Space/Supervisor/Protocol above — same flat
     shape (see Pending's comment just above for why `class Pending` was
     flattened out of it). No new VM semantics: a timer is an ordinary event
     source that posts into the space via the C seam (`platform
     timerAfter:token:`/`timerEvery:token:`/`timerCancel:`/`monotonicMillis`
     — the five forwarders near `readLine` above, wired to Task 6's
     `host_timer_*`/`host_monotonic_millis` C prims). The C side carries DATA
     ONLY (a token, a millisecond count) — which channel, what message, and
     cancellation bookkeeping all live here in nsl, so C stays one dumb
     registry + one posting path (design constraint, staged header). Wiring
     at boot: `timers:: Timers usingSpace: space seam: platform. space
     whenever: 'sys/timer' do: [:e | timers dispatch: e].` — `'sys/timer'`
     (no `%` prefix: Milestone C retired `%` as a mechanism, so the reserved
     channel is a plain path like any other) lives in the caller (test/
     supervisor setup), not in this class, exactly as the staged header
     already noted. Every fire is an ordinary reactor dispatch — run-to-
     completion ordering (T-C.6) applies to timer events identically; no
     ISR-context nsl execution ever happens (host_advance's C posts are the
     only ISR-adjacent code and they only ever call space_post). A timer
     token is a small capability: holding it is the right to cancel it. *)
  public class Timers = ( | private space private seam private nextToken ::= 1. private pending ::= Dictionary new. | ) (
    (* pending: token -> Pending(chan, msg, repeating) *)

    public after: ms post: aMessage on: aChannel = (
      | tok |
      tok:: self allocateToken.
      (seam timerAfter: ms token: tok) ifFalse: [ ^ self error: 'timer table full' ].   (* #81 *)
      pending at: tok put: (Pending chan: aChannel msg: aMessage repeating: false).
      ^ tok
    )

    public every: ms post: aMessage on: aChannel = (
      | tok |
      tok:: self allocateToken.
      (seam timerEvery: ms token: tok) ifFalse: [ ^ self error: 'timer table full' ].   (* #81 *)
      pending at: tok put: (Pending chan: aChannel msg: aMessage repeating: true).
      ^ tok
    )

    public cancel: tok = (
      | p |
      p:: pending at: tok ifAbsent: [ nil ].       (* cancelling twice is a no-op *)
      p == nil ifFalse: [
        pending removeKey: tok.
        seam timerCancel: tok ].
      ^ self
    )

    public pendingCount = ( ^ pending size )

    (* tuvm#23 — the supervisor's timer sweep. Cancel every pending timer whose
       TARGET channel is rootPath or nested under it, through the ordinary
       `cancel:` path — which unregisters at the seam, and on target that is
       what stops the k_timer AND frees its M6 handle pin (timer_zephyr.c).
       Without this sweep a crash-looping job's restarts each register a fresh
       `every:` while the dead instance's repeater lives on (its token was held
       only by the dead instance), pinning one handle slot per restart until
       "handle table full" kills the node. Ownership is derived from the
       letter's ADDRESS (`p chan rootPath`), not stored per registration: under
       the capability discipline a job's timers post into its own subtree, so
       the address IS the owner — the same attribution rule the supervisor
       already applies to crash records (SupervisedJob>>addresses:). Snapshot
       `keys` first: cancel: mutates `pending`, and the walk must not iterate
       a table being edited. *)
    public cancelAddressedBy: rootPath = (
      | ks |
      ks:: pending keys.
      1 to: ks size do: [ :i | | tok p |
        tok:: ks at: i.
        p:: pending at: tok ifAbsent: [ nil ].
        p == nil ifFalse: [
          (self is: p chan rootPath under: rootPath) ifTrue: [ self cancel: tok ] ] ].
      ^ self
    )

    (* chPath equals rootPath, or is nested under it (rootPath then '/', byte
       47). The same hand-rolled byte compare as SupervisedJob>>addresses: (no
       startsWith: exists in this dialect — that method documents the grep);
       every `^` below sits inside whileTrue:, which dispatch.c inlines, so
       they are ordinary method returns, not the deleted-NLR pattern. *)
    is: chPath under: rootPath = (
      | rlen clen i |
      (chPath = rootPath) ifTrue: [ ^ true ].
      rlen:: rootPath size.
      clen:: chPath size.
      (clen > rlen) ifFalse: [ ^ false ].
      i:: 1.
      [ i <= rlen ] whileTrue: [
        (chPath at: i) = (rootPath at: i) ifFalse: [ ^ false ].
        i:: i + 1 ].
      ^ (chPath at: rlen + 1) = 47 )

    public now = ( ^ seam monotonicMillis )

    (* Called by the boot-time reserved-channel reaction (see the wiring
       comment above). Event = the fired token (a SmallInteger). Late fire
       after cancel -> not in `pending` -> dropped silently BY DESIGN
       (transient-signal semantics; the race is inherent, the resolution is
       pinned here). *)
    public dispatch: tokenEvent = (
      | p |
      p:: pending at: tokenEvent ifAbsent: [ nil ].
      p == nil ifFalse: [
        p repeating ifFalse: [ pending removeKey: tokenEvent ].
        p chan out: '' value: p msg ].    (* '' = post at the capability's own root *)
      ^ self
    )

    allocateToken = ( | t | t:: nextToken. nextToken:: nextToken + 1. ^ t )
    public setSpace: s seam: c = ( space:: s. seam:: c. ^ self )
  ) : (
    public usingSpace: s seam: c = ( ^ self new setSpace: s seam: c )
  )

  (* rete#312 Q1: THE one profile handler, owned by the kernel so no app carries a copy.
     A request opens a per-method window for ms and its close dumps the rows to the
     console (vm.c mprof_report); a second request while one is open restarts it.
     rete#415: ONE mechanism, `requestMs:id:`, whatever carried the request: porta's
     `goal/profile` cell (Profile{id, ms}), or a `profile <ms>` line (`parseProfileMs:`)
     on the console cable in a standard image (`sys/console`, announced by the UART
     interrupt) or through the debugger's command loop in a debug image (supervisor.nsl),
     which owns the cable and `dbg/req` there. A line names no id, so one is minted:
     negative, so it never meets a cell's. Installed by the Supervisor before every
     app's `main:`.

     The window closes on the kernel's one Timers, so it closes only in an app that
     dispatches `sys/timer` -- every reactor node does. An app with no reactor never
     drains its space, so nothing here reaches it; its profile is a build option
     (OEVM_MPROF_FLIP_AT/DUMP_AT). The console is read with `consoleLine`, which never
     blocks: an app that reads the cable itself may already have taken the line. *)
  class Profiler = ( | private kernel private space private timers private tok ::= nil. private endCh
                       private reqId ::= nil. private fromBoot ::= false. | ) (
    public install: withCable = (
      | first |
      endCh:: space channel: 'sys/profileEnd'.
      endCh whenever: '' do: [ :m | self close ].
      self resumeRetained.
      withCable ifTrue: [
        (* rete#364: the call that arms the console also takes a line already waiting
           (custos sends `profile <ms>` as a host VM starts); dropping it lost the
           request. *)
        first:: kernel consoleLine.
        first == false ifFalse: [
          (space channel: 'sys/console') whenever: '' do: [ :n | self drainConsole ].
          first == nil ifFalse: [ self request: first ].
          self drainConsole ] ].
      ^ self
    )
    (* Answers the window's ms, or 0 for a line that is not `profile <positive int>`. *)
    public request: line = (
      | ms |
      ms:: kernel parseProfileMs: line.
      ms > 0 ifTrue: [ self requestMs: ms id: self mintId ].
      ^ ms
    )
    (* One announcement may stand for several lines: take every complete one. *)
    drainConsole = (
      | line |
      [ line:: kernel consoleLine. line == nil ] whileFalse: [ self request: line ].
      ^ self
    )

    (* A line's id: below every id this node has armed or served, so it is new. *)
    mintId = (
      | low |
      self retained ifFalse: [ ^ -1 ].
      low:: kernel rtcGet: 11.
      (kernel rtcGet: 12) < low ifTrue: [ low:: kernel rtcGet: 12 ].
      low < 0 ifTrue: [ ^ low - 1 ].
      ^ -1 )
    (* rete#415 Q8/Q9: a request is ONE request, named by its id, and it
       survives deep sleep in the kernel's RTC slots (10 ms, 11 id, 12 served, 13 check;
       an app owns 0-9). A cell is replayed into every cold boot, so `served` is what
       makes it one-shot. The rule, one for every node: a new id opens a window at once.
       A window that reaches its ms dumps and is served (the always-on bell). A window
       that sleep cuts dumps nothing and stays armed, and the next boot opens a fresh
       window before main:, which dumps and is served at its ms or at sleep (a sleepy
       node's next wake). ms 0 disarms. *)
    public requestMs: ms id: id = (
      ms > 0 ifFalse: [ self retainMs: 0 id: 0 served: self served. ^ self ].
      id = self served ifTrue: [ ^ self ].
      ((tok == nil) not and: [ reqId = id ]) ifTrue: [ ^ self ].   (* the boot window's replay *)
      self retainMs: ms id: id served: self served.
      self open: ms.
      reqId:: id. fromBoot:: false.
      ^ self )
    resumeRetained = (
      | ms id |
      self retained ifFalse: [ ^ self ].
      ms:: kernel rtcGet: 10. id:: kernel rtcGet: 11.
      (ms > 0 and: [ (id = self served) not ]) ifFalse: [ ^ self ].
      ('profile: window from boot, request ' , id printString) println.
      self open: ms.
      reqId:: id. fromBoot:: true.
      ^ self )
    retained = ( ^ (kernel rtcGet: 13) = (self checkMs: (kernel rtcGet: 10) id: (kernel rtcGet: 11) served: (kernel rtcGet: 12)) )
    served = ( self retained ifFalse: [ ^ nil ]. ^ kernel rtcGet: 12 )
    checkMs: ms id: id served: s = ( ^ ((ms bitXor: id) bitXor: (s bitXor: 789516773)) bitAnd: 1073741823 )
    retainMs: ms id: id served: s = (
      | s0 |
      s0:: s == nil ifTrue: [ 0 ] ifFalse: [ s ].
      kernel rtcPut: 10 value: ms. kernel rtcPut: 11 value: id. kernel rtcPut: 12 value: s0.
      kernel rtcPut: 13 value: (self checkMs: ms id: id served: s0).
      ^ self )

    open: ms = (
      tok == nil ifFalse: [ timers cancel: tok ].
      kernel profileStart.
      tok:: timers after: ms post: #profileEnd on: endCh.
      ^ self
    )
    public close = (
      reqId == nil ifFalse: [
        self retainMs: (kernel rtcGet: 10) id: (kernel rtcGet: 11) served: reqId.
        reqId:: nil ].
      tok:: nil. kernel profileStop. ^ self )
    (* rete#415 P3, Q9: Kernel>>deepSleep: is about to end the VM. A window opened from
       boot is closed now and SAYS it was cut, so a dump shorter than the request is not
       read as the whole window. A window opened mid-wake is carried instead: it dumps
       nothing, and the next boot opens it again whole. *)
    public cutBySleep = (
      tok == nil ifTrue: [ ^ self ].
      timers cancel: tok.
      fromBoot ifFalse: [
        tok:: nil. reqId:: nil.
        'profile: window carried to the next wake' println.
        ^ self ].
      'profile: window cut by sleep' println.
      ^ self close )
    public setKernel: k = ( kernel:: k. space:: k space. timers:: k timers. ^ self )
  ) : (
    public usingKernel: k = ( ^ self new setKernel: k )
  )

  (* Zephyr rung-2 sub-project 1: the ISR→channel pulse capability. Registration
     hands the seam a (pin, edge, message, channel-path); C pins the message via the
     M6 handle table and stores the ISR slot. On target a GPIO edge ISR posts the
     pulse; on host, `fire:` simulates the edge. No nsl-side state — data, not policy. *)
  class GpioPulse = ( | private space private seam | ) (
    public pin: n edge: e post: aMessage on: aChannel = (
      seam gpioPin: n edge: e post: aMessage on: aChannel rootPath.
      ^ self )
    public fire: n = ( seam gpioFire: n. ^ self )   (* host/test only *)
    (* tuvm#82: the outbound direction. A pin the board never declared RAISES
       rather than answering a plausible-but-false level — it is a wrong literal in
       the source, not something traffic can produce, and a silent false would show
       up as an LED that merely looks broken. The C leaf stays raw and answers nil;
       the check lives here, the same division Vector>>at: uses over basicAt:. The
       tag is what makes `on: [ :e | e tag = #gpioUndeclared ]` possible for code
       that is deliberately probing an unknown board. *)
    public set: n to: aBool = (
      (seam gpioSet: n to: aBool) == nil
        ifTrue: [ ^ self error: 'gpio pin not declared' tag: #gpioUndeclared ].
      ^ self )
    public level: n = (
      | v |
      v:: seam gpioLevel: n.
      v == nil ifTrue: [ ^ self error: 'gpio pin not declared' tag: #gpioUndeclared ].
      ^ v )
    public setSpace: s seam: c = ( space:: s. seam:: c. ^ self )
  ) : (
    public usingSpace: s seam: c = ( ^ self new setSpace: s seam: c )
  )

  (* tuvm#88: the display seam's nsl half. The C leaves stay raw — nil for a board
     with no display, an SMI status otherwise — and the RAISE lives here, the same
     division Vector>>at: uses over basicAt: and the only one available since
     build_and_raise is static to dispatch.c.
     Three tags rather than one because the three conditions want different
     responses: unavailable is the wrong board, bounds is a wrong literal, and
     fault is the panel or its wiring. A node probing an unknown board can catch
     #displayUnavailable alone and carry on headless. *)
  class Display = ( | private seam | ) (
    public clear = ( ^ self check: (seam displayClear) )
    public at: r col: c put: s = ( ^ self check: (seam displayAt: r col: c put: s) )
    public refresh = ( ^ self check: (seam displayRefresh) )
    public refreshRow: r = ( ^ self check: (seam displayRefreshRow: r) )
    check: rc = (
      rc == nil ifTrue: [ ^ self error: 'no display on this board' tag: #displayUnavailable ].
      rc = 1 ifTrue: [ ^ self error: 'row or column outside the grid' tag: #displayBounds ].
      rc = 2 ifTrue: [ ^ self error: 'display driver fault' tag: #displayFault ].
      ^ self )
    public setSeam: c = ( seam:: c. ^ self )
  ) : (
    public usingSeam: c = ( ^ self new setSeam: c )
  )

  (* tuvm#94 stage 1: the bell seam's nsl half, the same division as Display
     above — the C leaf stays raw (nil for a board with no bell, an SMI status
     otherwise) and the RAISE lives here.
     THE 1-8 CHECK IS HERE AND NOT IN C on purpose. It is not a hardware limit:
     the cosine generator would happily strike twenty. It is the ship's-bell
     convention, which is a fact about the PRODUCT, and the product's rules belong
     where they can be read — and where a raise can be written at all, since
     build_and_raise is static to dispatch.c. C therefore has no bounds status
     code; there are only two tags here, not the display's three. *)
  class Bell = ( | private seam | ) (
    public strike: n = (
      ((n < 1) or: [ n > 8 ]) ifTrue: [
        ^ self error: 'bell count outside 1-8' tag: #bellBounds ].
      ^ self check: (seam bellStrike: n) )
    (* tuvm#94 stage 2: which count belongs to which half-hour. `i` counts
       half-hours from midnight, so i=1 is 00:30 and i=47 is 23:30.
       THE LINE THIS SITS ON: `Bell` owns the CONVENTION — which counts are legal
       and which count a given half-hour calls for; the node owns the SCHEDULE —
       when a half-hour happens and what to do about it. Both halves of the
       convention are therefore in one place and neither is in C.
       Bells run 1-8 over a four-hour watch and reset, so the count is i modulo 8
       with 0 reading as 8 (the full end-of-watch eight, not silence). Checks out
       against the three anchors the design names: 00:30 -> 1, 18:30 -> 5,
       12:00 -> 8. Floored `\\` (rete#246) answers non-negative for any i, so the
       old "defined for i >= 0 only" caveat is gone with the hand-spelling. *)
    public bellsForHalfHour: i = (
      | m |
      m:: i \\ 8.
      m = 0 ifTrue: [ ^ 8 ].
      ^ m )
    check: rc = (
      rc == nil ifTrue: [ ^ self error: 'no bell on this board' tag: #bellUnavailable ].
      rc = 2 ifTrue: [ ^ self error: 'bell driver fault' tag: #bellFault ].
      ^ self )
    public setSeam: c = ( seam:: c. ^ self )
  ) : (
    public usingSeam: c = ( ^ self new setSeam: c )
  )

  (* shipsBellsV3 §16.4 (#102): the RTC alarm capability. The RTC says WHEN — the
     MCU's own timebase never competes as the trigger, which is the entire reason
     for having a DS3231 at all.
     `at:post:on:` answers TRUE when the alarm was armed and FALSE when it could
     not be — no RTC, or an image built without CONFIG_RTC_ALARM. It does NOT
     raise, and that is the deliberate difference from GpioPulse>>set:to:: an
     undeclared pin is a wrong literal in the source, while an unarmable alarm is
     a real state of a real board, and a node that must survive a MISSED alarm has
     to survive an unarmable one by the same path. A raise would push that into an
     exception handler and tempt a caller to treat it as impossible. *)
  class RtcAlarm = ( | private space private seam | ) (
    public at: secondsOfDay post: aMessage on: aChannel = (
      ^ (seam rtcAlarmAt: secondsOfDay post: aMessage on: aChannel rootPath) == nil
          ifTrue: [ false ] ifFalse: [ true ] )
    public setSpace: s seam: c = ( space:: s. seam:: c. ^ self )
  ) : (
    public usingSpace: s seam: c = ( ^ self new setSpace: s seam: c )
  )

  (* Module-level validation/depth helpers (Milestone B Task 6) — NOT public:
     reachable only by sibling classes nested directly in this module, via
     their own `outer` link (slot 0), never by application code (an app
     module's own `outer` never points at this Kernel instance). `rankOf:`
     mirrors the native `platform valueRank:` prim but falls back to asking
     the object itself when the prim answers -1 ("other heap" — Task 4),
     which is how a heap value type (e.g. List) opts in via its own
     `valueRank` override. *)
  (* rete#477: Cbor>>encode:'s scratch builder; nil while an encode holds it. *)
  takeEncodeScratch = (
    encodeScratchBusy ifTrue: [ ^ nil ].
    encodeScratchOne == nil ifTrue: [ encodeScratchOne:: ByteBuilder new reserve: 1024 ].
    encodeScratchBusy:: true.
    ^ encodeScratchOne reset )
  releaseEncodeScratch = ( encodeScratchBusy:: false. ^ self )
  rankOf: v = ( | r | r:: platform valueRank: v. r = -1 ifTrue: [ ^ v valueRank ]. ^ r )
  isValueObject: v = ( ^ (rankOf: v) >= 0 )
  depthOf: v = ( (rankOf: v) >= 7 ifTrue: [ ^ v valueDepth ]. ^ 0 )
  checkValue: v = ( (isValueObject: v) ifFalse: [ self error: 'not a value' ]. ^ v )
  checkDepth: d = ( d > 32 ifTrue: [ self error: 'message depth exceeded' ]. ^ d )

  (* Channel-path canonicalization (Milestone C Task 2, addendum A1) — same
     non-public family as the helpers above, reached the same way (Channel's
     `outer` send). Byte-walks `p` (`/` = 47, `.` = 46) rejecting: a leading
     or trailing `/`, an empty segment (`//`), and any segment made ENTIRELY
     of `.` bytes (`dots = segLen`) — which covers both `.` and `..` and also
     `...`+ ; stricter than A1 strictly demands (A1 only names `.`/`..`), but
     deliberate: a dot-only segment has no legitimate use, so the wider
     rejection closes the whole family in one rule rather than special-casing
     two lengths. Segment bytes are otherwise unrestricted except `/` — no
     other character carries reserved meaning (design §9 Q1). `''` is the
     legal root-of-everything path (checked first, before the leading/
     trailing-slash test would otherwise need to guard against `p at: 1` on
     an empty String). Answers `p` unchanged when canonical; crashes
     `bad channel path` (never silently normalizes) otherwise. *)
  checkPath: p = (
    | n i segLen dots |
    n:: p size.
    n = 0 ifTrue: [ ^ p ].                                   (* '' = the root, legal *)
    ((p at: 1) = 47 or: [ (p at: n) = 47 ]) ifTrue: [ self error: 'bad channel path' ].
    i:: 1. segLen:: 0. dots:: 0.
    [ i <= n ] whileTrue: [
      (p at: i) = 47
        ifTrue: [
          (segLen = 0 or: [ dots = segLen ]) ifTrue: [ self error: 'bad channel path' ].
          segLen:: 0. dots:: 0 ]
        ifFalse: [
          segLen:: segLen + 1.
          (p at: i) = 46 ifTrue: [ dots:: dots + 1 ] ].
      i:: i + 1 ].
    (segLen = 0 or: [ dots = segLen ]) ifTrue: [ self error: 'bad channel path' ].
    ^ p )

  (* Value order, typed equality, structural hash (Milestone B Task 7) — same
     non-public family as the helpers above, reached the same way (List's
     `outer` send; Map/Record join later the same way). Rank arms cover ONLY
     the ranks that exist today — 0 nil, 1 Boolean, 2 Integer, 3 Float,
     4 String, 6 Symbol, 7 List. Rank compare always runs FIRST, so values of
     different ranks are never equal (Integer 1 is not Float 1.0 in this
     algebra) even though both ranks individually order via `<`. Boolean
     order is a fixed, arbitrary choice: false < true. Genuine Symbols
     (Booleans are already peeled off as rank 1 before this arm) are compared
     byte-wise through the same String helper below, reading their name bytes
     directly via at:/size.

     UNTIL rete#205 that read went through `printString` ('#' + name), because
     dispatch.c's PRIM_at/PRIM_size fast-pathed String and RawBytes but not
     Symbol. It was not a cosmetic detour: printString's Symbol arm mallocs a
     scratch buffer and builds a String, so ONE comparison cost two C-heap
     mallocs and two immediately-dead Strings — and since this method is the
     Map's own order, it runs on every construction sort AND every binary-search
     key lookup. Measured at 71% of all C-heap allocation on a bridging node
     (docs/results/2026-08-12-allocation-attribution-c6.md §5.3). The ORDER is
     unchanged: both operands here are Symbols, so both printStrings carried the
     same '#' prefix and comparing the names gives the identical answer. *)
  valueCompare: a with: b = (
    | ra rb |
    ra:: rankOf: a. rb:: rankOf: b.
    ra = rb ifFalse: [ ^ ra < rb ifTrue: [ -1 ] ifFalse: [ 1 ] ].
    ra = 0 ifTrue: [ ^ 0 ].                                     (* nil = nil *)
    ra = 1 ifTrue: [                                            (* Boolean: false < true *)
      a == b ifTrue: [ ^ 0 ].
      ^ a ifTrue: [ 1 ] ifFalse: [ -1 ] ].
    (ra = 2 or: [ ra = 3 ]) ifTrue: [                            (* Integer / Float *)
      a < b ifTrue: [ ^ -1 ]. b < a ifTrue: [ ^ 1 ]. ^ 0 ].
    ra = 4 ifTrue: [ ^ byteCompare: a with: b ].                 (* String *)
    ra = 5 ifTrue: [ ^ bytesCompare: a with: b ].                (* Bytes *)
    ra = 6 ifTrue: [ ^ byteCompare: a with: b ].                 (* Symbol *)
    ra = 7 ifTrue: [ ^ listCompare: a with: b ].                 (* List *)
    ra = 8 ifTrue: [ ^ mapCompare: a with: b ].                  (* Map *)
    ra = 9 ifTrue: [ ^ recordCompare: a with: b ].                (* Record *)
    ^ self error: 'not a value'
  )

  (* Byte-wise total order over two Strings: shared-prefix bytes decide first;
     an exact-prefix tie falls to shorter-is-less. Shared verbatim by the String
     (rank 4) and Symbol (rank 6) arms above — since rete#205 both answer at:
     and size, so neither needs converting to reach the other's helper. *)
  byteCompare: s with: t = (
    | n m lim |
    n:: s size. m:: t size. lim:: n < m ifTrue: [ n ] ifFalse: [ m ].
    1 to: lim do: [ :i | | sb tb |
      sb:: s at: i. tb:: t at: i.
      sb < tb ifTrue: [ ^ -1 ].
      tb < sb ifTrue: [ ^ 1 ] ].
    n < m ifTrue: [ ^ -1 ]. n > m ifTrue: [ ^ 1 ]. ^ 0
  )

  (* Byte-wise total order over two Bytes values: shared-prefix bytes decide
     first (via u8At:/byteSize, a RawBytes-wrapping kernel object — NOT a
     String — so byteCompare:with: itself cannot be reused, it sends
     at:/size), an exact-prefix tie falls to shorter-is-less. Same shape as
     byteCompare:with: above. *)
  bytesCompare: a with: b = (
    | n m lim |
    n:: a byteSize. m:: b byteSize. lim:: n < m ifTrue: [ n ] ifFalse: [ m ].
    1 to: lim do: [ :i | | sb tb |
      sb:: a u8At: i. tb:: b u8At: i.
      sb < tb ifTrue: [ ^ -1 ].
      tb < sb ifTrue: [ ^ 1 ] ].
    n < m ifTrue: [ ^ -1 ]. n > m ifTrue: [ ^ 1 ]. ^ 0
  )

  (* Element-wise total order over two Lists: shared-index elements decide
     first (recursively, via valueCompare:with:), an exact-prefix tie falls
     to shorter-is-less. *)
  listCompare: a with: b = (
    | n m lim |
    n:: a size. m:: b size. lim:: n < m ifTrue: [ n ] ifFalse: [ m ].
    1 to: lim do: [ :i | | c |
      c:: valueCompare: (a at: i) with: (b at: i).
      c = 0 ifFalse: [ ^ c ] ].
    n < m ifTrue: [ ^ -1 ]. n > m ifTrue: [ ^ 1 ]. ^ 0
  )

  (* Entry-wise total order over two Maps' SORTED entries: shared-index
     entries decide first, pairwise key-then-value (recursively, via
     valueCompare:with:), an exact-prefix tie falls to shorter-map-is-less.
     Same shape as listCompare:with: above, but each step is two compares
     (key, then value only if the keys tied) instead of one. Walks both Maps
     by index via the `keyAt:`/`valueAt:` accessors (see Map's own comment on
     why keysAndValuesDo: alone can't do lockstep two-receiver iteration). *)
  mapCompare: a with: b = (
    | n m lim c |
    n:: a size. m:: b size. lim:: n < m ifTrue: [ n ] ifFalse: [ m ].
    1 to: lim do: [ :i |
      c:: valueCompare: (a keyAt: i) with: (b keyAt: i).
      c = 0 ifFalse: [ ^ c ].
      c:: valueCompare: (a valueAt: i) with: (b valueAt: i).
      c = 0 ifFalse: [ ^ c ] ].
    n < m ifTrue: [ ^ -1 ]. n > m ifTrue: [ ^ 1 ]. ^ 0
  )

  (* Tag-then-fields total order over two Records: tag decides first (both
     Symbols, compared via the rank-6 arm above), fields decide the tie
     (both Maps, routes through mapCompare:with:). Uses only the public
     tag/fields accessors — no new public surface needed (unlike Map's
     keyAt:/valueAt:, which exist purely so this family can walk two
     receivers in lockstep; Record has exactly one field of each kind, so a
     plain accessor read suffices). *)
  recordCompare: a with: b = (
    | c |
    c:: valueCompare: a tag with: b tag.
    c = 0 ifFalse: [ ^ c ].
    ^ valueCompare: a fields with: b fields
  )

  value: a equals: b = ( ^ (valueCompare: a with: b) = 0 )

  (* FNV-style structural hash: a leaf folds its existing `hash` with its
     rank; a container seeds the fold with its rank and mixes in each
     child's valueHashOf: in canonical (construction) order. 30-bit mask
     keeps every intermediate SMI-safe (mirrors the Integer bitops fold
     idiom from Task 1) — this is why the LEAF fallback below masks too
     (Milestone B Task 8 fix, discovered via TDD: a bare Symbol's native
     `hash` is a large, unbounded value — NOT a small SMI like Integer's
     self-hash — so folding it into a container's `h * 16777619` step
     unmasked overflows LargeInteger's 64-bit magnitude limit before the
     container's own bitAnd ever runs; Task 7's own test never combined a
     Symbol into a container hash, so this went uncaught until a Map with
     Symbol keys exercised it here). Masking the leaf is a no-op for every
     already-passing case (Integer/List leaf hashes here are already well
     under 2^30) and only changes behavior for previously-broken cases. *)
  valueHashOf: v = (
    | r h |
    r:: rankOf: v.
    r = 7 ifTrue: [                                              (* List *)
      h:: r.
      v do: [ :e | h:: ((h bitXor: (valueHashOf: e)) * 16777619) bitAnd: 1073741823 ].
      ^ h ].
    r = 8 ifTrue: [                                              (* Map *)
      h:: r.
      v keysAndValuesDo: [ :k :val |
        h:: ((h bitXor: (valueHashOf: k)) * 16777619) bitAnd: 1073741823.
        h:: ((h bitXor: (valueHashOf: val)) * 16777619) bitAnd: 1073741823 ].
      ^ h ].
    r = 9 ifTrue: [                                              (* Record *)
      h:: r.
      h:: ((h bitXor: (valueHashOf: v tag)) * 16777619) bitAnd: 1073741823.
      h:: ((h bitXor: (valueHashOf: v fields)) * 16777619) bitAnd: 1073741823.
      ^ h ].
    r = 5 ifTrue: [                                              (* Bytes — folded
      explicitly, container-style, ABOVE the leaf fallback: a Bytes value's own
      `hash` method calls back into `outer valueHashOf: self`, so if rank 5 ever
      reached the fallback below it would recurse forever. *)
      h:: r.
      1 to: v byteSize do: [ :i | h:: ((h bitXor: (v u8At: i)) * 16777619) bitAnd: 1073741823 ].
      ^ h ].
    ^ ((v hash) bitXor: r) bitAnd: 1073741823
  )

  public readLine = ( ^ platform readLine )
  (* rete#377: the debugger's hold, told to the liveness observer — true before its
     command loop, false on the continue — so a stop served through porta is a HELD VM
     and not a wedged one. The cable read no longer says it; the loop does. *)
  public debugHeld: aBoolean = ( ^ platform debugHeld: aBoolean )
  public protectedFire: aBlock value: v = ( ^ platform protectedFire: aBlock value: v )
  public valueRank: v = ( ^ platform valueRank: v )
  (* The restart-sweep verb (Milestone D Task 4): the Supervisor (Task 5) calls
     this directly with a crashed job's rootCap to drop every reaction it owns,
     across every channel, before the job restarts. Thin forwarder to the C
     prim, same shape as protectedFire:/valueRank: above. *)
  public spaceDropReactionsOwnedBy: cap = ( ^ platform spaceDropReactionsOwnedBy: cap )
  (* tuvm#20: posts shed by the full event ring — per exact channel, or the
     node total for ''. Cumulative, never reset. The pull side of G2's "never
     silent" (the periodic sys/metrics push side is tuvm#24). Thin forwarder,
     same shape as spaceDropReactionsOwnedBy: above. *)
  public spaceOverruns: p = ( ^ platform spaceOverruns: p )
  public sysStats = ( ^ platform sysStats )
  (* rete#215: the retained panic note. Thin forwarders, the sysStats shape above.
     A wedge raises no fatal error, so nothing in this tree could ever produce
     Panic reason #watchdog before now — RECORDS §2.4 pinned the symbol and the
     record, and both were aspirational. *)
  public panicNote = ( ^ platform panicNote )
  public panicNoteAck: bootId = ( ^ platform panicNoteAck: bootId )
  (* Milestone D Task 6: the host virtual-clock timer seam. Thin forwarders,
     same shape as spaceDropReactionsOwnedBy: above — the `Timers` class
     (below) is the only intended caller (it holds `platform` as its
     `seam`), but these are ordinary public Kernel-instance selectors like
     every other forwarder in this family. *)
  public timerAfter: ms token: tok = ( ^ platform timerAfter: ms token: tok )
  public timerEvery: ms token: tok = ( ^ platform timerEvery: ms token: tok )
  public timerCancel: tok = ( ^ platform timerCancel: tok )
  public monotonicMillis = ( ^ platform monotonicMillis )
  public advanceMillis: ms = ( ^ platform advanceMillis: ms )
  (* Zephyr rung-2 sub-project 1: the ISR→channel pulse seam. Thin forwarders,
     same shape as the timer forwarders above — the `GpioPulse` class (above)
     is the only intended caller (it holds `platform` as its `seam`), but
     these are ordinary public Kernel-instance selectors like every other
     forwarder in this family. *)
  public gpioPin: n edge: e post: m on: path = ( ^ platform gpioPin: n edge: e post: m on: path )
  public gpioFire: n = ( ^ platform gpioFire: n )
  (* tuvm#82: the OUTBOUND half of the gpio seam. Thin forwarders, same shape as
     gpioPin:/gpioFire: above. Both answer nil for a pin the board never declared —
     the GpioPulse wrapper is what turns that nil into a tagged raise, so these stay
     raw and a test can observe the nil directly. *)
  public gpioSet: n to: aBool = ( ^ platform gpioSet: n to: aBool )
  public gpioLevel: n = ( ^ platform gpioLevel: n )
  (* tuvm#88: the display seam. Thin forwarders, same shape as the gpio family
     above. All four answer nil when the board has no display and an SMI status
     otherwise — the Display wrapper is what turns those into tagged raises, so
     these stay raw and a test can observe the codes directly. *)
  public displayClear = ( ^ platform displayClear )
  public displayAt: r col: c put: s = ( ^ platform displayAt: r col: c put: s )
  public displayRefresh = ( ^ platform displayRefresh )
  public displayRefreshRow: r = ( ^ platform displayRefreshRow: r )
  (* tuvm#94: the bell seam. Same thin-forwarder shape as the display family
     above — nil when the board has no bell, an SMI status otherwise; the Bell
     wrapper turns those into tagged raises, so this stays raw and a test can
     observe the codes directly. IT BLOCKS for the whole striking, ~500 ms a
     bell. *)
  public bellStrike: n = ( ^ platform bellStrike: n )
  (* tuvm#94 stage 4: the NTP seam. Thin forwarder — nil when the sync failed, an
     SMI of seconds-since-local-midnight (0..86399) otherwise. The offset is passed
     IN because the timezone is a product fact, not a hardware one.
     There is deliberately NO wrapper class here, unlike Bell/Display: a wrapper
     exists to turn status codes into tagged raises, and this seam has no error to
     raise. A failed sync is an ordinary answer the node acts on directly (keep
     free-running), not an exceptional condition — inventing a raise for it would
     force every caller to write a handler for the normal case.
     IT BLOCKS up to the SNTP timeout; call only between strikes. *)
  public ntpSyncTz: offsetSeconds = ( ^ platform ntpSyncTz: offsetSeconds )
  (* tuvm#100 (2026-08-01): the DATE of the last successful ntpSyncTz:, packed
     decimal (20260801), in that call's timezone — nil if none has succeeded.
     It exists so the RTC correction loop can complete: ntpSyncTz: answers
     seconds-of-day, wallClockSetDate:time: demands a date, and without this a node
     can measure the clock's error but not fix it.
     DOES NOT BLOCK and does NOT ask the network — it reads what the sync already
     received, so one request serves both halves.
     Call ntpSyncTz: first and only trust this if that answered non-nil. *)
  public ntpDate = ( ^ platform ntpDate )
  (* tuvm#94 stage 5: the RTC-retention seam. Thin forwarders over the platform prims,
     the same shape as ntpSyncTz: above. rtcValid answers a Boolean here (the prim
     answers an SMI 0/1 — no true/false oop is needed on the C side). rtcGet:/
     rtcPut:value: are indexed SMI accessors; the field indices (design §3) are node
     constants, not baked here, so the seam stays a dumb array. *)
  public rtcValid = ( ^ (platform rtcValid) = 1 )
  (* rete#233 T10: did this boot come out of deep sleep on the timer? False only for a
     KNOWN other cause — the runner's trial/revert reboot, the observer's watchdog, a
     power-on — on which the RTC record is still valid but the bell must not strike. A
     host, or a board whose hwinfo cannot say, answers true: the clock keeps striking
     exactly as it did before this rule existed. *)
  public timerWake = ( ^ (platform timerWake) = 1 )
  public rtcGet: i = ( ^ platform rtcGet: i )
  public rtcPut: i value: v = ( platform rtcPut: i value: v. ^ self )
  (* tuvm#94 stage 5: deepSleep: seconds. NEVER RETURNS — the VM ceases to exist
     until the next timer wake reboots it. There is no wrapper and no answer to coerce:
     the caller's very next line is unreachable by construction. *)
  (* rete#415 P3: an open profile window is closed first, so its dump leaves before the
     VM ends (the table is RAM, and a wake is often shorter than the window). *)
  public deepSleep: seconds = (
    profilerOne == nil ifFalse: [ profilerOne cutBySleep ].
    ^ platform deepSleep: seconds )
  (* tuvm#100: the wall-clock seam — an external RTC (DS3231 over I2C) as the
     timebase. Thin forwarder, deliberately the SAME shape as ntpSyncTz: above:
     nil when there is no RTC or it has never been set, an SMI of seconds-since-
     local-midnight (0..86399) otherwise. That sameness is the point — schedule
     arithmetic cannot tell which timebase answered, so a node moves between the
     network and the RTC without touching its striking code.
     NOT the rtcValid/rtcGet:/rtcPut:value: family above: those are the deep-sleep
     RETENTION store. Different device, different question, hence the name.
     No wrapper class and no raise, for ntpSyncTz:'s reason: a board with no RTC
     is an ordinary answer the node acts on (free-run), not an exceptional
     condition. Unlike ntpSyncTz: this does NOT block on a network — it is one
     short I2C transaction — and it takes no tz offset, because an RTC holds the
     local time that was written to it. *)
  public wallClock = ( ^ platform wallClock )
  (* tuvm#100: setting the RTC. `yyyymmdd` is a packed decimal date (20260731) and
     `secondsOfDay` is wallClock's own unit, so a set followed by a read is an
     identity. One call rather than two because a date write and a separate time
     write leave a window where the part holds halves of two different instants.
     nil when there is no RTC or the write was refused (a secondsOfDay outside
     0..86399), SMI 0 when the clock was set. *)
  public wallClockSetDate: yyyymmdd time: secondsOfDay = ( ^ platform wallClockSetDate: yyyymmdd time: secondsOfDay )
  (* shipsBellsV3 (#102): the RTC's own alarm. Arms it for a time-of-day; when it
     fires, `aMessage` is posted on `aChannelPath` through the ordinary pulse
     mailbox — the same delivery the gpio and sensor seams use. nil when it cannot
     be armed (no RTC, or an image without CONFIG_RTC_ALARM), which is a REAL
     answer a node is expected to handle rather than an error: the fallback it
     forces is what makes a missed alarm survivable. *)
  public rtcAlarmAt: secondsOfDay post: aMessage on: aChannelPath = ( ^ platform rtcAlarmAt: secondsOfDay post: aMessage on: aChannelPath )
  public pumpEvents = ( ^ platform pumpEvents )
  (* webserver-channel-device spike, Task 3: the http driver's platform prims.
     Same thin-forwarder shape as the gpio/timer families above — the C-side
     work (framing, ring, in-flight table) lives entirely in src/http.c +
     src/backend/<target>/http_<target>.c; this Kernel instance is just the
     capability the user's nsl code actually holds as `platform`. *)
  (* rete#440: the listener rings 'sys/http/listen' when a client is pending and reads
     nothing; this reaction does the accept, the read and the parse on the VM thread,
     one connection per `httpAccept`, until it answers false. False also re-arms the
     doorbell, so the listener is always read to empty (invariant 4). *)
  public httpListen: port = ( | r |
    r:: platform httpListen: port.
    (self space channel: 'sys/http/listen') whenever: '' do: [ :bell |
      [ platform httpAccept ] whileTrue: [ ] ].
    ^ r )
  public httpAccept = ( ^ platform httpAccept )
  public httpRespondId: id status: st body: b = ( ^ platform httpRespondId: id status: st body: b )
  public httpInject: m path: p = ( ^ platform httpInject: m path: p )
  public httpBeginId: id status: st = ( ^ platform httpBeginId: id status: st )
  public httpChunkId: id data: s    = ( ^ platform httpChunkId: id data: s )
  public httpEndId: id              = ( ^ platform httpEndId: id )
  (* AMG8833 thermal rung Task 1: the Tier-1 sensor seam. Same thin-forwarder
     shape as the http family above — the C-side work lives entirely in
     src/sensor_backend.h + src/backend/<target>/sensor_<target>.c; this Kernel
     instance is just the capability the user's nsl code actually holds as
     `platform`. sensorRead: 'kind' (rete#436: 'thermal', 'accel') answers a raw
     Array of SMIs in milli-units of the channel's SI unit (or nil when the kind
     is unknown or its device not ready) — read with basicAt:, the heapStats
     precedent, not Array's at:. sensorArm:post:on:threshold: answers the
     platform when the trigger is armed and NIL when the backend refuses, exactly
     like rtcAlarmAt:post:on: — so a caller has to carry a fallback rather than
     assume a trigger it never got (rete#184). *)
  public sensorRead: kind = ( ^ platform sensorRead: kind )
  public sensorArm: kind post: msg on: path threshold: milli = ( ^ platform sensorArm: kind post: msg on: path threshold: milli )

  public Object            = ( ^ Object )
  public Array             = ( ^ Array )
  public Collection        = ( ^ Collection )
  public OrderedCollection = ( ^ OrderedCollection )
  public Interval          = ( ^ Interval )
  public Set               = ( ^ Set )
  public Dictionary        = ( ^ Dictionary )
  public Association       = ( ^ Association )
  public List              = ( ^ List )
  public Map               = ( ^ Map )
  public Protocol          = ( ^ Protocol )
  public Record            = ( ^ Record )
  (* Rung 3 Task 5: the CBOR codec is a stateless utility, but its public entry
     (`encode:`) is an INSTANCE method, so the accessor answers a fresh instance
     (same "always fresh, same underlying substrate" shape as `space`/`timers`).
     Returning the class object instead would route `Cbor encode:` through the
     compiler's class-construction fallback — sending an instance-side selector
     to a class object silently NEWs the class and drops the message. *)
  public Cbor              = ( ^ Cbor new )
  public HeapStats         = ( ^ HeapStats )
  (* tuvm#61: the span-slot capability. Answers the CLASS, not an instance — the
     `Cbor new` comment above explains why the two are spelled differently: sending
     an instance-side selector to a class object silently NEWs the class and drops
     the message. Callers do `platform Spans new` and hold the instance. *)
  public Spans             = ( ^ Spans )
  (* tuvm#72: same shape as Spans above — answers the CLASS, so
     `platform SpanCapture onSpace:spans:` reaches the class-side constructor
     rather than whatever an implicit accessor would hand back. Written out
     explicitly for exactly the reason the comment above gives. *)
  public SpanCapture       = ( ^ SpanCapture )
  public heapStats         = ( ^ HeapStats fromList: (platform heapStats) )
  (* rete#192: DO NOT SEND THIS ON A PERIODIC PATH. Sending it once per check-in
     hangs a C6 silently — proven on hardware 2026-08-10 against a build that
     differed only in this send. The mechanism is unknown, and this accessor plus
     the CHeapStats class are that bug's only reproducer, which is why they are
     still here. `Kernel>>cheap` reads the raw prim Array instead; see its comment.
     Its twin `heapStats` above is NOT known to be affected — it is exercised on
     target by CborBenchNodeC6 and MeasureNodeDK and works. *)
  public cheapStats        = ( ^ CHeapStats fromList: (platform cheapStats) )
  (* #165: open and close a per-method profile window. The counter is a build
     option (OEVM_METHOD_PROFILE) and these are no-ops without it, so an app may
     send them unconditionally. The rows do NOT come back through here — they go
     to the console, which is already teed off the board (design D4). *)
  public profileStart      = ( platform profileStart. ^ self )
  public profileStop       = ( platform profileStop. ^ self )
  (* rete#312 Q1: the kernel's one profile handler (class Profiler). *)
  public profiler          = (
    profilerOne == nil ifTrue: [ profilerOne:: Profiler usingKernel: self ].
    ^ profilerOne )
  (* #342 spike: the Supervisor's Debugger in a debug image, nil otherwise. Set once,
     before main:, so an app cannot replace it. *)
  public debugger          = ( ^ debuggerOne )
  public debugger: d       = ( debuggerOne == nil ifTrue: [ debuggerOne:: d ]. ^ self )
  (* rete#312: a complete console line if one is queued, nil if not, false when this
     console cannot announce lines. Never blocks; the first send arms `sys/console`. *)
  public consoleLine       = ( ^ platform consoleLine )
  (* rete#415: point the console's UDP tee at [addr]:port (a literal IPv6 address; ''
     turns it off). Answers false when the platform could not parse it. *)
  public consoleTee: addr port: port = ( ^ platform consoleTee: addr port: port )
  (* #74: the build actually running, so a reader can pick the matching sidecar. *)
  public buildId           = ( ^ platform buildId )
  (* rete#118: which BOARD this is — its factory link address in lowercase hex, read
     from silicon (on the host, the OEVM_NODE_ID env value). The primitive FAILS when
     there is none. buildId names the image, bootId names the run, this names the
     hardware. *)
  public nodeId            = ( ^ platform nodeId )
  (* rete#118: the build-time BOARD NAME (what the bench calls this board), apart from
     the node id, which is read from silicon. A String, or nil when the build was not
     told one — obs/build then omits `board`. *)
  public boardName         = ( ^ platform boardName )
  (* rete#273 D1: an app WITHOUT a bridge (the wedge probes) declares its own
     app cadence straight to the observer. Bridged apps go through
     PortaBridge>>appLiveness:, which also owns the default. *)
  public appLiveness: aMs  = ( platform appLiveness: aMs. ^ self )
  (* rete#162: the RUN of that build — a counter incremented once per boot and
     persisted in NVS (RECORDS §3). Sibling of buildId above and forwarded here
     for the same reason: an app's `platform` is the kernel instance, so without
     this line no app could name its own boot. Answers 0 on a node with no
     persistent storage, which is a value to branch on and not an error. *)
  public bootId            = ( ^ platform bootId )
  (* rete#243: the CONTRACT the image was built against — 8 bytes of the pinned
     MANIFEST.cddl's SHA-256, baked beside buildId. Fourth provenance sibling
     (image / run / board / contract). nil on a pinless build (host, or any
     pre-manifest image) — obs/build omits #man then, absence meaning "the node
     cannot say". The prim answers a RawBytes LEAF; the wrap here is
     otaRunningHash's precedent, and `== nil` not isNil for the same prim-built
     reason. *)
  public manifestPin = ( | r |
    r:: platform manifestPin.
    r == nil ifTrue: [ ^ nil ].
    ^ Bytes overRaw: r )
  (* rete#25: the image-push seam (prims 145-150, src/ota.h). Five accessors, no
     policy (the stage is the kernel's own OtaFetch's since rete#440 R5, never an
     app's) — an app decides WHICH hash it wants and WHEN to confirm; C owns the
     bytes, because a staged image must never enter the VM heap (design G3).

     Bytes cross the prim boundary as the RawBytes LEAF, not as an nsl Bytes
     object: C has no way to read a wrapper's slot, so these accessors do the
     wrap (`Bytes overRaw:`) and unwrap (`rawLeaf`) — the same division of
     labour Socket>>sendTo: already uses. That is the whole reason these are not
     one-line forwarders like buildId above.

     With no runner environment every answer is an ORDINARY VALUE a caller can
     branch on with no handler in sight: nil, false, false. A node launched bare
     is unchanged by this seam existing. *)
  public otaRunningHash = ( | r |
    r:: platform otaRunningHash.
    r == nil ifTrue: [ ^ nil ].
    ^ Bytes overRaw: r )
  (* GUARDED BEFORE `rawLeaf`, and that ordering is the whole point. `rawLeaf`
     exists only on Bytes, so sending it to anything else is a
     doesNotUnderstand — and a DNU here is not a catchable nsl condition, it is
     dispatch.c's abort(). Once PortaBridge wires this up, the argument
     originates in a gateway-written `goal/` record, so an unguarded send would
     let a peer kill the node with one malformed field. That is exactly the
     failure the C side's own guards are written to avoid (platform.c: "a bad
     one is a peer's mistake to report, not this node's to die of"), and it was
     reachable in front of them.

     `isBytes` is TOTAL — every builtin receiver, nil included, answers false in
     dispatch.c's predicate fast-path, and every heap object falls through to
     Object>>isBytes — so this guard cannot itself become the crash it prevents.

     An UNFROZEN ByteArray is refused too, and deliberately: it inherits
     Object>>isBytes (false), and accepting it would mean the seam reading bytes
     that its owner can still mutate underneath a blocking fetch. Refusing is
     also the honest reading of `Bytes` being reachable only through a real
     freeze copy. Note Socket>>sendTo: sends `rawLeaf` unguarded — no precedent
     was broken here, because its argument is app-supplied and this one is not.

     The C-side guards stay exactly as they are. Defense is layered, not moved. *)
  public otaIsRunning: aHash = (
    aHash isBytes ifFalse: [ ^ false ].
    ^ platform otaIsRunning: aHash rawLeaf )
  public otaTrial = ( ^ platform otaTrial )
  public otaConfirm = ( platform otaConfirm. ^ self )
  (* DOES NOT RETURN when the backend can exit: the process leaves in
     STAGE_READY(42) and the runner relaunches on the staged image. The `^ self`
     is reached only on a backend that cannot exit. *)
  public otaActivate: aHash sig: aSig = (
    aHash isBytes ifFalse: [ ^ self ].
    (aSig == nil or: [ aSig isBytes ]) ifFalse: [ ^ self ].
    platform otaActivate: aHash rawLeaf sig: (self otaRawOf: aSig).
    ^ self )
  (* A BAD SIGNATURE REFUSES THE WHOLE CALL rather than being dropped to nil.
     Dropping it would stage or activate an image with its provenance quietly
     removed — the runner would then see an unsigned record and have nothing to
     check, which is worse than the tick that never happened. Absent (nil) and
     malformed are different things and must not collapse.

     A nil signature is TOLERATED HERE AND REFUSED UPSTREAM, and the two are not
     in tension — they are defense in depth with the decision in one place.
     Design D3 requires a real signature: `PortaBridge>>otaWantedFrom:` answers
     nil for a `goal/apps/main` record with no `#sig`, so no unsigned image is
     ever staged or activated by this node, and the field is pinned in
     PROTOCOL-NSL-RECORDS. This accessor still lets nil across because `sig` is
     CARRIED, not checked (design D4: verification has exactly one seat and it is
     the runner) — collapsing "there is no signature" into an empty one here
     would hand the runner something that LOOKS checkable and is not. So: the
     bridge decides whether a signature is required, this seam decides only that
     a malformed one is a refusal and an absent one is not silently invented. *)
  otaRawOf: aBytes = (
    aBytes == nil ifTrue: [ ^ nil ].
    ^ aBytes rawLeaf )
  (* #165 D2/D6: parse a dbg/req line into a window length in ms. PURE — it
     starts nothing and touches no state, so it is testable without a bridge and
     the app stays in charge of the window's lifecycle.

     Answers 0 for anything that is not a well-formed `profile <positive int>`:
     a wrong verb, a missing duration, a zero duration, or a duration with any
     non-digit in it. Refused rather than defaulted — a defaulted length is an
     invented constant, and a zero-length window would enable counting and never
     stop. The caller does nothing on 0, and the line still lands in the space,
     so a request that could not be understood is visible rather than eaten. *)
  public parseProfileMs: line = (
    | rs verb tok n i b |
    rs:: ReadStream on: line.
    verb:: rs upTo: 32.
    verb = 'profile' ifFalse: [ ^ 0 ].
    tok:: rs upTo: 32.
    tok == nil ifTrue: [ ^ 0 ].
    tok size = 0 ifTrue: [ ^ 0 ].
    (* Every character must be a digit. supervisor.nsl's parseInt: SKIPS
       non-digits, which would read 'a5' as 5; that is wrong for a wire value. *)
    n:: 0.
    i:: 1.
    [ i <= tok size ] whileTrue: [
      b:: tok at: i.
      (b < 48 or: [ b > 57 ]) ifTrue: [ ^ 0 ].
      n:: (n * 10) + (b - 48).
      i:: i + 1 ].
    ^ n )
  (* tuvm#24: the sys/metrics snapshot — prim 104 (heapStats) + prim 109
     (sysStats) composed into ONE flat immutable Record, the sys/metrics
     cell's wire schema (pinned in protocol/PROTOCOL-NSL-RECORDS.md §4.4).
     The kernel only BUILDS the record; publishing it onto a cell is the
     app's act, on a user-requested cadence (G9), with the channel arriving
     as a capability — the kernel never conjures space access (Milestone-C
     constructor-args rule). Raw prim arrays are read with basicAt:, the
     HeapStats precedent. *)
  public metrics = ( | h s pairs |
    h:: platform heapStats.
    s:: platform sysStats.
    pairs:: OrderedCollection new.
    pairs add: #hsz -> (h basicAt: 1).
    pairs add: #lb -> (h basicAt: 2).
    pairs add: #hhw -> (h basicAt: 3).
    pairs add: #lfb -> (h basicAt: 4).
    pairs add: #gcc -> (h basicAt: 5).
    pairs add: #hnl -> (s basicAt: 1).
    pairs add: #hnhw -> (s basicAt: 2).
    pairs add: #qhw -> (s basicAt: 3).
    pairs add: #ovr -> (s basicAt: 4).
    (* tuvm#34: the ISR pulse seam's own counters, widening this record from 9
       fields to 11. That seam used to answer a full mailbox with k_oops, so there
       was nothing to publish; now that it SHEDS instead, a silent shed would be
       strictly worse than the crash it replaced. pulseDrops rising is the alarm —
       the reactor is not pumping fast enough; pulseCoalesced rising is the
       mechanism working, a repeating source folding into one pending wakeup. *)
    pairs add: #pdr -> (s basicAt: 5).
    pairs add: #pco -> (s basicAt: 6).
    (* rete#214: the seam's OTHER loss path, widening this to 12. A queued event whose
       handle resolved NULL at pump time is discarded by tuvm#13's ABA guard — right,
       since the slot's new occupant is not what was posted — but it incremented
       nothing, so a destroyed wakeup left #pdr reading 0 and the record reading
       healthy. A lost wakeup is the failure shape #192/#213 present. Since #151 a
       timer rides BY VALUE and cannot take that branch, so a non-zero #pst names the
       handle path specifically — and that claim was unfalsifiable until this field. *)
    pairs add: #pst -> (s basicAt: 7).
    ^ Record tag: #Metrics fields: (Map fromPairs: pairs) )
  (* rete#190: the sys/cheap snapshot — prim 152 (cheapStats) as ONE flat immutable
     Record, the sys/cheap cell's wire schema (pinned in
     protocol/PROTOCOL-NSL-RECORDS.md §4.4). A SEPARATE record from Metrics, not
     five more Metrics fields: RECORDS §4.4 already records that lesson against
     LatencySpan — adding a concern adds a record, not a field, so this schema does
     not grow the way Metrics has. Metrics is 195 B of the 256 B cap and keeps all
     61 B of its headroom.
     The kernel only BUILDS the record; publishing it onto a cell is the app's act
     (G9), with the channel arriving as a capability.
     READ WITH basicAt:, NOT THROUGH `self cheapStats`. Going through the
     `CHeapStats fromList:` wrapper here HANGS A C6 — silently, no panic, no VM
     error — on the first check-in after the bridge-health verdict. Established on
     hardware 2026-08-10 by three builds differing in one thing each, same board and
     command: the wrapper version died at tick 2-3 on three separate boots; a
     constant record ran clean; and THIS body, which still executes prim 152 every
     check-in, ran to tick 610-614 (where it meets the unrelated pre-existing cliff
     below). So prim 152 is innocent — it is the four-line nsl wrapper that is fatal,
     and the MECHANISM IS STILL UNKNOWN (rete#192). `Kernel>>cheapStats` and the
     CHeapStats class survive as that bug's only reproducer; do not put either back
     on the check-in path.
     Reading the raw prim Array is also what `metrics` above has done with
     `platform heapStats` every check-in for a rung, so this is the proven shape
     rather than a special case — one fewer mechanism, not one more. *)
  public cheap = ( | c pairs |
    c:: platform cheapStats.
    pairs:: OrderedCollection new.
    pairs add: #ob  -> (c basicAt: 1).
    pairs add: #ohw -> (c basicAt: 2).
    pairs add: #alc -> (c basicAt: 3).
    pairs add: #fre -> (c basicAt: 4).
    pairs add: #fal -> (c basicAt: 5).
    ^ Record tag: #CHeap fields: (Map fromPairs: pairs) )
  (* rete#215: the sys/panic report — prim 153 as the Panic record RECORDS §2.4 pins.
     The kernel only BUILDS it; publishing onto a channel is the app's act with the
     channel arriving as a capability, exactly as metrics and cheap are handled —
     the kernel never conjures space access.

     READ WITH basicAt:, NOT through a wrapper class. `CHeapStats fromList:` on the
     check-in path silently HANGS a C6 (rete#192, mechanism still unknown), and this
     record is built at boot on every node. One fewer mechanism, and the one that is
     known to be survivable.

     `core` is nil and stays nil: blobs are off the space (RECORDS §2.4), and a node
     that just died is the last node that should be asked to retain one. *)
  public panic = ( | n pairs |
    n:: platform panicNote.
    (* `== nil`, NOT `isNil`. A prim-built indexable answers basicAt:/basicSize and
       nothing else — it is not an instance of a class carrying Object's protocol — so
       `isNil` is a doesNotUnderstand on it. Found on a C6 on 2026-08-19: the send
       aborted the VM on the boot that was trying to REPORT the previous wedge, and
       three of those in a row halted the node. `sensorRead:`'s callers already use
       `(f == nil)` for exactly this reason (ThermalDiagNode.nsl:53); metrics and cheap
       never hit it because they only ever send basicAt:. *)
    (n == nil) ifTrue: [ ^ nil ].
    pairs:: OrderedCollection new.
    pairs add: #reason -> (self panicReasonFor: (n basicAt: 1)).
    pairs add: #bootId -> (n basicAt: 2).
    pairs add: #monoMs -> (n basicAt: 3).
    pairs add: #detail -> (n basicAt: 4).
    pairs add: #core   -> nil.
    ^ Record tag: #Panic fields: (Map fromPairs: pairs) )

  (* The C side writes a small int because a fatal handler may not allocate; the symbol
     belongs here, where the record is built. The mapping is RN_REASON_* in
     nodus/oevm/src/reboot_note.h and it is APPEND-ONLY. An unrecognised code answers
     #hardFault rather than a sixth symbol: RECORDS §2.4 pins the enumeration, and a
     reason the gateway cannot name is worth less than an imprecise one it can. *)
  panicReasonFor: code = (
    code = 1 ifTrue: [ ^ #watchdog ].
    code = 3 ifTrue: [ ^ #assert ].
    code = 4 ifTrue: [ ^ #stackOverflow ].
    code = 5 ifTrue: [ ^ #oom ].
    ^ #hardFault )
  (* Milestone E Task 1: crash-Record factory reachable from ANY context. The
     error:/error:tag: raise prims cannot reach the sibling `Record` class from an
     app receiver (v1 BLOCKED finding), but they DO hold the captured Kernel
     instance, so they send it this accessor — kernel scope, where `Record`
     resolves — to build the in-flight crash Record before raising it. *)
  public crashRecordTag: aTag text: aText = ( ^ Record tag: aTag with: #text -> aText )
  (* Milestone E F1: the default-tag factory for a bare `self error:` (no explicit
     tag). The `#error` literal here compiles into the image's INTERNED symbol
     table, so any `#error` elsewhere (e.g. an app handler predicate
     `[ :e | e tag = #error ]`) interns to the SAME oop and identity-`=` matches.
     The v1 PRIM_error minted a FRESH non-interned Symbol, which never matched. *)
  public crashRecordText: aText = ( ^ Record tag: #error with: #text -> aText )
  public ByteArray         = ( ^ ByteArray )
  public NetBridge         = ( ^ NetBridge )
  (* porta space-sync (plan 2). Answers the CLASS, not an instance — `platform
     PortaBridge socket:space:id:peer:port:` must reach the class-side
     constructor, and sending an instance-side selector to a class object
     silently NEWs the class and drops the message (the `Cbor new` note above).
     THE NODE MUST HOLD THE ONE INSTANCE IT GETS: the cursor, the ack high-water
     and the pending capture queue all live on it, so re-fetching this accessor
     would silently start a second, empty bridge — the pre-#244 `platform
     timers` lesson, which cost a 9h23m run and every bell in it (that
     accessor answers a singleton now; this one still cannot). *)
  public PortaBridge       = ( ^ PortaBridge )
  public ReadStream        = ( ^ ReadStream )
  public WriteStream       = ( ^ WriteStream )
  (* Stateless facade (Milestone C Task 2): the tuple-space substrate is the
     C singleton (Task 1's space.c), so every call answers a FRESH Space
     object rooted at '' — not a cached instance — yet all of them address
     the same underlying space, exactly like two `platform List` sends
     answering the same class object above. *)
  public space             = ( ^ Space new setRoot: '' )
  (* Milestone D Task 5: a fresh Supervisor holding the root Space, same
     "always fresh, same underlying substrate" shape as `space` above — the
     jobs OrderedCollection lives on this particular Supervisor instance, so
     callers keep the one answered by `platform supervisor` rather than
     re-fetching it. *)
  public supervisor        = ( ^ Supervisor new setSpace: self space )
  (* rete#244: THE per-kernel Timers singleton, minted on first ask. This
     accessor used to answer a fresh instance per send, and that was the
     documented landmine at four call sites and the silent 0-of-19-bells
     overnight failure (tuvm#94): each fresh instance owned its own `pending`
     registry AND handed out colliding tokens from `nextToken 1`, so a timer
     registered through one fetch and dispatched through another fired in C
     and was dropped without a sound. Unlike `space`/`gpio`/`display`, whose
     instances are stateless views over substrate C owns, Timers keeps its
     registry in nsl — the one accessor where "always fresh" and "same
     underlying substrate" were never both true. A test that needs a private
     registry constructs it explicitly: `Timers usingSpace:seam:` is
     unchanged. See 11_supervision/12_timers_instance_identity.nsl, which
     pins both the identity and the cross-fetch delivery. *)
  public timers            = (
    timersOne == nil ifTrue: [ timersOne:: Timers usingSpace: self space seam: self ].
    ^ timersOne )
  (* Zephyr rung-2 sub-project 1: a fresh GpioPulse instance wired to a fresh
     root Space and this Kernel instance as seam, same "always fresh, same
     underlying substrate" shape as `timers` above. Callers register pulses
     directly via this accessor — C owns the per-pin registration slot, so
     unlike `timers` there is no shared nsl-side registry callers need to
     keep a single instance of. *)
  public gpio              = ( ^ GpioPulse usingSpace: self space seam: self )
  (* tuvm#88: a fresh Display instance wired to this Kernel instance as seam,
     same "always fresh, same underlying substrate" shape as `gpio` above —
     C owns the grid state, so there is no shared nsl-side registry callers
     need to keep a single instance of. *)
  public display           = ( ^ Display usingSeam: self )
  (* tuvm#94: a fresh Bell instance wired to this Kernel instance as seam, same
     shape as `display` above. A NEW KERNEL CLASS IS UNREACHABLE WITHOUT AN
     EXPLICIT ACCESSOR — an app's `platform` is this Kernel instance, so a class
     nested here that nothing hands out simply does not exist for a node. *)
  public bell              = ( ^ Bell usingSeam: self )
  (* shipsBellsV3 (#102): a fresh RtcAlarm wired to this Kernel instance as seam,
     same shape as `gpio` — C owns the one alarm registration, so there is no
     nsl-side registry to keep a single instance of. (Contrast `timers`, whose
     pending table IS nsl-side and must be held.) *)
  public rtcAlarm          = ( ^ RtcAlarm usingSpace: self space seam: self )
) : (
)
