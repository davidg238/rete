# nodus/tuvm/tests/target/pulse-coalesce.env — #151
#
# Does the pulse coalescer destroy logical timer events? Three phases: an
# uncontended chain (must be clean), a repeater under a slow handler (the
# instrument check — coalescing MUST happen, or the other two phases measure
# nothing), and the ship's bell's real topology (the chain must not stall).
#
# ~60 s of on-device work: 2000 strokes at 10 ms, then ~2 s, then 3000 at 10 ms.
SCENARIO=pulse-coalesce
NODE=PulseCoalesceProbeC6.nsl
BOARD_ID=esp32c6
CLASS=disruptive
TIMEOUT_S=180
