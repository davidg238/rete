# nodus/tuvm/tests/target/stale-handle.env — #151
#
# A timer event must survive a later, unrelated registration. Both arms arm a
# one-shot and burn past its expiry inside a single reaction; they differ by ONE
# line — the test arm registers another timer afterwards.
#
# class=disruptive: it deliberately burns the reactor and latches nothing back
# up afterwards. It may only be deployed to a disposable board.
SCENARIO=stale-handle
NODE=StaleHandleProbeC6.nsl
BOARD_ID=esp32c6
CLASS=disruptive
TIMEOUT_S=120

# rete#216 — THE OBSERVATION WINDOW. This probe emits its TAPs and stops, so it
# has no progress line to watch and `none` says so out loud rather than by
# omission. What still applies is the fault half: a probe that passes and then
# panics is the same false green, and that half needs no per-scenario predicate.
#
# It carries bridge-health's 180 s rather than a shorter window of its own. No
# post-verdict death has ever been recorded for this probe — which is an absence
# of evidence, not evidence for a smaller number, and shaving it to save bench
# time would be exactly the invented constant the design posture warns against.
# The cost is real and named: it adds 180 s to a scenario that otherwise decides
# in well under two minutes.
OBSERVE_S=180
OBSERVE_PROGRESS=none
