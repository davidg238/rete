(*
expect:
probe done
*)
(* Does the pulse coalescer destroy LOGICAL timer events on target? (#151 probe)

   WHY THIS EXISTS. `pulse_post_isr` merges a post when (chan_id, handle_idx)
   matches one already queued, justified in-comment as "the payload is a doorbell
   token, not a value, so the two entries are byte-identical and merging loses no
   information". For timers that premise is false: `Timers>>dispatch:` looks the
   token up in `pending` and fires exactly that one, so every timer event is a
   distinct obligation, not a redraw request. Merging two is a skipped step.

   WHY THE HOST CANNOT ANSWER IT. The two backends deliver timer events by
   different paths:
       target  timer_zephyr.c:38   pulse_post_isr(e->chan_id, e->handle_idx)
       host    timer_posix.c:122   space_post("sys/timer", 9, tok)
   The host posts straight into the space and never enters the mailbox, so it can
   neither coalesce nor drop. All 239 suite tests run on that path, which is why
   the suite is silent here and why this had to be a node.

   READING THE OUTPUT. Every phase prints owed/delivered and the DELTA in
   pulseCoalesced (sysStats basicAt: 6) and pulseDrops (basicAt: 5) across the
   phase. delivered < owed with coalesced > 0 is the finding. delivered == owed
   with coalesced == 0 is a clean phase and evidence AGAINST the mechanism for
   that topology — say so rather than re-running until it misbehaves.

   Phase 1 is the control: an uncontended chain of one-shots, the shape
   ShipsBellAlarmNodeC6's striker uses (strikeOn arms, the handler re-arms). It
   should be perfect; if it is not, nothing later means anything.

   Phase 2 is the positive control: ONE repeating registration, so one handle, with
   a handler slow enough that several intervals elapse inside a single reaction.
   This is the case pulse_zephyr.c's comment calls "the mechanism working". If this
   phase does not coalesce, the mechanism does not exist on this silicon and the
   whole line of enquiry is dead.

   Phase 3 is the bell's real topology: the striker chain plus three concurrent
   one-shots standing in for the alarm, the countdown and the watchdog. The
   detector needs no statistics — `ticks` keeps climbing while the node lives, so
   if `strokes` stops climbing the chain has STALLED, which is the solid tone.

   Node shape is TimerNode's. Holds ONE Timers instance (it owns the nsl-side
   pending registry — `platform timers` answers a fresh one per call). Blocks
   forever draining in each phase rather than returning, so it can never leak a
   live repeater the way TimerNode documents. Dialect: `[ ... ] whileTrue:`, never
   `repeat`; no modulo. *)
class PulseCoalesceProbeC6 packageUsing: manifest = (
  | plat space timers
    strokeCh tickCh
    strokes ::= 0. ticks ::= 0. busyMillis ::= 0.
    chaining ::= false. |
) (

  public main: platform args: args = (
    plat:: platform.
    space:: plat space.
    timers:: plat timers.          (* hold ONE — it owns the pending registry *)
    space whenever: 'sys/timer' do: [ :e | timers dispatch: e ].

    strokeCh:: space channel: 'probe/stroke'.
    strokeCh whenever: '' do: [ :m | self onStroke ].

    tickCh:: space channel: 'probe/tick'.
    tickCh whenever: '' do: [ :m | self onTick ].

    ('probe: mailbox depth is 16; chain width ' , self widthMillis printString ,
      ' ms, matching the striker') out.

    self phase1.
    self phase2.
    self phase3.

    'probe done' out.
  )

  (* --- phase 1: the control -------------------------------------------------
     2000 chained one-shots and nothing else running. Owed == delivered exactly,
     because each post is consumed by pulse_pump before the handler that arms its
     successor ever runs. *)
  phase1 = (
    | c0 d0 |
    'phase 1: uncontended chain of one-shots' out.
    strokes:: 0. busyMillis:: 0. chaining:: true.
    c0:: self coalesced. d0:: self drops.
    timers after: self widthMillis post: #s on: strokeCh.
    [ strokes < 2000 ] whileTrue: [ plat pumpEvents. space drain ].
    chaining:: false.
    self report: 'phase 1' owed: 2000 got: strokes since: c0 drops: d0.
    ^ self )

  (* --- phase 2: the positive control ---------------------------------------
     ONE repeating registration, so one handle_idx, with a handler that burns
     ~50 ms against a 10 ms interval. Several intervals therefore elapse inside a
     single reaction, which is exactly the "a source with a post already pending"
     condition. Cancelled before leaving the phase. *)
  phase2 = (
    | c0 d0 tok owed |
    'phase 2: repeater at 10 ms under a 50 ms handler' out.
    ticks:: 0. busyMillis:: 50.
    c0:: self coalesced. d0:: self drops.
    tok:: timers every: 10 post: #t on: tickCh.
    [ ticks < 40 ] whileTrue: [ plat pumpEvents. space drain ].
    timers cancel: tok.
    busyMillis:: 0.
    (* Owed is derived from elapsed time, not assumed: 40 deliveries at ~50 ms of
       handler each is ~2 s of wall clock, and a 10 ms repeater owes ~200 over
       that. The exact number does not matter — coalesced > 0 is the finding. *)
    owed:: 200.
    self report: 'phase 2' owed: owed got: ticks since: c0 drops: d0.
    ^ self )

  (* --- phase 3: the bell's topology ----------------------------------------
     The striker chain, plus three concurrent one-shots re-armed at the cadences
     ShipsBellAlarmNodeC6 uses (the countdown's sub-second margin, the watchdog's
     2 s grace, the alarm's lead). Runs to 3000 strokes — ~30 s at 10 ms — and
     reports every 500. A frozen stroke count with a live tick count is the stall. *)
  phase3 = (
    | c0 d0 last stuck |
    'phase 3: chain + alarm/countdown/watchdog one-shots' out.
    strokes:: 0. ticks:: 0. busyMillis:: 0. chaining:: true.
    c0:: self coalesced. d0:: self drops.

    timers after: self widthMillis post: #s on: strokeCh.
    timers after: 250  post: #t on: tickCh.
    timers after: 2000 post: #t on: tickCh.
    timers after: 5000 post: #t on: tickCh.

    last:: 0. stuck:: 0.
    [ (strokes < 3000) and: [ stuck < 40 ] ] whileTrue: [
      plat pumpEvents. space drain.
      (strokes = last)
        ifTrue:  [ stuck:: stuck + 1 ]
        ifFalse: [ stuck:: 0. last:: strokes ] ].
    chaining:: false.

    stuck < 40
      ifTrue:  [ 'phase 3: chain ran to completion' out ]
      ifFalse: [ ('phase 3: CHAIN STALLED at stroke ' , strokes printString ,
                   ' with ticks ' , ticks printString , ' — the solid tone') out ].
    self report: 'phase 3' owed: 3000 got: strokes since: c0 drops: d0.
    ^ self )

  (* --- reactions ----------------------------------------------------------- *)

  onStroke = (
    strokes:: strokes + 1.
    chaining ifTrue: [ timers after: self widthMillis post: #s on: strokeCh ].
    ^ self )

  onTick = (
    ticks:: ticks + 1.
    busyMillis > 0 ifTrue: [ self burn: busyMillis ].
    ^ self )

  (* A deliberate stall inside a reaction. Busy-wait, not a sleep: the point is to
     hold the reactor OUT of pumpEvents so posts accumulate in the mailbox, which a
     sleep would not do on a run-to-completion loop. *)
  burn: ms = (
    | until |
    until:: plat monotonicMillis + ms.
    [ plat monotonicMillis < until ] whileTrue: [ ].
    ^ self )

  (* --- instruments --------------------------------------------------------- *)

  coalesced = ( ^ (plat sysStats) basicAt: 6 )
  drops     = ( ^ (plat sysStats) basicAt: 5 )

  report: name owed: owed got: got since: c0 drops: d0 = (
    (name , ': owed ' , owed printString , ' delivered ' , got printString) out.
    (name , ': coalesced ' , (self coalesced - c0) printString ,
            ' drops ' , (self drops - d0) printString) out.
    ^ self )

  widthMillis = ( ^ 10 )    (* the striker's own on-time *)

) : (
)
