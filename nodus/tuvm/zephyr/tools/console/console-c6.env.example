# Copy to ~/.config/rete/console-c6.env and correct the path for your bench:
#   mkdir -p ~/.config/rete
#   cp console-c6.env.example ~/.config/rete/console-c6.env
#   ls -l /dev/serial/by-id/        # confirm the hash below is yours
#
# This must be the CONSOLE port (the CP2102N UART bridge), never the flash port
# (the Espressif USB JTAG node, ttyACM*). On the C6 they are different physical
# channels and the console one stays enumerated across target resets — that
# split is what makes an always-on collector possible at all (#57, design §3).
#
# Always the by-id symlink, never a ttyUSB number: those are allocation-order
# names and this bench has more than one CP210x device.
RETE_CONSOLE_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_ac2dce6f529ced118f43fd6be259fb3e-if00-port0
