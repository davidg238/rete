# Bakes the NODE ID: which board this image is for (rete#186).
#
# A sibling of gen_build_id.cmake, deliberately: buildId names the IMAGE, this names
# the BOARD, and both reach nsl the same way (a generated C string + a platform prim)
# so there is one shape to learn rather than two.
#
# Configure time, not build time, and that is the difference from gen_build_id: the id
# comes from -DTUVM_NODE_ID and does not change between builds of the same board, where
# the build id must be re-stamped on every build.
#
# NO DEFAULT BOARD NAME, and no guess at one. The failure this whole issue is about is a
# node writing into a space that was not its own, so inventing a plausible board name
# here would reproduce it with a friendlier spelling.
#
# WHAT AN UNNAMED BUILD FALLS BACK TO IS THE BUILD HOST'S TAILSCALE NAME (David,
# 2026-08-22). Tailscale runs on the HOSTS — msi-7d43, gw85224-01 — and not on the nodes,
# which are C6s on Thread and cannot run it. So it cannot be the id itself: one host
# flashes several boards, and a per-host id would be a slot again, which is the bug. As a
# FALLBACK it is strictly better than a bare "unnamed", because two unnamed boards
# flashed from different hosts then land in different spaces instead of silently sharing
# one. It is also the name the bench is already navigated by.
#
# RESIDUAL, stated rather than engineered around: two unnamed boards flashed from the
# SAME host still collide. The fix for that is to name the board — which is the point.
if(NOT NODE_ID)
  execute_process(COMMAND tailscale status --self --peers=false
                  OUTPUT_VARIABLE _ts OUTPUT_STRIP_TRAILING_WHITESPACE
                  ERROR_QUIET RESULT_VARIABLE _ts_rc)
  # `tailscale status --self --peers=false` prints "<ip> <hostname> <user> ..."; take
  # field 2. Guarded on the exit code AND a non-empty match, because tailscale exits
  # non-zero when logged out and prints a human sentence rather than a row.
  if(_ts_rc EQUAL 0 AND _ts)
    string(REGEX MATCH "^[^ \t]+[ \t]+([^ \t]+)" _m "${_ts}")
    if(CMAKE_MATCH_1)
      set(NODE_ID "${CMAKE_MATCH_1}")
    endif()
  endif()
endif()
# No tailscale (or logged out): the plain hostname is the same idea one layer down.
if(NOT NODE_ID)
  cmake_host_system_information(RESULT NODE_ID QUERY HOSTNAME)
endif()
if(NOT NODE_ID)
  set(NODE_ID "unnamed")
endif()
file(WRITE ${OUT_C}
     "/* generated by cmake/gen_node_id.cmake — do not edit, do not commit */\n"
     "const char tuvm_node_id[] = \"${NODE_ID}\";\n")
