(*
PortaBridgeNodeC6 — PortaBridgeNode, on the C6, over a real Thread mesh. The
hardware half of design §9's gate (plan 3 of 3).

This file is PortaBridgeNode.nsl with five differences and no others:
  1. the constants below address the real gateway instead of loopback;
  2. `chip` answers #esp32c6, so obs/build says which silicon reported;
  3. `tick` prints one console line, because the gate must be able to tell a
     surviving drop from a drop that never fired — porta cannot witness the
     node's own `misses`, and a leg that passes either way is not a test (D8);
  4. `report` also prints ` dropped N` — the bridge's counted `#streamDropped`,
     appended after ` acked N` so the existing `^tick ` and `misses [0-9]\+`
     greps still match.
  5. THE SELF-CHECK: it emits the `bridge-health` scenario's TAP-lite verdict
     once, and then goes on bridging forever (target harness design D1/D3,
     2026-08-05). See the block above `tapPlan:`.
A change to the BRIDGING body of either file is a change to both; difference 5
is additive and has no counterpart in the host file.

expect (console, once attached):
PORTA NODE READY
TAP bridge-health plan=3
tick 1 misses 0 cursor 0 acked 2 dropped 0
...
TAP bridge-health done pass=3 fail=0

The gateway is addressed by its MESH-LOCAL EID, not its OMR address: there is no
global IPv6 here and no DNS64, so literal addresses are the only ones that work,
and an MTD child has no OMR source address at all (rung-7). This node is an FTD,
but the ML-EID is correct either way and does not depend on the role.

Cadence stays the 2 s of plan 2. The adaptive controller is #115.

Dialect: `[ ... ] whileTrue:`, never `repeat`; state in instance slots so every
reaction block is a one-line self-send (the LD_SLOT gotcha).
*)
class PortaBridgeNodeC6 usingPlatform: platform net: net = (
  | space bridge timers profChan ticks ::= 0.
    (* difference 5 — the bridge-health self-check. `obsCap` is held rather than
       re-derived per tick for the same reason `timers` is: one instance, minted
       once. *)
    obsCap goalName ::= nil. lastUnacked ::= -1. lastAcked ::= 0.
    obsConverged ::= false.
    verdictDone ::= false. tapPass ::= 0. tapFail ::= 0.
    (* tuvm#107: the span table. ONE window per boot — see `main:args:`. *)
    spans capture sTick sCheckIn sPublish | 
) (
  nodeId    = ( ^ 'c6-bench' )
  (* gw85224-01's mesh-local EID, read from the OTBR on 2026-06-28 and unchanged
     since; the same literal SoakNode.nsl has been echoing against. *)
  gwAddr    = ( ^ 'fdc5:9109:9afe:97ea:9541:d963:f8d9:8567' )
  gwPort    = ( ^ 6969 )
  localPort = ( ^ 16970 )
  cadence   = ( ^ 2000 )   (* ms between check-ins *)
  (* Build provenance, so an agent can tell which code is on which node — tuvm#74,
     a labelled revenue-gate. `chip` is a source constant because it is a build
     fact; `sdk`, `image` and `builtAt` are OMITTED until tuvm#74 gives the node a
     way to name its own build, and absence means "the node cannot say", which is
     honest and is not a default. *)
  chip      = ( ^ #esp32c6 )

  public main: platform2 args: args = (
    | sock tickChan |
    space:: platform space.
    sock:: net udpBindPort: self localPort.
    sock == nil ifTrue: [ ^ self fail: 'bind' ].
    (* The ONE Spans for this image, minted BEFORE the bridge because the bridge
       registers its own six slots at construction. Two instances would both
       allocate from 2 and silently share samples. *)
    spans:: platform Spans new.
    bridge:: platform PortaBridge
      socket: sock space: space id: self nodeId peer: self gwAddr port: self gwPort
      spans: spans.
    bridge subscribeStream: 'tel/log'.
    bridge subscribeStream: 'sys/reset'.

    (* tuvm#107 landed, so the span cells fit the 256 B cap and `diag/**` is in the
       bridge's outbound cell scan. No subscribeStream: here — these are CELLS, and
       the scan finds them.

       ONE window per boot: opened here, closed in `emitVerdict`. That is not a
       cadence anybody invented, it is the window this workload already defines —
       the certification run — and it is the degenerate case whose cost can be
       measured. After the verdict the cells stop changing, so `changedSince:`
       stops returning them and the steady-state wire cost is exactly zero.

       A repeating window would need a period, a period is a tunable, and there is
       no data yet to choose one from. What would earn it: this capture showing
       that one boot-to-verdict window does not answer where the time goes. Remote
       control of the window is a different question and is blocked on tuvm#159 —
       porta may write only goal/** and dbg/req, so it cannot drive diag/spans/ctl
       at all today. *)
    (* `spans` was minted above, with the bridge. The bridge holds slots 2-10 (its
       six-way decomposition of checkIn, plus tuvm#161's three-way split of
       pushBuild nested inside it); these three land at 11-13, of
       OEVM_SPAN_SLOTS = 16. sCheckIn stays even though it now brackets six inner
       spans — it is the only way to see UN-BRACKETED time inside the bridge, and
       `sCheckIn - (sum of six)` should read as zero. *)
    sTick::     spans register: #jobTick.     (* the whole timer -> report job *)
    sCheckIn::  spans register: #checkIn.     (* pull + push, the radio round trip *)
    sPublish::  spans register: #publish.     (* the health and log writes *)
    capture::   platform SpanCapture onSpace: space spans: spans.
    capture start.
    (space channel: 'diag/spans/ctl')
      put: '' value: (platform Record tag: #SpanCtl with: #state -> #running).

    (* porta's writes land as ordinary cell writes, so the echo is an ordinary
       reaction — there is no protocol handler anywhere in this node. *)
    (space channel: 'goal/name') whenever: '' do: [ :v | self nameChanged: v ].

    (* #165 D2: react to porta's dbg/req. The kernel already accepts this path
       (mayApply:) and already delivers it as a stream (space out:), so nothing
       inbound changes — this is just a reader, exactly like the goal/name
       reaction above. *)
    (space channel: 'dbg/req') whenever: '' do: [ :v | self dbgReq: v ].

    (* D6: the end-of-window signal. Timers post a MESSAGE to a CHANNEL — there
       is no after:do: — so the window's end is an ordinary channel event. *)
    profChan:: space channel: 'sys/profileEnd'.
    profChan whenever: '' do: [ :m | self profileWindowEnd ].

    space put: 'obs/build' value: (platform Record tag: #Build with: #chip -> self chip).

    obsCap:: space channel: 'obs'.

    timers:: platform timers.     (* hold ONE instance — it owns the pending registry *)
    space whenever: 'sys/timer' do: [ :e | timers dispatch: e ].
    tickChan:: space channel: 'sys/tick'.
    tickChan whenever: '' do: [ :m | self tick ].
    timers every: self cadence post: #go on: tickChan.

    'PORTA NODE READY' println.
    (* The plan is declared BEFORE the first tick, and before the mesh has even
       attached. A node that never attaches then emits a plan and no results,
       which the runner FAILS as an unfinished workload — where a bare timeout
       could not say whether it ran and lost, or never ran at all. *)
    self tapPlan: 3.

    [ true ] whileTrue: [
      platform pumpEvents.        (* blocks until the cadence timer fires *)
      space drain ].
    ^ 0
  )

  (* One check-in, then one report. In that order: applying goal/** first means the
     health this node publishes describes the state porta just asked for, not the
     one before it. *)
  tick = (
    ticks:: ticks + 1.
    spans begin: sTick.
    spans begin: sCheckIn.
    bridge checkIn.
    spans end: sCheckIn.
    (* MEASURED HERE, between the check-in and the next health write, and nowhere
       else: `publishHealth` below immediately makes obs/ unacked again, so a
       reading taken after it would never be 0 and the assertion would be
       unfalsifiable in the wrong direction — permanently red instead of
       permanently green, but just as meaningless. *)
    self noteObsAcked.
    spans begin: sPublish.
    self publishHealth.
    space out: 'tel/log' value:
      (platform Record tag: #Log with: #level -> #info
                                 with: #text -> ('tick ' , ticks printString)).
    spans end: sPublish.
    self report.
    (* jobTick closes BEFORE checkVerdict, so the tick that ends the window is
       itself measured — otherwise the last sample would be the one missing. *)
    spans end: sTick.
    self checkVerdict.
    ^ self
  )

  (* The console half of the gate. `misses` is the load-bearing number: leg 4
     fails if it never moves, because an injector that silently did nothing
     would otherwise be scored as a survived drop. *)
  report = (
    ('tick ' , ticks printString ,
     ' misses ' , bridge misses printString ,
     ' cursor ' , bridge cursor printString ,
     ' acked ' , bridge acked printString ,
     ' dropped ' , bridge dropped printString) println.
    ^ self
  )

  (* `goalName` is kept so the self-check can compare what porta ASKED for against
     what this node then reported observing — the convergence property itself,
     rather than the weaker "obs/name is non-empty". *)
  nameChanged: v = ( goalName:: v. space put: 'obs/name' value: v. ^ self )

  (* Each of these is a SELF-SEND from inside the whenever: block above, not
     inline work. A cross-class call inside a reified block cannot resolve its
     outer chain (rete#133), so the block must do nothing but send to self. *)
  dbgReq: line = (
    | ms |
    ms:: platform parseProfileMs: line.
    ms > 0 ifTrue: [ self profileWindowStart: ms ].
    ^ self )

  (* SELF-LIMITING (D6). The node stops on its own, so a node that never hears
     from porta again still stops counting and still reports. An explicit stop
     message would leave a field node paying the counter's cost forever the
     first time one was lost, with nobody aware.

     `timers` is the app's ONE instance (line 115). Do NOT mint a second: token
     allocation is per-instance but the C timer registry is keyed globally, so a
     second instance would alias this one's tokens and misfire silently. *)
  profileWindowStart: ms = (
    platform profileStart.
    timers after: ms post: #profileEnd on: profChan.
    ^ self )

  profileWindowEnd = (
    platform profileStop.
    ^ self )

  (* LIVENESS AND DELIVERY ONLY (design D2, 2026-08-04). heapFree/heapLargest/overruns
     left this record — not duplicated elsewhere, DELETED from here, because every one
     of them already lives at sys/metrics (RECORDS §4.4), which the bridge now
     publishes on every check-in. Two overlapping health records is how obs/health
     came to have three mutually inconsistent definitions: 3 fields in the conformance
     target, 7 in RECORDS, 8 actually on the wire.

     wakes/pollTimeouts carry the tick count and the bridge's missed replies until the
     mode record gives them a stricter meaning.

     streamDropped STAYS. It counts information lost on the way OUT, which is the
     number that says the observability itself is lying — a delivery fact about this
     node's reporting, not a VM internal. *)
  publishHealth = (
    | pairs |
    pairs:: platform OrderedCollection new.
    pairs add: #uptimeMs -> platform monotonicMillis.
    pairs add: #bootId -> 1.
    pairs add: #wakes -> ticks.
    pairs add: #pollTimeouts -> bridge misses.
    pairs add: #streamDropped -> bridge dropped.
    space put: 'obs/health' value:
      (platform Record tag: #Health fields: (platform Map fromPairs: pairs)).
    ^ self
  )

  fail: msg = ( msg println. ^ 1 )

  (* --- difference 5: the `bridge-health` scenario (design D1/D3) -------------
     The node half of what tests/porta_sync_c6.sh used to assert from the
     gateway, moved to where it belongs: a workload testifies about what only it
     can see, and this node is the only party that can see its own bounded
     `pending` queue evicting rows. What only the FAR end can see — that the
     tel/log series arrived contiguously and exactly once — stays at porta and is
     not claimed here (D4.1).

     class=observe: nothing below writes, reboots, latches or slows anything. It
     reads three numbers the bridge is keeping anyway, which is what makes this
     the first scenario that could later be pointed at a live field node.

     It emits ONCE and then goes on bridging forever. That matters twice over: a
     health check that ends the workload could not be a health check, and the
     bench integration test of porta (tests/porta_sync_c6.sh) needs a node still
     ticking after the verdict is in. *)

  (* 180 s at the 2 s cadence. The budget is for ATTACH, not for convergence:
     porta_sync_c6.sh has waited 90 s for the first obs/build to land since the
     gate was written, and the three properties below are all true within two
     check-ins of the mesh coming up. Reaching this deadline emits the verdict
     as it stands — a FAIL that says which of the three is false, never a
     silence the runner has to guess at. *)
  verdictTicks = ( ^ 90 )

  (* Every obs/ cell this node has written has been acknowledged by porta.
     `changedSince: acked` answers the cells porta has NOT yet accepted, so 0
     looks like a real ack. Sampled between the check-in and the next health
     write; see the note in `tick`.

     AND THE WATERMARK MUST BE INSIDE THIS BOOT'S SEQUENCE. Found by this gate on
     its first hardware run, 2026-08-05, which it scored 3/3 while every cell the
     node wrote was being thrown away: the space counter restarts at 0 on boot,
     porta's stored high-water for the node does not, so a REBOOTED node pushes
     seq 1..7 against a stored high-water of 7138, porta skips all of it as
     already-applied, and `applyAck:` then advances the node's own `acked` to
     7138 — after which `changedSince: acked` is empty FOREVER, for the same
     reason the rows are being discarded. The green and the loss had the identical
     cause.

     `acked <= space seq` is the invariant that separates them, and it needs
     nothing new on the wire: porta can only legitimately acknowledge a seq this
     node has issued, so a watermark ABOVE this node's own counter is proof the
     two ends are talking about different boots. Silent, total and permanent
     otherwise — until somebody wipes the store, which is exactly what the old
     gate did and why nobody had seen it.

     The far end is fixed too (porta rewinds its high-water when a pull declares
     both a lower cursor and a lower hw — PROTOCOL-NSL rule 5 of five), so this
     clause is now a REGRESSION DETECTOR rather than a live condition. It stays
     because it is the node's only way to notice, and because the gap that fix
     leaves — a node porta has never written to — is real. *)
  noteObsAcked = (
    lastUnacked:: (obsCap changedSince: bridge acked max: 8) size.
    lastAcked:: bridge acked.
    (lastUnacked = 0 and: [ lastAcked <= space seq ]) ifTrue: [ obsConverged:: true ].
    ^ self )

  healthPresent = ( ^ ((space peek: 'obs/health') == nil) not )

  (* Convergence, stated as the tree diff it is: what porta asked for at
     goal/name is what this node now reports at obs/name. `goalName` nil means
     no goal/** entry ever arrived — which is a real failure of the downstream
     half and is reported as one, with the operator action that fixes it. *)
  nameConverged = (
    goalName == nil ifTrue: [ ^ false ].
    ^ (space peek: 'obs/name') = goalName )

  checkVerdict = (
    verdictDone ifTrue: [ ^ self ].
    (obsConverged and: [ self nameConverged and: [ bridge dropped = 0 ] ])
      ifTrue: [ ^ self emitVerdict ].
    ticks < self verdictTicks ifTrue: [ ^ self ].
    ^ self emitVerdict )

  emitVerdict = (
    verdictDone:: true.
    (* Close the one window (tuvm#107). Writing #stopped is what makes SpanCapture
       publish the per-slot cells and the { n, ms } summary; they ride the NEXT
       check-in's push, after this tick's assertions have already been taken. *)
    (space channel: 'diag/spans/ctl')
      put: '' value: (platform Record tag: #SpanCtl with: #state -> #stopped).
    self tap: 1 named: 'obs-acked'
                ok: (obsConverged and: [ self healthPresent ])
                detail: ('health=' , (self healthPresent ifTrue: [ 'present' ] ifFalse: [ 'absent' ]) ,
                         ' hw=' , lastAcked printString ,
                         ' seq=' , space seq printString ,
                         ' unacked=' , lastUnacked printString ,
                         (lastAcked > space seq
                            ifTrue:  [ ' PORTA HIGH-WATER IS AHEAD OF THIS BOOT: every cell this node writes is being discarded as already-applied' ]
                            ifFalse: [ '' ])).
    self tap: 2 named: 'goal-converged'
                ok: self nameConverged
                detail: (goalName == nil
                  ifTrue:  [ 'no goal/name arrived from porta — write one: porta put ' , self nodeId , ' goal/name <value>' ]
                  ifFalse: [ 'obs/name=' , (space peek: 'obs/name') printString ,
                             ' goal/name=' , goalName printString ]).
    self tap: 3 named: 'no-stream-drops'
                ok: bridge dropped = 0
                detail: ('streamDropped=' , bridge dropped printString ,
                         ' misses=' , bridge misses printString).
    self tapDone.
    ^ self )

  (* --- TAP-lite (design D3) -------------------------------------------------
     Byte-identical to the block in StaleHandleProbeC6 and PulseCoalesceProbeC6,
     and duplicated on purpose: D1 says there is no assertion library in the
     kernel, because a test category in the VM is the thing this design exists
     not to build. Three copies of eleven lines is the price, and it is cheaper
     than a mechanism.

     Every line self-identifies with the scenario, so a log holding an earlier
     run — or two workloads sharing one — cannot be misattributed. *)

  scenarioName = ( ^ 'bridge-health' )

  tapPlan: n = (
    ('TAP ' , self scenarioName , ' plan=' , n printString) out.
    ^ self )

  tap: idx named: nm ok: passed detail: d = (
    passed
      ifTrue:  [ tapPass:: tapPass + 1.
                 ('TAP ' , self scenarioName , ' ok ' , idx printString ,
                   ' ' , nm , ' ' , d) out ]
      ifFalse: [ tapFail:: tapFail + 1.
                 ('TAP ' , self scenarioName , ' not ok ' , idx printString ,
                   ' ' , nm , ' ' , d) out ].
    ^ self )

  tapDone = (
    ('TAP ' , self scenarioName , ' done pass=' , tapPass printString ,
      ' fail=' , tapFail printString) out.
    ^ self )
) : (
  public packageUsing: manifest = ( ^ self new )
)
