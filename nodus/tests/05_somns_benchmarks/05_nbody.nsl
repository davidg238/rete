(*
expect:
true
skip-berry: true
*)
class NBodyBenchmarkTest packageUsing: manifest = () (
class Benchmark = () (
    public assert: expected equals: value = (
      expected = value ifFalse: [
        self error: 'Expected value differs'
      ].
      ^ true
    )
)
class NBody usingPlatform: platform = () (
  public class NBody = Benchmark (
    | private expectedEnergy |
  )(
    public innerBenchmarkLoop: innerIterations numThreads: threads = (
        | bodies |
        bodies:: NBodySystem new.

        1 to: innerIterations do: [:i |
            bodies advance: 0.01.
        ].

        innerIterations = 250000 ifTrue: [
          ^ bodies energy = -0.1690859889909308
        ].
        expectedEnergy isNil ifTrue: [
          expectedEnergy:: bodies energy.
          ^ true
        ].

        ^ expectedEnergy = bodies energy.
    )
  )

  class NBodySystem = (
  | private bodies = self createBodies. |
  )(
    public createBodies = (
      | px py pz bodies |
      bodies:: { Body sun. Body jupiter. Body saturn. Body uranus. Body neptune }.

      px:: 0.0 asFloat.  py:: 0.0 asFloat.  pz:: 0.0 asFloat.

      bodies do: [:b |
        px:: px + (b vx * b mass).
        py:: py + (b vy * b mass).
        pz:: pz + (b vz * b mass).
      ].

      (bodies at: 1) offsetMomentumX: px y: py z: pz.
      ^ bodies
    )

    public advance: dt = (
      1 to: bodies size do: [:i |
        | iBody |
        iBody:: bodies at: i.

        i + 1 to: bodies size do: [:j |
          | dx dy dz jBody dSquared distance mag |
          jBody:: bodies at: j.
          dx:: iBody x - jBody x.
          dy:: iBody y - jBody y.
          dz:: iBody z - jBody z.

          dSquared:: (dx * dx) + (dy * dy) + (dz * dz).
          distance:: dSquared sqrt.
          mag::      dt / (dSquared * distance).

          iBody vx: iBody vx - (dx * jBody mass * mag).
          iBody vy: iBody vy - (dy * jBody mass * mag).
          iBody vz: iBody vz - (dz * jBody mass * mag).

          jBody vx: jBody vx + (dx * iBody mass * mag).
          jBody vy: jBody vy + (dy * iBody mass * mag).
          jBody vz: jBody vz + (dz * iBody mass * mag).
        ].
      ].

      bodies do: [:body |
        body x: body x + (dt * body vx).
        body y: body y + (dt * body vy).
        body z: body z + (dt * body vz).
      ].
    )

    public energy = (
      | dx dy dz distance e |
      e:: 0.0 asFloat.

      1 to: bodies size do: [:i |
        | iBody |
        iBody:: bodies at: i.

        e:: e + (0.5 asFloat * iBody mass *
             ((iBody vx * iBody vx) +
              (iBody vy * iBody vy) +
              (iBody vz * iBody vz))).

        i + 1 to: bodies size do: [:j |
          | jBody |
          jBody:: bodies at: j.

          dx:: iBody x - jBody x.
          dy:: iBody y - jBody y.
          dz:: iBody z - jBody z.

          distance:: ((dx*dx) + (dy*dy) + (dz*dz)) sqrt.
          e:: e - ((iBody mass * jBody mass) / distance).
        ].
      ].
      ^ e
    )
  )

  class Body = (
  | public x  ::= 0.0 asFloat.
    public y  ::= 0.0 asFloat.
    public z  ::= 0.0 asFloat.
    public vx ::= 0.0 asFloat.
    public vy ::= 0.0 asFloat.
    public vz ::= 0.0 asFloat.
    public mass ::= 0.0 asFloat.
  |
  ) (
    public offsetMomentumX: px y: py z: pz = (
      vx:: 0.0 asFloat - (px / Body SolarMass).
      vy:: 0.0 asFloat - (py / Body SolarMass).
      vz:: 0.0 asFloat - (pz / Body SolarMass).
    )
  ) : (
    public Pi          = ( ^ 3.141592653589793 asFloat )
    public SolarMass   = ( ^ 4.0 asFloat * self Pi * self Pi )
    public DaysPerYear = ( ^ 365.24 asFloat )

    public jupiter = ( | b |
      b:: self new.
      b x:    4.8414314424647209 asFloat.
      b y:   -1.16032004402742839 asFloat.
      b z:   -0.103622044471123109 asFloat.
      b vx:   (0.00166007664274403694 asFloat)   * self DaysPerYear.
      b vy:   (0.00769901118419740425 asFloat)   * self DaysPerYear.
      b vz:  (-0.0000690460016972063023 asFloat) * self DaysPerYear.
      b mass: (0.000954791938424326609 asFloat)  * self SolarMass.
      ^ b
    )

    public saturn = ( | b |
      b:: self new.
      b x:    8.34336671824457987 asFloat.
      b y:    4.12479856412430479 asFloat.
      b z:   -0.403523417114321381 asFloat.
      b vx:  (-0.00276742510726862411 asFloat)   * self DaysPerYear.
      b vy:   (0.00499852801234917238 asFloat)   * self DaysPerYear.
      b vz:   (0.0000230417297573763929 asFloat) * self DaysPerYear.
      b mass: (0.000285885980666130812 asFloat)  * self SolarMass.
      ^ b
    )

    public uranus = ( | b |
      b:: self new.
      b x:   12.894369562139131 asFloat.
      b y:  -15.1111514016986312 asFloat.
      b z:   -0.223307578892655734 asFloat.
      b vx:   (0.00296460137564761618 asFloat)   * self DaysPerYear.
      b vy:   (0.0023784717395948095 asFloat)    * self DaysPerYear.
      b vz:  (-0.0000296589568540237556 asFloat) * self DaysPerYear.
      b mass: (0.0000436624404335156298 asFloat) * self SolarMass.
      ^ b
    )

    public neptune = ( | b |
      b:: self new.
      b x:   15.3796971148509165 asFloat.
      b y:  -25.9193146099879641 asFloat.
      b z:    0.179258772950371181 asFloat.
      b vx:   (0.00268067772490389322 asFloat)   * self DaysPerYear.
      b vy:   (0.00162824170038242295 asFloat)   * self DaysPerYear.
      b vz:  (-0.000095159225451971587 asFloat)  * self DaysPerYear.
      b mass: (0.0000515138902046611451 asFloat) * self SolarMass.
      ^ b
    )

    public sun = ( | b |
      b:: self new.
      b mass: self SolarMass.
      ^ b
    )
  )
  public newInstance = ( ^ NBody new )
)
public main: platform args: args = (
    | n = NBody usingPlatform: platform. nbody |
    nbody:: n newInstance.
    (nbody innerBenchmarkLoop: 1000 numThreads: 1) printString out.
)
) : (
)
