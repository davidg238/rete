(*
expect-runtime-fail: bad channel path
*)
(* T-C canonicalization guard — an empty segment (`a//b`) is rejected at
   grant time, never silently normalized (addendum A1). *)
class CanonicalizationEmptySegment packageUsing: manifest = () (
public main: platform args: args = (
  | space |
  space:: platform space.
  space channel: 'a//b'.
  'unreached' out.
)
) : (
)
