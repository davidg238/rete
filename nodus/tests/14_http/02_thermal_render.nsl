(*
expect:
served /thermal 200
served /nope 404
max 31.2C min 22.0C hot (3,5)
finished
*)
(* Task 4 — the /thermal route renders the dev/thermal0/sample cell (an 8x8
   heat-grid) via an on-node reduce (max/min/hot-pixel) + SVG fold. Assertion is
   compact-by-design: the framed SVG response is ~64 rects, so instead of pinning
   it byte-for-byte this test exercises renderFrame: through the round-trip
   (proving it runs without crashing), asserts routing (200 for /thermal, 404 for
   /nope), and pins the reduce result (`caption:`) — the semantically meaningful
   output. The full SVG-over-the-wire is proven end-to-end by the curl integration
   test in Task 6. No httpRespondId: egress here, so nothing dumps the body to
   stdout — keeping the assertion deterministic. Seed: all cells 22.0C (2200)
   except one hot pixel at row 3 col 5 (index 3*8+5+1 = 30) = 31.2C (3120). *)
class HttpThermal packageUsing: manifest = () (
  public main: platform args: args = (
    | space req reply thermal frame oc i |
    space::   platform space.
    req::     space channel: 'dev/http/request'.
    reply::   space channel: 'dev/http/reply'.
    thermal:: space channel: 'dev/thermal0/sample'.
    (* Build the frame as an algebra value (List of 64 SMIs) — a mutable Array
       would trip the channel's `not a value` boundary. Hot pixel at index 30
       (row 3 col 5 = 3*8+5+1) = 31.2C; the rest 22.0C. *)
    oc:: platform OrderedCollection new.
    i:: 1. [ i <= 64 ] whileTrue: [
      oc add: (i = 30 ifTrue: [ 3120 ] ifFalse: [ 2200 ]). i:: i + 1 ].
    frame:: platform List fromCollection: oc.
    thermal put: '' value: frame.
    req whenever: '' do: [ :r |
      | id path status body |
      id::   r basicAt: 1.
      path:: r basicAt: 3.
      (path = '/thermal')
        ifTrue:  [ status:: 200. body:: self renderFrame: (thermal peek: '' ifAbsent: [ nil ]) ]
        ifFalse: [ status:: 404. body:: 'notfound' ].
      ('served ' , path , ' ' , status printString) out.
      reply out: '' value: (platform Record tag: #response
                              with: #id -> id with: #status -> status with: #body -> body) ].
    platform httpInject: 'GET' path: '/thermal'.
    platform pumpEvents. space drain.
    platform httpInject: 'GET' path: '/nope'.
    platform pumpEvents. space drain.
    (self caption: frame) out.
    'finished' out.
  )

  renderFrame: f = (
    | row col svg t k |
    (f == nil) ifTrue: [ ^ '<html><body>no frame</body></html>' ].
    svg:: '<html><body><svg viewBox=''0 0 8 8'' width=''320'' height=''320'' shape-rendering=''crispEdges''>'.
    row:: 0. [ row <= 7 ] whileTrue: [
      col:: 0. [ col <= 7 ] whileTrue: [
        t:: f at: (row * 8 + col + 1).
        k:: ((t - 1500) * 255) // 2000.
        (k < 0)   ifTrue: [ k:: 0 ].
        (k > 255) ifTrue: [ k:: 255 ].
        svg:: svg , '<rect x=''' , col printString , ''' y=''' , row printString ,
              ''' width=''1'' height=''1'' fill=''rgb(' , k printString , ',0,' ,
              (255 - k) printString , ')''/>'.
        col:: col + 1 ]. row:: row + 1 ].
    ^ svg , '</svg><p>' , (self caption: f) , '</p></body></html>'
  )

  caption: f = (
    | row col t maxV minV hotR hotC |
    maxV:: f at: 1. minV:: f at: 1. hotR:: 0. hotC:: 0.
    row:: 0. [ row <= 7 ] whileTrue: [
      col:: 0. [ col <= 7 ] whileTrue: [
        t:: f at: (row * 8 + col + 1).
        (t > maxV) ifTrue: [ maxV:: t. hotR:: row. hotC:: col ].
        (t < minV) ifTrue: [ minV:: t ].
        col:: col + 1 ]. row:: row + 1 ].
    ^ 'max ' , (self centi: maxV) , 'C min ' , (self centi: minV) ,
      'C hot (' , hotR printString , ',' , hotC printString , ')'
  )

  centi: v = (
    | whole tenth |
    whole:: v // 100.
    tenth:: (v - (whole * 100)) // 10.
    ^ whole printString , '.' , tenth printString
  )
) : (
)
