(*
expect:
true
*)
(* rete#161 fix (1): `Cbor>>sizeOf:` answers the encoded byte count WITHOUT building
   the bytes, so the push frame's fit test becomes arithmetic instead of an encode
   per candidate and a re-encode per dropped row.

   THIS TEST IS THE WHOLE ASSUMPTION THAT RESTS ON. If sizeOf: and encode: ever
   disagree, a frame is mis-sized in silence: too small wastes a datagram on a radio
   that fragments above ~102 B, and too large is refused by porta for the WHOLE push,
   which is how a node talks itself out of the fleet (rete#199).

   THE CORPUS SITS ON THE SHORTEST-FORM HEAD BOUNDARIES, because that is the only
   place a byte count changes without the value changing shape. `emitHead:len:into:`
   spends 1 byte below 24, 2 below 256, 3 below 65536, 5 below 2^32 and 9 above — and
   it is reused for container lengths, string lengths AND tag numbers, so one wrong
   branch is wrong in three places at once. A corpus of round numbers would agree by
   luck and prove nothing.

   Both directions of every boundary are present (23/24, 255/256, ...): a sizer that
   is off by one only ABOVE a boundary passes a corpus that only samples below it. *)
class CborSizeAgreesTest packageUsing: manifest = () (

public main: platform args: args = (
  | C corpus ok i v |
  C:: platform Cbor.
  corpus:: self corpus: platform.
  ok:: true.
  i:: 1.
  [ i <= corpus size ] whileTrue: [
    v:: corpus at: i.
    (C sizeOf: v) = (C encode: v) byteSize
      ifFalse: [
        ok:: false.
        ('MISMATCH at ' , i printString ,
         ': sizeOf ' , (C sizeOf: v) printString ,
         ' vs encode ' , (C encode: v) byteSize printString) println ].
    i:: i + 1 ].
  ok printString println.
)

corpus: platform = (
  | c |
  c:: platform OrderedCollection new.

  (* major 0 — unsigned, at every head width *)
  c add: 0.   c add: 23.  c add: 24.
  c add: 255. c add: 256.
  c add: 65535. c add: 65536.
  c add: 4294967295. c add: 4294967296.

  (* major 1 — negative uses the same head on (-1 - n) *)
  c add: -1. c add: -24. c add: -25. c add: -256. c add: -257.

  (* The worst legal bootId. 09_batch_size pins the frame against this value
     rather than a fresh node's 1, and the size guard must agree with it. *)
  c add: 1073741823.

  (* major 3 — text length crosses the same boundary as a container length *)
  c add: ''.
  c add: 'a'.
  c add: 'abcdefghijklmnopqrstuvw'.
  c add: 'abcdefghijklmnopqrstuvwx'.

  (* tag 39 — a Symbol is a tag head wrapping a text head, so it spends the
     boundary twice and is the case a one-branch sizer gets wrong. *)
  c add: #n.
  c add: #averyLongSymbolNameOverTwentyFourChars.

  (* major 4 — container length head *)
  c add: (self listOf: 0 on: platform).
  c add: (self listOf: 23 on: platform).
  c add: (self listOf: 24 on: platform).

  (* major 5 — keys are re-sorted bytewise over ENCODED key bytes at emit time,
     which does not change the total, and this pins that it does not. *)
  c add: (platform Map with: #n -> 42 with: #s -> 'hi').

  (* tag 27 — the push envelope's own shape, the one the frame test sizes *)
  c add: (platform Record tag: #push fields:
           (platform Map with: #id -> 'c6-bench' with: #bid -> 1073741823)).

  (* nesting: the recursion carries a depth counter and nothing else, which is
     the property that makes a row cost the same bytes alone as in place *)
  c add: (platform List with: (self listOf: 3 on: platform)
                        with: (platform Map with: #k -> 'v')).
  ^ c )

listOf: n on: platform = (
  | c i |
  c:: platform OrderedCollection new.
  i:: 1.
  [ i <= n ] whileTrue: [ c add: i. i:: i + 1 ].
  ^ platform List fromCollection: c )
) : (
)
