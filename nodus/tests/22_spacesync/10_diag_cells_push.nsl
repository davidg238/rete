(*
porta space-sync — the cell scan covers `diag/` too, which is what makes a span
capture reach the gateway at all. tuvm#107 split SpanCapture's ~1120 B nested value
into sibling cells at diag/spans/<span> (140 B each) plus a { n, ms } summary, so
the subtree finally FITS the 256 B value cap — and the scan is the other half of
that: a value that fits but is never scanned is still unsendable, which is exactly
how sys/metrics went unpublished for a whole rung (22_spacesync/07).

PROTOCOL-NSL §4.1 grants the bridge read access to obs/**, tel/**, sys/**, dbg/resp
AND diag/** outbound. This asserts the diag half of that grant.

goal/ must still NOT appear: it is porta's authority, and echoing porta's own writes
back at it is what the direction rule forbids. Confinement does the filtering — the
bridge scans through capabilities ROOTED at each prefix, so there is no prefix test
in the code to get wrong (22_spacesync/02 proves the rooting).

expect:
rows 3
has diag/spans/acquire true
has diag/spans/result true
has obs/health true
has goal/name false
*)
class DiagCellsPush packageUsing: manifest = () (
  has: rows path: p = (
    | i |
    i:: 1.
    [ i <= rows size ] whileTrue: [
      ((rows at: i) at: 2) = p ifTrue: [ ^ true ].
      i:: i + 1 ].
    ^ false )

  public main: platform args: args = (
    | space bridge rows |
    space:: platform space.
    space put: 'goal/name' value: 'bench'.
    space put: 'obs/health' value: 11.
    space put: 'diag/spans/acquire' value: 33.
    space put: 'diag/spans/result' value: 44.

    (* A nil socket is legal here and never reached: collectOutbound does no I/O. *)
    bridge:: platform PortaBridge socket: nil space: space id: 'test' peer: '::1' port: 1.
    rows:: bridge collectOutbound.

    ('rows ' , rows size printString) println.
    ('has diag/spans/acquire ' , (self has: rows path: 'diag/spans/acquire') printString) println.
    ('has diag/spans/result ' , (self has: rows path: 'diag/spans/result') printString) println.
    ('has obs/health ' , (self has: rows path: 'obs/health') printString) println.
    ('has goal/name ' , (self has: rows path: 'goal/name') printString) println.
  )
) : (
)
