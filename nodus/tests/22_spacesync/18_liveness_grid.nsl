(*
porta space-sync — what the node ADOPTS is not always what it was asked for
(rete#231 D3/D7), and the divergence is the answer rather than an error.

Three rules, each of which the gateway must never have to know in advance:
  misses >= 1          — a budget below one cadence promises a silence the node
                         cannot keep even when perfectly healthy
  bud = telCad x misses — STRUCTURAL since rete#273 D2: there is no bud on the
                         wire to snap, so the grid cannot be violated
  bud <= 24 h          — CLAMPED on misses and published, never rejected (D7): a
                         managed fleet means no node can make itself unjudgeable,
                         and a silent refusal would be indistinguishable from
                         acceptance

`space seq` READS the counter; `space stamp` BUMPS it (prim 138 vs 139), so the
republish assertions below are written against `seq` — against `stamp` the
idempotent case cannot pass and the republished case cannot fail.

The socket is nil; `liveness:misses:` is the seam under test.
expect:
plain 2000 8 16000
floor 2000 1 2000
ceiling 30000 2880 86400000
cadceiling 86400000 1 86400000
republished true
idempotent true
*)
class LivenessGrid packageUsing: manifest = () (
  bridgeOn: platform = (
    ^ platform PortaBridge socket: nil space: platform space id: 'test' peer: '::1' port: 1
        spans: platform Spans new timers: platform timers )

  show: label bridge: b = (
    (label , ' ' , b cadMs printString , ' ' , b missBudget printString , ' ' , b budMs printString) println.
    ^ self )

  public main: platform args: args = (
    | b seqBefore |
    (* An ordinary declaration passes through untouched; the budget is derived. *)
    b:: self bridgeOn: platform.
    b liveness: 2000 misses: 8.
    self show: 'plain' bridge: b.

    (* Zero misses is raised to one: the budget is never below the cadence. *)
    b:: self bridgeOn: platform.
    b liveness: 2000 misses: 0.
    self show: 'floor' bridge: b.

    (* A week of misses is clamped to the ceiling ON MISSES: 2880 x 30 s = 24 h. *)
    b:: self bridgeOn: platform.
    b liveness: 30000 misses: 604800000.
    self show: 'ceiling' bridge: b.

    (* A cadence past the ceiling is clamped to it, and then only ONE miss fits. *)
    b:: self bridgeOn: platform.
    b liveness: 999999999 misses: 8.
    self show: 'cadceiling' bridge: b.

    (* A declaration that MOVES the pair must re-publish; one that repeats it
       must not, or the row rides every push forever. *)
    b:: self bridgeOn: platform.
    b publishLiveness.
    seqBefore:: platform space seq.
    b liveness: 2000 misses: 8.
    b publishLiveness.
    ('republished ' , (platform space seq > seqBefore) printString) println.
    seqBefore:: platform space seq.
    b liveness: 2000 misses: 8.
    b publishLiveness.
    ('idempotent ' , (platform space seq = seqBefore) printString) println.
  )
) : (
)
