(*
expect:
armed 1
tick 1
adopted 5000 15000
pending 1
after old period 1
tick 2
done
*)
(* rete#240.2 — goal/liveness's cadence half is HONOURED. Adopting a new cad
   re-arms the kernel base tick at the one adoption point (adoptCad:misses:),
   cancelling the old registration: pendingCount stays 1, the OLD period's due
   time passes silently (clock 4000 below), and the next tick lands one NEW
   period after the re-arm (clock 7000). The budget is telCad x misses by
   construction: 5000 x 3 = 15000. Host virtual clock; the pulse-mailbox
   half of this seam is target work (nodus/oevm/tests/target). *)
class LivenessCadRearm packageUsing: manifest = ( | ticks ::= 0. | ) (
  public main: platform args: args = (
    | space timers bridge tickChan |
    space:: platform space.
    timers:: platform timers.
    space whenever: 'sys/timer' do: [ :e | timers dispatch: e ].
    tickChan:: space channel: 'sys/tick'.
    tickChan whenever: '' do: [ :m | ticks:: ticks + 1. ('tick ' , ticks printString) out ].
    bridge:: platform PortaBridge socket: nil space: space id: 'test' peer: '::1' port: 1
      spans: platform Spans new.
    bridge liveness: 2000 misses: 8.
    bridge startTicking: timers on: tickChan.
    ('armed ' , timers pendingCount printString) out.

    platform advanceMillis: 2000. space drain.        (* tick 1 at clock 2000 *)

    (space channel: 'goal/liveness')
      put: '' value: (platform Record tag: #Liveness with: #misses -> 3 with: #telCad -> 5000).
    space drain.
    bridge applyLivenessGoal.
    ('adopted ' , bridge cadMs printString , ' ' , bridge budMs printString) out.
    ('pending ' , timers pendingCount printString) out.

    platform advanceMillis: 2000. space drain.        (* clock 4000: the OLD due time — silent *)
    ('after old period ' , ticks printString) out.

    platform advanceMillis: 3000. space drain.        (* clock 7000: one NEW period after re-arm *)
    'done' out.
  )
) : (
)
