(*
NodeIdProbe — the board proof for rete#118. Prints the build-time board name and the
node id read from silicon, one line each, then returns. Board first, so an RP board
(which has no link address, so `nodeId` fails) still shows its board line.
Granted no capability, so it needs no `net:` header. Run: run.sh --node NodeIdProbe.nsl
*)
class NodeIdProbe packageUsing: manifest = () (
  public main: platform args: args = (
    ('board ' , platform boardName printString) println.
    ('node ' , platform nodeId) println.
    ^ 0 )
) : ()
