# Bakes the BOARD NAME: what the bench calls the board this image is for (rete#118).
#
# The node id (`platform nodeId`) is no longer baked: it is the board's factory link
# address, read from silicon at run time (platform_zephyr.c). What stays build-time is
# the NAME the bench navigates by (console-<board>.env), published as obs/build.board
# so a human can map the hex id to a board.
#
# A sibling of gen_build_id.cmake, but configure time, not build time: the name comes
# from the OEVM_BOARD_NAME env (run.sh) and does not change between builds of a board.
#
# NO DEFAULT, no tailscale/hostname guess (deleted with the node id fallback chain): a
# guessed board name is the #186 failure with a friendlier spelling. Unset bakes the
# empty string, `platform boardName` answers nil, and obs/build carries no `board` key.
#
# The name is a FILE NAME from the bench, and it is written into C below, so anything
# outside [A-Za-z0-9._-] is refused rather than escaped.
if(NOT BOARD_NAME)
  set(BOARD_NAME "")
endif()
if(NOT BOARD_NAME STREQUAL "" AND NOT BOARD_NAME MATCHES "^[A-Za-z0-9._-]+$")
  message(FATAL_ERROR "OEVM_BOARD_NAME '${BOARD_NAME}': only [A-Za-z0-9._-] allowed")
endif()
file(WRITE ${OUT_C}
     "/* generated by cmake/gen_board_name.cmake — do not edit, do not commit */\n"
     "const char oevm_board_name[] = \"${BOARD_NAME}\";\n")
