(*
expect:
TAP timerless done
*)
(* rete#231 D1 — THE NODE THE DETECTOR COULD NOT SEE.

   Every other probe on this bench arms a repeating timer of its own, so #215's observer
   always had a deadline to judge against: `timer_target_snapshot` reports the live
   repeaters, and the shortest one bounds how long silence may last. A node whose app
   declares NO repeating timer gave it nothing, and `pulse_pump` is K_FOREVER-blocking
   on Zephyr — which is BOTH healthy-idle and wedged. There was no deadline, so nothing
   fired, so a wedge in this shape produced no evidence at all. That is not a
   hypothetical shape: a purely reactive node (GPIO, inbound radio) is the ordinary case
   for a sensor.

   THIS NODE DECLARES NO TIMER. It constructs a bridge and hands it the app's one Timers
   instance; the KERNEL registers the base tick (`PortaBridge>>startTicking:on:`), and
   that registration is what puts a deadline in the snapshot. The heartbeat therefore
   rides the reactor rather than a C thread, which is the whole of D1: a heartbeat a
   wedged node can still emit is `port=up` with better manners — the exact lie #152 is
   about — so its absence has to mean something.

   WHAT THE BOARD MUST WITNESS, and what no host run can (the posix timer backend
   bypasses the pulse mailbox entirely):
     1. the detector fires at all on a node with no app timer, and its dump names the
        kernel base tick as the deadline it used;
     2. NO check-in is emitted between the wedge and the reboot — a check-in appearing
        there would prove the heartbeat outlives the wedge, i.e. the C design was chosen
        after all, and the whole argument for nsl-on-the-reactor is wrong;
     3. the wakeups coalesce: two obligations at different multiples of one base tick
        cost fewer radio wakes than the sum of independent periods.

   Modelled on WedgeProbeC6.nsl and it keeps that file's hard-won rules: ONE Timers
   instance (`platform timers` answers a fresh one per send, and a second instance makes
   `dispatch:` drop every event); `== nil` and never `isNil` on a prim-built indexable;
   TAP only on the boot that REPORTS, because the collector greps every `TAP <name>` line
   after the first build-id line and a plan emitted twice fails for duplication; and the
   reporting boot must not wedge again inside rete#216's observation window. *)
class TimerlessNodeC6 usingPlatform: platform net: net = (
  | plat space timers bridge spans tickCh
    ticks ::= 0. wedging ::= false. tapPass ::= 0. tapFail ::= 0. |
) (

  (* rete#186: THE ID IS THE BOARD, and it is baked at build time rather than written
     here. This method used to answer a string literal, and the literal was the bug:
     whatever devkit was flashed with this app wrote into that one space, so `c6-bench`
     accumulated 36,153 events across 19 `obs/build` entries from at least two boards
     AND two different apps, with nothing in the store saying which. `platform nodeId`
     answers the bench instance the image was built for (zephyr/run.sh fills it from the
     same collector env file the console reader resolves through), so the flash, the
     console and the porta space cannot disagree about who this is.
     The ROLE is not gone, it just lives where it always belonged: porta writes
     `goal/name` and this node converges `obs/name` onto it. *)
  nodeId    = ( ^ platform nodeId )
  gwAddr    = ( ^ 'fdc5:9109:9afe:97ea:9541:d963:f8d9:8567' )
  gwPort    = ( ^ 6969 )
  localPort = ( ^ 16972 )
  chip      = ( ^ #esp32c6 )
  cadence   = ( ^ 2000 )   (* the KERNEL's period — this app registers none *)

  (* Comfortably past boot, and well past the 16 s budget this node declares, so the
     trip is unambiguous. *)
  wedgeAtTick = ( ^ 15 )   (* 15 ticks x 2 s = 30 s, WedgeProbeC6's wall-clock wedge
                              point, which is what keeps the wedge-note build's 15 s
                              synthetic trigger strictly earlier and the two tests
                              distinct *)

  (* `platform2` shadows the class parameter deliberately, as PortaBridgeNodeC6 does:
     the class-level `platform` is the one every method here reaches through. *)
  public main: platform2 args: args = (
    | note sock |
    plat:: platform.
    space:: plat space.
    timers:: plat timers.
    space whenever: 'sys/timer' do: [ :e | timers dispatch: e ].

    note:: plat panicNote.
    (note == nil)
      ifTrue:  [ 'timerless: no note — this boot is the one that dies' out ]
      ifFalse: [ self reportNote: note ].

    sock:: net udpBindPort: self localPort.
    spans:: plat Spans new.
    (* A BIND FAILURE MAKES THIS NODE INVISIBLE, AND IT MUST SAY SO IN ONE LINE.
       This branch used to read "wedging anyway, the detector is the test", which was
       false in the one shape that matters: the wedge is driven by `tick`, `tick` is
       driven by the base tick, and the base tick is registered BY THE BRIDGE below —
       which is never constructed when the bind fails. So a bind failure yields a node
       that ticks nothing, wedges never, and puts no deadline in `timer_target_snapshot`
       (observer.c returns COND_NONE at n == 0). It is then indistinguishable from a
       healthy idle node, because `pulse_pump` blocks on K_FOREVER either way.

       That is not hypothetical: 2026-08-22 10:49 this node was built with no radio
       layer, sat silent for the full 300 s, and the run cost a board cycle to read.
       The manifest carries the CONF_EXTRA that prevents it; this line is what makes the
       next occurrence legible in one grep instead of one cycle. *)
    sock == nil
      ifTrue:  [ 'timerless: bind FAILED — no bridge, so NO base tick is registered: this node will not tick, will not wedge, and the detector has no deadline for it. Check the image has a radio layer (CONF_EXTRA prj_esp32c6_thread.conf).' out ]
      ifFalse: [
        bridge:: plat PortaBridge
          socket: sock space: space id: self nodeId peer: self gwAddr port: self gwPort
          spans: spans.
        bridge subscribeStream: 'tel/log'.
        space put: 'obs/build' value:
          (plat Record tag: #Build with: #chip -> self chip with: #build -> plat buildId).
        (* rete#231 D2: this node's promise about its radio, 8 x the base tick. *)
        bridge liveness: self cadence budget: self cadence * 8 ].

    (* THE ONLY REPEATING TIMER IN THIS IMAGE, and the app does not register it: the
       bridge does, from the cadence adopted above. Take the channel away and there is
       no deadline anywhere in `timer_target_snapshot` — which is the state every
       purely reactive node was in before this rung. *)
    tickCh:: space channel: 'sys/tick'.
    tickCh whenever: '' do: [ :m | self tick ].
    bridge == nil ifFalse: [ bridge startTicking: timers on: tickCh ].

    'TIMERLESS NODE READY' out.
    [ true ] whileTrue: [ plat pumpEvents. space drain ].
    ^ self )

  (* The report, and the ONLY boot that emits TAP. Two results planned before either is
     taken, so a probe that dies between them is FAILED rather than read as one green. *)
  reportNote: note = (
    | reason |
    (* FIRST: this boot does not wedge. A boot reporting the last wedge must not become
       the next one — it would reboot inside the observation window and the gate would
       read a death it caused itself. *)
    wedging:: true.
    self tapPlan: 2.
    self tap: 1 named: 'the detector fired on a node with no app timer' ok: true
         detail: ('detail=' , (note basicAt: 4)).
    reason:: (plat panic fields) at: #reason ifAbsent: [ #none ].
    self tap: 2 named: 'reason is watchdog' ok: (reason = #watchdog)
         detail: ('reason=' , reason printString).
    self tapDone.
    (* Ack AFTER the report: the ack clears the note, and a clear that ran first would
       leave the gate reading a green against nothing. *)
    plat panicNoteAck: 0.
    ^ self )

  tick = (
    ticks:: ticks + 1.
    ('timerless tick ' , ticks printString) out.
    bridge == nil ifFalse: [ bridge checkIn ].
    (wedging not and: [ ticks >= self wedgeAtTick ]) ifTrue: [
      wedging:: true.
      'timerless: entering the wedge — nothing below this line is expected' out.
      [ true ] whileTrue: [ ] ].
    ^ self )

  (* --- TAP-lite, WedgeProbeC6's form ---------------------------------------- *)
  scenarioName = ( ^ 'timerless' )

  tapPlan: n = (
    ('TAP ' , self scenarioName , ' plan=' , n printString) out.
    ^ self )

  tap: idx named: nm ok: passed detail: d = (
    passed
      ifTrue:  [ tapPass:: tapPass + 1.
                 ('TAP ' , self scenarioName , ' ok ' , idx printString ,
                   ' ' , nm , ' ' , d) out ]
      ifFalse: [ tapFail:: tapFail + 1.
                 ('TAP ' , self scenarioName , ' not ok ' , idx printString ,
                   ' ' , nm , ' ' , d) out ].
    ^ self )

  tapDone = (
    ('TAP ' , self scenarioName , ' done pass=' , tapPass printString ,
      ' fail=' , tapFail printString) out.
    ^ self )

) : (
  public packageUsing: manifest = ( ^ self new )
)
