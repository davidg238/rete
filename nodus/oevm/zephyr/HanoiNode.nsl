(*
HanoiNode — self-timed Towers of Hanoi for the oevm/nsl interpreter on ESP32
(Model B / .oimg). Runs a chosen set of depths, printing "hanoi <n>: <ms>" per
depth, then "done".

Depths tested: 8, 16, 20, 24. Recursion DEPTH = n (shallow — max 24 frames, no
VM-stack risk); WORK = 2^n-1 recursive sends, so each +1 doubles the time
(measured ~11.4 us/move, so n=24 ~= 192 s). The move body is verbatim from
00_perf/performance.ns's hanoiMove: (the Toit SimpleHanoi `move`), self-timed
via the `millis` primitive as 00_perf/richards.ns is. No capability, no expect:
(timings vary — perf bucket). This build has no task/interrupt watchdog enabled
(CONFIG_TASK_WDT not set), so the long n=24 compute runs uninterrupted.
*)
class HanoiNode packageUsing: manifest = () (
  public main: platform args: args = (
    self runHanoi: 8.
    self runHanoi: 16.
    self runHanoi: 20.
    self runHanoi: 24.
    ('done') out.
    ^ 0
  )
  runHanoi: n = (
    | t0 t1 |
    t0:: 0 millis.
    self hanoiMove: n from: 1 to: 2 temp: 3.
    t1:: 0 millis.
    ('hanoi ' , n printString , ': ' , (t1 - t0) printString) out.
    ^ n
  )
  public hanoiMove: n from: src to: dst temp: tmp = (
    n > 1 ifTrue: [
      self hanoiMove: n - 1 from: src to: tmp temp: dst.
      self hanoiMove: n - 1 from: tmp to: dst temp: src.
    ].
    ^ n
  )
) : (
)
