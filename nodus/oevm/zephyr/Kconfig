# oevm app Kconfig — WiFi credentials for the ESP32 HTTP node (#46).
# Values are supplied by the git-ignored overlay prj_esp32_wifi.local.conf;
# the defaults below keep non-WiFi boards (DK/dongle) building.
config OEVM_WIFI_SSID
	string "WiFi SSID for the HTTP node"
	default ""

config OEVM_WIFI_PSK
	string "WiFi WPA2 PSK for the HTTP node"
	default ""

# #65 diagnostic. Default n so it never ships in a normal build: it costs a
# thread + stack and prints forever. Turned on by the prj_esp32_netdiag.conf
# overlay (run.sh --conf-extra), which also enables NET_BUF_POOL_USAGE.
config OEVM_NET_HEARTBEAT
	bool "Periodic net-buffer / context census on the console (#65 diagnostic)"
	default n
	depends on NETWORKING
	help
	  Prints a one-line census of the net_pkt slabs, the net_buf data pools and
	  the in-use net_contexts every OEVM_NET_HEARTBEAT_MS. Exists to answer one
	  question: when the node goes unreachable under load while still associated
	  to the AP, has a packet pool drained to zero (exhaustion) or is the kernel
	  no longer scheduling at all (deadlock)? The line stopping is as much of a
	  result as any value in it.

config OEVM_NET_HEARTBEAT_MS
	int "Heartbeat period in milliseconds"
	default 2000
	depends on OEVM_NET_HEARTBEAT

# #56 D8. Default n so it is not merely unreachable in a normal build but
# absent from it. Turned on by prj_esp32c6_faultgate.conf (run.sh --conf-extra),
# which also enables the coredump backend — a fault with no #CD: lines is a
# banner, not evidence. Same shape as OEVM_NET_HEARTBEAT above.
config OEVM_FAULT_TRIGGER
	bool "Fault on purpose at boot, to exercise the symbolizing path (#56)"
	default n
	help
	  Dereferences a null pointer from a known source line shortly after boot.
	  Exists so custos's backtrace (GET /board/<n>/panics/<i>/bt) is proven by a scripted gate rather than
	  by the next real incident. If this is set in a build you did not
	  deliberately configure, that build is wrong.

# rete#215 §8 row 1. Default n so it is not merely unreachable in a normal build but
# ABSENT from it — the same shape as OEVM_FAULT_TRIGGER above, and turned on only by
# prj_esp32c6_wedgegate.conf. It exists so "the note survives a watchdog reset" is proven
# by a scripted gate rather than by the next real wedge.
#
# This is NOT the Kconfig bench/field split design §9 rules out: the DETECTOR ships
# always-on and unchanged. What this gates is a synthetic wedge, and a gate needs one
# because a real wedge cannot be summoned on demand.
config OEVM_WEDGE_TRIGGER
	bool "Wedge on purpose after OEVM_WEDGE_TRIGGER_S seconds (rete#215)"
	default n
	help
	  Stops the reactor draining the pulse mailbox, which the observer must then
	  detect as OBS_COND_APP_STALE (rete#273: the feed stops moving past the
	  declared app cadence). If this is set in a build you did not
	  deliberately configure, that build is wrong.

config OEVM_WEDGE_TRIGGER_S
	int "Seconds after boot before the synthetic wedge"
	default 15
	depends on OEVM_WEDGE_TRIGGER

config OEVM_WEDGE_FORENSICS
	bool "Dump reactor/thread state when the wedge detector fires (rete#222)"
	default n
	select THREAD_MONITOR
	select THREAD_NAME
	select THREAD_STACK_INFO
	select INIT_STACKS
	select THREAD_RUNTIME_STATS   # SCHED_THREAD_USAGE defaults y underneath it
	help
	  EVIDENCE ONLY — it changes no verdict and reboots nothing. On a wedge the
	  observer additionally prints whether the VM's own cursors are still advancing,
	  and walks every thread for its state and stack headroom. That separates a
	  reactor stuck in the interpreter from one blocked on something that is not the
	  pulse mailbox, which is the fact #222, #192 and #213 have all lacked.

	  Not default-on: the selects cost SRAM (INIT_STACKS paints every stack) and the
	  T0.3 footprint ratchet is 75% spent. Turn it on for a hunt, not for a ship.

# rete#440 R1: the Net reader (src/backend/zephyr/udp_zephyr.c) waits in zsock_poll over
# the VM's sockets and the http listener, plus one eventfd that wakes it when that set
# changes. Every socket build links udp_zephyr.c (a Bluetooth build links udp_ble.c,
# which needs no reader), so this is not a choice: it follows the backend. The eventfd
# takes one descriptor, so the table grows by exactly one over Zephyr's own defaults
# (these defaults are read first, the app Kconfig being parsed before Kconfig.zephyr).
config OEVM_NET_READER
	bool
	default y if NET_SOCKETS && !BT
	select ZVFS
	select ZVFS_EVENTFD

config ZVFS_OPEN_MAX
	default 17 if OEVM_NET_READER && (WIFI_NM_WPA_SUPPLICANT || POSIX_API)
	default 5 if OEVM_NET_READER

# Every fd the build can open is pollable by the reader (PR #462 review): a socket the
# reader has no room for fails its bind, and this is what keeps that from happening.
# The reader's own stack and priority (2048 B, K_PRIO_PREEMPT(10)) copy the console
# tee's (log_udp.c, also 2048 B at K_PRIO_PREEMPT(10)); see udp_zephyr.c.
config ZVFS_POLL_MAX
	default ZVFS_OPEN_MAX if OEVM_NET_READER

source "Kconfig.zephyr"
