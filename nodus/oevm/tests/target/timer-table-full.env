# nodus/oevm/tests/target/timer-table-full.env — rete#81 on a board (R2 bench, 2026-11-09, first GREEN at master 1001a48a).
# A full timer table raises in the arming job (main, then a reaction) and the node
# lives: `tablefull tick N` keeps climbing past the TAPs.
SCENARIO=timer-table-full
TAP_NAME=tablefull
NODE=TimerTableFullProbeC6.nsl
BOARD_ID=esp32c6
CLASS=disruptive
TIMEOUT_S=120
OBSERVE_S=60
OBSERVE_PROGRESS='^.*tablefull tick [0-9]+'
