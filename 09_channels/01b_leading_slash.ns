(*
expect-runtime-fail: bad channel path
*)
(* T-C canonicalization guard — a leading `/` is rejected at grant time, never
   silently normalized (addendum A1). *)
class CanonicalizationLeadingSlash packageUsing: manifest = () (
public main: platform args: args = (
  | space |
  space:: platform space.
  space channel: '/a'.
  'unreached' out.
)
) : (
)
