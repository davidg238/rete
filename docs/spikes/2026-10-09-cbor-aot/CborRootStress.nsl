(* THROWAWAY (rete#395): the rooting price. Arm B (sends kept) against arm D (arm B
   holding a fresh rooted object across every send) and arm C (all C), one binary;
   arm E (fresh object, NOT rooted) is the hazard: under OEVM_GC_STRESS its
   `root lost` count must be non-zero, or arm D's green proves nothing.
   Three payloads with sends (str256 has none), four timed arms = 12 span slots. *)
class CborRootStress packageUsing: manifest = ( | platform cbor spans nb nc nd ne nf | ) (

  samples = ( ^ 3 )
  repsNsl = ( ^ 1 )
  repsNative = ( ^ 3 )

  health = ( | pairs |
    pairs:: platform OrderedCollection new.
    pairs add: #uptimeMs -> 2592000000.
    pairs add: #bootId -> 1.
    pairs add: #wakes -> 1296000.
    pairs add: #pollTimeouts -> 431.
    pairs add: #streamDropped -> 17.
    ^ platform Record tag: #Health fields: (platform Map fromPairs: pairs) )

  metrics = ( | pairs |
    pairs:: platform OrderedCollection new.
    pairs add: #heapSize -> 53248.
    pairs add: #liveBytes -> 36196.
    pairs add: #heapHighWater -> 53228.
    pairs add: #largestFreeBlock -> 18608.
    pairs add: #gcCycles -> 1523.
    pairs add: #handlesLive -> 1.
    pairs add: #handlesHighWater -> 1.
    pairs add: #queueHighWater -> 2.
    pairs add: #overruns -> 0.
    pairs add: #pulseDrops -> 0.
    pairs add: #pulseCoalesced -> 0.
    ^ platform Record tag: #Metrics fields: (platform Map fromPairs: pairs) )

  logRec = ( ^ platform Record tag: #Log with: #level -> #info
                                     with: #text -> 'tick 1296000' )

  rowSeq: s path: p value: v = ( ^ platform List with: s with: p with: 2 with: v )

  batch = ( | rows |
    rows:: platform OrderedCollection new.
    rows add: (self rowSeq: 1296000 path: 'obs/health'  value: self health).
    rows add: (self rowSeq: 1296001 path: 'sys/metrics' value: self metrics).
    rows add: (self rowSeq: 1296002 path: 'tel/log'     value: self logRec).
    ^ platform Record tag: #push
        with: #id -> 'c6-bench'
        with: #bootId -> 1
        with: #entries -> (platform List fromCollection: rows) )

  ints64 = ( | oc i |
    oc:: platform OrderedCollection new.
    i:: 1. [ i <= 64 ] whileTrue: [ oc add: i // 4. i:: i + 1 ].
    ^ platform List fromCollection: oc )

  time: name slot: slot of: v with: enc reps: n = (
    | st bytes minUs perEncodeNs s |
    bytes:: (enc encode: v) byteSize.
    s:: 1.
    [ s <= self samples ] whileTrue: [
      spans begin: slot.
      self encodeTimes: v with: enc reps: n.
      spans end: slot.
      s:: s + 1 ].
    st:: spans statsAt: slot.
    minUs:: st basicAt: 2.
    perEncodeNs:: minUs * 1000 // n.
    (name, ' bytes=', bytes printString, ' ns/encode=', perEncodeNs printString) println.
    ^ self )

  encodeTimes: v with: enc reps: n = ( | i |
    i:: 1.
    [ i <= n ] whileTrue: [ enc encode: v. i:: i + 1 ].
    ^ self )

  check: name of: v = ( | ref |
    ref:: cbor encode: v.
    ('check ', name, ' bytes=', ref byteSize printString,
     ' armB=', ((nb encode: v) = ref) printString,
     ' armC=', ((nc encode: v) = ref) printString,
     ' armD=', ((nd encode: v) = ref) printString) println.
    ^ self )

  hazard: name of: v = ( | ref |
    ref:: cbor encode: v.
    ('guard  ', name, ' armF=', ((nf encode: v) = ref) printString) println.
    ('hazard ', name, ' armE=', ((ne encode: v) = ref) printString) println.
    ^ self )

  install: arm = (
    ^ self installNativeCbor: (platform List with: 1) map: (platform Map with: #a -> 1)
           record: (platform Record tag: #T with: #a -> 1) bytes: (cbor encode: 1)
           true: true false: false cbor: cbor arm: arm )

public main: p args: args = (
  | s16 s64 s256 mapNest4 i64 bat |
  platform:: p.
  cbor::  platform Cbor.
  spans:: platform Spans new.

  s16::  '0123456789abcdef'.
  s64::  s16, s16, s16, s16.
  s256:: s64, s64, s64, s64.
  mapNest4:: platform Map with: #v -> (platform Map with: #v -> (platform Map with: #v -> (platform Map with: #v -> s256))).
  i64:: self ints64.
  bat:: self batch.

  nb:: self install: 2.
  nc:: self install: 3.
  nd:: self install: 4.
  ne:: self install: 5.
  nf:: self install: 6.

  ('build ' , platform buildId) println.
  '=== byte identity against the nsl encoder ===' println.
  self check: 'ints64'   of: i64.
  self check: 'mapNest4' of: mapNest4.
  self check: 'batch'    of: bat.

  '=== timing: min of samples, one binary ===' println.
  self time: 'ints64   nsl ' slot: (spans register: #i64n)  of: i64  with: cbor reps: self repsNsl.
  self time: 'ints64   armB' slot: (spans register: #i64b)  of: i64  with: nb   reps: self repsNative.
  self time: 'ints64   armD' slot: (spans register: #i64d)  of: i64  with: nd   reps: self repsNative.
  self time: 'ints64   armC' slot: (spans register: #i64c)  of: i64  with: nc   reps: self repsNative.
  self time: 'mapNest4 nsl ' slot: (spans register: #mn4n)  of: mapNest4 with: cbor reps: self repsNsl.
  self time: 'mapNest4 armB' slot: (spans register: #mn4b)  of: mapNest4 with: nb   reps: self repsNative.
  self time: 'mapNest4 armD' slot: (spans register: #mn4d)  of: mapNest4 with: nd   reps: self repsNative.
  self time: 'mapNest4 armC' slot: (spans register: #mn4c)  of: mapNest4 with: nc   reps: self repsNative.
  self time: 'batch    nsl ' slot: (spans register: #batn)  of: bat  with: cbor reps: self repsNsl.
  self time: 'batch    armB' slot: (spans register: #batb)  of: bat  with: nb   reps: self repsNative.
  self time: 'batch    armD' slot: (spans register: #batd)  of: bat  with: nd   reps: self repsNative.
  self time: 'batch    armC' slot: (spans register: #batc)  of: bat  with: nc   reps: self repsNative.

  '=== guard F (rooted, send allocates) then hazard E (same, unrooted; last: it may not survive) ===' println.
  self hazard: 'ints64'   of: i64.
  self hazard: 'mapNest4' of: mapNest4.
  self hazard: 'batch'    of: bat.
  'done' println.
  ^ 0 )
) : (
)
